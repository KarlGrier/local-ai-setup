+bool PleTable::gather_batch_issue(const uint32_t* rows, size_t n_tokens, std::string& err) {
+    if (impl_->pending || impl_->batch_pending) { err = "PleTable::gather_batch_issue while rows are in flight"; return false; }
+    // (a prefetch may still be in flight: its rows are read again here if they have not landed; collected below)
+    const size_t n = n_tokens * (size_t) PLE_N_HEADS;
+    impl_->batch_n = n;
+    impl_->batch_pending = true;
+    if (impl_->mode == PleIo::Direct) {
+        impl_->batch_raw.resize(n * PLE_ROW_BYTES);
+        impl_->batch_ticket = impl_->reader.issue(rows, n, impl_->batch_raw.data());
+    } else {
+        impl_->batch_rows.assign(rows, rows + n);
+    }
+    return true;
+}
+
+void PleTable::prefetch(const uint32_t* rows, size_t n_rows) {
+    if (impl_->mode != PleIo::Direct || impl_->pf_pending || impl_->batch_pending || n_rows == 0) return;
+    impl_->pf_raw.resize(n_rows * PLE_ROW_BYTES);
+    impl_->pf_ticket = impl_->reader.issue(rows, n_rows, impl_->pf_raw.data());
+    impl_->pf_pending = true;
+}
+
+bool PleTable::gather_batch_collect(float* out, std::string& err) {
+    if (!impl_->batch_pending) { err = "PleTable::gather_batch_collect without issue"; return false; }
+    impl_->batch_pending = false;
+    if (impl_->pf_pending) {   // the prefetch's ticket (its rows are in the cache or in this batch's own reads)
+        impl_->pf_pending = false;
+        if (!impl_->reader.collect(impl_->pf_ticket, err)) return false;
+    }
+    const size_t n = impl_->batch_n;
+    if (impl_->mode == PleIo::Direct) {
+        if (!impl_->reader.collect(impl_->batch_ticket, err)) return false;
+        for (size_t i = 0; i < n; ++i) iq4nl_dequant_row(impl_->batch_raw.data() + i * PLE_ROW_BYTES, out + i * PLE_HEAD_DIM);
+        impl_->bytes_read += (uint64_t) n * PLE_ROW_BYTES;
+        return true;
+    }
+    for (size_t i = 0; i < n; ++i) read_row(impl_->batch_rows[i], out + i * PLE_HEAD_DIM);
+    return true;
+}
+
 void PleTable::set_injected_delay_us(double us) { impl_->reader.set_injected_delay_us(us); }
 
