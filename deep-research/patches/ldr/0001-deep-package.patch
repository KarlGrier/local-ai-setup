+            f"a search that would settle it: {i.get('query')}" if i.get("query") else "")
+        items.append((i["quote"], mark("Check", f"{i.get('type', 'check')}: {(i.get('why') or '').strip()}"
+                                                + (f" ({hint})" if hint else ""))))
