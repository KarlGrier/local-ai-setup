def relief_gb() -> float:
    """the relief-restart trigger for the model 8080 serves: 13 GB for DeepSeek, 20 for Qwen (asked at most once a minute;
    the last answer while Strata does not answer)"""
    if time.time() - _relief[0] > 60:
        _relief[0] = time.time()
        try:
            ids = [m.get("id", "") for m in requests.get(f"{STRATA}/v1/models", timeout=3).json().get("data", [])]
            _relief[1] = MEM_RELIEF_DS_GB if any("deepseek" in i.lower() for i in ids) else MEM_RELIEF_GB
        except Exception:
            pass
    return _relief[1]
