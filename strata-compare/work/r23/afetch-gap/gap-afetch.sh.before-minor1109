PREV=""
if [ $DRY = 0 ] && [ $MOCK = 0 ] && [ -n "$(find $BO $SPD $Y40 $EL -mindepth 1 -print -quit 2> /dev/null; ls -d $SQO/VF $SQO/R1 $SQO/X1 $SQO/X2 $SQO/R2 2> /dev/null)" ]; then
