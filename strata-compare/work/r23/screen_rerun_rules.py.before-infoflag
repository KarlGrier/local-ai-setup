# AMENDMENT 2026-11-07 (Karl, 11-07, on results/r23/port-0211/HUNT-1107.md) - it applies from now on, not to finished gates:
#   "Measurement rule: yes, as a dated amendment applying from now on. Per-workload prompt numbers exclude the
#   chat-cache save. Time the save as its own line in every screen, and judge it separately against its own noise,
#   taking its two-speed pattern into account, so a real regression in saving still shows."
# This file's own screen code is the pre-amendment client clock of its finished gate(s) and is kept as it ran. A new
# gate takes the amended numbers and the chat-cache save line from work/r22/g17_rules.py ("11-07 park amendment":
# screen_rows / screen_passes / baseline_speed / wl_noloss / save_rule), not from a copy of this file's code.
"""screen_rerun_rules.py - r23 (11-05): the rules of work/r23/gap-screen-rerun.sh, written BEFORE it ran. Decode gap b's
9-workload-screen arm-passes that a DeepSeek engine killed at start (strata-dsv41, pid 1135004, 15.0 GiB on the 5080,
started 11-05 ~06:50:33, inside gap b): LO3 (06:50:34), Bs3 (06:50:39), L3 (06:50:42), each with "cudaMalloc ... out of
memory" and "other programs on it: strata-dsv41" in results/r23/decode-timing/gap-b/speed/<n>.engine.log. They are rerun
on engine-r23decode with gap b's configs, and then decode part b is decided from the merged data. Measurement only:
nothing is served or switched. decode_rules.py (gap b's rules) is NOT edited: its decide-b runs unchanged on the merge.

WHAT IS RERUN (missing): an arm-pass of gap b's screen that decode_rules.py does not count (a complete clean pass = env
  PASS, lines PASS, no fatal gate, all 9 workloads with decode and prompt tok/s), among the arms gap b screened, AND whose
  engine-log slice (gap-b/speed/<n>.engine.log) has both of the collision's lines (the cudaMalloc out-of-memory line and
  "other programs on it: ... strata-dsv41"). Any other uncounted arm-pass is KEPT as gap b judged it (a rerun could
  replace a real failure). Order: the original pass's positions (pass 3 "O B Os LO Bs L" -> LO Bs L). --only limits it.
  Found 11-05 from gap b's files: LO3, Bs3, L3. Bs3 is the one-card base: without it Os vs Bs has 2 base passes, so item O
  cannot be decided.
MERGE (final): first decpath_rules.py merge-b, unchanged (the decode-path gap's own merge): gap b's speed/*.jsonl,
  gates.txt and bp90/cold-*.jsonl, with the decode-path gap's bp90 rerun (results/r23/decpath/bp90-rerun, if it ran) in
  place of gap b's failed Basalt arm-passes; without a rerun, gap b's bp90 as it is. Then this gap's screen arm-passes
  over it: for a label N this gap ran (a gate env_N or lines_N in screen-rerun/gates.txt), gap b's speed/N{n,a,r}.jsonl +
  N.wu.jsonl and its env_N / lines_N / pcie_N / fatal_N gate lines are replaced by this gap's. Never overlaid: a label
  gap b already counts (a clean pass is never replaced), and a VOID label (a foreign_N FAIL gate: a GPU compute process
  or engine process that is not engine-r23decode's was seen during the arm) - gap b's failed state stays for it
  (NOT DECIDED). Gap b's and the decode-path gap's files are only read.
DECIDE: decode_rules.py decide-b MERGED --a gap-a (unchanged: 3 complete clean passes per arm, no loss / GAIN, bp90)
  -> MERGED/decision.{txt,json}; decision-b-final.txt = the sources (what came from where, what is still missing) + that
  decision; decision-b-final.json = the same as data.

Subcommands: missing [--gap-b D] [--only "LO3 L3"] | final [--gap-b D --gap-a D --rerun D --bp-rerun D --out D] |
  selftest [--dir D] (synthetic data in work/r23/scratch-screen-rerun/; gap b's real files are only read)
"""
import argparse
import contextlib
import hashlib
import importlib.util
import io
import json
import re
import shutil
import sys
import time
from pathlib import Path

sys.dont_write_bytecode = True
WS = Path("/home/USER/ai-speed-testing/strata-compare")
D = WS / "results/r23/decode-timing"
GAPB, GAPA, OUT = D / "gap-b", D / "gap-a", D / "screen-rerun"
BPRR = WS / "results/r23/decpath/bp90-rerun"
DR_PATH, DP_PATH = WS / "work/r23/decode_rules.py", WS / "work/r23/decpath_rules.py"
SCRATCH = WS / "work/r23/scratch-screen-rerun"
ORDER = {1: "B L O LO Bs Os", 2: "Os Bs LO O L B", 3: "O B Os LO Bs L"}   # gap b's turned order
ARMS = ("B", "L", "O", "LO", "Bs", "Os")
RECORDED = ["LO3", "Bs3", "L3"]                                           # found 11-05 from gap b's files
OOM = re.compile(r"cudaMalloc\(.*out of memory")
DSV = re.compile(r"other programs on it:.*strata-dsv41")
OWN = ("env", "lines", "pcie", "fatal")
_M = {}


def mod(name, path):
    if name not in _M:
        spec = importlib.util.spec_from_file_location(name, path)
        m = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(m)
        _M[name] = m
    return _M[name]


def dr():
    return mod("decode_rules_sr", DR_PATH)


def dp():
    return mod("decpath_rules_sr", DP_PATH)


def key(line):
    return line.split(" ", 1)[0]


def screened(g):
    return [a for a in ARMS if any(re.fullmatch(rf"(env|lines)_{a}[123]", k) for k in g)]


def not_counted(gb):
    """gap b's arm-passes decode_rules.py does not count (arms it screened): [(label, arm, pass)] in pass order"""
    m = dr()
    g = m.read_gates(gb)
    arms = screened(g)
    got = {a: m.passes(gb, g, a) for a in arms}
    return [(f"{a}{k}", a, k) for k in (1, 2, 3) for a in ORDER[k].split() if a in arms and k not in got[a]]


def collided(gb, n):
    p = Path(gb) / "speed" / f"{n}.engine.log"
    t = p.read_text(errors="replace") if p.exists() else ""
    return bool(OOM.search(t) and DSV.search(t))


def cmd_missing(a):
    only = set(a.only.split()) if a.only else None
    rr = []
    for n, arm, k in not_counted(a.gap_b):
        if not collided(a.gap_b, n):
            print(f"KEPT {n}: not counted in gap b, and its engine log has no DeepSeek-collision lines - not rerun "
                  "(gap b's verdict stands)")
        elif only is not None and n not in only:
            print(f"KEPT {n}: collision lines present, left out by --only")
        else:
            print(f"RERUN {n} {arm} {k}")
            rr.append(n)
    print(f"INFO {len(rr)} to rerun: {' '.join(rr) or 'none'}; found 11-05: {' '.join(RECORDED)}"
          + (" (= that)" if rr == RECORDED else ""))
    return 0


def cmd_final(a):
    m, p = dr(), dp()
    gb, ga, sr, bprr, out = (Path(x) for x in (a.gap_b, a.gap_a, a.rerun, a.bp_rerun, a.out))
    merged = out / "merged"
    nc = [n for n, _, _ in not_counted(gb)]
    with contextlib.redirect_stdout(io.StringIO()) as buf:   # the decode-path gap's merge, unchanged
        p.cmd_merge_b(argparse.Namespace(gap_b=str(gb), rerun=str(bprr), merged=str(merged)))
    merge_line = buf.getvalue().strip()
    bp_labels = sorted({json.loads(x)["label"] for f in (bprr.glob("cold-*.jsonl") if bprr.exists() else [])
                        for x in f.read_text().splitlines() if x.strip()})
    sgf = sr / "gates.txt"
    sl = sgf.read_text().splitlines() if sgf.exists() else []
    ran = []
    for x in sl:
        mm = re.fullmatch(r"(?:env|lines)_((?:B|L|O|LO|Bs|Os)[123])", key(x))
        if mm and mm.group(1) not in ran:
            ran.append(mm.group(1))
    foreign = {key(x)[8:]: x.split(" ", 2)[2] if x.count(" ") >= 2 else "" for x in sl
               if key(x).startswith("foreign_") and x.split(" ")[1:2] == ["FAIL"]}
    gm_ = merged / "gates.txt"
    gl = gm_.read_text().splitlines()
    used, notes = [], []
    for n in ran:
        if n not in nc:
            notes.append(f"{n}: gap b already counts it - this gap's run is not used")
            continue
        if n in foreign:
            notes.append(f"{n}: VOID ({foreign[n][:160]}) - not merged, gap b's failed state stays")
            continue
        own = {f"{q}_{n}" for q in OWN}
        gl = [x for x in gl if key(x) not in own] + [x for x in sl if key(x) in own]
        for s in ("n.jsonl", "a.jsonl", "r.jsonl", ".wu.jsonl"):
            (merged / "speed" / f"{n}{s}").unlink(missing_ok=True)
            src = sr / "speed" / f"{n}{s}"
            if src.exists():
                shutil.copy(src, merged / "speed" / src.name)
        used.append(n)
    for n, why in foreign.items():
        if n not in ran:
            notes.append(f"{n}: not started ({why[:160]})")
    gm_.write_text("\n".join(gl) + "\n")
    with contextlib.redirect_stdout(io.StringIO()):
        m.decide_b(argparse.Namespace(outdir=str(merged), a=str(ga)))
    dec = (merged / "decision.txt").read_text()
    g = m.read_gates(merged)
    still = [n for n, _, _ in not_counted(merged)]
    bp_still = [f"{x}-{y}-{z}" for x, y, z in p.bp_missing(merged / "bp90")]
    st_of = lambda n: (f"env {g.get(f'env_{n}', ('MISSING',))[0]}, lines {g.get(f'lines_{n}', ('MISSING',))[0]}"
                       + (", FATAL" if f"fatal_{n}" in g else "") + (", counted" if n not in still else ", NOT counted"))
    L = [f"decode part b - FINAL decision ({time.strftime('%F %T')}; work/r23/screen_rerun_rules.py final; the rules: "
         "decode_rules.py decide-b, unchanged, on the merged records in merged/)",
         "sources (gap b's and the decode-path gap's files are only read):",
         f"  part b ({gb}): every arm-pass it counts; not counted there: {' '.join(nc) or 'none'}",
         f"  screen rerun ({sr}): " + ("; ".join(f"{n} {st_of(n)}" for n in used) or "none merged"),
         f"  bp90 rerun of the decode-path gap ({bprr}): " + (f"{len(bp_labels)} arm-passes ({' '.join(bp_labels)})"
                                                              if bp_labels else "not run - bp90 = gap b's own passes"),
         f"  still missing after the merge: screen {' '.join(still) or 'none'}; bp90 {' '.join(bp_still) or 'none'}"]
    L += [f"  note: {x}" for x in notes] + [f"  merge-b: {merge_line}", ""]
    (out / "decision-b-final.txt").write_text("\n".join(L) + "\n" + dec)
    dj = json.loads((merged / "decision.json").read_text())
    (out / "decision-b-final.json").write_text(json.dumps(
        {"written": time.strftime("%F %T"), "screen_rerun_used": used, "notes": notes, "bp90_rerun": bp_labels,
         "not_counted_in_gap_b": nc, "still_missing": {"screen": still, "bp90": bp_still}, "decision": dj}, indent=1))
    print("\n".join(L[:6]))
    print("\n".join(x for x in dec.splitlines() if x.startswith("=> item")))
    return 0


