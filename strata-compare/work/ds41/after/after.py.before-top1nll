              "KL>1 count <= the worse reference's + 1": c["kl_gt1"] <= max(r1["kl_gt1"], r2["kl_gt1"]) + 1,
              "top-1 agreements >= the lower reference's - 1": c["top1_agree"] >= min(r1["top1_agree"], r2["top1_agree"]) - 1}
    skip_lines = sum(1 for i in range(8) if os.path.exists(f"{cand}/s{i}/engine.out")
                     for l in open(f"{cand}/s{i}/engine.out", errors="replace") if "prompt skip" in l)
    f = lambda r: f"mean {r['kl_mean']:.5f}, p90 {r['kl_p90']:.5f}, KL>1 {r['kl_gt1']}, top-1 {r['top1_agree']} of {r['positions']}"
    ok = all(checks.values())
    out = {"cand": c, "refs": res, "checks": checks, "pass": ok, "skip_engine_lines": skip_lines,
           "line": f"final config (v0.2.6 + #343 + 8/32) vs stock v0.2.6: {'PASS (rounding-level)' if ok else 'FAIL'} - "
                   f"cand {f(c)}; R1 chunk 4096 {f(r1)}; R2 CPU share {f(r2)}; "
                   + "; ".join(f"{'ok' if v else 'FAIL'} {k}" for k, v in checks.items())
                   + f"; prompt-skip engine lines {skip_lines} (8 segments)"}
    st["final_gate"] = out
    save(st)
    say(out["line"])
