def final_gate(st):
    """Karl (via the user, 16:05): "gate the split: run the rounding check on exactly the final config (v0.2.6 + #343 +
    8/32) vs stock v0.2.6, against the same references and bounds (including the new p90 rule). If it fails, report it
    before the daily config goes live; Karl decides." The round's final check (teacher-forced long8: a 12,000-token prefix
    read as one prompt, 256 positions scored per segment) with its stored base (stock v0.2.6, the engine defaults) and
    references (R1 chunk 4096, R2 reserve 2600 - teacher/final-*); the candidate = the daily config's engine settings
    on the measurement profile (SHIPPED), as the ship config's candidate was"""
    if st.get("final_gate") or DRY:
        return
    ids = skipcheck.ids_file()
    m = dict(daily_mods(st, f"{R}/gate-slots"), **{"--expert-profile": tune.SHIPPED})
    say(f"final config rounding check: {json.dumps({k: v for k, v in m.items() if not str(k).startswith('STRATA_DS4_SLOT')})}")
    try:
