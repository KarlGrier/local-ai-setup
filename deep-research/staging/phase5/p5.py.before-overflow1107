def norm_class(c) -> str | None:
    if not isinstance(c, str):
        return None
    c = c.strip().lower()
    c = CLASS_ALIASES.get(c, c)
    return c if c in CLASSES else None


def bench2_module():
    spec = importlib.util.spec_from_file_location("bench2_p5", BENCH2)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def run_info(run: Path) -> dict:
    d = {"state": run_state(run)}
    try:
        bj = json.loads((run / "bench.json").read_text())
        d.update(wall_min=round(bj.get("wall_s", 0) / 60, 1), rc=bj.get("rc"), ended=bj.get("ended"),
                 efforts=bj.get("ldr_efforts"))
        if bj.get("search_trip"):      # 11-06 (Karl): tripped the client's search rule, end check passed -> complete
            d["flag"] = "search trip, end check passed"
            d["search_trip"] = {k: bj["search_trip"].get(k) for k in ("at", "rule", "empty_in_a_row", "outage_from",
                                                                      "searches_back_at")}
    except (OSError, ValueError):
        pass
    try:
        mk = json.loads((run / "marks.json").read_text())
        d["engine_log"] = Path(mk.get("engine_log") or "?").name
        d["min_avail_gb"] = mk.get("min_avail_gb")
    except (OSError, ValueError):
        pass
    return d


def cmd_tally(a, cfg) -> int:
    out = Path(a.out) if a.out else WS / cfg["out"]
    ck, op = out / "checkable", out / "open"
    manifest = json.loads((ck / "MANIFEST.json").read_text())
    arms = [arm["name"] for arm in cfg["arms"]]
    # 1 every grade first - the keys stay closed until then
    grades, problems = {}, []
    for line, ids in manifest["lines"].items():
        for qid in ids:
            gp = ck / "grades" / f"{qid}.json"
            if not gp.exists():
                problems.append(f"{qid}: no grade")
                continue
            g = json.loads(gp.read_text())
            labs = manifest["packets"][qid]["labels"]
            cls = {lab: norm_class((g.get("class") or {}).get(lab)) for lab in labs}
            if g.get("id") != qid or any(v is None for v in cls.values()):
                problems.append(f"{qid}: grade file incomplete (id / a class per label {labs}, one of {CLASSES})")
                continue
            grades[qid] = {**g, "class": cls}
    okey_path = op / KEY_NAME
    # the open questions from their packet folders (the key file stays closed until every grade is in)
    open_ids = sorted(d.name for d in op.iterdir() if d.is_dir() and (d / "A.md").exists()) if op.exists() else []
    ogrades = {}
    for qid in open_ids:
        gp = op / f"grades-{qid}.json"
        if not gp.exists():
            problems.append(f"open {qid}: no grade")
            continue
        g = json.loads(gp.read_text())
        labs = sorted(p.stem for p in (op / qid).glob("*.md"))
        if any(lab not in (g.get("totals") or {}) for lab in labs):
            problems.append(f"open {qid}: totals missing for some of {labs}")
            continue
        ogrades[qid] = g
    if problems and not a.partial:
        print("not tallied - keys left closed:\n  " + "\n  ".join(problems), file=sys.stderr)
        return 2
    # blind-open.py --reveal's convention: a summary line per graded open question in grades.jsonl
    gl = op / "grades.jsonl"
    done = {json.loads(l)["id"] for l in gl.read_text().splitlines() if l.strip()} if gl.exists() else set()
    with open(gl, "a") as f:
        for qid, g in ogrades.items():
            if qid not in done:
                f.write(json.dumps({k: g.get(k) for k in ("id", "graded", "rank", "checklist", "totals",
                                                          "wrong_claims")}) + "\n")
    # 2 the keys
    key = json.loads((ck / KEY_NAME).read_text())
    okey = json.loads(okey_path.read_text()) if okey_path.exists() else {}
    folder_arm = {}
    for arm in cfg["arms"]:
        for s in {ent["set"] for line in cfg["lines"].values() for ent in line["sets"]} | {cfg["o01_line"]["set"]}:
            folder_arm[folder(s, arm)] = arm["name"]
    bench2 = bench2_module()
    ans = {x["id"]: x for f in cfg["answer_files"] for x in load_jsonl(B / f)}
    res = {"tallied": datetime.now().isoformat(timespec="seconds"), "arms": arms, "partial": bool(problems),
           "problems": problems, "lines": {}, "questions": {}, "open": {}}
    for line, ids in manifest["lines"].items():
        counts = {arm: {c: 0 for c in CLASSES + ["not run", "ungraded"]} for arm in arms}
        by_set = {}
        for qid in ids:
            k = key[qid]
            row = {"line": line, "set": k["set"], "class": {}, "committed_to": {}, "why": {}, "match": {}, "run": {}}
            inv = {arm: lab for lab, arm in k["labels"].items()}
            for arm in arms:
                run = B / "runs" / k["folders"][arm] / qid
                row["run"][arm] = run_info(run)
                if arm in k["missing"] or arm not in inv:
                    c = "not run"
                elif qid not in grades:
                    c = "ungraded"
                else:
                    lab = inv[arm]
                    c = grades[qid]["class"][lab]
                    row["committed_to"][arm] = (grades[qid].get("committed_to") or {}).get(lab)
                    row["why"][arm] = (grades[qid].get("why") or {}).get(lab)
                row["class"][arm] = c
                counts[arm][c] += 1
                by_set.setdefault(k["set"], {a_: {c_: 0 for c_ in CLASSES + ["not run", "ungraded"]} for a_ in arms})
                by_set[k["set"]][arm][c] += 1
                if c != "not run" and qid in ans:
                    txt = bench2.answer_text(run, "deep")
                    row["match"][arm] = bool(txt and bench2.matches(txt, ans[qid]))
            if qid in grades and grades[qid].get("key_doubt"):
                row["key_doubt"] = grades[qid]["key_doubt"]
            res["questions"][qid] = row
        res["lines"][line] = {"title": cfg["lines"][line]["title"], "ids": ids, "counts": counts, "by_set": by_set}
    for qid in open_ids:
        g = ogrades.get(qid)
        n_items = cfg["open_refs"].get(qid, [None, 0])[1]
        row = {"max": 2 * n_items, "totals": {}, "wrong_claims": {}, "rank": None, "run": {}}
        for lab, fold in okey.get(qid, {}).items():
            arm = folder_arm.get(fold, fold)
            row["run"][arm] = run_info(B / "runs" / fold / qid)
            if g:
                row["totals"][arm] = g["totals"].get(lab)
                row["wrong_claims"][arm] = (g.get("wrong_claims") or {}).get(lab)
        if g:
            rank = g.get("rank") or []
            row["rank"] = [folder_arm.get(okey[qid].get(x, x), x) for x in rank]
        res["open"][qid] = row
    (out / "p5-results.json").write_text(json.dumps(res, indent=1, ensure_ascii=False))
    (out / "REPORT.md").write_text(report_md(cfg, res))
    print(f"tallied: {out / 'REPORT.md'}, {out / 'p5-results.json'}" + (" (PARTIAL)" if problems else ""))
    return 0


def report_md(cfg: dict, res: dict) -> str:
    arms = res["arms"]
    arm_desc = []
    for arm in cfg["arms"]:
        items = arm.get("items")
        items = ", ".join(items) if isinstance(items, list) else (items or "none")
        arm_desc.append(f"**{arm['name']}** = profile {arm['profile']}"
                        + (f", report {arm['effort']} / citation check {arm.get('verify_effort', arm['effort'])}"
                           if arm.get("effort") else "")
                        + f", items {items}, runs folders `<set>-{arm['profile']}"
                        + (f"-{arm['label']}" if arm.get("label") else "") + "`")
    L = [f"# Phase 5 holdout - {' vs '.join(arms)} (tallied {res['tallied']})", ""]
    if res["partial"]:
        L += ["**PARTIAL** - not every packet is graded: " + "; ".join(res["problems"]), ""]
    L += ["Arms: " + "; ".join(arm_desc) + ".", "",
          "Checkable questions: the Answer-section rule (hard-build-p5/PHASE5-CHECKABLE-RULES.md), graded blind from "
          "packets of each run's Answer section (staging/phase5/p5.py packets: tools/blind-open.py's cleaning, citations "
          "and links out, labels shuffled per question); grades written before the key was opened. Only **correct** "
          "scores; wrong commitments (an answer that is not the key's) and non-answers (none, or 'could not determine') "
          "are counted apart. The string match is the old whole-Answer cross-check only, never the score. Open "
          "questions: tools/blind-open.py packets, one fresh grader per question against my-research/, as blind-p4s7.",
          ""]
    hdr = "| | correct | wrong commitment | hedged | non-answer | not run | string match (cross-check) | mean wall min |"
    for line in ("checkable", "harder"):
        if line not in res["lines"]:
            continue
        ln = res["lines"][line]
        L += [f"## {ln['title']}", "", hdr, "|---|---|---|---|---|---|---|---|"]
        for arm in arms:
            c = ln["counts"][arm]
            n = len(ln["ids"])
            m = sum(1 for q in ln["ids"] if res["questions"][q]["match"].get(arm))
            walls = [res["questions"][q]["run"][arm].get("wall_min") for q in ln["ids"]
                     if res["questions"][q]["run"][arm].get("wall_min") is not None]
            ung = f" (+{c['ungraded']} ungraded)" if c["ungraded"] else ""
            L.append(f"| {arm} | **{c['correct']}** of {n}{ung} | {c['wrong commitment']} | {c['hedged']} | "
                     f"{c['non-answer']} | {c['not run']} | {m} | "
                     f"{(sum(walls) / len(walls)) if walls else 0:.0f} |")
        if len(ln["by_set"]) > 1:
            for s, per in ln["by_set"].items():
                n = sum(1 for q in ln["ids"] if res["questions"][q]["set"] == s)
                L.append(f"| *of which {s} ({n})* | " + " / ".join(f"{arm} {per[arm]['correct']}" for arm in arms)
                         + " | " + " / ".join(f"{per[arm]['wrong commitment']}" for arm in arms)
                         + " | " + " / ".join(f"{per[arm]['hedged']}" for arm in arms)
                         + " | " + " / ".join(f"{per[arm]['non-answer']}" for arm in arms)
                         + " | " + " / ".join(f"{per[arm]['not run']}" for arm in arms) + " | | |")
        L.append("")
        if line == "harder":
            L += ["Per question (class; a wrong commitment shows what it committed to):", "",
                  "| question | " + " | ".join(arms) + " |", "|---|" + "---|" * len(arms)]
            for q in ln["ids"]:
                row = res["questions"][q]
                cells = []
                for arm in arms:
                    c = row["class"][arm]
                    if c == "wrong commitment" and row["committed_to"].get(arm):
                        c += f" ({row['committed_to'][arm]})"
                    cells.append(c)
                L.append(f"| {q} | " + " | ".join(cells) + " |")
            L.append("")
    if res["open"]:
        ol = cfg["lines"].get("open", {})
        otitle = ol["title"] if ol.get("title") and len(res["open"]) == ol.get("expect") else f"open ({len(res['open'])})"
        L += [f"## {otitle}", "",
              "| question (out of) | " + " | ".join(arms) + " | wrong claims found, " + " / ".join(arms) + " | rank |",
              "|---|" + "---|" * len(arms) + "---|---|"]
        tot = {arm: 0.0 for arm in arms}
        wc = {arm: 0 for arm in arms}
        mx = 0
        for q, row in res["open"].items():
            mx += row["max"]
            vals = []
            for arm in arms:
                v = row["totals"].get(arm)
                vals.append("-" if v is None else f"{v:g}")
                tot[arm] += v or 0
                wc[arm] += row["wrong_claims"].get(arm) or 0
            L.append(f"| {q} ({row['max']}) | " + " | ".join(vals) + " | "
                     + " / ".join(str(row["wrong_claims"].get(arm, "-")) for arm in arms) + " | "
                     + (" > ".join(row["rank"]) if row["rank"] and row["rank"] != ["tie"] else "tie" if row["rank"] else "-")
                     + " |")
        L.append(f"| open total ({mx}) | " + " | ".join(f"**{tot[arm]:g}**" for arm in arms) + " | "
                 + " / ".join(str(wc[arm]) for arm in arms) + " | |")
        L.append("")
    if "checkable" in res["lines"]:
        ln = res["lines"]["checkable"]
        L += [f"## Detail: {ln['title']} per question", "", "| question | set | " + " | ".join(arms) + " |",
              "|---|---|" + "---|" * len(arms)]
        for q in ln["ids"]:
            row = res["questions"][q]
            cells = []
            for arm in arms:
                c = row["class"][arm]
                if c == "wrong commitment" and row["committed_to"].get(arm):
                    c += f" ({row['committed_to'][arm]})"
                cells.append(c)
            L.append(f"| {q} | {row['set']} | " + " | ".join(cells) + " |")
        L.append("")
    dis = []
    for q, row in res["questions"].items():
        for arm in arms:
            c = row["class"].get(arm)
            if arm in row["match"] and c not in ("not run", "ungraded") and row["match"][arm] != (c == "correct"):
                dis.append(f"- {q} / {arm}: graded {c}, string match {'hit' if row['match'][arm] else 'no hit'}")
    L += ["## Blind grade vs the string cross-check", ""] + (dis or ["- none: they agree on every graded answer"]) + [""]
    doubts = [f"- {q}: {row['key_doubt']}" for q, row in res["questions"].items() if row.get("key_doubt")]
    if doubts:
        L += ["## Key doubts raised by graders (the class stays against the key)", ""] + doubts + [""]
    eng = {}
    for row in list(res["questions"].values()) + list(res["open"].values()):
        for arm, ri in row["run"].items():
            if ri.get("engine_log"):
                eng.setdefault(arm, {}).setdefault(ri["engine_log"], 0)
                eng[arm][ri["engine_log"]] += 1
    bad_rc = [f"{q}/{arm} rc {ri.get('rc')}" for q, row in list(res["questions"].items()) + list(res["open"].items())
              for arm, ri in row["run"].items() if ri.get("state") == "done" and ri.get("rc") not in (0, None)]
    flagged = [f"{q}/{arm}: {ri['flag']} (trip at {(ri.get('search_trip') or {}).get('at')})"
               for q, row in list(res["questions"].items()) + list(res["open"].items())
               for arm, ri in row["run"].items() if ri.get("flag")]
    L += ["## Runs", "",
          "- engine log per arm (marks.json): " + "; ".join(
              f"{arm}: " + ", ".join(f"{k} x{v}" for k, v in sorted(d.items())) for arm, d in eng.items()),
          "- one engine for every run: " + ("yes" if len({k for d in eng.values() for k in d}) <= 1 else
                                            "**NO - the arms or runs differ in engine; see p5-results.json**"),
          f"- engine wanted (p5.json): {cfg['engine'].get('config')} / {cfg['engine'].get('sha12')}",
          "- runs with rc != 0: " + (", ".join(bad_rc) if bad_rc else "none"),
          "- flagged runs (11-06): " + (", ".join(flagged) if flagged else "none"), ""]
    return "\n".join(L)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--config", default=None)
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("plan")
    p.add_argument("--out", default=None)
    p.add_argument("--allow-placeholder", action="store_true")
    sp.add_parser("check-engine")
    sp.add_parser("check-frozen")
    sp.add_parser("swap-mark")
    sp.add_parser("status")
    p = sp.add_parser("packets")
    p.add_argument("--out", default=None)
    p.add_argument("--allow-missing", action="store_true")
    p.add_argument("--force", action="store_true")
    p = sp.add_parser("tally")
    p.add_argument("--out", default=None)
    p.add_argument("--partial", action="store_true")
    a = ap.parse_args()
    cfg = load_cfg(a.config)
    return {"plan": cmd_plan, "check-engine": cmd_check_engine, "check-frozen": cmd_check_frozen,
            "swap-mark": cmd_swap_mark, "status": cmd_status, "packets": cmd_packets, "tally": cmd_tally}[a.cmd](a, cfg)


if __name__ == "__main__":
    sys.exit(main())
