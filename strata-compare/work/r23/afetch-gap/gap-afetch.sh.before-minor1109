sqarm() {   # sqarm ARM [BUDGET_S]: one sampled arm on a fresh test server (STEPS-adaptfetch.txt 2 / 3): both env checks, the
  # client; test_cleanup (a leftover voids the start: its folder moves to void-ARM-*, so the harness cannot use it)
  local arm=$1 bud=${2:-} cfg=$SQO/cfg/$1.json lab=$LP-sq$1 L off exe eo=$EL/sq-$1.englog
