  GW_S=0.3; KGRACE_N=3; KGRACE_S=0.2; KTERM_S=1; KERR=$M/kernel_error
  ENGNAMES=afmock-eng; ENG28=$M/engines/engine-r22p028x; ENGAF=$M/engines/engine-r23afetch; LOCKF=$M/gpu-test.lock   # (fake engines: never named strata*)
