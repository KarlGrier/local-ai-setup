VFV=""; VFDONE=0; VFTRIES=0
vf_part() {   # the read-back start (STEPS 2): VF, then sq.py verify; the verdict is read from verify-VF.json (not its exit code).
  # Neither PASS nor FAIL (not started, voided, a foreign GPU user, a crash): VFDONE=0, tried once more later (review 11-09
  # m3 / m6: at most one retry; the first try's FAIL gates are marked RETRIED, its folder kept as void-VF-try1-*)
  local vrc k
  VFDONE=1; VFTRIES=$((VFTRIES + 1))
  if [ $VFTRIES = 2 ]; then
    for k in env_sqVF envsq_VF fatal_sqVF void_sqVF foreign_sqVF; do [ "$(gst $k)" = FAIL ] && gate $k RETRIED "try 1 FAIL; the read-back start tried again"; done
    [ -d $SQO/VF ] && mv $SQO/VF $SQO/void-VF-try1-$(date +%H%M%S); rm -f $SQO/verify-VF.json $SQO/envcheck-VF.txt
  fi
  sqarm VF 300 || true
  sq verify $SQO VF > $SQO/verify.out 2>&1; vrc=$?
  VFV=$(jget $SQO/verify-VF.json "['verdict']" 2> /dev/null) || VFV=""
  [ "$VFV" = PASS ] && [ "$(gst foreign_sqVF)" = FAIL ] && VFV="NOT DECIDED (a foreign GPU user during VF)"
  say "  read-back VF (try $VFTRIES): ${VFV:-no verify-VF.json} ($(tail -1 $SQO/verify.out | cut -c1-200); sq.py verify exit $vrc)"
  gate readback_VF $(case $VFV in PASS) echo PASS;; FAIL) echo FAIL;; *) echo NOT-DECIDED;; esac) "try $VFTRIES: verify-VF.json ${VFV:-missing}; sq.py verify exit $vrc"
  if [ "$VFV" != PASS ] && [ "$VFV" != FAIL ] && [ $VFTRIES -lt 2 ]; then VFDONE=0; say "  the read-back start is tried once more later"; fi
}
sq_decide() {   # sq.py decide (CPU): the harness's own decision (it refuses a changed rule.txt)
  local sd sdc
