+            body = body[:p] + mk + body[p:]
+        return body, "\n".join(lines)
+    for c in bad:
+        q = c["quote"].strip()
+        fix = (c.get("fix") or c.get("why") or "").strip()
+        mark = f" **[Setup check: {fix}]**" if fix else " **[Setup check: this disagrees with your setup profile]**"
+        at = body.find(q)
+        if at >= 0:
