# profiles/qwen4-flash.env - Qwen4 Flash on Strata: SKELETON for day one (written 2026-10-29, before any release).
#
# EVERY VALUE BELOW IS UNMEASURED. Qwen4 is not released and Strata does not support it yet: nothing in this file is a
# Qwen4 fact. Each value is Flash-Next's (profiles/flash-next.env) as the placeholder, with what day one must measure
# before it is kept. Plan: results/bench2/QWEN4-DAY1-PLAN.md.
# run-ldr.sh refuses this profile (LDR_PROFILE_STATUS=draft) unless LDR_ALLOW_DRAFT_PROFILE=1; only the day-one queue
# sets that. It stays draft until Karl has seen the day-one result.
#
# Day one, after C3 is installed: copy this file to ~/ai/deep-research/profiles/, fill in the measured values, then
#   .venv/bin/python -I <package>/deep/modelprofile.py --check profiles/qwen4-flash.env
#   .venv/bin/python -I <package>/deep/modelprofile.py --show --profile qwen4-flash
#
# MEASURE ON DAY ONE - the model facts that decide the values below (some are not profile keys):
#   context     the --max-context Strata serves Qwen4 at on this PC (its VRAM reserve, MemAvailable >= 12 GB during a
#               full-context prompt), never above the model's own window -> LDR_DEEP_CONTEXT_TOKENS; every 'auto' size
#               follows it
#   tokenizer   vocab size + sha256 of tokenizer.json / vocab.json / merges.txt against deep/tokenizer (Flash-Next's Qwen
#               BPE, 248,320 tokens) -> LDR_DEEP_TOKENIZER_DIR, the margins, the template overheads
#   thinking    the reasoning_effort names Strata accepts for Qwen4, thinking tokens per level on one fixed prompt,
#               whether thinking can be turned off, whether thinking still ends inside max_tokens (Strata's answer_room,
#               3/4 of max_tokens on Flash-Next) -> the efforts, LDR_DEEP_EFFORT_MAP, the ladder, LDR_LLM_MAX_TOKENS
#   tool calls  the format Qwen4's chat template uses; Strata must return structured tool_calls through strata-proxy
#               (no '<tool_call' text in prose answers in logs/llm-calls.jsonl) -> LDR_DEEP_TOK_TOOLS_OVERHEAD; a
#               failure here stops day one before any LDR run
#   speed       decode and prompt tok/s at ~8K, ~32K and the full context (Flash-Next: ~100 tok/s decode) -> the pace
#               values below, and Fix 6's time plan (deep/checks.py EST, 1,200 tok/s prompt / 35 tok/s output - NOT a
#               profile key, C3 README open item 3)
#   MTP         whether the model files carry MTP heads or a drafter exists, and whether Strata uses it for Qwen4
#               (Flash-Next: --mtp + --spec) - speed only, not a profile key
#   max output  the model's / Strata's output limit -> LDR_DEEP_REPORT_MAX_OUTPUT
# Sampling is Karl's rule, not a measurement: T 1.0 / top-p 0.95 / top-k 20 / min-p 0.05 on every arm.
#
# auto = base * LDR_DEEP_CONTEXT_TOKENS // 131072 (the base, Flash-Next's tuned value, is in the comment): at the
# placeholder context these are exactly Flash-Next's sizes. They were tuned on Flash-Next only
# (results/AUDIT-FLASHNEXT-TUNING-1027.md); day one keeps them derived and does not re-tune them (C3c's kind of test).

LDR_PROFILE_MODEL=Qwen4-Flash (Strata)    # unmeasured: the model id Strata reports on /v1/models
LDR_PROFILE_STATUS=draft                  # unmeasured: every value in this file

# ---- context and output (unmeasured) --------------------------------------------------------------------------------
LDR_DEEP_CONTEXT_TOKENS=131072            # unmeasured (Flash-Next's): Strata's --max-context for Qwen4 on this PC. Below
                                          # ~54K, lower LDR_LLM_MAX_TOKENS too: compact_at (56000 x C / 131072) must stay
                                          # under C - max_tokens - 512 (C3 README open item 4: no clamps)
LDR_LLM_MAX_TOKENS=30000                  # unmeasured (Flash-Next's): thinking + answer per LDR call; check that a call
                                          # at medium and at xhigh ends with an answer inside it (answer_room on Qwen4?)
LDR_DEEP_REPORT_MAX_OUTPUT=60000          # unmeasured (Flash-Next's): must not exceed the model's / Strata's output limit
LDR_DEEP_REPORT_ANSWER_RESERVE=8192       # unmeasured (Flash-Next's)
LDR_DEEP_REPORT_MARGIN=1024               # unmeasured (Flash-Next's): exact token counts only; 16384 if the tokenizer
                                          # check fails and counts are estimated (as sonnet-5-5.env)
LDR_DEEP_TOKEN_MARGIN=512                 # unmeasured (Flash-Next's): exact counts only; 8192 with estimated counts

# ---- compaction (unmeasured; Flash-Next's tuning) ---------------------------------------------------------------------
LDR_DEEP_COMPACT_AT=auto                  # unmeasured: 56000 at 131072
LDR_DEEP_KEEP_RECENT=6                    # unmeasured (Flash-Next's)
LDR_DEEP_KEEP_RECENT_FRAC=0.35            # unmeasured (Flash-Next's)
LDR_DEEP_COMPACT_FALLBACK_TOKENS=auto     # unmeasured: 12000 at 131072

# ---- what the lead and the writers see (unmeasured; derived from the context, Flash-Next's bases) ----------------------
LDR_DEEP_SUB_RETURN_MAX_CHARS=auto        # unmeasured: 16000 at 131072
LDR_DEEP_SNIPPET_CHARS=auto               # unmeasured: 300 at 131072
LDR_DEEP_FETCH_MAX_CHARS=auto             # unmeasured: 120000 at 131072
LDR_DEEP_EXTRACT_MAX_CHARS=4000           # unmeasured (Flash-Next's)
LDR_DEEP_REPORT_EVIDENCE_TOKENS=auto      # unmeasured: 48000 at 131072
LDR_DEEP_SECTION_EXTRACT_FRAC=0.6         # unmeasured (Flash-Next's)
LDR_DEEP_REPORT_FINDINGS_TOKENS=auto      # unmeasured: 12000 at 131072
LDR_DEEP_OUTLINE_LEAD_TOKENS=auto         # unmeasured: 10000 at 131072
LDR_DEEP_OUTLINE_FINDINGS_FRAC=0.40       # unmeasured (Flash-Next's)
LDR_DEEP_CLAIMS_PER_SOURCE=auto           # unmeasured: 40 at 131072 (item 5)
LDR_DEEP_READ_PASSAGE_TOKENS=auto         # unmeasured: 350 at 131072 (item 6)
LDR_DEEP_SEED_TEXT_CHARS=auto             # unmeasured: 60000 at 131072
LDR_DEEP_VERIFY_CLAIM_SOURCE_TOKENS=auto  # unmeasured: 2000 at 131072
LDR_DEEP_VERIFY_BATCH_TOKENS=auto         # unmeasured: 36000 at 131072
LDR_DEEP_VERIFY_BATCH_CLAIMS=8            # unmeasured (Flash-Next's)
LDR_DEEP_VERIFY_PAGE_TOKENS=auto          # unmeasured: 40000 at 131072 (old per-source check, unused)
LDR_DEEP_TRIED_PART_CHARS=auto            # unmeasured: 60000 at 131072 (tried list is off)
LDR_DEEP_TRIED_MERGE_CHARS=auto           # unmeasured: 100000 at 131072
LDR_DEEP_TRIED_BLOCK_CHARS=auto           # unmeasured: 36000 at 131072

# ---- tokenizer (unmeasured) -------------------------------------------------------------------------------------
LDR_DEEP_TOKENIZER_DIR=/home/USER/ai/deep-research/deep/tokenizer   # unmeasured: Flash-Next's Qwen BPE (248,320 tokens).
                                          # Keep ONLY if the day-one hash + vocab check matches. Else: Qwen4's own
                                          # tokenizer files in a new dir (deep/tokenizer-qwen4/), or empty (chars/3)
                                          # with the two margins widened as noted above
LDR_DEEP_TOK_MSG_OVERHEAD=8               # unmeasured (Flash-Next's ChatML): prompt_tokens of a 2-message request minus
                                          # its contents, from Qwen4's chat template
LDR_DEEP_TOK_TOOLS_OVERHEAD=150           # unmeasured (Flash-Next's): prompt_tokens with LDR's tools minus without,
                                          # minus the tool JSON itself
LDR_DEEP_TOK_CHARS_PER_TOKEN=3            # unmeasured (Flash-Next's): used only without a tokenizer

# ---- reasoning effort per call type (unmeasured; our names: low / medium / high / xhigh) ------------------------
# bench2 sets report / verify per run (day one: medium / xhigh, as p4s7); agent and extraction efforts reach Strata
# through strata-proxy's mode file (run/proxy-mode.json), not through LDR - if Strata's Qwen4 names differ from ours,
# both LDR_DEEP_EFFORT_MAP and the proxy mode file need them
LDR_DEEP_EXTRACT_EFFORT=                  # unmeasured (Flash-Next's): empty = the proxy / Strata decides
LDR_DEEP_COMPACT_EFFORT=medium            # unmeasured (Flash-Next's: xhigh thought 30K tokens with no answer, 09-30)
LDR_DEEP_REPORT_EFFORT=xhigh              # unmeasured (Flash-Next's package default)
LDR_DEEP_VERIFY_EFFORT=xhigh              # unmeasured (Flash-Next's: medium passed 10 claims xhigh flagged, 10-20)
LDR_DEEP_TRIED_MAP_EFFORT=low             # unmeasured (Flash-Next's)
LDR_DEEP_TRIED_MERGE_EFFORT=medium        # unmeasured (Flash-Next's)
LDR_DEEP_EFFORT_MAP=                      # unmeasured: empty = Strata takes our names as they are; set "ours=theirs,..."
                                          # only if day one finds Strata's Qwen4 names differ
LDR_DEEP_EFFORT_LADDER=lower              # unmeasured (Flash-Next's runaway xhigh thinking): count the smoke's calls that
                                          # end at max_tokens with no answer
# Jan's deep jobs (tools/research-runner.py) - not used on day one: Jan's runner stays on flash-next.env
LDR_JOB_AGENT_EFFORT=medium               # unmeasured (Flash-Next's)
LDR_JOB_EXTRACT_EFFORT=medium             # unmeasured (Flash-Next's)
LDR_JOB_REPORT_EFFORT=medium              # unmeasured (Flash-Next's)
LDR_JOB_VERIFY_EFFORT=xhigh               # unmeasured (Flash-Next's)

# ---- pace: workers, step limits, time (unmeasured; Flash-Next's speed and depth choices) ------------------------
LDR_WORKERS=1                             # unmeasured: Strata answers one request at a time on Flash-Next - check Qwen4
LDR_DEEP_MAX_ITERATIONS=200               # unmeasured (Flash-Next's): record the lead calls each day-one run uses
LDR_DEEP_MAX_SUB_ITERATIONS=30            # unmeasured (Flash-Next's)
LDR_DEEP_MAX_SUBTOPICS=8                  # unmeasured (Flash-Next's)
LDR_DEEP_MAX_SUBTOPICS_HARD=12            # unmeasured (Flash-Next's)
LDR_DEEP_SUBAGENT_BUDGET_S=3600           # unmeasured (Flash-Next's)
LDR_DEEP_SUBAGENT_HARD_S=7200             # unmeasured (Flash-Next's)
LDR_DEEP_SUBAGENT_SHARE=0.75              # unmeasured (Flash-Next's, serial waves with 1 worker)
LDR_DEEP_SUBAGENT_MIN_START_S=60          # unmeasured (Flash-Next's)
LDR_DEEP_TIME_BUDGET_S=10800              # unmeasured (Flash-Next's; bench2 sets it per run)
LDR_DEEP_VERIFY_MAX_CLAIMS=120            # unmeasured (Flash-Next's: ~12.4 s a claim at xhigh)
LDR_DEEP_READ_MAX=400                     # unmeasured (Flash-Next's, item 6)
LDR_DEEP_READ_PRIMARY_MAX=40              # unmeasured (Flash-Next's, item 6)
LDR_DEEP_READ_PRIMARY_PER_PAGE=2          # unmeasured (Flash-Next's, item 6)
LDR_QUICK_MAX_ITERATIONS=12               # unmeasured (Flash-Next's; quick jobs are Jan's, not day one)
LDR_QUICK_CAP_S=900                       # unmeasured (Flash-Next's)

# ---- code tool (unmeasured; derived from the context, Flash-Next's bases) ---------------------------------------
LDR_DEEP_CODE_READ_LINES=auto             # unmeasured: 120 at 131072
LDR_DEEP_CODE_GREP_HITS=auto              # unmeasured: 40 at 131072
LDR_DEEP_CODE_TREE_ENTRIES=auto           # unmeasured: 200 at 131072
LDR_DEEP_CODE_LINE_CHARS=240              # unmeasured (Flash-Next's)
LDR_DEEP_CODE_ISSUE_CHARS=auto            # unmeasured: 3000 at 131072
LDR_DEEP_CODE_COMMENT_CHARS=auto          # unmeasured: 1500 at 131072
LDR_DEEP_CODE_ISSUE_LIST_CHARS=auto       # unmeasured: 600 at 131072
LDR_DEEP_CODE_SHORT_READS=1               # unmeasured (Flash-Next's short-read wording; 0 only at a much larger context)

# ---- sampling (unmeasured on Qwen4; Karl's rule) ----------------------------------------------------------------
LDR_TEMPERATURE=1.0                       # unmeasured: Karl's rule T 1.0 / 0.95 / 20 / 0.05 on every arm. LDR sends
                                          # only T; the Qwen4 Strata config must carry 0.95 / 20 / 0.05 (check its
                                          # start lines). A different model-card default goes to Karl, not changed here
