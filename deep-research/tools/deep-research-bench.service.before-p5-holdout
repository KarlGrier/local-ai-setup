[Unit]
Description=Deep research measurements (C3c since 11-06: queue-plan-c3c.json - o01-o03 on model profile flash-next-c3c (pc3c), SearXNG only; ~/ai/deep-research/tools/bench2-queue.sh)
After=default.target deep-research-runner.service

[Service]
Type=simple
# waits for 09:00; new work only 09:00-22:00; stops between questions for a new Strata release or tmp/bench2.stop
ExecStart=/bin/bash /home/USER/ai/deep-research/tools/bench2-queue.sh
WorkingDirectory=/home/USER/ai/deep-research
Environment=BENCH2_PLAN=queue-plan-c3c.json
Restart=on-failure
RestartSec=60
KillMode=process

[Install]
WantedBy=default.target
