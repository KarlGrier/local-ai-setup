#!/usr/bin/env python3
"""gap8_verdicts.py - round 22 gap 8 (10-22): the two checks that decide the switch (the user, 10-21: "if both checks
pass in the next gap ... switch 8080 mid-Phase 4 to P021 plus the two lossless ports"), written down before the gap.

  kernel PFY_MD           the 40-prompt yardstick (work/r22/pf_yardstick.py compare output). A prompt-kernel variant
                          is rounding-level when, on the long prompts, its top-1 agreement with the build without it is
                          at least, and its KL mean and KL max at most, those of our own other exact prompt path (the
                          unfused kernels, PF_FUSED=0) against the same reference. Prints PASS/FAIL per variant and
                          "CHOSEN v2=<1|3|2|none>": the first that passes of v2 (all three kernels), v2d (down only),
                          v2g (gate/up only) - in that order of speed (gap 7: -4.9 / -2.5 / -2.0 % TTFT).
                          The user, 10-22 (before the gap): the v2 variants also need their worst single-position KL
                          (KL max: one logit row per prompt) no higher than the worse of the two rounding references'
                          worst - the unfused path and the served CPU share (cpushare: STRATA_PREFILL_CPU_SHARE=0.4).
                          IMMA: immai8 against refi8 beside unfusedi8 (both with the served int8 K/V), the same rule.
  cvsa DIR                C (spec 7 + STRATA_DRAFT_CUM) vs A (P021 today) from abrun's records (client decode tok/s):
                          PASS when C's W1-W3 mean is >= +3 % over A's AND C is ahead in at least 3 of the 4 passes
                          (the user, 10-22: W1 alone swings about +-10 %), AND neither the tool-call turns' nor the
                          research-shaped call's mean is more than 3 % slower. The pcie arms (PA = A without the forced
                          --pcie-frac 0, PC = C without it) are reported against A and C - no verdict: the user decides.
"""
import json
import pathlib
import re
import statistics
import sys


def kernel(md: str) -> int:
    rows = {}
    for line in open(md):
        m = re.match(r"^(\S+)\s+long \(2K-32K\)\s+(\d+)\s+([\d.]+)%\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)", line)
        if m:
            rows[m.group(1)] = {"n": int(m.group(2)), "top1": float(m.group(3)), "kl_mean": float(m.group(4)),
                                "kl_max": float(m.group(6))}
    def judge(name, refname, worst=None):
        r, u = rows.get(name), rows.get(refname)
        if not r or not u:
            print(f"{name}: no data ({'missing ' + name if not r else 'missing ' + refname})")
            return False
        ok = r["top1"] >= u["top1"] and r["kl_mean"] <= u["kl_mean"] and r["kl_max"] <= u["kl_max"]
        extra = ""
        if worst is not None:
            # the worse of the two rounding references' worst position; without the cpushare row, the unfused path alone
            w = rows.get(worst)
            bound = max(u["kl_max"], w["kl_max"]) if w else u["kl_max"]
            okw = r["kl_max"] <= bound
            extra = (f"; worst position {r['kl_max']:.6f} vs the worse reference's {bound:.6f} "
                     f"({'unfused ' + format(u['kl_max'], '.6f') + ', ' + worst + ' ' + format(w['kl_max'], '.6f') if w else 'no ' + worst + ' row: unfused only'})"
                     f" {'ok' if okw else 'TOO HIGH'}")
            ok = ok and okw
        print(f"{name}: top-1 {r['top1']:.1f} % (unfused {u['top1']:.1f}), KL mean {r['kl_mean']:.6f} ({u['kl_mean']:.6f}), "
              f"KL max {r['kl_max']:.6f} ({u['kl_max']:.6f}){extra} -> {'PASS' if ok else 'FAIL'}")
        return ok
    chosen = "none"
    for name, val in (("v2", "1"), ("v2d", "3"), ("v2g", "2")):
        if judge(name, "unfused", worst="cpushare") and chosen == "none":
            chosen = val
    print(f"CHOSEN v2={chosen}")
    print(f"IMMA {'PASS' if judge('immai8', 'unfusedi8') else 'FAIL'}")
    return 0


def cvsa(d: str) -> int:
    recs = []
    for f in pathlib.Path(d).glob("*.jsonl"):
        if f.name.endswith(".wu.jsonl"):
            continue
        recs += [json.loads(x) for x in open(f) if x.strip()]
    # arm names: <arm><pass><n|a|r>, e.g. A1n, PC3r
    def sel(arm, kind, ids=None):
        out = {}
        for r in recs:
            m = re.match(r"^([A-Z]+)(\d)([nar])$", r["arm"])
            if not m or m.group(1) != arm or m.group(3) != kind or not r.get("decode_tps"):
                continue
            if ids and r["id"] not in ids:
                continue
            out.setdefault(int(m.group(2)), []).append(r["decode_tps"])
        return out
    W = ("W1-think", "W2-code", "W3-research")
    def mean_all(by):
        v = [x for xs in by.values() for x in xs]
        return statistics.mean(v) if v else float("nan")
    tab = {}
    for arm in ("A", "C", "PA", "PC"):
        tab[arm] = {k: sel(arm, *k2) for k, k2 in (("normal", ("n", W)), ("agent", ("a",)), ("research", ("r",)))}
    def pct(x, y):
        return 100 * (x / y - 1) if y == y and y else float("nan")
    print("| arm | W1-W3 tok/s (per pass) | mean | tool-call turns | research call |")
    print("|---|---|---|---|---|")
    for arm in ("A", "C", "PA", "PC"):
        t = tab[arm]
        per = " / ".join(f"{statistics.mean(v):.1f}" for _, v in sorted(t["normal"].items()))
        print(f"| {arm} | {per} | {mean_all(t['normal']):.1f} | {mean_all(t['agent']):.1f} | {mean_all(t['research']):.1f} |")
    a, c = tab["A"], tab["C"]
    gain = pct(mean_all(c["normal"]), mean_all(a["normal"]))
    passes = [k for k in a["normal"] if k in c["normal"]]
    ahead = sum(statistics.mean(c["normal"][k]) > statistics.mean(a["normal"][k]) for k in passes)
    ag = pct(mean_all(c["agent"]), mean_all(a["agent"]))
    rs = pct(mean_all(c["research"]), mean_all(a["research"]))
    ok = gain >= 3 and len(passes) >= 4 and ahead >= 3 and ag >= -3 and rs >= -3
    print(f"C vs A: W1-W3 {gain:+.1f} % (ahead in {ahead} of {len(passes)} passes; needs 3 of 4), tool-call turns {ag:+.1f} %, "
          f"research call {rs:+.1f} % (each needs >= -3 %) -> {'PASS' if ok else 'FAIL'}")
    tc = [r.get("tool_call_chars", 0) for r in recs if r["arm"].endswith("a")]
    print(f"tool-call turns: {len(tc)} replies, tool-call characters min {min(tc) if tc else 0} / median "
          f"{statistics.median(tc) if tc else 0} (gap 7: 45-105 tokens - these must carry code)")
    for x, base in (("PA", "A"), ("PC", "C")):
        print(f"{x} vs {base} (no forced pcie-frac 0): W1-W3 {pct(mean_all(tab[x]['normal']), mean_all(tab[base]['normal'])):+.1f} %, "
              f"tool-call turns {pct(mean_all(tab[x]['agent']), mean_all(tab[base]['agent'])):+.1f} %, "
              f"research call {pct(mean_all(tab[x]['research']), mean_all(tab[base]['research'])):+.1f} %  "
              f"(runs per prompt: {min((sum(1 for r in recs if re.match('^' + x + r'[0-9]n$', r['arm']) and r['id'] == w) for w in W), default=0)})")
    print(f"CVSA {'PASS' if ok else 'FAIL'}")
    return 0


if __name__ == "__main__":
    sys.exit(kernel(sys.argv[2]) if sys.argv[1] == "kernel" else cvsa(sys.argv[2]))
