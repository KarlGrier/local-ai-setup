+# --- deep-research patch 0008 (2026-11-04): subagents ran out of LangGraph steps before their wrap-up -----------------
+def _deep_recursion_limit(max_calls: int) -> int:
+    """LangGraph steps for a deep-mode agent allowed max_calls model calls. With DeepAgentMiddleware each round is
+    three graph steps (its before_model hook is a node of its own, then the model, then the tools), so the old
+    "2 x calls + 10" (70 for 30 calls) stopped every subagent at its 23rd model call with GraphRecursionError - before
+    the middleware's step-limit wrap-up (at call 29) could make it write its findings; its findings were lost (148 of
+    217 subagents since 11-01, all at 23 calls: staging/ldr-study/PAPERS.md). 3 x calls + 10 leaves the wrap-up room
+    (the tool-less final call ends the graph at about 3 x calls - 1 steps). LDR_DEEP_FIX item "steps"; without it
+    the old limit stays."""
+    from ...deep.checks import fix_on
+
+    return int(max_calls) * (3 if fix_on("steps") else 2) + 10
+
+
+def _deep_salvage(store, label: str, topic: str, max_chars: int = 12_000) -> str:
+    """The backstop when a deep subagent still hits the step limit: instead of only "reached iteration limit", give
+    the lead the page extractions this subagent gathered (verbatim quotes with their [N], from the evidence store)."""
+    head = f"Research on '{topic}' reached iteration limit."
+    from ...deep.checks import fix_on
+
+    if store is None or not fix_on("steps"):
+        return head
+    rows = []
+    try:
+        for s in store.fetched_sources():
+            for f in s.fetches:
+                if f.agent == label and f.extraction and not f.extraction.startswith("NOT RELEVANT"):
+                    rows.append(f"[{s.idx}] {(s.title or '')[:120]} - {s.url}\n{f.extraction.strip()[:1500]}")
+    except Exception:  # noqa: BLE001
+        return head
+    if not rows:
+        return head
+    body, used = [], 0
+    for r in rows:
+        if used + len(r) > max_chars:
+            body.append(f"[... {len(rows) - len(body)} more extractions are in the evidence store]")
+            break
+        body.append(r)
+        used += len(r) + 2
+    return (head + " It did not write its findings; these are the page extractions it gathered (verbatim quotes from "
+            "the pages; cite them by their [N]):\n\n" + "\n\n".join(body))
+
+
