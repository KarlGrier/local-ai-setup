def strata_idle_for_us() -> tuple[bool, str]:
    """Strata may be restarted: no other client used it within the yield window (the gate's view)."""
    c = rc.read_clock()
    last = float(c.get("last_foreign") or 0)
    window = max(5.0, float(rc.settings()["yield_minutes"])) * 60
    if last and time.time() - last < window:
        return False, f"another client used Strata {(time.time() - last) / 60:.0f} min ago"
    return True, ""


def restart_strata(reason: str) -> bool:
    """Free Strata's chat cache: hold research at the gate, wait for the call in progress, stop Strata, start it again
    (strata-ensure.sh), release. Same config (C*18t); takes ~15 s plus the wait."""
    ctl = json.loads(rc.CONTROL_FILE.read_text()) if rc.CONTROL_FILE.exists() else {}
    ctl.update(pause=True, reason=reason)
    rc.CONTROL_FILE.write_text(json.dumps(ctl))
    try:
        r = requests.get("http://127.0.0.1:8090/_research/wait-idle?timeout=900", timeout=960,
                         proxies={"http": None, "https": None})
        if not r.json().get("idle"):
            log(f"restart_strata: a research call is still running after 15 min; not restarting")
            return False
    except (requests.RequestException, ValueError):
        pass                                       # no proxy: nothing of ours can be running
    stop = subprocess.run([str(rc.SC / "run-strata.sh"), "stop"], cwd=rc.SC, env={**clean_env(), "STRATA_PORT": "8080"},
                          capture_output=True, text=True, timeout=180)
    for _ in range(60):                            # the old server must be gone, or strata-ensure.sh says "busy"
        if subprocess.run(["pgrep", "-f", r"(^|/)llama-server( |$)|strata --serve"], capture_output=True).returncode:
            break
        time.sleep(1)
    start = subprocess.run([str(ENSURE), "Deep research"], env=clean_env(), capture_output=True, text=True, timeout=600)
    log(f"restart_strata ({reason}): stop rc {stop.returncode}, start rc {start.returncode}, "
        f"MemAvailable now {avail_gb():.1f} GB")
    return start.returncode == 0


