# arms/ours.env - C4 arm (a): our LDR build (six fixes, code tool on) on Claude Sonnet 5.5 through the budget guard.
# EVERY VALUE IS A DRAFT, UNMEASURED (c4-arm.sh refuses GUARD_STATUS=draft unless C4_ALLOW_DRAFT=1).
# Read by c4-arm.sh with `set -a; source`; a variable the caller already set wins (the ${X:-default} form), e.g. the
# pilot: C4_RUN_SUFFIX=pilot GUARD_RUN_CAP_USD=3 ./c4-arm.sh start ours

GUARD_STATUS=${GUARD_STATUS:-draft}
GUARD_ARM=ours
GUARD_PORT=${GUARD_PORT:-8191}                         # draft: free on 10-29 (live: 3000 5000 8080 8090 8888-8890)
C4_LDR_PORT=${C4_LDR_PORT:-5011}                       # draft: this arm's LDR web UI
GUARD_RUN_ID=${GUARD_RUN_ID:-o03-ours}                 # c4-arm.sh appends -$C4_RUN_SUFFIX (pilot, ...)
GUARD_MODEL=claude-sonnet-5-5

# ---- money (the plan, 10-27: $3 pilot of each arm, then ours ~$40, stock ~$12, $60 in total incl. pilots) ------------
GUARD_RUN_CAP_USD=${GUARD_RUN_CAP_USD:-40}             # draft: the plan's figure
GUARD_TOTAL_CAP_USD=${GUARD_TOTAL_CAP_USD:-60}         # Karl 10-27: both arms + pilots; the same value in both arm files
GUARD_REPORT_RESERVE=${GUARD_REPORT_RESERVE:-0.22}     # Karl 10-29: ~20-25 % of the run cap kept for the report stage.
                                                       # Research (lead, subagents, extraction, compaction, anything
                                                       # not identified) is refused at (1 - 0.22) x $40 = $31.20; the
                                                       # report / verification steps may use all $40 (README)
GUARD_AGENT_CAP_USD=${GUARD_AGENT_CAP_USD:-}           # OFF: the report reserve above does its job (requests with
                                                       # tools only; kept as an extra option)
GUARD_INPUT_TOKENS_PER_BYTE=${GUARD_INPUT_TOKENS_PER_BYTE:-1.0}   # worst case: 1 token per byte (an upper bound)
GUARD_WAIT_INFLIGHT_S=${GUARD_WAIT_INFLIGHT_S:-900}
GUARD_KEY_FILE=${GUARD_KEY_FILE:-$HOME/.config/model-suite/anthropic.key}

# ---- requests (draft, unmeasured) -----------------------------------------------------------------------------------------
GUARD_DEFAULT_EFFORT=${GUARD_DEFAULT_EFFORT:-high}     # Karl 10-29: high, matched with the stock arm (calls that send
                                                       # no effort and have no class effort)
GUARD_CLASS_EFFORTS=${GUARD_CLASS_EFFORTS:-agent=high,extract=low}   # Karl 10-29: the agent loop (lead + subagents)
                                                       # at high like stock (the c3 profile's LDR_JOB_AGENT_EFFORT=medium
                                                       # is not used by C4); extract=low = our profile's
                                                       # LDR_DEEP_EXTRACT_EFFORT (our build's own step setting)
GUARD_EFFORT_MAP=${GUARD_EFFORT_MAP:-}                 # our names are Sonnet 5.5 levels as they are
GUARD_DEFAULT_MAX_TOKENS=${GUARD_DEFAULT_MAX_TOKENS:-32000}
GUARD_MAX_TOKENS_CAP=${GUARD_MAX_TOKENS_CAP:-64000}    # = the profile's LDR_LLM_MAX_TOKENS / report output
GUARD_CACHE_TTL=${GUARD_CACHE_TTL:-5m}                 # Karl 10-29: 5 minutes; caching only on reused prefixes (README)
GUARD_LEAD_CACHE_1H=${GUARD_LEAD_CACHE_1H:-0}          # Karl 10-29: OFF. 1 = the lead agent's prefix lives 1 h - only
                                                       # if the pilot's tools/lead_gaps.py shows gaps > 5 min
GUARD_THINKING_REPLAY=${GUARD_THINKING_REPLAY:-store}

# ---- LDR (staged run-ldr.sh, LDR_BACKEND=guard) ----------------------------------------------------------------------------
LDR_PROFILE=deep
LDR_MODEL_PROFILE=${LDR_MODEL_PROFILE:-sonnet-5-5}     # staging/c3/profiles/sonnet-5-5.env (a draft itself)
LDR_DEEP_FIX=${LDR_DEEP_FIX:-all}                      # draft: "our build with the six fixes" (plan); items 5/6 = add
                                                       # ,read,claims if they are in the build by then
LDR_DEEP_CODE=${LDR_DEEP_CODE:-1}                      # the plan: code tool on (o03 has no code side)
LDR_SEARCH_FALLBACK=0                                  # SearXNG only, no paid search (plan)
LDR_RESEARCH_S2=0
