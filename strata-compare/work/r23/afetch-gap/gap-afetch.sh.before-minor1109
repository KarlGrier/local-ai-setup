  $LIB/with_server.sh $lab $cfg -- "$PY $FR br envcheck $exe $cfg --gate env_sq$arm --gates $G && $PY $Q/sq.py envcheck $SQO $arm && SQ_SPEC=$SQO/spec.json SQ_ARM=$arm SQ_LABEL=$lab SQ_ELOG_BASE=$off${bud:+ SQ_BUDGET_S=$bud} $PY $Q/sq_client.py http://127.0.0.1:8081 $SQO/$arm; echo \"sampled $arm chain rc \$?\"" 8>&- 9>&- < /dev/null > $SQO/$arm.with_server.txt 2>&1
  grep -E "engine pid [0-9]+:|ENV CHECK|ready|exited|refus|Error|GUARD|Traceback|chain rc|WARNING|budget" $SQO/$arm.with_server.txt | cut -c1-300 | tee -a $S
  wstop sq$arm
