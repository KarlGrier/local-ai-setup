WS = Path("/home/USER/ai-speed-testing/strata-compare")
KIT = WS / "work/qwen4-kit"
PY = WS / ".venv/bin/python"
VERSION = "dayone.py 2026-11-05"
GIB, MIB = 2 ** 30, 2 ** 20
SERVED = WS / "models/ISTA-GSQ-RCO/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf"
SERVED_PROFILE = WS / "strata-cstar18/data/expert-profile.bin"
X28H = WS / "configs/x28h.json"
UD31_DECISION = WS / "results/r23/ud31/decision.json"
UD31_DEC = WS / "results/r23/ud31/dec"            # gap-ud31-dec.sh's decision.json + .txt (the decode-path follow-up)
SCRATCH = {"dir": KIT / "scratch-d"}              # dryrun / selftest / --fetch-test scratch (--scratch DIR moves it)
R23 = WS / "strata-r23p0211"                      # the v0.2.11 port tree: its v3.1 header fixture (selftest-e)
UA = {"User-Agent": "strata-compare-dayone/1.0"}
# F1-frame-pools.md (logged, the served pack r20a + the STRP profile): the slot model's calibration points
F1 = {"uniform_auto": 3526, "sized_auto": 4583, "pin": 2500, "sized_pin": 3238, "helper": 3300, "helper_gib": 6.206154823}
# the series' minutes on Flash-Next (gap-ud31.sh and earlier gaps: exact7 4, score.py arm 7, the spilling R 12, a screen
# pass 5, pf_yardstick long40 ~8, the compare 10); a new model's are scaled by its active-parameter ratio
MIN = {"e7": 4, "smoke": 2, "q": 7, "qr": 12, "pfy": 9, "pfyr": 14, "scr": 5, "cmp": 10}
HC_RE = re.compile(r"^(blk\.\d+\.hc_(attn|ffn)_(down|up)|output_hc_(down|up))\.weight$")


def load(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


D1 = load("day1", KIT / "day1.py")


def now():
    return datetime.datetime.now().strftime("%Y-%m-%d %H:%M")


def log(msg):
    print(f"{time.strftime('%H:%M:%S')} {msg}", flush=True)


def sha256_file(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()


# =====================================================================================================================
# 1. the listing (pinned commit) and the quants
# =====================================================================================================================
def hf_json(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=60) as r:
        return json.load(r), r.headers


def resolve_commit(repo, rev):
    if re.fullmatch(r"[0-9a-f]{40}", rev):
        return rev
    j, _ = hf_json(f"https://huggingface.co/api/models/{repo}/revision/{rev}")
    return j["sha"]


def api_tree(repo, commit):
    """every entry at the commit (recursive, paged by the Link header), raw: gentle_dl.py's TREE.json format"""
    out, url = [], f"https://huggingface.co/api/models/{repo}/tree/{commit}?recursive=1&expand=0"
    while url:
        j, h = hf_json(url)
        out += j
        url = next((p.split(";")[0].strip(" <>") for p in h.get("Link", "").split(",") if 'rel="next"' in p), None)
    return out


def list_repo(repo, rev, listing=None, offline=False):
    """the repo's files at a pinned commit; {"available": False, ...} for a repo that is not published yet (Karl 11-05
    item 1: "take whichever is available first") - HF answers 401 (no token) or 404 for a repo that does not exist,
    403 when it refuses: recorded as not available, never worked around. --listing REPO=ABSENT simulates one offline."""
    if listing == "ABSENT":
        return {"repo": repo, "commit": None, "entries": [], "available": False, "http": None,
                "source": f"not published (simulated offline: --listing {repo}=ABSENT, {now()})"}
    if listing:
        if not re.fullmatch(r"[0-9a-f]{40}", rev or ""):
            raise SystemExit(f"--listing for {repo} needs --repo {repo}@<the listing's 40-hex commit>")
        return {"repo": repo, "commit": rev, "entries": json.loads(Path(listing).read_text()), "source": str(listing),
                "available": True}
    if offline:
        raise SystemExit(f"{repo}: --offline and no --listing for it")
    try:
        commit = resolve_commit(repo, rev or "main")
    except urllib.error.HTTPError as e:
        if e.code in (401, 403, 404):
            return {"repo": repo, "commit": None, "entries": [], "available": False, "http": e.code,
                    "source": f"HF API {now()}: HTTP {e.code} ({'refused: not worked around' if e.code == 403 else 'not published yet, or not public'})"}
        raise
    return {"repo": repo, "commit": commit, "entries": api_tree(repo, commit), "available": True,
            "source": f"HF API {now()} (revision {rev or 'main'} -> {commit})"}


QUANT_RE = re.compile(r"(?<![A-Za-z0-9])((?:UD-)?(?:IQ\d_[A-Z0-9]+|TQ\d_\d|Q\d_K(?:_[A-Z0-9]+)?|Q\d_\d|Q\d_[A-Z]+|BF16|F16|F32|"
                      r"MXFP4[A-Z0-9_]*|NVFP4[A-Z0-9_]*))(?![A-Za-z0-9])", re.I)


def classify(path):
    base = Path(path).name
    low = path.lower()
    if base.endswith(".gguf_file"):   # Unsloth publishes its engram tables and imatrix as .gguf_file (data, never run)
        base = base[:-5]
    if not base.endswith(".gguf"):
        return "other", None, None
    if base.startswith("mtp-") or "/mtp/" in f"/{low}":
        kind = "mtp"
    elif "engram" in low:
        kind = "engram"
    elif base.startswith("mmproj"):
        kind = "mmproj"
    elif "imatrix" in low:
        kind = "imatrix"
    else:
        kind = "model"
    m = D1.SHARD_RE.match(base)
    stem = m.group(1) if m else base[:-5]
    q = QUANT_RE.findall(stem)
    return kind, (q[-1].upper().replace("UD-", "UD-") if q else stem), stem


def publisher_of(text):
    t = text.lower()
    return "unsloth" if "unsloth" in t else "ista" if ("ista" in t or "ist-daslab" in t or "gsq-rco" in t) else "other"


def quants_of(lst, dest_root):
    out, side = OrderedDict(), []
    for e in lst["entries"]:
        if e.get("type") != "file" or not e.get("lfs"):
            continue
        kind, label, stem = classify(e["path"])
        if kind == "other":
            continue
        if kind != "model":
            side.append({"kind": kind, "path": e["path"], "size": int(e["size"]), "oid": e["lfs"]["oid"]})
            continue
        key = (str(Path(e["path"]).parent), stem)
        q = out.setdefault(key, {"label": label, "stem": stem, "repo": lst["repo"], "commit": lst["commit"],
                                 "publisher": publisher_of(lst["repo"]), "source": "listed", "files": [], "bytes": 0})
        q["files"].append({"path": e["path"], "size": int(e["size"]), "oid": e["lfs"]["oid"]})
        q["bytes"] += int(e["size"])
    for q in out.values():
        q["files"].sort(key=lambda f: f["path"])
        q["dest"] = str(Path(dest_root) / q["label"])
        q["shard1"] = q["files"][0]["path"]
    return list(out.values()), side


def real_size(s):
    """a shard's real size: NAME.size beside a head-only file (fetch_model's head format), else the file's own"""
    side = Path(str(s) + ".size")
    return int(side.read_text().split()[0]) if side.exists() else (s.stat().st_size if s.exists() else None)


def local_candidate(shard1):
    p = Path(shard1).absolute()   # not resolve(): the shard names must stay (an HF-cache file links to a hash-named blob)
    shards = D1.shards_of(p)
    _, label, stem = classify(p.name)
    return {"label": label, "stem": stem, "repo": None, "commit": None, "publisher": publisher_of(str(p)), "source": "local",
            "files": [{"path": str(s), "size": real_size(s), "oid": None} for s in shards],
            "bytes": sum(real_size(s) for s in shards if s.exists()), "dest": str(p.parent), "shard1": str(p)}


# =====================================================================================================================
# 2. headers
# =====================================================================================================================
def sums_of(d):
    p, out = Path(d) / "SHA256SUMS", {}
    for ln in p.read_text().splitlines() if p.exists() else []:
        if ln.strip():
            h, _, n = ln.strip().partition("  ")
            out[n] = h
    return out


def header_state(q, headers_root):
    """('disk', shard-1 path, verified?) when every shard is in its destination at the pinned size; ('headers', path)
    when every shard's header is under --headers (DIR/<repo path>, NAME.size = the pinned size); else ('none', None)"""
    if q["source"] == "local":
        ok = all(f["size"] for f in q["files"])
        return {"state": "disk" if ok else "none", "path": q["shard1"] if ok else None, "verified": None,
                "why": "a local file (not pinned: no listing)"}
    d = Path(q["dest"])
    on = [d / Path(f["path"]).name for f in q["files"]]
    if all(p.exists() and p.stat().st_size == f["size"] for p, f in zip(on, q["files"])):
        s = sums_of(d)
        ver = all(s.get(p.name) == f["oid"] for p, f in zip(on, q["files"]))
        return {"state": "disk", "path": str(on[0]), "verified": ver,
                "why": "every shard in its destination at the pinned size" + ("; SHA256SUMS = the pins" if ver else
                                                                               "; NO SHA256SUMS match: re-hash")}
    if headers_root:
        hs = [Path(headers_root) / f["path"] for f in q["files"]]

        def ok(p, f):
            sz = Path(str(p) + ".size")
            return p.exists() and (int(sz.read_text().split()[0]) if sz.exists() else p.stat().st_size) == f["size"]
        if all(ok(p, f) for p, f in zip(hs, q["files"])):
            return {"state": "headers", "path": str(hs[0]), "verified": None, "why": f"headers under {headers_root}"}
    return {"state": "none", "path": None, "verified": None, "why": "no header here"}


def fetch_headers(q, headers_root, base=None):
    """bringup/fetch_model.py fetch_head for every shard (base = a local folder holding the files: offline test)"""
    FM = load("fetch_model", WS / "bringup/fetch_model.py")
    pins = {"repo": q["repo"], "revision": q["commit"], "files": {f["path"]: (f["size"], f["oid"]) for f in q["files"]}}
    for f in q["files"]:
        dest = Path(headers_root) / Path(f["path"]).parent
        dest.mkdir(parents=True, exist_ok=True)
        if base:   # fetch_model reads ranges from <base>/<name> (the name is the repo path): a symlink farm in scratch-d
            b = SCRATCH["dir"] / "fetch-base"
            (b / Path(f["path"]).parent).mkdir(parents=True, exist_ok=True)
            link = b / f["path"]
            if not link.is_symlink():
                os.symlink(Path(base) / Path(f["path"]).name, link)
            FM.fetch_head(pins, f["path"], dest, str(b))
        else:
            FM.fetch_head(pins, f["path"], dest, None)
            time.sleep(0.5)


def header_model(path, tree):
    D1.type_table(Path(tree))
    return D1.Model(path)


def blobs_of(m):
    """{layer: blob bytes} as day1.sizes / Strata's pack (gate + up + down per expert, + 16 B NVFP4 scales, 256-aligned)"""
    trunk = D1.trunk_of(m)
    n_exp = D1.ai(m, "expert_count")
    out = OrderedDict()
    for l in range(trunk):
        ts = [m.tensors.get(f"blk.{l}.ffn_{p}_exps.weight") for p in ("gate", "up", "down")]
        if not all(ts) or not n_exp or any(t.nbytes is None for t in ts):
            continue
        b = sum(t.nbytes // n_exp for t in ts) + (16 if any(t.type == 40 for t in ts) else 0)
        out[l] = (b + 255) // 256 * 256
    return out, n_exp


def hc_types(m):
    return sorted({t.tname for t in m.tensors.values() if HC_RE.match(t.name)})


# =====================================================================================================================
# 3. the slot model (results/catchup/F1-frame-pools.md; generate.cpp's sized fill)
# =====================================================================================================================
def read_profile(path, nl, ne):
    if not path or not Path(path).exists():
        return None, "no expert profile"
    raw = Path(path).read_bytes()
    if raw[:4] != b"STRP":
        return None, f"{path}: not a STRP profile"
    _ver, pl, pe, _want, n = struct.unpack_from("<5I", raw, 4)
    if (pl, pe) != (nl, ne):
        return None, f"{Path(path).name} is {pl} x {pe}, the model {nl} x {ne}: not used (uniform slots)"
    return [struct.unpack_from("<2H", raw, 24 + 4 * i) for i in range(n)], f"{Path(path).name}: {n} ranked pairs"


def slot_model(blobs, n_exp, pairs, main_bytes, helper_budget, margin_bytes, pin):
    """5080: --expert-cache N is a budget of N largest blobs, capped by the free room; with a profile the pairs fill it
    in rank order at their own sizes (the sized fill), without one it holds N uniform slots. The 4060 Ti: a count,
    filled with the next ranks (without a profile: the rest in layer-interleaved order)."""
    mx = max(blobs.values())
    order = pairs if pairs else [(l, e) for e in range(n_exp) for l in blobs]

    def fill(budget):
        if not pairs:
            n = int(min(budget, main_bytes) // mx)
            return n, n * mx, order[:n]
        used, n = 0, 0
        cap = min(budget, main_bytes)
        for l, e in order:
            b = blobs.get(l)
            if b is None or used + b > cap:
                break
            used += b
            n += 1
        return n, used, order[:n]
    u_auto = int(main_bytes // mx)
    u_cfg = int(max(0, main_bytes - margin_bytes) // mx)
    out = {"max_blob": mx, "mean_blob": sum(blobs.values()) / len(blobs), "profile": bool(pairs),
           "main_room_gib": main_bytes / GIB, "margin_mib": margin_bytes / MIB, "uniform_auto": u_auto, "uniform_cfg": u_cfg}
    out["sized_auto"], b_auto, _ = fill(u_auto * mx)
    out["sized_cfg"], b_cfg, taken = fill(u_cfg * mx)
    out["main_gib"] = b_cfg / GIB
    if pin:
        out["pin"], (out["sized_pin"], _, _) = pin, fill(pin * mx)
    rest = order[len(taken):]
    used = n = 0
    for l, e in rest:
        b = blobs.get(l, mx)
        if used + b > helper_budget:
            break
        used += b
        n += 1
    out["helper"], out["helper_gib"], out["helper_budget_gib"] = n, used / GIB, helper_budget / GIB
    return out


def helper_bytes_of(blobs, pairs, n_exp, main_bytes, count):
    """bytes of `count` helper experts after the main card's fill (the served config's 3,300 -> today's bytes)"""
    s = slot_model(blobs, n_exp, pairs, main_bytes, 1 << 62, 0, None)
    mx = s["max_blob"]
    order = pairs if pairs else [(l, e) for e in range(n_exp) for l in blobs]
    rest = order[s["sized_auto"]:]
    return sum(blobs.get(l, mx) for l, _ in rest[:count])


def served_calibration(tree, room_main_gib=None):
    """the slot model on the served file (header + profile) against F1's logged numbers"""
    m = header_model(SERVED, tree)
    blobs, ne = blobs_of(m)
    pairs, note = read_profile(SERVED_PROFILE, len(blobs), ne)
    logged_main = F1["uniform_auto"] * max(blobs.values())       # what auto granted (logged 3,526 uniform)
    model_main = (room_main_gib or 0) * GIB
    rows = {}
    for what, mb in (("logged budget (3,526 x largest)", logged_main + max(blobs.values()) - 1),
                     ("day1's room (fit model)", model_main)):
        if mb <= 0:
            continue
        s = slot_model(blobs, ne, pairs, mb, F1["helper_gib"] * GIB, 0, F1["pin"])
        rows[what] = s
    hb = helper_bytes_of(blobs, pairs, ne, logged_main + max(blobs.values()) - 1, F1["helper"])
    return {"blobs": blobs, "n_exp": ne, "pairs": pairs, "note": note, "rows": rows, "helper_today_bytes": hb}


# =====================================================================================================================
# 4. day1, the estimates, the pick
# =====================================================================================================================
def run_day1(paths, out, name, files_at, a, extra=()):
    cmd = ["nice", "-n", "19", "taskset", "-c", "31", "timeout", "300", str(PY), "-I", "-B", str(KIT / "day1.py"), "check",
           *map(str, paths), "--name", name, "--out", str(out), "--tree", a.tree, "--tie-tol-gib", str(a.tie_tol_gib)]
    for g, d in files_at:
        cmd += ["--files-at", f"{g}={d}"]
    if a.no_swap:
        cmd.append("--no-swap")
    for k in ("exe", "server", "mtp"):
        if getattr(a, k, None):
            cmd += [f"--{k}", getattr(a, k)]
    cmd += list(extra)
    Path(out).mkdir(parents=True, exist_ok=True)
    r = subprocess.run(cmd, capture_output=True, text=True)
    (Path(out).parent / f"{Path(out).name}.stdout.txt").write_text("$ " + " ".join(shlex.quote(c) for c in cmd) + "\n"
                                                                   + r.stdout + r.stderr)
    if r.returncode != 0 or not (Path(out) / "report.json").exists():
        raise SystemExit(f"day1.py check failed (rc {r.returncode}): {r.stderr[-800:]}")
    return json.loads((Path(out) / "report.json").read_text())


FOLLOW_MARK = "=> U DECODE-PATH FOLLOW-UP: "      # ud31_rules.py's line in decision.txt


def v31_default(ud31=None, dec=None):
    """Karl 11-05 item 1: "The v3.1 result decides which one becomes the default once both exist." The v3.1 gaps' own
    files, read by their own rules (work/r23/ud31_rules.py decide + dec-decide, written before either gap ran):
      decision.json quality.status JUDGED, quality.kl_U:
        "BETTER THAN P"           -> unsloth (the only class that escapes the frozen pack-rounding rule)
        "INCLUDES PACK ROUNDING"  (U worse than P, or inside the margin: a record, NOT a verdict on the file) -> the
                                  decode-path follow-up decides: dec/decision.json "verdict" (or decision.txt's "=> U vs
                                  P, text NLL on the decode path: V" line): BETTER THAN P -> unsloth, WORSE THAN P ->
                                  ista, INCONCLUSIVE -> NO DIFFERENCE (Karl decides; "if the file choice hinges on it,
                                  Karl decides on a separate R decode-path gap"), NOT JUDGED / missing -> PENDING
        "NOT DECIDED", status NOT JUDGED, no file -> PENDING
      decision.json's follow-up flag must agree with decision.txt's FOLLOW-UP line (as ud31_rules.py dec-pre checks);
      a disagreement -> PENDING (Karl looks). U's exactness and speed lines are FLAGS beside the result, not a rule.
    Returns {"state": UNSLOTH | ISTA | NO DIFFERENCE | PENDING, "publisher": unsloth / ista / None, "why", "flags"}."""
    ud31 = Path(ud31) if ud31 else UD31_DECISION.parent
    dec = Path(dec) if dec else ud31 / "dec"
    dj, dt = ud31 / "decision.json", ud31 / "decision.txt"
    out = {"state": "PENDING", "publisher": None, "flags": [], "files": [str(dj), str(dt), str(dec / "decision.json")]}
    if not dj.exists():
        out["why"] = f"{dj} not written yet (work/r23/gap-ud31.sh has not run)"
        return out
    try:
        d = json.loads(dj.read_text())
        q = d.get("quality", {})
    except (ValueError, OSError) as e:
        out["why"] = f"{dj} unreadable ({e})"
        return out
    ex, sp = (d.get("exactness") or {}).get("U"), (d.get("speed") or {}).get("U")
    if ex and not str(ex).startswith("REPEATABLE"):
        out["flags"].append(f"v3.1 exactness U: {ex}")
    if sp and not str(sp).startswith("NO LOSS"):
        out["flags"].append(f"v3.1 speed U vs P: {sp}")
    fu = (q.get("pack_rounding") or {}).get("dec_followup")
    txt = dt.read_text(errors="replace") if dt.exists() else ""
    m = re.search(re.escape(FOLLOW_MARK) + r"(WANTED|NOT NEEDED|NOT DECIDED)", txt)
    if not dt.exists() or not m or (fu and m.group(1) != fu):
        out["why"] = (f"{dt} {'missing' if not dt.exists() else 'has no FOLLOW-UP line' if not m else 'says ' + m.group(1)}"
                      f" while decision.json says {fu}: the two disagree - PENDING (Karl looks)")
        return out
    kl, cls = q.get("kl_U"), q.get("kl_U_class")
    if q.get("status") != "JUDGED" or kl in (None, "NOT DECIDED"):
        out["why"] = f"the v3.1 gap's quality is {q.get('status', '?')} / kl_U {kl} ({dj})"
        return out
    if kl == "BETTER THAN P":
        out.update(state="UNSLOTH", publisher="unsloth", why=f"the v3.1 gap: U's KL rules vs P (text level, against R) "
                   f"BETTER THAN P - no follow-up needed ({dj})")
        return out
    if kl != "INCLUDES PACK ROUNDING":
        out["why"] = f"kl_U {kl!r} is not a value ud31_rules.py writes - PENDING (Karl looks)"
        return out
    v, src = None, None
    if (dec / "decision.json").exists():
        try:
            v, src = json.loads((dec / "decision.json").read_text()).get("verdict"), dec / "decision.json"
        except (ValueError, OSError):
            v = None
    if v is None and (dec / "decision.txt").exists():
        mm = re.search(r"^=> (?:U vs P, text NLL on the decode path: )?(BETTER THAN P|WORSE THAN P|INCONCLUSIVE|NOT JUDGED)",
                       (dec / "decision.txt").read_text(errors="replace"), re.M)
        v, src = (mm.group(1) if mm else None), dec / "decision.txt"
    head = f"the v3.1 gap: U {cls} on the prompt path, RECORDED AS INCLUDES PACK ROUNDING (the frozen rule) -> the decode-path follow-up"
    if v in (None, "NOT JUDGED"):
        out["why"] = f"{head} has {'not run' if v is None else 'NOT JUDGED'} ({dec})"
    elif v.startswith("BETTER"):
        out.update(state="UNSLOTH", publisher="unsloth", why=f"{head}: U BETTER THAN P on decode-path text NLL ({src})")
    elif v.startswith("WORSE"):
        out.update(state="ISTA", publisher="ista", why=f"{head}: U WORSE THAN P on decode-path text NLL ({src})")
    elif v == "INCONCLUSIVE":
        out.update(state="NO DIFFERENCE", why=f"{head}: INCONCLUSIVE ({src}) - no quality difference found; Karl decides "
                   "(his rule: if the file choice hinges on it, a separate R decode-path gap)")
    else:
        out["why"] = f"{head}: verdict {v!r} not one dec-decide writes - PENDING"
    return out


def prefer_default():
    """--prefer auto: the v3.1 result (U = Unsloth's UD-IQ3_XXS, P = our ISTA IQ3_S), read by v31_default (11-05e: the
    frozen pack-rounding rule and the decode-path follow-up included; the 11-05 first version read kl_U_class first,
    which would have turned a RECORDED-AS-PACK-ROUNDING loss into "ista")"""
    v = v31_default()
    flags = f" [FLAGS: {'; '.join(v['flags'])}]" if v["flags"] else ""
    if v["publisher"]:
        return v["publisher"], v["why"] + flags
    if v["state"] == "NO DIFFERENCE":
        return "any", v["why"] + " - quality decides between tied files" + flags
    if not UD31_DECISION.exists():
        return "any", ("no v3.1 quality result yet (work/r23/gap-ud31.sh not run): the documented default is the v3.1 header "
                       "result - UD-IQ3_XXS ties our ISTA IQ3_S on expert bytes (46.84 GiB each) - so quality decides")
    return "any", f"the v3.1 result is PENDING ({v['why']}) - quality decides" + flags


def estimates(cands, rep_by_path):
    """expert bytes for the quants without a header: file bytes - the non-expert bytes of the same repo's nearest read
    quant (the n-gram shard and the dense part are shared or similar); a pre-screen for which headers to read"""
    for c in cands:
        if c.get("rep"):
            continue
        refs = [x for x in cands if x.get("rep") and x["repo"] == c["repo"] and x["rep"].get("fit")]
        if not refs:
            c["est"] = None
            continue
        r = min(refs, key=lambda x: abs(x["bytes"] - c["bytes"]))
        nonexp = r["rep"]["file_bytes"] - r["rep"]["fit"]["experts_gib"] * GIB
        e = (c["bytes"] - nonexp) / GIB
        room = r["rep"]["fit"]["room_total_gib"]
        c["est"] = {"experts_gib": e, "room_gib": room, "fits": e <= room, "margin_gib": room - e, "from": r["label"]}


def fetch_set(cands, best_exact, room):
    """estimated quants that could change the pick or tie with it: est experts in [best exact - 1 GiB, room x 1.08]"""
    lo = (best_exact or 0) - 1.0
    return [c for c in cands if c.get("est") and lo <= c["est"]["experts_gib"] <= room * 1.08]


def apply_prefer(pick, cand_of, prefer, served_path):
    files = pick.get("tie") or ([pick["pick"]] if pick.get("pick") else [])
    pubs = {f: cand_of[f]["publisher"] if f in cand_of else publisher_of(f) for f in files}
    if len(files) <= 1:
        return files, "no tie"
    if prefer in ("ista", "unsloth"):
        keep = [f for f in files if pubs[f] == prefer]
        if keep:
            note = f"tie broken by --prefer {prefer}: {', '.join(Path(f).name for f in keep)} (dropped: " \
                   f"{', '.join(Path(f).name for f in files if f not in keep)})"
            return keep, note
        return files, f"--prefer {prefer}: no tied file from that publisher - quality decides"
    return files, "--prefer any: QUALITY DECIDES (the KL driver runs every tied file against the reference)"


# =====================================================================================================================
# 5. configs
# =====================================================================================================================
def argval(args, flag):
    v = [args[i + 1] for i, x in enumerate(args[:-1]) if x == flag]
    return v[-1] if v else None


def set_arg(args, flag, val, after=None):
    if flag in args[:-1]:
        args[args.index(flag) + 1] = str(val)
    elif after and after in args[:-1]:
        i = args.index(after) + 2
        args[i:i] = [flag, str(val)]
    else:
        args += [flag, str(val)]


def drop_arg(args, flag, value=True):
    while flag in args:
        i = args.index(flag)
        del args[i:i + (2 if value else 1)]


def finalize_config(cfg, slots, hcq8, name, swap, helper_rule, ngram=None, hc_off=False):
    """hc_off (11-06, Karl): the v3.1 exactness veto's second outcome - Unsloth runs with STRATA_HC_Q8=0"""
    cfg = json.loads(json.dumps(cfg), object_pairs_hook=OrderedDict)
    args = cfg["args"]
    if ngram and ngram.get("placement") == "ram":   # 11-05e item 3: the table in RAM, out of the expert RAM tier
        set_arg(args, "--ple-io", "ram")
    old = {"--expert-cache": argval(args, "--expert-cache"), "--expert-cache-device1": argval(args, "--expert-cache-device1")}
    set_arg(args, "--expert-cache", slots["uniform_cfg"])
    if slots.get("helper_final"):
        set_arg(args, "--expert-cache-device1", slots["helper_final"], after="--chat-cache-mib")
    drop_arg(args, "--vision", value=False)
    vis = cfg.pop("vision", None)
    fb = cfg.pop("fallback", None)
    env = cfg.setdefault("env", OrderedDict())
    if hcq8:
        env["STRATA_HC_Q8"] = "0" if hc_off else "1"
    cfg["log"] = str(WS / f"logs/engine-{name}.log")
    cfg["_dayone"] = OrderedDict([
        ("written", f"{VERSION} {now()}: day1.py's config + only the changes below. NOT RUN."),
        ("expert_cache", f"{old['--expert-cache']} -> {slots['uniform_cfg']} (explicit: a budget of {slots['uniform_cfg']:,} largest "
                         f"blobs of {slots['max_blob']:,} B = the 5080's room {slots['main_room_gib']:.3f} GiB - "
                         f"{slots['margin_mib']:.0f} MiB margin; auto would grant {slots['uniform_auto']:,}); expected log "
                         f"'expert cache {slots['sized_cfg']:,} slots' ({'the profile sized fill' if slots['profile'] else 'uniform: no profile of this shape'})"),
        ("expert_cache_device1", f"{old['--expert-cache-device1']} -> {slots.get('helper_final')} ({slots.get('helper_note')})"),
        ("vision", "dropped (a test config: no picture helper)" if vis or "--vision" in json.dumps(old) else "none"),
        ("fallback", f"dropped ({fb})" if fb else "none"),
        ("STRATA_HC_Q8", "1: the file stores its hyper-connection projections as Q8_0 (Karl 11-05: the verify read takes the "
                         "GGUF's own Q8_0 bytes; the prompt path still reads the pack's BF16 = the pack-rounding tag)"
         if hcq8 else "not set (BF16 hyper-connections, or none)"),
        ("mode", "same-model swap" if swap else "stock (new model)"),
        ("slot_model", {k: v for k, v in slots.items() if k not in ("blobs",)}),
    ])
    if ngram:
        cfg["_dayone"]["ngram_placement"] = ngram.get("config_note")
    if hcq8 and hc_off:
        cfg["_dayone"]["STRATA_HC_Q8"] = ("0: Karl 11-06 - U's v3.1 exactness failed with the switch on and passed with it off "
                                          "(work/qwen4-kit/hcoff/gap-ud31-hcoff.sh): day one runs Unsloth with the switch off")
    return cfg


def ref_config(base_cfg, ref, name, room_ram_gib, margin_gib=5.0):
    """the KL reference R: quality only (score.py / pf_yardstick put the experts on the CPU anyway). The candidate's
    config with R's paths, the 5080 alone, no helper, --resident-budget-gib when R's experts exceed the RAM tier,
    chat cache 2 GiB, STRATA_UNBUFFERED_LOAD=1 (configs/r21-yq-udq4.json's memory form, as ud31-R.json)"""
    cfg = json.loads(json.dumps(base_cfg), object_pairs_hook=OrderedDict)
    args = cfg["args"]
    set_arg(args, "--pack", ref["pack"])
    set_arg(args, "--native", ref["paths"][0])
    if ref.get("ngram_path"):
        set_arg(args, "--ple-gguf", ref["ngram_path"])
    drop_arg(args, "--expert-cache-device1")
    set_arg(args, "--expert-cache", "auto")
    set_arg(args, "--chat-cache-mib", 2048)
    resident = int(room_ram_gib - margin_gib)   # ud31-R.json / r21-yq-udq4.json: 52 on Flash-Next (RAM tier 57.8 - 5)
    if ref["experts_gib"] > room_ram_gib:
        set_arg(args, "--resident-budget-gib", resident)
    env = cfg["env"]
    cvd = env.get("CUDA_VISIBLE_DEVICES", "")
    if "," in cvd:
        env["CUDA_VISIBLE_DEVICES"] = cvd.split(",")[0]
    env["STRATA_UNBUFFERED_LOAD"] = "1"
    if ref["hcq8"]:
        env["STRATA_HC_Q8"] = "1"
    else:
        env.pop("STRATA_HC_Q8", None)
    cfg["log"] = str(WS / f"logs/engine-{name}-R.log")
    cfg["model_name"] = f"strata-{name}-R"
    cfg["_dayone"] = OrderedDict([
        ("written", f"{VERSION} {now()}: the KL reference R for {name} - quality arms only, never served. NOT RUN."),
        ("reference", f"{Path(ref['paths'][0]).name}: {ref['experts_gib']:.2f} GiB of experts ({ref['label']})"),
        ("memory form", "5080 alone, no helper, chat cache 2 GiB, STRATA_UNBUFFERED_LOAD=1"
                        + (f", --resident-budget-gib {resident} (its experts exceed the {room_ram_gib:.1f} GiB "
                           "RAM tier: the rest streams from the SSD - slow, quality only)" if ref["experts_gib"] > room_ram_gib else "")),
        ("STRATA_HC_Q8", "1 (R stores Q8_0 hyper-connections: its own bytes)" if ref["hcq8"] else "not set")])
    return cfg


# =====================================================================================================================
# 6. the driver templates (bash; @@KEY@@ filled by render())
# =====================================================================================================================
COMMON = r'''#!/bin/bash
# @@FILE@@ - Qwen4 day one: @@WHAT@@
# Generated by work/qwen4-kit/dayone.py (@@VERSION@@, @@WHEN@@) for @@NAME@@ (@@LABEL@@; @@MODE@@).
# GENERATED, NOT REVIEWED, NOT RUN. The generator writes NO .ready file: Claude reviews this driver and writes
# @@FILE@@.ready before work/r23/gap-series.sh (or a hand start, `bash <driver>`, no arguments) may use it.
# Measurements only: P028x stays served, NOTHING SWITCHES. Rules: work/qwen4-kit/q4_rules.py's docstring, copied to the
# gap folder when the gap starts. Every model-specific value comes from the params file below (dayone.py wrote it).
@@STEPS@@
# A kernel check after every step; a failure stops new steps and leaves the gap OPEN (8080 down, exit 3: Karl decides).
# No new step after Q4_MAX_MIN (default @@MAXM@@) minutes with 8080 down; a step starts only if its minutes fit.
# Exit 0 = done (outcome in decision.txt), 1 = refused / not opened (8080 untouched), 3 = kernel check failed (gap open),
# 4 = port_gap4.sh end failed.
set -u -o pipefail
exec 8>&- 9>&-                     # no inherited lock descriptor (work/r22 lock-fd rule): this script holds none itself
WS=/home/USER/ai-speed-testing/strata-compare
export RB_CACHE=$WS/tmp/qwen4
source $WS/bringup/lib/env.sh
unset GUARD_MEM_GIB GUARD_VRAM_MIB GUARD_SWAP_GROW_GIB GUARD_VRAM_MODE GUARD_FOLLOW_PORT LR_MAX SPEED_FILE
for v in $(compgen -e | grep '^STRATA_'); do [ "$v" = STRATA_MON_GPU ] || unset "$v"; done   # no stray switch reaches an engine
P=$WS/.venv/bin/python; KR=$WS/work/r22; LIB=$WS/bringup/lib; KIT=$WS/work/qwen4-kit; Q4R=$KIT/q4_rules.py
PRM=@@PARAMS@@
NAME=@@NAME@@; SHORT=@@SHORT@@; MODE=@@MODE_KEY@@
CFG=@@CFG@@; EXE=@@EXE@@; NGPU=@@NGPU@@
TREE=@@TREE@@                # the release's source tree: patchtest.sh TREE=, its tools
X=$WS/configs/x28h.json; X_EXE=$WS/engine-r22p028x/strata; P028X_SHA=f4c4f654fb24   # P028x as served, without vision
ENGINES="@@ENGINES@@"        # engine process names (exact): the preflight and the waits; add the release's if it is new
R=@@RESULTS@@; O=$R/gap-@@KIND@@; G=$O/gates.txt; PROF=$WS/bringup/out/logs/prof
STARTS=$R/gap-@@KIND@@-starts.log; S=$STARTS             # until the pre-gap checks pass (then $O/summary.txt)
MAXM=${Q4_MAX_MIN:-@@MAXM@@}
TAG=$(date +%m%d%H%M)
export PROMPT_DIR=@@PROMPT_DIR@@ EVICT_GLOB="@@EVICT@@"
mkdir -p $R $WS/tmp/qwen4 $WS/logs
say() { echo "=== $(date '+%F %T') $*" | tee -a $S; }
gate() { echo "$1 $2 ${*:3} [q4 $(date '+%m-%d %H:%M')]" >> $G; say "  gate $*"; }
gstat() { grep "^$1 " $G 2> /dev/null | tail -1 | cut -d' ' -f2; }
KFAIL=0; T0=$(date +%s); DEADLINE=$T0
kc() { $LIB/kcheck.sh "q4-$SHORT-$1" > /dev/null 8>&- 9>&- || { say "KERNEL CHECK FAILED after $1"; KFAIL=1; echo "kfail FAIL after $1" >> $G; return 1; }; }
left() { echo $(( DEADLINE - $(date +%s) )); }
ok_to_go() { [ $KFAIL = 0 ] && [ $(left) -gt 0 ]; }
fits() { ok_to_go && [ $(left) -ge $(( $1 * 60 )) ]; }   # a step starts only if it ends before the deadline
sha12() { sha256sum "$1" | cut -c1-12; }
elog() { $P -I -c "import json; print(json.load(open('$1'))['log'])"; }
slog() { ls -t $WS/bringup/out/logs/server_$1_*.log 2> /dev/null | head -1; }   # the newest server log of a with_server label
ppid_of() { local s; s=$(cat /proc/$1/stat 2> /dev/null) || return 0; s=${s##*) }; set -- $s; echo "${2:-}"; }
memavail() { awk '/^MemAvailable/ {printf "%d", $2 / 1048576}' /proc/meminfo; }
prm() { $P -I -c "import json, sys; d = json.load(open('$PRM'))
for k in sys.argv[1].split('.'): d = d[int(k)] if isinstance(d, list) else d[k]
print(d if not isinstance(d, list) else ' '.join(map(str, d)))" "$1"; }

preflight() {   # refuse (exit 1, nothing touched) when a measurement holds the GPU lock or a model server other than the
  # 8080 queue's P028x runs: every engine process (exact names) and every NVIDIA compute process must belong to the server
  # listening on 8080, and that server's engine must be P028x (engine-r22p028x, sha $P028X_SHA; its vision helper allowed)
  local l p q apps bad=""
  if [ -s $WS/tmp/port-gap.lockpid ] && kill -0 "$(cat $WS/tmp/port-gap.lockpid)" 2> /dev/null; then
    say "another gap holds the test lock (tmp/port-gap.lockpid $(cat $WS/tmp/port-gap.lockpid)) - not started"; exit 1
  fi
  if ! flock -n -x $WS/tmp/gpu-test.lock true 2> /dev/null; then
    say "tmp/gpu-test.lock is held (a measurement or a test server) - not started"; exit 1
  fi
  l=$(ss -H -ltnp "( sport = :8080 )" 2> /dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2)
  apps=$(nvidia-smi --query-compute-apps=pid --format=csv,noheader 2> /dev/null) || { say "nvidia-smi did not answer - not started"; exit 1; }
  for p in $( { for x in $ENGINES; do pgrep -x "$x"; done; echo "$apps"; } | tr -d ' ' | grep -E '^[0-9]+$' | sort -un); do
    q=$p; while [ -n "$q" ] && [ "$q" -gt 1 ] && [ "$q" != "${l:-none}" ]; do q=$(ppid_of $q); done
    if [ -n "$l" ] && [ "$q" = "$l" ]; then
      case $(cat /proc/$p/comm 2> /dev/null) in
        strata|strata-host) [ "$(sha12 /proc/$p/exe 2> /dev/null)" = $P028X_SHA ] || bad="$bad 8080-engine:$p($(readlink /proc/$p/exe))";;
        strata-vision) ;;
        *) bad="$bad 8080:$p($(cat /proc/$p/comm 2> /dev/null))";;
      esac
    else bad="$bad $p($(cat /proc/$p/comm 2> /dev/null))"; fi
  done
  ss -H -ltn "( sport = :8081 )" 2> /dev/null | grep -q . && bad="$bad listener-on-8081(a-test-server)"
  [ -z "$bad" ] || { say "a model server other than the 8080 queue's P028x is running:$bad - not started"; exit 1; }
}
wait_mem() {   # after 8080 stops: its engines gone and their memory back, at most 120 s
  local i x left_p m
  for i in $(seq 60); do
    left_p=""; for x in $ENGINES; do pgrep -x $x > /dev/null && left_p="$left_p $x"; done
    m=$(memavail)
    [ -z "$left_p" ] && [ "$m" -ge 40 ] && break
    sleep 2
  done
  say "8080 down: engines left:${left_p:- none}, MemAvailable ${m} GB"
}
fatalchk() {   # fatalchk NAME ENGINE_LOG OFFSET LABEL: a fatal GPU error / stall / engine restart / non-finite (gap 17)
  local n=$1 L=$2 off=$3 sl hits
  sl=$(slog $4)
  hits=$( { tail -c +$((off + 1)) $L 2> /dev/null; [ -n "$sl" ] && cat $sl; } | grep -c -E "fatal GPU error|no progress for [0-9]+ s during a request|the engine had stopped \(exit code|became non-finite")
  [ "$hits" = 0 ] && gate fatal_$n PASS "no fatal / stall / restart / non-finite line" \
    || gate fatal_$n FAIL "$hits line(s): fatal GPU error / stall / engine restart / non-finite (engine log $L from byte $off; $sl)"
}
evict_all() {   # drop the model files' clean pages (scripts/evict.py, posix_fadvise) and report the page cache
  local f="" x
  for x in $EVICT_GLOB; do [ -e "$x" ] && f="$f $x"; done
  $P -I $WS/scripts/evict.py $f > $O/evict-$1.txt 2>&1
  say "  evicted ($1): $(grep -c 'page cache' $O/evict-$1.txt) files; $(awk '/^(Dirty|Writeback|Cached|MemAvailable|SwapFree):/ {printf "%s %d MiB  ", $1, $2 / 1024}' /proc/meminfo)"
}
need_files() { local f; for f in "$@"; do [ -e "$f" ] || { say "missing $f - not started"; exit 1; }; done; }
predl_all() {   # predl_all GATE: every listed arm's shards here, at the pinned size, with a SHA256SUMS line = the pin
  local i n=$(prm dl.n) rc=0 d t pths
  for i in $(seq 0 $((n - 1))); do
    d=$(prm dl.items.$i.dest); t=$(prm dl.items.$i.tree); pths=$(prm dl.items.$i.paths_csv)
    $P -I -B $Q4R predl $d $t --paths $pths >> $PRE/predl.txt 2>&1 || rc=1
  done
  return $rc
}
rehash_all() {   # rehash_all: inside the gap, every listed shard re-hashed against the pin before anything reads it
  local i n=$(prm dl.n) d t pths
  for i in $(seq 0 $((n - 1))); do
    d=$(prm dl.items.$i.dest); t=$(prm dl.items.$i.tree); pths=$(prm dl.items.$i.paths_csv)
    $P -I -B $Q4R rehash $d $t --paths $pths --gate dl_sha_$i --gates $G 8>&- 9>&- 2>&1 | tail -1 | tee -a $S
    [ "$(gstat dl_sha_$i)" = PASS ] || return 1
  done
  return 0
}
lossless_cfg() {   # lossless_cfg KEY CONFIG [ENGINE_LOG]: bringup/patchtest.sh lossless (no GPU; with a log: none of the lossy lines)
  local r
  r=$(CFG=$2 TREE=$TREE ${3:+ELOG=$3} $WS/bringup/patchtest.sh lossless 2>&1 8>&- 9>&- | grep -E "PASS|FAIL" | tail -1)
  if echo "$r" | grep -q "cfg: PASS" && { [ -z "${3:-}" ] || echo "$r" | grep -q "log clean"; }; then gate $1 PASS "$(echo $r | cut -c1-200)"
  else gate $1 FAIL "$(echo $r | cut -c1-200)"; return 1; fi
}
open_gap() {   # open_gap WHAT: port_gap4.sh begin (the running question finishes, test lock, 8080 down)
  $KR/port_gap4.sh begin "$1" 8>&- 9>&- 2>&1 | tee -a $S
  [ -s $WS/tmp/port-gap.lockpid ] || { rm -f /home/USER/ai/deep-research/tmp/bench2.hold; say "the gap did not open (hold removed)"; exit 1; }
  T0=$(date +%s); DEADLINE=$(( T0 + MAXM * 60 ))
  echo "$T0 $(date -Is)" > $O/t0.txt
  wait_mem
}
close_gap() {   # close_gap: the decision, port_gap4.sh end (P028x back) + a kernel check; exits
  if [ $KFAIL = 1 ]; then say "the gap stays OPEN (8080 down) after a kernel-check failure: Karl decides"; decide; exit 3; fi
  decide
  say "P028x back on 8080 (port_gap4.sh end) - nothing switched"
  if ! $KR/port_gap4.sh end 8>&- 9>&- 2>&1 | tee -a $S; then
    say "port_gap4.sh end FAILED: 8080 and the research queue need a look"; exit 4
  fi
  kc end || { say "the kernel check failed after P028x came back: Karl decides"; exit 3; }
  after_gap
  say "@@KIND@@ gap: $(( ($(date +%s) - T0) / 60 )) min with 8080 down; done"
  exit 0
}
start_attempt() {   # the pre-gap checks every driver shares (no GPU; 8080 untouched)
  say "start attempt: $(basename $0) (pre-gap checks)"
  preflight
  [ -f $WS/tmp/r19/kwatch.pid ] && kill -0 "$(cat $WS/tmp/r19/kwatch.pid)" 2> /dev/null || { say "the kernel-log watcher is not running - not started"; exit 1; }
  PRE=$R/pre-@@KIND@@; rm -rf $PRE; mkdir -p $PRE   # this attempt's pre-gap check outputs (overwritten by the next attempt)
  need_files $PRM $Q4R $KR/port_gap4.sh $LIB/kcheck.sh $LIB/run.sh $LIB/exact7.sh $LIB/with_server.sh $LIB/guard.py \
    $WS/bringup/patchtest.sh $WS/scripts/evict.py $TREE
  if [ "$(prm dl.n)" -gt 0 ]; then
    predl_all || { say "REFUSED: the download is not complete and verified: $(grep FAIL $PRE/predl.txt | head -2 | tr '\n' ' ' | cut -c1-240) - not started"; exit 1; }
  fi
  PREV=""
  if [ -e $O ]; then PREV=$R/prev-@@KIND@@-$(date +%m%d-%H%M%S); mv $O $PREV; fi   # the rules judge only this attempt's files
  mkdir -p $O
  $P -I -B $Q4R rules --out $O/rules.txt > /dev/null 2>&1 || { say "could not write the rules snapshot $O/rules.txt - not started"; exit 1; }
}
'''

EXACT = r'''
# ================================================================ before the gap (no GPU; 8080 untouched)
PIN=@@PIN@@; E7REF=@@E7REF@@; PACK=@@PACK@@
start_attempt
need_files $CFG $EXE $PACK/native_experts.txt $PACK/index.txt @@SHARDS@@ @@DRAFTER@@
for f in math.tokens code.tokens p2000.tokens 32k.tokens tf-long112k.prompt; do
  [ -s $PROMPT_DIR/$f ] || { say "missing prompt file $f in $PROMPT_DIR (exact7's items; a new tokenizer: day1.py retok first) - not started"; exit 1; }
done
$P -I -B $Q4R cfgcheck $CFG $PRM > $PRE/cfg.txt 2>&1 || { say "REFUSED: $(tail -1 $PRE/cfg.txt) - not started"; exit 1; }
if [ "$E7REF" != c13 ] && [ "$(ls $PROF/$E7REF-*.out 2> /dev/null | wc -l)" != 7 ]; then say "P028x's exact7 $E7REF is not complete (7 .out files) - not started"; exit 1; fi
ls $PROF/$SHORT-$TAG-* > /dev/null 2>&1 && { say "exact7 labels $SHORT-$TAG-* exist already - not started"; exit 1; }
S=$O/summary.txt
lossless_cfg lossless_cfg $CFG || { say "REFUSED: the lossless config check fails - not started"; exit 1; }
say "QWEN4 DAY ONE EXACTNESS SMOKE ($(basename $0)): $NAME - smoke + exact7 twice at pin $PIN (repeatability) - measurements only, P028x stays served, nothing switches"
[ -n "$PREV" ] && say "an earlier attempt's outputs moved to $PREV"
gate rules INFO "q4_rules.py's docstring at the gap's start: gap-exact/rules.txt sha $(sha12 $O/rules.txt)"
gate cfg PASS "$(tail -1 $PRE/cfg.txt | cut -c1-200)"
[ "$(prm dl.n)" -gt 0 ] && gate predl PASS "$(grep -c '^PASS' $PRE/predl.txt) quant(s): every shard here, pinned size + SHA256SUMS"
DONE=0
e7() {   # e7 KEY REF INFO: exact7 at the pin, its engine environment checked as it starts (q4_rules.py envcli, mode e7)
  local k=$1 ref=$2 L=$SHORT-$TAG-$1 jp info=${3:-}
  fits @@E7_MIN@@ || { say "skipped exact7 $L (@@E7_MIN@@ min do not fit before the deadline, or a kernel check)"; return 1; }
  say "exact7 $L ($(basename $CFG), against $ref)"
  ( PIN_CACHE=$PIN REF=$ref $LIB/exact7.sh $L $CFG 2>&1 | tail -9 | tee -a $S ) 8>&- 9>&- &
  jp=$!
  $P -I -B $Q4R envcli $EXE $CFG --job $jp --mode e7 --pin $PIN --ngpu $NGPU --kill --gate env_e7$k --gates $G 8>&- 9>&- 2>&1 \
    | tee $O/env-e7$k.txt | tail -1 | tee -a $S
  wait $jp
  $P -I -B $WS/work/r23/decode_rules.py e7gate $S $L $info --gate e7_$k --gates $G 8>&- 9>&- | tee -a $S
  kc e7-$k
}
decide() { $P -I -B $Q4R exactdecide $O --arm X 8>&- 9>&- | tail -1 | tee -a $S; cp $O/decision.txt $R/decision-exact.txt 2> /dev/null; }
after_gap() { :; }

# ================================================================ the gap
open_gap "Qwen4 day one $NAME exactness smoke (dayone.py: smoke + exact7 x2 at pin $PIN; measurements only, P028x stays served, nothing switches)"
kc open || close_gap
say "1 the files: every listed shard re-hashed against its pin (pages dropped as read), then evicted"
if [ "$(prm dl.n)" -gt 0 ]; then rehash_all || { say "a shard does not hash to its pin: nothing runs on it, the gap ends"; close_gap; }; fi
evict_all start
kc files || close_gap
say "2 the CLI smoke: $NAME loads and generates (run.sh math 256)"
if fits @@SMOKE_MIN@@; then
  L=$SHORT-$TAG-smoke
  $LIB/run.sh $L $CFG math 256 8>&- 9>&- 2>&1 | tail -3 | tee -a $S
  $P -I -B $Q4R smoke $PROF/$L.out $PROF/$L.err --gate smoke --gates $G 8>&- 9>&- | tee -a $S
  lossless_cfg lossless_log $CFG $PROF/$L.err
  $P -I -B $Q4R slots $PROF/$L.err --main @@PRED_MAIN@@ @@PRED_HELPER_ARG@@ --gate slots_cfg --gates $G 8>&- 9>&- | tee -a $S
  kc smoke || close_gap
fi
if [ "$(gstat smoke)" = PASS ]; then
  say "3 exactness: exact7 at pin $PIN, X1 @@E7REF_WHAT@@, X2 against X1 (7/7 + MATCHED)"
  e7 X1 $E7REF --info
  $P -I -B $Q4R slots $PROF/$SHORT-$TAG-X1-x-math.err --main @@PRED_PIN@@ @@PRED_HELPER_ARG@@ --gate slots_e7 --gates $G 8>&- 9>&- | tee -a $S
  e7 X2 $SHORT-$TAG-X1
else
  say "no exact7: the smoke did not pass ($(gstat smoke))"
fi
close_gap
'''

KL = r'''
# ================================================================ before the gap (no GPU; 8080 untouched)
DATA=@@KLDATA@@              # dump = score.py many positions (Flash-Next's head and tokenizer); pfy = pf_yardstick long40
REFA=R; CANDS="@@CANDS@@"; BASE=@@BASE@@; ARMS="@@ARMS@@"
NL=$O/nll; PF=$O/pfy; SCORE=$WS/work/r23/nll-many/score.py; RU=$WS/work/r23/ud31_rules.py; NR=$WS/work/r23/nll_rules.py
cfg_of() { prm "kl.cfg.$1"; }
min_of() { prm "kl.min.$1"; }
start_attempt
for a in $ARMS; do need_files $(cfg_of $a) $(prm "kl.pack.$a")/native_experts.txt $(prm "kl.pack.$a")/index.txt; done
need_files @@SHARDS@@
for a in $CANDS; do
  $P -I -B $Q4R cfgcheck $(cfg_of $a) $PRM > $PRE/cfg-$a.txt 2>&1 || { say "REFUSED: $a: $(tail -1 $PRE/cfg-$a.txt) - not started"; exit 1; }
done
$P -I -B $Q4R cfgcheck $(cfg_of R) $PRM --quality-only > $PRE/cfg-R.txt 2>&1 || { say "REFUSED: R: $(tail -1 $PRE/cfg-R.txt) - not started"; exit 1; }
if [ $DATA = dump ]; then
  need_files $SCORE $RU $NR
  for f in 32k.tokens tf-long28k.prompt tf-long40k.prompt tf-long64k.prompt tf-long112k.prompt pp4k.tokens ldrsyn20k.tokens \
           rep9k.tokens pp32k.tokens tf-long96k.prompt pp8k.tokens; do
    [ -s $WS/bringup/out/r20a/prompts/$f ] || { say "missing prompt file $f (score.py's long11 set) - not started"; exit 1; }
  done
else
  for f in 32k.tokens tf-long28k.prompt tf-long40k.prompt tf-long64k.prompt tf-long112k.prompt pp4k.tokens ldrsyn20k.tokens rep9k.tokens; do
    [ -s $PROMPT_DIR/$f ] || { say "missing prompt file $f in $PROMPT_DIR (pf_yardstick long40; a new tokenizer: day1.py retok first) - not started"; exit 1; }
  done
  $P -I -B $KIT/day1.py pfy $PROMPT_DIR --check > $PRE/pfy-check.txt 2>&1 || true   # INFO: the cuts against the texts' lengths
fi
S=$O/summary.txt
for a in $ARMS; do [ $a = P ] && continue; lossless_cfg lossless_cfg_$a $(cfg_of $a) || { say "REFUSED: the lossless config check fails on $a - not started"; exit 1; }; done
mkdir -p $NL $PF
say "QWEN4 DAY ONE QUALITY ($(basename $0)): $CANDS against the named local reference R ($(prm kl.ref_label)), data $DATA - the KL rules at the text level, text NLL INFO (the many-positions bound is revoked) - measurements only, P028x stays served, nothing switches"
[ -n "$PREV" ] && say "an earlier attempt's outputs moved to $PREV"
gate rules INFO "q4_rules.py's docstring at the gap's start: gap-kl/rules.txt sha $(sha12 $O/rules.txt)"
for a in $CANDS; do gate cfg_$a PASS "$(tail -1 $PRE/cfg-$a.txt | cut -c1-200)"; done
[ -s $PRE/pfy-check.txt ] && gate pfy_cuts INFO "$(tail -1 $PRE/pfy-check.txt | cut -c1-200)"
DONE_Q=0
watchdog() {   # watchdog JOB MINUTES NAME: an arm past MINUTES (3 x its estimate) is hung - stop its engine by PID
  local j=$1 m=$2 n=$3 t p q
  t=$(( $(date +%s) + m * 60 ))
  while kill -0 $j 2> /dev/null; do
    if [ $(date +%s) -ge $t ]; then
      for p in $( { for x in $ENGINES; do pgrep -x $x; done; } | sort -un); do
        q=$p; while [ -n "$q" ] && [ "$q" -gt 1 ] && [ "$q" != $j ]; do q=$(ppid_of $q); done
        [ "$q" = $j ] && kill -TERM $p 2> /dev/null && echo "watchdog: $n ran past $m min - its engine (pid $p) was stopped" >> $O/$n.watchdog
      done
      return 0
    fi
    sleep 5
  done
}
qarm() {   # qarm ARM: one quality arm (dump: score.py run --set long11 --rows all:8; pfy: day1.py pfy -- run --set long40),
  # its engine's environment checked as it starts; a kernel check after it
  local n=$1 m cfg jp wd mw rc t1 d need
  cfg=$(cfg_of $1); m=$(min_of $1); need=$(prm kl.memneed.$1)
  fits $m || { say "skipped quality arm $n ($m min do not fit before the deadline, or a kernel check)"; return 1; }
  # Karl 11-05: keep the wait-for-memory check, abort cleanly rather than swap (q4_rules.py QUALITY "memory")
  if ! $P -I -B $Q4R memwait --need-gib $need --max-s 120 --gate mem_$n --gates $G 8>&- 9>&- 2>&1 | tail -1 | tee -a $S; then
    gate run_$n FAIL "aborted: memory (not started: MemAvailable below the arm's $need GiB after 120 s)"; kc arm-$n; return 1
  fi
  say "quality arm $n ($(basename $cfg); ~$m min; $DATA; memory need $need GiB)"
  t1=$(date +%s); rm -f $O/$n.rc $O/$n.watchdog $O/$n.aborted
  if [ $DATA = dump ]; then
    d=$NL/$n; rm -rf $d
    ( $P $LIB/guard.py q4nll-$SHORT-$n -- $P -I $SCORE run $cfg $d --set long11 --rows all:8 > $O/$n.run.txt 2>&1; echo $? > $O/$n.rc ) 8>&- 9>&- &
    jp=$!
    watchdog $jp $(( 3 * m )) $n 8>&- 9>&- &
    wd=$!
    $P -I -B $Q4R memwatch $jp --names "$ENGINES" --floor-gib 12 --margin-gib 1 --swap-pages 1024 --out $O/$n.aborted \
      --gate memw_$n --gates $G > $O/$n.memwatch.txt 2>&1 8>&- 9>&- &
    mw=$!
    $P -I -B $NR envwatch $jp $cfg --kill --gate env_$n --gates $G 8>&- 9>&- 2>&1 | tail -2 | tee -a $S
  else
    d=$PF/$n; rm -rf $d
    ( $P $LIB/guard.py q4pfy-$SHORT-$n -- $P -I -B $KIT/day1.py pfy $PROMPT_DIR -- run $cfg $d --set long40 > $O/$n.run.txt 2>&1; echo $? > $O/$n.rc ) 8>&- 9>&- &
    jp=$!
    watchdog $jp $(( 3 * m )) $n 8>&- 9>&- &
    wd=$!
    $P -I -B $Q4R memwatch $jp --names "$ENGINES" --floor-gib 12 --margin-gib 1 --swap-pages 1024 --out $O/$n.aborted \
      --gate memw_$n --gates $G > $O/$n.memwatch.txt 2>&1 8>&- 9>&- &
    mw=$!
    $P -I -B $Q4R envcli $(prm kl.exe.$n) $cfg --job $jp --mode pfy --ngpu $(prm kl.ngpu.$n) --kill --gate env_$n --gates $G 8>&- 9>&- 2>&1 | tail -1 | tee -a $S
  fi
  wait $jp
  kill $wd 2> /dev/null; wait $wd 2> /dev/null
  wait $mw 2> /dev/null    # memwatch ends with the job (or after it stopped the engine)
  [ -f $O/$n.watchdog ] && say "  $(cat $O/$n.watchdog)"
  rc=$(cat $O/$n.rc 2> /dev/null || echo none)
  if [ -f $O/$n.aborted ]; then say "  $n: $(cat $O/$n.aborted)"; gate run_$n FAIL "$(cut -c1-250 $O/$n.aborted)"
  elif [ "$rc" = 0 ] && [ -f $d/index.json ]; then gate run_$n PASS "rc 0: $(grep -E 'rows from [0-9]+ texts|prompts, [0-9]+ logit rows' $O/$n.run.txt | tail -1)"
  else gate run_$n FAIL "rc $rc: $(grep -E '^PROBLEM|SystemExit|Error|answered|ended before|GUARD' $O/$n.run.txt | head -3 | tr '\n' ' ' | cut -c1-250)"; fi
  say "  $n: $(( ($(date +%s) - t1 + 59) / 60 )) min"
  kc arm-$n
}
quality_after() {   # quality_after THREADS: CPU only - the rows (dump: validate each arm with its own head, the compare;
  # pfy: the rows from the engine's own logits), then the KL rules at the text level
  local th=$1 x c cfgs="" ok=1 good=""
  say "quality: rows + the KL rules ($th BLAS threads, nice 19)"
  for x in $ARMS; do
    if [ "$(gstat run_$x)" = PASS ] && [ "$(gstat env_$x)" = PASS ]; then good="$good $x"; else say "  arm $x not clean (run $(gstat run_$x), env $(gstat env_$x))"; fi
  done
  echo " $good " | grep -q " R " || { say "no clean R arm: QUALITY NOT JUDGED"; DONE_Q=1; return; }
  rm -f $O/rows.tsv
  if [ $DATA = dump ]; then
    for x in $good; do
      c=$(cfg_of $x)
      nice -n 19 $P -I -B $RU validate $NL/$x $c --json $NL/validate-$x.json --gate validate_$x --gates $G > $NL/validate-$x.txt 2>&1
      tail -1 $NL/validate-$x.txt | sed "s/^/  validate $x: /" | tee -a $S
      [ "$(gstat validate_$x)" = PASS ] && cfgs="$cfgs --cfg $x=$c"
    done
    if [ "$BASE" = P ] && [ -f $NL/P/index.json ]; then
      nice -n 19 $P -I $SCORE validate $NL/P > $NL/validate-P-scorepy.txt 2>&1
      $P -I -B $RU headcheck $NL/validate-P-scorepy.txt $NL/validate-P.json --gate head_P --gates $G 2>&1 | tee -a $S
    fi
    nice -n 19 $P -I -B $RU compare $NL $cfgs --base @@CMP_BASE@@ --ref R --threads $th --json $O/result.json --rows-out $O/rows.tsv \
      --gate compare --gates $G > $O/compare.txt 2>&1 || gate compare FAIL "rc $?: $(tail -2 $O/compare.txt | tr '\n' ' ' | cut -c1-200)"
  else
    nice -n 19 $P -I -B $Q4R pfyrows $PF --ref R --arms $(echo $good | tr ' ' '\n' | grep -v '^R$' | paste -sd,) --prompt-dir $PROMPT_DIR \
      --sets long40 --out $O/rows.tsv --gate rows --gates $G > $O/rows.txt 2>&1 || gate rows FAIL "$(tail -1 $O/rows.txt | cut -c1-200)"
  fi
  if [ -s $O/rows.tsv ]; then
    nice -n 19 $P -I -B $Q4R kldecide $O/rows.tsv --ref R --cands $(echo $CANDS | tr ' ' ',') @@KLD_BASE@@ @@KLD_TAG@@ \
      --published "$(prm kl.published)" --out $O --gate kl --gates $G 2>&1 | tail -3 | tee -a $S
  else say "no rows.tsv: QUALITY NOT JUDGED"; fi
  DONE_Q=1
}
decide() { [ -f $O/decision-kl.txt ] && cp $O/decision-kl.txt $R/decision-kl.txt; true; }
after_gap() {
  if [ $DONE_Q = 0 ]; then
    for i in $(seq 60); do [ "$(memavail)" -ge 22 ] && break; sleep 10; done   # heads (~5 GB) above the 12 GB floor
    if [ "$(memavail)" -ge 22 ]; then quality_after 4; decide
    else say "MemAvailable $(memavail) GB < 22 after 10 min: the rows / KL rules are NOT run - by hand later (quality_after in this script)"; fi
  fi
}

# ================================================================ the gap
open_gap "Qwen4 day one $NAME quality (dayone.py: $ARMS against R, $DATA; measurements only, P028x stays served, nothing switches)"
kc open || close_gap
say "1 the files: every listed shard re-hashed against its pin, then evicted"
if [ "$(prm dl.n)" -gt 0 ]; then rehash_all || { say "a shard does not hash to its pin: nothing runs on it, the gap ends"; close_gap; }; fi
evict_all start
kc files || close_gap
say "2 the quality arms: $ARMS ($(( $(left) / 60 )) min to the deadline)"
for a in $ARMS; do qarm $a; done
say "3 the rows and the KL rules (inside the gap when they fit)"
if fits @@CMP_MIN@@; then quality_after 8; fi
close_gap
'''

SPEED = r'''
# ================================================================ before the gap (no GPU; 8080 untouched)
SPD=$O/speed; KQ=@@KLDATA@@
cfg_of() { case $1 in P) echo $X;; Q) echo $CFG;; esac; }
exe_of() { case $1 in P) echo $X_EXE;; Q) echo $EXE;; esac; }
ngpu_of() { case $1 in P) echo 2;; Q) echo $NGPU;; esac; }
start_attempt
need_files $CFG $EXE $X $X_EXE @@PACK@@/native_experts.txt @@DRAFTER@@ $KR/abarm.sh $KR/g17_rules.py /home/USER/ai-speed-testing/basalt-ab/scripts/abrun.py @@SHARDS@@
[ "$(sha12 $X_EXE)" = $P028X_SHA ] || { say "engine-r22p028x is not P028x ($P028X_SHA) - not started"; exit 1; }
$P -I -B $Q4R cfgcheck $CFG $PRM > $PRE/cfg.txt 2>&1 || { say "REFUSED: $(tail -1 $PRE/cfg.txt) - not started"; exit 1; }
S=$O/summary.txt
lossless_cfg lossless_cfg $CFG || { say "REFUSED: the lossless config check fails - not started"; exit 1; }
mkdir -p $SPD
say "QWEN4 DAY ONE SPEED ($(basename $0)): the 9-workload screen, Q = $NAME against P = x28h (P028x as served), 3 passes in turned order - the no-loss rule + Karl's 40-60 tok/s target (INFO) - measurements only, P028x stays served, nothing switches"
[ -n "$PREV" ] && say "an earlier attempt's outputs moved to $PREV"
gate rules INFO "q4_rules.py's docstring at the gap's start: gap-speed/rules.txt sha $(sha12 $O/rules.txt)"
gate cfg PASS "$(tail -1 $PRE/cfg.txt | cut -c1-200)"
sarm() {   # sarm ARM PASS: one 9-workload screen pass on a fresh test server (gap 17 / 18's harness), its engine's env checked
  local a=$1 k=$2 n=$1$2 cfg L off
  cfg=$(cfg_of $1)
  fits @@SCR_MIN@@ || { say "skipped screen $n (@@SCR_MIN@@ min do not fit before the deadline, or a kernel check)"; return 1; }
  L=$(elog $cfg); touch $L; off=$(stat -c %s $L)
  say "screen $n ($(basename $cfg))"
  $LIB/with_server.sh q4-$SHORT-$n $cfg -- "$P -I -B $KR/g17_rules.py envcheck $(exe_of $a) $cfg --ngpu $(ngpu_of $a) --gate env_scr$n --gates $G && bash $KR/abarm.sh http://127.0.0.1:8081 $off $SPD $n ${n}n=normal:1:W1,W2,W3 ${n}a=agent:1 ${n}r=research4:1" 8>&- 9>&- 2>&1 \
    | grep -E "engine pid [0-9]+:|ENV CHECK|tok/s|ready|exited|refus|Error|GUARD|vram" | tee -a $S
  tail -c +$((off + 1)) $L > $SPD/engine-$n.log
  fatalchk scr$n $L $off q4-$SHORT-$n
  kc scr-$n
}
decide() { $P -I -B $Q4R speeddecide $O --arm Q --base P --target @@TARGET@@ 8>&- 9>&- | tail -2 | tee -a $S; cp $O/decision.txt $R/decision-speed.txt 2> /dev/null; true; }
after_gap() { :; }

# ================================================================ the gap
open_gap "Qwen4 day one $NAME speed screen (dayone.py: the 9-workload screen x3, Q vs P028x; measurements only, P028x stays served, nothing switches)"
kc open || close_gap
say "1 the files: every listed shard re-hashed against its pin"
if [ "$(prm dl.n)" -gt 0 ]; then rehash_all || { say "a shard does not hash to its pin: nothing runs on it, the gap ends"; close_gap; }; fi
kc files || close_gap
say "2 speed: the 9-workload screen, 3 passes (P Q / Q P / P Q), a fresh test server each ($(( $(left) / 60 )) min to the deadline)"
for k in 1 2 3; do
  case $k in 2) order="Q P";; *) order="P Q";; esac
  fits $(( 2 * @@SCR_MIN@@ )) || { say "screen pass $k not started ($(( 2 * @@SCR_MIN@@ )) min do not fit, or a kernel check)"; break; }
  for a in $order; do sarm $a $k; done
  if [ $k = 1 ]; then
    [ -f $SPD/P1.startlog ] && $P -I -B $KR/g17_rules.py startlines base $SPD/P1.startlog $(slog q4-$SHORT-P1) --gate start_P --gates $G 8>&- 9>&- | tee -a $S
    if [ -f $SPD/Q1.startlog ]; then
      @@STARTQ@@
      lossless_cfg lossless_log $CFG $SPD/engine-Q1.log
      $P -I -B $Q4R slots $SPD/Q1.startlog --main @@PRED_MAIN@@ @@PRED_HELPER_ARG@@ --gate slots --gates $G 8>&- 9>&- | tee -a $S
    fi
  fi
done
close_gap
'''

STEPS = {
    "exact": """# Steps (the series' exactness pattern, gap-ud31.sh section 2; q4_rules.py EXACTNESS):
#   0 before the gap (no GPU, 8080 untouched) - REFUSES (exit 1) unless: no gpu-test.lock / other gap / model server other
#     than the 8080 queue's P028x / 8081 listener; the kernel watcher runs; the download complete and verified (every shard
#     at its pinned size with a SHA256SUMS line = the pinned oid); the pack finished; the config = the one dayone.py wrote
#     (cfgcheck); the lossless config check (patchtest.sh lossless); exact7's prompt files in PROMPT_DIR
#   1 port_gap4.sh begin; every shard re-hashed against its pin (a mismatch ends the gap: nothing runs on it); evict
#   2 the CLI smoke (run.sh math 256): loads and generates; the lossless check on its engine log; slots INFO
#   3 exact7 at the pin: X1 (@@E7REF_WHAT@@), X2 against X1 (7/7 + slots MATCHED); each engine's env checked
#   4 q4_rules.py exactdecide -> decision.txt (REPEATABLE / NOT REPEATABLE / CHECK FAILED / VOID / NOT RUN); port_gap4.sh end""",
    "kl": """# Steps (gap-ud31.sh sections 3 and 5 for a day-one file; q4_rules.py QUALITY):
#   0 before the gap - REFUSES (exit 1) unless the preflight, the kernel watcher, the verified download, every arm's pack and
#     config (cfgcheck on the candidates), the lossless config check on every arm but P, the prompt files
#   1 port_gap4.sh begin; re-hash; evict
#   2 the quality arms @@ARMS@@ (data @@KLDATA@@: @@KLDATA_WHAT@@), each engine's env checked; Karl 11-05's memory
#     rule on every arm: memwait before it starts (its need: experts in RAM + 12 GiB floor + 6 GiB), memwatch while it
#     runs (MemAvailable < 13 GiB, engine VmSwap > 0 or +4 MiB of swap-ins/outs -> its engine stopped by PID, "aborted:
#     memory", the arm FAILs; never let it swap); R's --resident-budget-gib = the RAM tier - 5
#   3 inside the gap when it fits (else after it, nice 19): the rows (@@ROWS_WHAT@@), q4_rules.py kldecide: the KL rules
#     against R at the text level (8 distinct texts; ties / X vs P by ud31's text-level rule), text NLL INFO with the
#     whole-text interval -> decision-kl.txt; port_gap4.sh end""",
    "speed": """# Steps (gap-ud31.sh section 4 for a day-one file; q4_rules.py SPEED):
#   0 before the gap - REFUSES (exit 1) unless the preflight, the kernel watcher, the verified download, the pack, the config
#     (cfgcheck), the lossless config check, x28h's engine = P028x
#   1 port_gap4.sh begin; re-hash
#   2 the 9-workload screen (abarm.sh), 3 passes P Q / Q P / P Q, a fresh test server each (g17_rules.py envcheck); after
#     pass 1: start lines (P: g17 base; Q: @@STARTQ_WHAT@@), the lossless check on Q's engine log, slots INFO
#   3 q4_rules.py speeddecide (g17's wl_noloss, Q vs P; Karl's 40-60 tok/s target INFO) -> decision.txt; port_gap4.sh end""",
}


# ---- 11-05e: the U-vs-ISTA speed screen (item 1) and the dense forms of the exactness / speed drivers (item 4)
SPEED_AB = r'''
# ================================================================ before the gap (no GPU; 8080 untouched)
SPD=$O/speed
cfg_of() { prm "ab.cfg.$1"; }
exe_of() { prm "ab.exe.$1"; }
ngpu_of() { prm "ab.ngpu.$1"; }
prm_of() { prm "ab.params.$1"; }
start_attempt
need_files $(cfg_of A) $(cfg_of B) $(exe_of A) $(exe_of B) $X $X_EXE $KR/abarm.sh $KR/g17_rules.py /home/USER/ai-speed-testing/basalt-ab/scripts/abrun.py @@NEED_AB@@ @@SHARDS@@
[ "$(sha12 $X_EXE)" = $P028X_SHA ] || { say "engine-r22p028x is not P028x ($P028X_SHA) - not started"; exit 1; }
for a in @@AB_NEW@@; do
  $P -I -B $Q4R cfgcheck $(cfg_of $a) $(prm_of $a) > $PRE/cfg-$a.txt 2>&1 || { say "REFUSED: $a: $(tail -1 $PRE/cfg-$a.txt) - not started"; exit 1; }
done
S=$O/summary.txt
for a in @@AB_NEW@@; do lossless_cfg lossless_cfg_$a $(cfg_of $a) || { say "REFUSED: the lossless config check fails on $a - not started"; exit 1; }; done
mkdir -p $SPD
say "QWEN4 DAY ONE U-vs-ISTA SPEED ($(basename $0)): the 9-workload screen, A = $(prm ab.label.A) against B = $(prm ab.label.B), 3 passes in turned order - the no-loss rule both ways + Karl's 40-60 tok/s target (INFO) - measurements only, P028x stays served, nothing switches"
[ -n "$PREV" ] && say "an earlier attempt's outputs moved to $PREV"
gate rules INFO "q4_rules.py's docstring at the gap's start: gap-@@KIND@@/rules.txt sha $(sha12 $O/rules.txt)"
for a in @@AB_NEW@@; do gate cfg_$a PASS "$(tail -1 $PRE/cfg-$a.txt | cut -c1-200)"; done
sarm() {   # sarm ARM PASS: one 9-workload screen pass on a fresh test server (gap 17 / 18's harness), its engine's env checked
  local a=$1 k=$2 n=$1$2 cfg L off
  cfg=$(cfg_of $1)
  fits @@SCR_MIN@@ || { say "skipped screen $n (@@SCR_MIN@@ min do not fit before the deadline, or a kernel check)"; return 1; }
  L=$(elog $cfg); touch $L; off=$(stat -c %s $L)
  say "screen $n ($(basename $cfg))"
  $LIB/with_server.sh q4-$SHORT-$n $cfg -- "$P -I -B $KR/g17_rules.py envcheck $(exe_of $a) $cfg --ngpu $(ngpu_of $a) --gate env_scr$n --gates $G && bash $KR/abarm.sh http://127.0.0.1:8081 $off $SPD $n ${n}n=normal:1:W1,W2,W3 ${n}a=agent:1 ${n}r=research4:1" 8>&- 9>&- 2>&1 \
    | grep -E "engine pid [0-9]+:|ENV CHECK|tok/s|ready|exited|refus|Error|GUARD|vram" | tee -a $S
  tail -c +$((off + 1)) $L > $SPD/engine-$n.log
  fatalchk scr$n $L $off q4-$SHORT-$n
  kc scr-$n
}
startq() {   # startq ARM: its start lines after pass 1 (the served x28h: g17 base; a new file: startcheck + the lossless log check + slots)
  local a=$1
  [ -f $SPD/${a}1.startlog ] || return 0
  if [ "$(prm ab.served.$a)" = True ]; then
    $P -I -B $KR/g17_rules.py startlines base $SPD/${a}1.startlog $(slog q4-$SHORT-${a}1) --gate start_$a --gates $G 8>&- 9>&- | tee -a $S
  else
    $P -I -B $Q4R startcheck $SPD/${a}1.startlog $(slog q4-$SHORT-${a}1) --gate start_$a --gates $G 8>&- 9>&- | tee -a $S
    lossless_cfg lossless_log_$a $(cfg_of $a) $SPD/engine-${a}1.log
    $P -I -B $Q4R slots $SPD/${a}1.startlog --main $(prm ab.slots.$a.main) --gate slots_$a --gates $G 8>&- 9>&- | tee -a $S
  fi
}
decide() {   # both directions of the no-loss rule, then the comparison's record with the default by the v3.1 result
  $P -I -B $Q4R speeddecide $O --arm B --base A --target @@TARGET@@ --tag BvA 8>&- 9>&- | tail -2 | tee -a $S
  $P -I -B $Q4R speeddecide $O --arm A --base B --target @@TARGET@@ --tag AvB 8>&- 9>&- | tail -2 | tee -a $S
  $P -I -B $Q4R uvidecide --params $PRM --speed $O --out $O 8>&- 9>&- | tail -5 | tee -a $S
  cp $O/decision-uvi.txt $R/decision-uvi.txt 2> /dev/null; true
}
after_gap() { :; }

# ================================================================ the gap
open_gap "Qwen4 day one $NAME U-vs-ISTA speed (dayone.py: the 9-workload screen x3, A vs B; measurements only, P028x stays served, nothing switches)"
kc open || close_gap
say "1 the files: every listed shard re-hashed against its pin"
if [ "$(prm dl.n)" -gt 0 ]; then rehash_all || { say "a shard does not hash to its pin: nothing runs on it, the gap ends"; close_gap; }; fi
kc files || close_gap
say "2 speed: the 9-workload screen, 3 passes (A B / B A / A B), a fresh test server each ($(( $(left) / 60 )) min to the deadline)"
for k in 1 2 3; do
  case $k in 2) order="B A";; *) order="A B";; esac
  fits $(( 2 * @@SCR_MIN@@ )) || { say "screen pass $k not started ($(( 2 * @@SCR_MIN@@ )) min do not fit, or a kernel check)"; break; }
  for a in $order; do sarm $a $k; done
  if [ $k = 1 ]; then startq A; startq B; fi
done
close_gap
'''

STEPS["speed_ab"] = """# Steps (the U-vs-ISTA comparison's speed half, Karl 11-05 item 1; q4_rules.py SPEED + U-vs-ISTA):
#   0 before the gap - REFUSES (exit 1) unless the preflight, the kernel watcher, the verified downloads of both arms, each new
#     arm's pack and config (cfgcheck against its own params file), the lossless config check on each new arm, x28h's engine =
#     P028x
#   1 port_gap4.sh begin; re-hash
#   2 the 9-workload screen (abarm.sh), 3 passes A B / B A / A B, a fresh test server each (g17_rules.py envcheck); after
#     pass 1: start lines (the served arm: g17 base; a new arm: startcheck + the lossless log check + slots INFO)
#   3 q4_rules.py speeddecide both ways (B vs A, A vs B: g17's wl_noloss) -> decision-BvA / -AvB; uvidecide -> decision-uvi.txt
#     (with the KL half's pair verdict when it ran, and the DEFAULT by the v3.1 result, re-read now); port_gap4.sh end"""


def _derive(tpl, pairs, what):
    for old, new in pairs:
        if tpl.count(old) != 1:
            raise SystemExit(f"{what}: the template line to replace occurs {tpl.count(old)} times: {old[:80]!r}")
        tpl = tpl.replace(old, new)
    return tpl


_DENSE_PRE = ('$P -I -B $Q4R densecheck $PRM > $PRE/dense.txt 2>&1 || { say "REFUSED: $(tail -1 $PRE/dense.txt) - not started"; '
              'exit 1; }   # dense: the tree must run the architecture\n')
_DENSE_GATE = 'gate cfg PASS "$(tail -1 $PRE/cfg.txt | cut -c1-200)"\ngate dense PASS "$(tail -1 $PRE/dense.txt | cut -c1-200)"\n'
EXACT_DENSE = _derive(EXACT, [
    ("need_files $CFG $EXE $PACK/native_experts.txt $PACK/index.txt @@SHARDS@@ @@DRAFTER@@\n",
     "need_files $CFG $EXE @@SHARDS@@   # dense: no pack, the file's own drafter layer\n" + _DENSE_PRE),
    ('gate cfg PASS "$(tail -1 $PRE/cfg.txt | cut -c1-200)"\n', _DENSE_GATE),
    ("  $P -I -B $Q4R slots $PROF/$L.err --main @@PRED_MAIN@@ @@PRED_HELPER_ARG@@ --gate slots_cfg --gates $G 8>&- 9>&- | tee -a $S\n",
     "  :   # dense: no expert slots\n"),
    ("  $P -I -B $Q4R slots $PROF/$SHORT-$TAG-X1-x-math.err --main @@PRED_PIN@@ @@PRED_HELPER_ARG@@ --gate slots_e7 --gates $G 8>&- 9>&- | tee -a $S\n",
     "  :   # dense: no expert slots\n")], "EXACT_DENSE")
SPEED_DENSE = _derive(SPEED, [
    ("need_files $CFG $EXE $X $X_EXE @@PACK@@/native_experts.txt @@DRAFTER@@ $KR/abarm.sh $KR/g17_rules.py /home/USER/ai-speed-testing/basalt-ab/scripts/abrun.py @@SHARDS@@\n",
     "need_files $CFG $EXE $X $X_EXE $KR/abarm.sh $KR/g17_rules.py /home/USER/ai-speed-testing/basalt-ab/scripts/abrun.py @@SHARDS@@   # dense: no pack\n" + _DENSE_PRE),
    ('gate cfg PASS "$(tail -1 $PRE/cfg.txt | cut -c1-200)"\n', _DENSE_GATE),
    ("      $P -I -B $Q4R slots $SPD/Q1.startlog --main @@PRED_MAIN@@ @@PRED_HELPER_ARG@@ --gate slots --gates $G 8>&- 9>&- | tee -a $S\n",
     "      :   # dense: no expert slots\n")], "SPEED_DENSE")
_DENSE_NOTE = ("# DENSE FORM (Karl 11-05 item 4): no pack and no expert slots; q4_rules.py densecheck REFUSES (exit 1, nothing\n"
               "# touched) while the release tree does not run the file's architecture; cfgcheck's dense rules (placement flags).\n")
STEPS["exact_dense"] = _DENSE_NOTE + STEPS["exact"].replace("the pack finished; ", "")
STEPS["speed_dense"] = _DENSE_NOTE + STEPS["speed"].replace(", the pack, the config", ", the config")

# ---- 11-06 (Karl): U's exactness with STRATA_HC_Q8 off - the v3.1 veto's escape ("unless the failure goes away with
# STRATA_HC_Q8 off and that config passes"); a step after work/r23/gap-ud31.sh, refusing unless U's exactness failed there
EXACT_HCOFF = _derive(EXACT, [
    ("need_files $CFG $EXE $PACK/native_experts.txt $PACK/index.txt @@SHARDS@@ @@DRAFTER@@\n",
     "need_files $CFG $EXE $PACK/native_experts.txt $PACK/index.txt @@SHARDS@@ @@DRAFTER@@\n"
     '$P -I -B $Q4R hcoffneed > $PRE/need.txt 2>&1 || { say "REFUSED: $(tail -1 $PRE/need.txt) - not started"; exit 1; }'
     "   # only when U's v3.1 exactness failed\n"),
    ('gate cfg PASS "$(tail -1 $PRE/cfg.txt | cut -c1-200)"\n',
     'gate cfg PASS "$(tail -1 $PRE/cfg.txt | cut -c1-200)"\ngate need PASS "$(tail -1 $PRE/need.txt | cut -c1-200)"\n'),
    ("  lossless_cfg lossless_log $CFG $PROF/$L.err\n",
     "  lossless_cfg lossless_log $CFG $PROF/$L.err\n"
     "  $P -I -B $WS/work/r23/ud31_rules.py hcline $PROF/$L.err $CFG --want off --gate hcq8_off --gates $G 8>&- 9>&- | tail -1 | tee -a $S"
     "   # the switch really off\n")], "EXACT_HCOFF")
STEPS["exact_hcoff"] = ("# U WITH STRATA_HC_Q8 OFF (Karl 11-06: \"a failed v3.1 exactness result vetoes it, unless the failure goes away with\n"
                        "# STRATA_HC_Q8 off and that config passes\"): q4_rules.py hcoffneed REFUSES (exit 1, nothing touched) unless\n"
                        "# results/r23/ud31/decision.json says U NOT REPEATABLE / CHECK FAILED; the smoke's engine log must show the\n"
                        "# switch off (ud31_rules.py hcline --want off). The rest is the kit's exactness smoke:\n" + STEPS["exact"])


# ---- 11-06 (Karl: "Add a Q4 split across both cards as a day-one quality comparison"): Strata cannot run it (no dense
# family; strata-split needs one compute capability on every card), so the comparison runs on the pinned llama.cpp
# (ext/llama.cpp-3cf03257, built for sm_89 + sm_120): QUALITY ONLY, no speed claim. R, Q3 (the 5080 alone) and Q4 (a layer
# split, the 4060 Ti first) on the same engine; llama-perplexity's KL mode per text of the kit's 8 distinct texts
LCPP_KL = r'''
# ================================================================ before the gap (no GPU; 8080 untouched)
LCPP=@@LCPP@@                # llama-perplexity of the pinned llama.cpp (ext/llama.cpp-3cf03257), built for sm_89 + sm_120
TX=@@TEXTS@@; BASE=@@BASEDIR@@; LQ=$O/lcpp
arm() { prm "lq.arms.$1.$2"; }
start_attempt
need_files $LCPP $TX/texts.json @@SHARDS@@
for t in $(prm lq.texts); do need_files $TX/$t.txt; done
$P -I -B $Q4R lcppcheck $PRM > $PRE/lcpp.txt 2>&1 || { say "REFUSED: $(tail -1 $PRE/lcpp.txt) - not started"; exit 1; }
S=$O/summary.txt
mkdir -p $LQ $BASE
say "QWEN4 DAY ONE DENSE Q4-SPLIT QUALITY ($(basename $0)) ON llama.cpp, NOT STRATA (Strata runs no dense model; its split engine needs one GPU architecture): R = $(arm R label), Q3 = $(arm Q3 label) on the 5080 alone (the plan), Q4 = $(arm Q4 label) split across both cards - quality only, NO speed claim - measurements only, P028x stays served, nothing switches"
[ -n "$PREV" ] && say "an earlier attempt's outputs moved to $PREV"
gate rules INFO "q4_rules.py's docstring at the gap's start: gap-@@KIND@@/rules.txt sha $(sha12 $O/rules.txt)"
gate lcpp PASS "$(tail -1 $PRE/lcpp.txt | cut -c1-200)"
watchdog() {   # watchdog JOB MINUTES NAME: a run past MINUTES (3 x its estimate) is hung - stop its process by PID
  local j=$1 m=$2 n=$3 t p q
  t=$(( $(date +%s) + m * 60 ))
  while kill -0 $j 2> /dev/null; do
    if [ $(date +%s) -ge $t ]; then
      for p in $( { for x in $ENGINES; do pgrep -x $x; done; } | sort -un); do
        q=$p; while [ -n "$q" ] && [ "$q" -gt 1 ] && [ "$q" != $j ]; do q=$(ppid_of $q); done
        [ "$q" = $j ] && kill -TERM $p 2> /dev/null && echo "watchdog: $n ran past $m min - its process (pid $p) was stopped" >> $O/$n.watchdog
      done
      return 0
    fi
    sleep 5
  done
}
lrun() {   # lrun ARM TEXT base|kld: one llama-perplexity run (R saves its log-probs; Q3 / Q4 are scored against them),
  # memory-guarded as the kit's quality arms (Karl 11-05: wait for memory first, abort cleanly rather than swap)
  local a=$1 t=$2 m=$3 c need mn jp mw wd rc extra
  c=$(prm lq.ctx.$t); need=$(arm $a memneed); mn=$(arm $a min)
  fits $mn || { say "skipped $a / $t ($mn min do not fit before the deadline, or a kernel check)"; return 1; }
  if ! $P -I -B $Q4R memwait --need-gib $need --max-s 120 --gate mem_${a}_$t --gates $G 8>&- 9>&- 2>&1 | tail -1 | tee -a $S; then
    gate run_${a}_$t FAIL "aborted: memory (not started: MemAvailable below $need GiB after 120 s)"; kc $a-$t; return 1
  fi
  extra="--kl-divergence-base $BASE/$t.kld"; [ $m = kld ] && extra="$extra --kl-divergence"
  say "llama-perplexity $a / $t ($m, -c $c, ~$mn min)"
  rm -f $LQ/$a-$t.rc $LQ/$a-$t.aborted $O/$a-$t.watchdog
  ( CUDA_VISIBLE_DEVICES=$(arm $a cvd) $P $LIB/guard.py q4lcpp-$SHORT-$a-$t -- $LCPP -m $(arm $a gguf) -f $TX/$t.txt -c $c --chunks 1 -b 2048 -ngl $(arm $a ngl) $(arm $a split) -fa on -ctk q8_0 -ctv q8_0 $extra > $LQ/$a-$t.txt 2>&1; echo $? > $LQ/$a-$t.rc ) 8>&- 9>&- &
  jp=$!
  watchdog $jp $(( 3 * mn )) $a-$t 8>&- 9>&- &
  wd=$!
  $P -I -B $Q4R memwatch $jp --names "$ENGINES" --floor-gib 12 --margin-gib 1 --swap-pages 1024 --out $LQ/$a-$t.aborted \
    --gate memw_${a}_$t --gates $G > $LQ/$a-$t.memwatch.txt 2>&1 8>&- 9>&- &
  mw=$!
  wait $jp
  kill $wd 2> /dev/null; wait $wd 2> /dev/null
  wait $mw 2> /dev/null
  [ -f $O/$a-$t.watchdog ] && say "  $(cat $O/$a-$t.watchdog)"
  rc=$(cat $LQ/$a-$t.rc 2> /dev/null || echo none)
  if [ -f $LQ/$a-$t.aborted ]; then gate run_${a}_$t FAIL "$(cut -c1-250 $LQ/$a-$t.aborted)"
  elif [ "$rc" = 0 ] && { [ $m = base ] || grep -q "Mean    KLD:" $LQ/$a-$t.txt; }; then gate run_${a}_$t PASS "rc 0 ($m, -c $c)"
  else gate run_${a}_$t FAIL "rc $rc: $(grep -iE 'error|failed' $LQ/$a-$t.txt | head -2 | tr '\n' ' ' | cut -c1-200)"; fi
  kc $a-$t
}
decide() { $P -I -B $Q4R lcppdecide $PRM --dir $LQ --gates $G --out $O 8>&- 9>&- | tail -4 | tee -a $S; cp $O/decision-q4split.txt $R/decision-q4split.txt 2> /dev/null; true; }
after_gap() { :; }

# ================================================================ the gap
open_gap "Qwen4 day one $NAME dense Q4-split quality on llama.cpp (dayone.py: R, Q3 on the 5080 alone, Q4 across both cards; quality only, measurements only, P028x stays served, nothing switches)"
kc open || close_gap
say "1 the files: every listed shard re-hashed against its pin, then evicted"
if [ "$(prm dl.n)" -gt 0 ]; then rehash_all || { say "a shard does not hash to its pin: nothing runs on it, the gap ends"; close_gap; }; fi
evict_all start
kc files || close_gap
say "2 per text: R saves its log-probabilities, Q3 and Q4 are scored against them; one base file (<= ~4 GB) at a time"
for t in $(prm lq.texts); do
  ok_to_go || break
  lrun R $t base
  if [ "$(gstat run_R_$t)" = PASS ]; then lrun Q3 $t kld; lrun Q4 $t kld; fi
  rm -f $BASE/$t.kld
done
close_gap
'''

STEPS["lcpp_kl"] = """# Steps (Karl 11-06: the dense 27B's Q4 split as a day-one QUALITY comparison; q4_rules.py DENSE Q4 SPLIT):
#   0 before the gap - REFUSES (exit 1) unless the preflight, the kernel watcher, the verified downloads (R, Q3, Q4), the
#     pinned llama.cpp's llama-perplexity built for sm_89 + sm_120 and knowing the file's architecture (lcppcheck), the texts
#   1 port_gap4.sh begin; re-hash; evict
#   2 per text of the kit's 8 distinct texts (-c = min(32768, its length / 2), the second half of that chunk scored): R
#     (Q8_0-class, layers past the cards' room on the CPU) saves its log-probabilities; Q3 on the 5080 alone and Q4 split
#     across both cards (4060 Ti first) are scored against them; memwait / memwatch / watchdog on each run; the base file
#     is deleted after the text
#   3 q4_rules.py lcppdecide: per text mean KLD, 90 % KLD, changed top-1 (from 'Same top p'), Q4 against Q3 by
#     ud31_rules.py's own side() / metric_verdict() (KL > 1 counts: not in llama.cpp's output) -> decision-q4split.txt;
#     port_gap4.sh end. NO speed claim: llama.cpp is not Strata"""


def render(tpl, v):
    out = tpl
    for k, val in v.items():
        out = out.replace(f"@@{k}@@", str(val))
    left = re.findall(r"@@[A-Z_0-9]+@@", out)
    if left:
        raise SystemExit(f"template keys not filled: {sorted(set(left))}")
    return out


def write_driver(path, kind, v, label=None):
    """label (11-05e): the gap folder's name when the template key is not it (speed_ab -> speed-ab, exact_dense -> exact)"""
    body = {"exact": EXACT, "kl": KL, "speed": SPEED, "speed_ab": SPEED_AB, "exact_dense": EXACT_DENSE,
            "speed_dense": SPEED_DENSE, "exact_hcoff": EXACT_HCOFF, "lcpp_kl": LCPP_KL}[kind]
    v = dict(v)
    v["STEPS"] = render(STEPS[kind], v)
    v["KIND"] = label or kind
    v["FILE"] = Path(path).name
    txt = render(COMMON, v) + render(body, v)
    Path(path).write_text(txt)
    os.chmod(path, 0o644)
    r = subprocess.run(["bash", "-n", str(path)], capture_output=True, text=True)
    return {"path": str(path), "bash_n": "OK" if r.returncode == 0 else r.stderr.strip()[:300], "sha256": sha256_file(path)[:12],
            "ready_file": Path(str(path) + ".ready").exists()}


# =====================================================================================================================
# 7. the plan
# =====================================================================================================================
def slug(s, n=10):
    h = hashlib.sha1(s.encode()).hexdigest()[:4]
    return re.sub(r"[^a-z0-9]", "", s.lower())[:n - 4] + h


def dest_root_of(a, repo):
    """--dest-root DIR (every repo) or REPO=DIR (one repo); default models/<repo name> (11-05e: two publishers' repos)"""
    plain, per = None, {}
    for x in a.dest_root or []:
        k, sep, v = x.partition("=")
        if sep and "/" in k and not k.startswith("/"):
            per[k] = v
        else:
            plain = x
    return per.get(repo) or plain or str(WS / "models" / repo.split("/")[-1])


def plan(a):
    out = Path(a.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    tree = a.tree
    pref, pref_why = (prefer_default() if a.prefer == "auto" else (a.prefer, "set on the command line"))
    P = OrderedDict([("version", VERSION), ("when", now()), ("argv", sys.argv[1:]), ("out", str(out)),
                     ("prefer", {"setting": a.prefer, "used": pref, "why": pref_why})])
    # ---- 1 listings (11-05e item 1: a repo that is not published yet is recorded, not fatal)
    listings = {}
    for kv in a.listing or []:
        k, _, f = kv.partition("=")
        listings[k] = f
    lsts, cands, sidecars = [], [], []
    (out / "listing").mkdir(exist_ok=True)
    for spec in a.repo or []:
        repo, _, rev = spec.partition("@")
        lst = list_repo(repo, rev or "main", listings.get(repo), a.offline)
        if not lst.get("available", True):
            lsts.append({"repo": repo, "commit": None, "source": lst["source"], "tree_json": None, "quants": 0, "sidecars": 0,
                         "available": False, "http": lst.get("http"), "publisher": publisher_of(repo)})
            log(f"{repo}: NOT AVAILABLE ({lst['source']})")
            continue
        tp = out / "listing" / f"{repo.replace('/', '--')}@{lst['commit'][:12]}.json"
        tp.write_text(json.dumps(lst["entries"], indent=0))
        lst["tree_json"] = str(tp)
        dest_root = dest_root_of(a, repo)
        qs, side = quants_of(lst, dest_root)
        for q in qs:
            q["tree_json"] = str(tp)
        cands += qs
        sidecars += [dict(s, repo=repo) for s in side]
        lsts.append({k: lst[k] for k in ("repo", "commit", "source", "tree_json")} | {"quants": len(qs), "sidecars": len(side),
                                                                                    "available": True, "publisher": publisher_of(repo)})
        log(f"{repo}@{lst['commit'][:12]}: {len(qs)} model quants, {len(side)} side files ({lst['source']})")
    for l_ in a.local or []:
        cands.append(local_candidate(l_))
    P["listings"] = lsts
    P["sidecars"] = sidecars
    global P_SIDECARS
    P_SIDECARS = sidecars
    # ---- 2 headers (reuse, then the offline fetch test)
    hroot = Path(a.headers).resolve() if a.headers else out / "headers"
    for c in cands:
        c["hdr"] = header_state(c, hroot)
    if a.fetch_test:   # exercise the range-request header fetch on a local copy (offline): label=LOCAL_DIR
        lab, _, base = a.fetch_test.partition("=")
        q = next(c for c in cands if c["label"] == lab and c["source"] == "listed")
        tdir = SCRATCH["dir"] / "fetch-test"
        shutil.rmtree(tdir, ignore_errors=True)
        fetch_headers(q, tdir, base=base)
        same = []
        for f in q["files"]:
            got = tdir / f["path"]
            ref = hroot / f["path"]
            same.append((Path(f["path"]).name, got.exists() and ref.exists() and got.read_bytes() == ref.read_bytes(),
                         got.stat().st_size if got.exists() else None))
        P["fetch_test"] = {"label": lab, "base": base, "dest": str(tdir),
                           "files": [{"file": n, "identical_to_saved_header": s, "bytes": b} for n, s, b in same]}
        log(f"header fetch test ({lab} from {base}): " + ", ".join(f"{n} {'=' if s else 'DIFFERS'}" for n, s, _ in same))
    # ---- 2b the pack pre-check (11-05e item 2): the release tree's own iq_pack on every quant whose headers are here
    pk_tree = a.rel or a.tree
    pk_work = out / "precheck"
    if not a.no_precheck:
        for c in cands:
            if c["hdr"]["state"] in ("disk", "headers"):
                c["pack"] = pack_precheck(c, hroot, pk_tree, pk_work, offline=True)
                log(f"pack pre-check {c['label']} ({c['source']}): {c['pack']['verdict']} - {c['pack']['why'][:150]}")
    refused = lambda c: (c.get("pack") or {}).get("verdict") == "REFUSES"  # noqa: E731
    # ---- 2c the n-gram / Engram table's placement (11-05e item 3), explicit in the fit
    a._ngram = ngram_placement(a, cands)
    P["ngram"] = {k: v for k, v in a._ngram.items() if k != "day1_extra"}
    # ---- 3 day1 round 1
    ready = [c for c in cands if c["hdr"]["state"] in ("disk", "headers") and not refused(c)]
    files_at = [(Path(c["hdr"]["path"]).name, c["dest"]) for c in ready if c["hdr"]["state"] == "headers"]
    rep = run_day1([c["hdr"]["path"] for c in ready], out / "day1check", a.name, files_at, a, a._ngram["day1_extra"])
    by_path = {r["file"]: r for r in rep["files"]}
    for c in ready:
        c["rep"] = by_path.get(c["hdr"]["path"])
    estimates(cands, by_path)
    fitting = [c["rep"]["fit"]["experts_gib"] for c in ready if c.get("rep") and c["rep"].get("fit", {}).get("fits")
               and c["rep"]["verdict"] != "REFUSED"]
    room = min((c["rep"]["fit"]["room_total_gib"] for c in ready if c.get("rep") and c["rep"].get("fit")), default=72.0)
    want = [c for c in fetch_set(cands, max(fitting) if fitting else None, room) if not c.get("pack")]
    P["prescreen"] = {"room_gib": room, "best_exact_fit_gib": max(fitting) if fitting else None,
                      "fetch": [c["label"] for c in want], "offline": a.offline}
    if want and not a.offline:
        for c in want:
            # 11-05e: the pre-check's range reader (128 KiB up, appended) writes fetch_model's head format into the
            # headers folder, then iq_pack runs on the heads; a refused quant never reaches day1 or the download plan
            log(f"header fetch + pack pre-check: {c['repo']} {c['label']} ({len(c['files'])} shards)")
            c["pack"] = pack_precheck(c, hroot, pk_tree, pk_work, offline=False)
            c["hdr"] = header_state(c, hroot)
            log(f"  {c['label']}: {c['pack']['verdict']} - {c['pack']['why'][:150]}")
        a._ngram = ngram_placement(a, cands)
        P["ngram"] = {k: v for k, v in a._ngram.items() if k != "day1_extra"}
        ready = [c for c in cands if c["hdr"]["state"] in ("disk", "headers") and not refused(c)]
        files_at = [(Path(c["hdr"]["path"]).name, c["dest"]) for c in ready if c["hdr"]["state"] == "headers"]
        rep = run_day1([c["hdr"]["path"] for c in ready], out / "day1check", a.name, files_at, a, a._ngram["day1_extra"])
        by_path = {r["file"]: r for r in rep["files"]}
        for c in ready:
            c["rep"] = by_path.get(c["hdr"]["path"])
        for c in cands:
            c.pop("est", None)
        estimates(cands, by_path)
    # ---- 4 the pick (the pack pre-check's refusals are left out: Karl's rule falls to the next quant)
    cand_of = {c["hdr"]["path"]: c for c in ready}
    picks = []
    for pk in rep["picks"]:
        files, note = apply_prefer(pk, cand_of, pref, str(SERVED))
        best = by_path.get(pk["pick"], {}).get("fit", {}).get("experts_gib") if pk.get("pick") else None
        prov = [c for c in cands if c.get("est") and c["est"]["fits"] and best is not None and not refused(c)
                and c["est"]["experts_gib"] > best + a.tie_tol_gib]
        fell = [c for c in cands if refused(c) and c.get("est") and c["est"]["fits"] and best is not None
                and c["est"]["experts_gib"] > best + a.tie_tol_gib]
        picks.append({"group": pk["group"], "day1_pick": pk["pick"], "why": pk["why"].replace("**", ""), "tie": pk.get("tie"),
                      "prefer_note": note, "final": files,
                      "provisional": [{"label": c["label"], "repo": c["repo"], "est_experts_gib": round(c["est"]["experts_gib"], 2),
                                       "est_margin_gib": round(c["est"]["margin_gib"], 2), "bytes": c["bytes"]} for c in prov],
                      "pack_fell_through": [{"label": c["label"], "repo": c["repo"], "publisher": c["publisher"],
                                             "est_experts_gib": round(c["est"]["experts_gib"], 2),
                                             "refused": c["pack"]["why"], "cite": c["pack"].get("cite")} for c in fell]})
    P["candidates"] = [{"label": c["label"], "publisher": c["publisher"], "source": c["source"], "repo": c["repo"],
                        "bytes": c["bytes"], "shards": len(c["files"]), "header": c["hdr"]["state"], "header_why": c["hdr"]["why"],
                        "verdict": (c.get("rep") or {}).get("verdict"),
                        "experts_gib": round((c.get("rep") or {}).get("fit", {}).get("experts_gib", 0), 3) if c.get("rep") else None,
                        "fits": (c.get("rep") or {}).get("fit", {}).get("fits") if c.get("rep") else None,
                        "est": {k: (round(v, 2) if isinstance(v, float) else v) for k, v in c["est"].items()} if c.get("est") else None,
                        "pack": pack_summary(c.get("pack"))}
                       for c in cands]
    P["picks"] = picks
    if a.pick_only:
        return finish_plan(out, P)
    # ---- 5-9 per final file: slots, configs, disk, download, pack, params, drivers
    cal = served_calibration(tree, (by_path.get(str(SERVED)) or {}).get("fit", {}).get("room_main_gib"))
    P["slot_calibration"] = {"profile": cal["note"], "helper_today_gib": cal["helper_today_bytes"] / GIB,
                             "rows": {k: {x: v[x] for x in ("uniform_auto", "sized_auto", "pin", "sized_pin", "main_room_gib")}
                                      for k, v in cal["rows"].items()},
                             "logged": F1}
    helper_budget_today = cal["helper_today_bytes"]
    params_dir, cfg_dir, drv_dir = out / "drivers", out / "configs", out / "drivers"
    for d in (cfg_dir, drv_dir):
        d.mkdir(exist_ok=True)
    pieces = {}
    for f in (out / "day1check" / "day1").glob("params-*.json"):
        pj = json.loads(f.read_text())
        pieces[Path(pj["files"][0]).name] = (f.stem[len("params-"):], pj)
    P["files"] = []
    ref = None
    if a.kl_ref_gguf:
        ref = analyse_ref(a, out)
    for pk in picks:
        group_files = []
        for fpath in pk["final"]:
            c = cand_of.get(fpath)
            r = by_path.get(fpath)
            if c is None or r is None:
                continue
            served = Path(fpath).resolve() == SERVED.resolve()
            item = per_file(a, out, c, r, pieces.get(Path(fpath).name), served, helper_budget_today, ref)
            P["files"].append(item)
            group_files.append(item)
        # the KL driver covers the whole pick set of a group (a tie: every tied file; swap mode: + P)
        if group_files and not a.no_drivers:
            pk["kl_driver"] = kl_driver(a, out, group_files, ref, pk, tie=len(pk["final"]) > 1)
    return finish_plan(out, P)


def analyse_ref(a, out):
    rp = Path(a.kl_ref_gguf).absolute()   # not resolve(): an HF-cache file is a symlink to a blob named by its hash
    rep = run_day1([rp], out / "day1check-ref", f"{a.name}-R", [], argparse.Namespace(**{**vars(a), "no_swap": True}))
    r = rep["files"][0]
    m = header_model(str(rp), a.tree)
    ple = m.tensors.get("per_layer_token_embd.weight")
    return {"label": f"{classify(rp.name)[1]} (local: {rp.parent})", "paths": [s["path"] for s in r["shards"]],
            "ngram_path": r["shards"][ple.shard]["path"] if ple is not None else None,
            "experts_gib": r["fit"]["experts_gib"], "compat": r["need_compat_bf16"], "hcq8": "Q8_0" in hc_types(m),
            "verdict": r["verdict"], "tokens_sha": (r.get("tokenizer") or {}).get("tokens_sha"),
            "pack": str(WS / f"bringup/out/{a.name}-R/pack"), "out_type": (m.tensors.get("output.weight").tname
                                                                          if m.tensors.get("output.weight") else None),
            "day1": str(out / "day1check-ref")}


def per_file(a, out, c, r, piece, served, helper_today, ref):
    """one final file: the slot model, the finished config, disk / download / pack plans, the params, two drivers"""
    item = OrderedDict([("label", c["label"]), ("publisher", c["publisher"]), ("source", c["source"]), ("served", served),
                        ("verdict", r["verdict"]), ("experts_gib", r["fit"]["experts_gib"]),
                        ("room_gib", r["fit"]["room_total_gib"]),
                        ("margin_gib", r["fit"]["room_total_gib"] - r["fit"]["experts_gib"]),
                        # 11-05e: what the U-vs-ISTA comparison needs to rebuild this item from the saved plan (item 1)
                        ("header_path", c["hdr"]["path"]), ("room_ram_gib", r["fit"]["room_ram_gib"]),
                        ("tokens_sha", (r.get("tokenizer") or {}).get("tokens_sha")), ("shards", r.get("shards") and
                                                                                        [s["path"] for s in r["shards"]]),
                        ("pack_precheck", (c.get("pack") or {}).get("verdict"))])
    if served:
        item["note"] = "the served file: its config is configs/P028x.json (x28h in tests) - no new pieces"
        return item
    if piece is None:
        item["note"] = "day1.py wrote no pieces for it"
        return item
    name, d1p = piece
    item["name"] = name
    m = header_model(c["hdr"]["path"], a.tree)
    blobs, ne = blobs_of(m)
    swap = d1p.get("mode", "").startswith("same-model")
    d1cfg = json.loads((out / "day1check" / "day1" / f"{name}.json").read_text(), object_pairs_hook=OrderedDict)
    prof_path = argval(d1cfg["args"], "--expert-profile")
    pairs, pnote = read_profile(prof_path, len(blobs), ne)
    fit = r["fit"]
    main_b = fit["room_main_gib"] * GIB
    helper_room = (fit.get("room_helpers_gib") or [0])[0] * GIB
    pin = 2500 if swap else (d1p.get("exact7") or {}).get("PIN_CACHE")
    rule = a.helper_rule or ("today-count" if swap else "today-bytes")
    budget = {"today-bytes": min(helper_today, helper_room), "max": helper_room,
              "today-count": helper_room}[rule]
    s = slot_model(blobs, ne, pairs, main_b, budget, a.main_margin_mib * MIB, pin)
    s_today = slot_model(blobs, ne, pairs, main_b, min(helper_today, helper_room), a.main_margin_mib * MIB, None)["helper"]
    s_max = slot_model(blobs, ne, pairs, main_b, helper_room, a.main_margin_mib * MIB, None)["helper"]
    s["helper_by_rule"] = {"today-bytes": s_today, "max": s_max}
    tpl_h = argval(d1cfg["args"], "--expert-cache-device1")
    if rule == "today-count" and tpl_h and tpl_h.isdigit():
        # P028x's count kept when its bytes (this file's next ranks) fit the helper's room
        order = pairs if pairs else [(l, e) for e in range(ne) for l in blobs]
        hb = sum(blobs.get(l, s["max_blob"]) for l, _ in order[s["sized_cfg"]:s["sized_cfg"] + int(tpl_h)])
        s["helper_final"] = int(tpl_h) if hb <= helper_room else s["helper"]
        s["helper_note"] = (f"the template's count {tpl_h} kept: its {hb / GIB:.3f} GiB fit the 4060 Ti's {helper_room / GIB:.2f} GiB "
                            f"(rule today-count; today's 6.21 GiB would hold {s_today:,}, the room's maximum {s_max:,})" if hb <= helper_room else
                            f"the template's {tpl_h} would take {hb / GIB:.3f} GiB > the room: {s['helper']:,}")
    else:
        s["helper_final"] = s["helper"] if helper_room > 0 else None
        s["helper_note"] = (f"rule {rule}: the next ranks that fit {budget / GIB:.3f} GiB "
                            + ("(today's 3,300 x Flash-Next's blobs = the measured-safe helper bytes)" if rule == "today-bytes"
                               else "(the room: 7.56 GiB free - 512 MiB)") + f" -> {s['helper']:,} experts, {s['helper_gib']:.3f} GiB")
    s["profile_note"] = pnote
    hct = hc_types(m)
    hcq8 = "Q8_0" in hct
    hc_off = bool(getattr(a, "_hc_q8_off", False)) and hcq8
    cfg = finalize_config(d1cfg, s, hcq8, name, swap, rule, getattr(a, "_ngram", None), hc_off)
    cfg_p = out / "configs" / f"{name}.json"
    cfg_p.write_text(json.dumps(cfg, indent=1) + "\n")
    sh = out / "day1check" / "day1" / f"{name}.shared-settings.json"
    if sh.exists():
        shutil.copyfile(sh, out / "configs" / f"{name}.shared-settings.json")
    item["config"] = str(cfg_p)
    item["mode"] = "swap" if swap else "stock"
    item["slots"] = {k: v for k, v in s.items()}
    item["hc_types"], item["hc_q8"] = hct, hcq8
    # disk / download
    shards_final = d1p["files"]
    listed = c["source"] == "listed"
    todo = sum(f["size"] for f in c["files"]) if listed and c["hdr"]["state"] != "disk" else 0
    dense_pack = fit.get("dense_gpu_gib", 0) * GIB + 0.2 * GIB
    ref_pack = 4.5 * GIB if ref and not Path(ref["pack"], "index.txt").exists() else 0
    splice = (a.splice_gb or 0) * 1e9
    drafter = 0
    mtp = None
    if "--mtp" not in cfg.get("args", []):
        # QWEN4-DAY1-PLAN "Drafter fallback": the publisher's MTP GGUF (BF16: the only form that rebuilds our rt bit for
        # bit) -> work/qwen4-kit/mtp_from_gguf.py convert -> an rt dir; the config points at it, the drivers refuse
        # until it exists
        bf16 = [s_ for s_ in (P_SIDECARS or []) if s_["kind"] == "mtp" and "BF16" in s_["path"].upper()
                and s_["repo"] == c["repo"]]
        if bf16:
            mf = min(bf16, key=lambda x: x["size"])
            mdest = Path(c["dest"]).parent / "MTP"
            mpath = mdest / Path(mf["path"]).name
            here = mpath.exists() and mpath.stat().st_size == mf["size"] and sums_of(mdest).get(mpath.name) == mf["oid"]
            rt = WS / f"bringup/out/{name}/mtp-rt"
            drafter = (0 if here else mf["size"]) + 1.0e9
            args = cfg["args"]
            i = args.index("--prefill") + 2 if "--prefill" in args[:-1] else len(args)
            args[i:i] = ["--spec", "7", "--spec-min-p", "0.5", "--mtp", str(rt)]
            cfg["_dayone"]["drafter"] = (f"--spec 7 --spec-min-p 0.5 --mtp {rt}: converted from {mf['path']} (BF16, "
                                         f"{mf['size'] / 1e9:.2f} GB) by mtp_from_gguf.py - the drivers refuse until it exists")
            mtp = {"file": mf["path"], "size": mf["size"], "oid": mf["oid"], "dest": str(mdest), "here_verified": here,
                   "rt": str(rt),
                   "inspect": f"nice -n 19 {PY} -I -B {KIT}/mtp_from_gguf.py inspect {mpath}",
                   "convert": (f"bash {WS}/work/r23/nogap-run.sh {out}/drafter-{name}.log {PY} -I -B {KIT}/mtp_from_gguf.py "
                               f"convert {mpath} --out {rt}"),
                   "check": ("no reference rt for a new model: CHECK-PLAN.md's acceptance check (results/qwen4-kit/"
                             "mtp-fallback/, ~45 min with 8080 down) before trusting its speed numbers")}
            cfg_p.write_text(json.dumps(cfg, indent=1) + "\n")
        else:
            cfg["_dayone"]["drafter"] = "none: no --mtp and no BF16 MTP GGUF in the listing - --spec off, say so in the speed numbers"
            cfg_p.write_text(json.dumps(cfg, indent=1) + "\n")
    du = shutil.disk_usage(WS / "models")
    after = du.free - todo - dense_pack - ref_pack - splice - drafter
    item["disk"] = {"free_gb": round(du.free / 1e9, 1), "download_gb": round(todo / 1e9, 1), "pack_gb": round(dense_pack / 1e9, 1),
                    "ref_pack_gb": round(ref_pack / 1e9, 1), "splice_gb": round(splice / 1e9, 1),
                    "drafter_gb": round(drafter / 1e9, 1), "free_after_gb": round(after / 1e9, 1), "ok": after >= 100e9,
                    "floor_gb": 100}
    if mtp:
        item["drafter_fallback"] = mtp
    dl = {"n": 0, "items": []}
    if listed:
        paths = [f["path"] for f in c["files"]]
        gd = [str(PY), "-I", "-B", str(KIT / "gentle_dl.py"), "--tree", c["tree_json"], "--repo", c["repo"], "--commit",
              c["commit"], "--dest", c["dest"], "--rate", str(a.rate)]
        win = ["--window", a.window] + sum((["--gap-match", g] for g in a.gap_match or []), [])
        dl = {"n": 1, "items": [{"dest": c["dest"], "tree": c["tree_json"], "paths_csv": ",".join(paths)}]}
        if mtp:
            dl["n"] += 1
            dl["items"].append({"dest": mtp["dest"], "tree": c["tree_json"], "paths_csv": mtp["file"]})
            gm = [str(PY), "-I", "-B", str(KIT / "gentle_dl.py"), "--tree", c["tree_json"], "--repo", c["repo"], "--commit",
                  c["commit"], "--dest", mtp["dest"], "--rate", str(a.rate)]
            mtp["download"] = " ".join(shlex.quote(x) for x in gm + ["--window", a.window]
                                       + sum((["--gap-match", g] for g in a.gap_match or []), []) + [mtp["file"]])
        pr = subprocess.run(gd + ["--plan"] + paths, capture_output=True, text=True)
        item["download"] = {"plan_rc": pr.returncode, "plan": pr.stdout.strip().splitlines()[:-1],
                            "command": " ".join(shlex.quote(x) for x in gd + win + paths),
                            "unit": (f"systemd-run --user --unit {name}-download --collect -p MemoryHigh=2G -p Nice=19 "
                                     + " ".join(shlex.quote(x) for x in gd + win + paths)),
                            "window": a.window, "gap_match": a.gap_match or [],
                            "note": ({"measure": "Karl 11-05: starts at once, pauses only while a gap is open (measuring) and "
                                                 "resumes when it closes; no fixed cap - while an LDR run holds bench.lock it "
                                                 "leaves 25 % of the measured line (35 MB/s before a measurement)",
                                      "gap": "--window gap (the 11-04 rule) needs --gap-match (a NON-TIMED gap's hold text)",
                                      "any": "--window any: never pauses"}[a.window])}
    else:
        item["download"] = {"note": "a local file: nothing to download (not pinned: no listing)"}
    # pack
    rel_tree = Path(a.rel or a.tree)
    pack_dir = WS / f"bringup/out/{name}/pack"
    ggpy = (rel_tree / "third_party/llama.cpp/gguf-py") if (rel_tree / "third_party/llama.cpp/gguf-py").exists() else \
        WS / "strata/third_party/llama.cpp/gguf-py"
    pk_cmd = (f"env PYTHONDONTWRITEBYTECODE=1 STRATA_GGUF_PY={ggpy} {PY} -I -B {rel_tree}/tools/iq_pack.py --gguf {shards_final[0]} "
              f"--out {pack_dir}" + (" --compat-bf16" if r["need_compat_bf16"] else ""))
    item["pack"] = {"dir": str(pack_dir), "compat_bf16": r["need_compat_bf16"],
                    "maybe_compat": r.get("maybe_compat_bf16"),
                    "command": f"bash {WS}/work/r23/nogap-run.sh {out}/pack-{name}.log {pk_cmd}",
                    "est_gb": round(dense_pack / 1e9, 1), "exists": (pack_dir / "native_experts.txt").exists()}
    # params for the drivers
    ctx_ratio = max(1.0, ((fit.get("tiers") or {}).get("compute_ratio") or 1.0))
    mins = {k: math.ceil(v * ctx_ratio) for k, v in MIN.items()}
    ngpu = len([x for x in (cfg.get("env", {}).get("CUDA_VISIBLE_DEVICES") or "").split(",") if x]) or 1
    exe = cfg.get("exe", "")
    short = slug(name)
    prm = OrderedDict([
        ("version", VERSION), ("name", name), ("label", c["label"]), ("mode", item["mode"]), ("config", str(cfg_p)),
        ("config_sha256", {str(cfg_p): sha256_file(cfg_p)}), ("exe", exe), ("ngpu", ngpu), ("files", shards_final),
        ("pack", str(pack_dir)), ("hc_q8", hcq8), ("hc_q8_switch", ("off" if hc_off else "on") if hcq8 else None),
        ("prompt_dir", d1p["prompts"]["dir"]),
        ("retok_needed", d1p["prompts"]["retok_needed"]), ("pin", pin),
        ("slots", {"main": s["sized_cfg"], "main_uniform": s["uniform_cfg"], "pin_sized": s.get("sized_pin"),
                   "helper": s.get("helper_final")}),
        ("dl", dl), ("drafter_rt", (mtp or {}).get("rt")), ("minutes", mins), ("target", [40, 60])])
    prm_p = out / "drivers" / f"params-{name}.json"
    prm_p.write_text(json.dumps(prm, indent=1) + "\n")
    item["params"] = str(prm_p)
    item["minutes"] = mins
    item["_prm"] = prm
    item["_c"] = c
    item["_ref"] = ref
    if a.no_drivers:
        return item
    tree_rel = str(rel_tree)
    base_v = {"VERSION": VERSION, "WHEN": now(), "NAME": name, "LABEL": c["label"], "SHORT": short,
              "MODE": "same-model swap of the served file" if swap else "a new model (stock config)", "MODE_KEY": item["mode"],
              "PARAMS": str(prm_p), "CFG": str(cfg_p), "EXE": exe, "NGPU": ngpu, "TREE": tree_rel,
              "ENGINES": " ".join(dict.fromkeys(["strata", "strata-host", "strata-vision", "strata-dsv41", "llama-server",
                                                  "ollama"] + ([Path(exe).name[:15]] if exe and not exe.startswith("<") else []))),
              "RESULTS": str(out / "gaps" / name), "PROMPT_DIR": d1p["prompts"]["dir"], "EVICT": " ".join(shards_final),
              "SHARDS": " ".join(shards_final), "PACK": str(pack_dir), "PIN": pin,
              "E7REF": "x28h-e7a" if swap else "c13", "E7REF_WHAT": "against P028x's x28h-e7a, INFO" if swap else
              "the first run: exact7.sh's built-in C*13 hashes as its INFO line only (new weights: X2 against X1 is the test)",
              "PRED_MAIN": s["sized_cfg"], "PRED_PIN": s.get("sized_pin") or 0,
              "DRAFTER": (f"{mtp['rt']}/dense.txt {mtp['rt']}/experts.bin" if mtp else ""),
              "PRED_HELPER_ARG": f"--helper {s['helper_final']}" if s.get("helper_final") else "",
              "E7_MIN": mins["e7"], "SMOKE_MIN": mins["smoke"], "SCR_MIN": mins["scr"], "TARGET": "40,60",
              "KLDATA": "-", "STARTQ": (f"$P -I -B $KR/g17_rules.py startlines base $SPD/Q1.startlog $(slog q4-$SHORT-Q1) --gate start_Q --gates $G 8>&- 9>&- | tee -a $S"
                                        if swap else "$P -I -B $Q4R startcheck $SPD/Q1.startlog $(slog q4-$SHORT-Q1) --gate start_Q --gates $G 8>&- 9>&- | tee -a $S"),
              "STARTQ_WHAT": "g17 base (the series' switches apply)" if swap else "q4_rules startcheck (unwanted lines only; the series' switches are off by design)"}
    if base_v["EXE"].startswith("<"):
        base_v["EXE"] = shlex.quote(exe)
    item["drivers"] = {}
    for kind, maxm in (("exact", 6 + 2 * mins["e7"] + mins["smoke"] + 8), ("speed", 6 + 6 * mins["scr"] + 8)):
        v = dict(base_v, MAXM=maxm, WHAT={"exact": "the EXACTNESS SMOKE", "speed": "the SPEED SCREEN"}[kind]
                 + f" of {name}")
        if kind == "speed":   # with_server.sh evicts both arms' files before each start (cold page cache)
            v["EVICT"] = " ".join(shards_final + [str(SERVED.parent / "*.gguf")])
        item["drivers"][kind] = write_driver(out / "drivers" / f"gap-{name}-{kind}.sh", kind, v)
    return item


P_SIDECARS: list = []


def kl_driver(a, out, items, ref, pk, tie=False, name=None, no_base=False, force_base=False):
    """name / no_base / force_base (11-05e, item 1): the U-vs-ISTA comparison names its own driver; two new files get
    no P base (the pair verdict); a new file against the served one gets P (x28h) as its base whatever its mode"""
    items = [x for x in items if x.get("name")]
    if not items:
        return None
    swap = all(x["mode"] == "swap" for x in items)
    name = name or (items[0]["name"] if len(items) == 1 else f"{a.name}-tie")
    data = a.kl_data
    if data == "auto":
        data = "dump" if swap and ref and ref.get("out_type") in ("Q6_K", "Q8_0") else "pfy"
    cands = [f"X{i + 1}" for i in range(len(items))] if len(items) > 1 else ["X"]
    base = "P" if (swap or force_base) and not no_base else ""
    arms = (["P"] if base else []) + cands + ["R"]
    cfg = {x: it["config"] for x, it in zip(cands, items)}
    pack = {x: it["pack"]["dir"] for x, it in zip(cands, items)}
    exe = {x: it["_prm"]["exe"] for x, it in zip(cands, items)}
    ngpu = {x: it["_prm"]["ngpu"] for x, it in zip(cands, items)}
    mins = items[0]["minutes"]
    mn = {x: mins["q" if data == "dump" else "pfy"] for x in cands}
    if base:
        cfg["P"], pack["P"], exe["P"], ngpu["P"], mn["P"] = str(X28H), str(WS / "bringup/out/r20a/pack"), \
            str(WS / "engine-r22p028x/strata"), 2, mins["q" if data == "dump" else "pfy"]
    ref_note = None
    if ref:
        rcfg = ref_config(json.loads(Path(items[0]["config"]).read_text(), object_pairs_hook=OrderedDict), ref, name,
                          items[0]["_c"]["rep"]["fit"]["room_ram_gib"], a.ref_resident_margin_gib)
        rp = out / "configs" / f"{name}-R.json"
        rp.write_text(json.dumps(rcfg, indent=1) + "\n")
        cfg["R"], pack["R"], exe["R"], ngpu["R"] = str(rp), ref["pack"], rcfg["exe"], 1
        mn["R"] = mins["qr" if data == "dump" else "pfyr"]
        bigger = all(ref["experts_gib"] > it["experts_gib"] for it in items)
        same_tok = all(ref["tokens_sha"] == (it["_c"]["rep"].get("tokenizer") or {}).get("tokens_sha") for it in items)
        ref_note = {"label": ref["label"], "experts_gib": ref["experts_gib"], "larger_than_every_candidate": bigger,
                    "same_vocabulary": same_tok, "config": str(rp), "pack": ref["pack"], "pack_compat_bf16": ref["compat"],
                    "pack_command": (f"bash {WS}/work/r23/nogap-run.sh {out}/pack-{name}-R.log env PYTHONDONTWRITEBYTECODE=1 "
                                     f"STRATA_GGUF_PY={WS / 'strata/third_party/llama.cpp/gguf-py'} {PY} -I -B "
                                     f"{Path(a.rel or a.tree)}/tools/iq_pack.py --gguf {ref['paths'][0]} --out {ref['pack']}"
                                     + (" --compat-bf16" if ref["compat"] else "")),
                    "hc_q8": ref["hcq8"], "data": data}
    else:
        cfg["R"], pack["R"], exe["R"], ngpu["R"], mn["R"] = "<SET: --kl-ref-gguf / --kl-ref-config>", "<SET>", "<SET>", 1, mins["qr"]
    tags = [x for x, it in zip(cands, items) if it["hc_q8"] and it["pack"]["compat_bf16"]]
    if ref and ref["hcq8"] and ref["compat"]:
        pass   # R's own rounding sits on R's side of every KL row (ud31_rules.py: noted, not a tag on a candidate)
    # the KL params: the first item's params + kl.* (one file the driver reads)
    prm = json.loads(json.dumps(items[0]["_prm"]))
    prm["config_sha256"] = {it["config"]: sha256_file(it["config"]) for it in items}
    if ref:
        prm["config_sha256"][cfg["R"]] = sha256_file(cfg["R"])
    prm["dl"] = {"n": sum(it["_prm"]["dl"]["n"] for it in items),
                 "items": [x for it in items for x in it["_prm"]["dl"]["items"]]}
    room_ram = items[0]["_c"]["rep"]["fit"]["room_ram_gib"]
    need = {x: round(min(it["experts_gib"], room_ram) + 18.0, 1) for x, it in zip(cands, items)}
    if base:
        need["P"] = round(46.84 + 18.0, 1)
    need["R"] = round((int(room_ram - a.ref_resident_margin_gib) if ref and ref["experts_gib"] > room_ram
                       else (ref or {}).get("experts_gib", room_ram)) + 18.0, 1)
    prm["kl"] = {"data": data, "cands": cands, "base": base or None, "arms": arms, "cfg": cfg, "pack": pack, "exe": exe,
                 "ngpu": ngpu, "min": mn, "memneed": need,
                 "memneed_why": "experts held in RAM (R: its --resident-budget-gib) + the 12 GiB floor + 6 GiB for the engine's other host memory", "ref_label": ref["label"] if ref else "<none named>",
                 "published": a.kl_published or "none recorded (the publisher's KLD table: record its number and source)",
                 "tag_pack": tags, "files": {x: it["label"] for x, it in zip(cands, items)}}
    prm_p = out / "drivers" / f"params-{name}-kl.json"
    prm_p.write_text(json.dumps(prm, indent=1) + "\n")
    maxm = 6 + sum(mn.values()) + mins["cmp"] + 8
    it0 = items[0]
    shards = " ".join(sorted({s for it in items for s in it["_prm"]["files"]} | (set(ref["paths"]) if ref else set())))
    evict = shards + (" " + str(SERVED.parent / "*.gguf") if base else "")
    v = {"VERSION": VERSION, "WHEN": now(), "NAME": name, "LABEL": ", ".join(it["label"] for it in items), "SHORT": slug(name),
         "MODE": ("same-model swap" if swap else "a new model") + f"; data {data}", "MODE_KEY": "swap" if swap else "stock",
         "PARAMS": str(prm_p), "CFG": it0["config"], "EXE": shlex.quote(it0["_prm"]["exe"]), "NGPU": it0["_prm"]["ngpu"],
         "TREE": str(Path(a.rel or a.tree)), "ENGINES": "strata strata-host strata-vision strata-dsv41 llama-server ollama",
         "RESULTS": str(out / "gaps" / name), "PROMPT_DIR": it0["_prm"]["prompt_dir"], "EVICT": evict, "SHARDS": shards,
         "MAXM": maxm, "WHAT": f"QUALITY - {', '.join(cands)} against the named local reference R",
         "KLDATA": data, "KLDATA_WHAT": "score.py run --set long11 --rows all:8, every 8th prompt row of 11 long texts"
         if data == "dump" else "pf_yardstick long40 through day1.py pfy PROMPT_DIR, the engine's own logits after 40 cuts",
         "ROWS_WHAT": "validate per arm with its own head, the head check on P, ud31_rules.py compare" if data == "dump"
         else "q4_rules.py pfyrows: KL(R || X), changed top-1, the next token's NLL per cut",
         "CANDS": " ".join(cands), "BASE": base or "none", "ARMS": " ".join(arms), "CMP_BASE": base or cands[0],
         "KLD_BASE": ("--base P" if base else "") + (" --tie" if tie else ""),
         "KLD_TAG": f"--tag-pack {','.join(tags)}" if tags else "",
         "CMP_MIN": mins["cmp"]}
    d = write_driver(out / "drivers" / f"gap-{name}-kl.sh", "kl", v)
    d["params"] = str(prm_p)
    d["reference"] = ref_note
    d["arms"] = {x: (prm["kl"]["files"].get(x) or ("P028x (x28h)" if x == "P" else (ref or {}).get("label", "R: NONE NAMED")))
                 for x in arms}
    return d


def finish_plan(out, P):
    def clean(x):
        if isinstance(x, dict):
            return {k: clean(v) for k, v in x.items() if not str(k).startswith("_")}
        if isinstance(x, list):
            return [clean(v) for v in x]
        if isinstance(x, float):
            return round(x, 4)
        return x
    P = clean(P)
    (out / "plan.json").write_text(json.dumps(P, indent=1, default=str) + "\n")
    (out / "PLAN.md").write_text(plan_md(P))
    log(f"plan: {out / 'plan.json'}, {out / 'PLAN.md'}")
    return P


def plan_md(P):
    L = []
    w = L.append
    w(f"# Day-one plan ({P['when']}, {P['version']})")
    w("")
    w(f"`dayone.py {' '.join(shlex.quote(x) for x in P['argv'])}`")
    w("")
    w("No GPU, no engine run, nothing downloaded or packed by `plan`. Each step below runs on its own "
      "(`dayone.py execute STEP --plan ...`), after Karl's go.")
    w("")
    w("## Listing and candidates")
    w("")
    for l_ in P.get("listings", []):
        if not l_.get("available", True):
            w(f"- `{l_['repo']}`: **NOT AVAILABLE** ({l_['source']})")
            continue
        w(f"- `{l_['repo']}` at commit `{l_['commit']}` ({l_['source']}): {l_['quants']} model quants, {l_['sidecars']} side files")
    w("")
    w("| quant | publisher | source | GB | header | pack pre-check (iq_pack) | verdict | experts GiB | fits | estimate (no header) |")
    w("|---|---|---|---|---|---|---|---|---|---|")
    for c in sorted(P["candidates"], key=lambda c: -(c["experts_gib"] or (c["est"] or {}).get("experts_gib") or 0)):
        e = c["est"]
        pk_ = c.get("pack") or {}
        pcol = (f"{pk_.get('verdict')}: {pk_.get('why', '')[:90]}" if pk_ else "-").replace("|", "/")
        w(f"| {c['label']} | {c['publisher']} | {c['source']} | {c['bytes'] / 1e9:.1f} | {c['header']} | {pcol} | {c['verdict'] or '-'} | "
          f"{c['experts_gib'] if c['experts_gib'] is not None else '-'} | {c['fits'] if c['fits'] is not None else '-'} | "
          + (f"{e['experts_gib']} GiB, {'fits' if e['fits'] else 'over'} (margin {e['margin_gib']}; from {e['from']})" if e else "-") + " |")
    w("")
    ng = P.get("ngram")
    if ng:
        w(f"n-gram / Engram table (item 3): **{ng['placement'].upper()}** - {ng['why']}")
        w("")
    ps = P.get("prescreen", {})
    w(f"Pre-screen: room {ps.get('room_gib', 0):.2f} GiB, the largest header-read fit {ps.get('best_exact_fit_gib')} GiB; headers "
      f"to read before trusting the pick: {', '.join(ps.get('fetch') or []) or 'none'}"
      + (" (offline: not fetched)" if ps.get("offline") and ps.get("fetch") else ""))
    if P.get("fetch_test"):
        ft = P["fetch_test"]
        w("")
        w(f"Header fetch path exercised offline on {ft['label']} (range reads from `{ft['base']}`): "
          + ", ".join(f"{x['file']} {'identical to the saved header' if x['identical_to_saved_header'] else 'DIFFERS'}" for x in ft["files"]))
    w("")
    w(f"## The pick (--prefer {P['prefer']['setting']} -> {P['prefer']['used']}: {P['prefer']['why']})")
    w("")
    for pk in P["picks"]:
        w(f"- group {pk['group'][:3]}: {pk['why']}")
        w(f"  - {pk['prefer_note']}; final: {', '.join(Path(f).name for f in pk['final']) or 'none'}")
        pvs = sorted(pk.get("provisional") or [], key=lambda x: -x["est_experts_gib"])
        if pvs:
            top = pvs[0]
            w(f"  - **PROVISIONAL - the rule's pick by size would be `{top['label']}`** ({top['repo']}): about "
              f"{top['est_experts_gib']} GiB of experts by the size estimate, margin {top['est_margin_gib']} GiB"
              + (" (TIGHT)" if top["est_margin_gib"] < 2 else "") + "; its header must be read (a live `plan` fetches it; "
              "offline it was not) before the pick above stands. Also larger than the header-read pick: "
              + (", ".join(f"`{x['label']}` (~{x['est_experts_gib']} GiB)" for x in pvs[1:]) or "none"))
        for x in pk.get("pack_fell_through") or []:
            w(f"  - **fell to the next quant (the pack pre-check):** `{x['label']}` ({x['publisher']}, ~{x['est_experts_gib']} GiB of "
              f"experts, would fit) - {x['refused']}")
        if pk.get("kl_driver"):
            k = pk["kl_driver"]
            w(f"  - KL driver `{Path(k['path']).name}` (bash -n {k['bash_n']}; arms {k['arms']}; reference "
              f"{(k['reference'] or {}).get('label', 'NONE NAMED')})")
    w("")
    if P.get("slot_calibration"):
        sc = P["slot_calibration"]
        w("## Slot model calibration (the served file, F1-frame-pools.md's logged numbers)")
        w("")
        for k, v in sc["rows"].items():
            w(f"- {k}: room {v['main_room_gib']:.3f} GiB -> uniform {v['uniform_auto']:,}, sized {v['sized_auto']:,} "
              f"(logged 3,526 / 4,583); pin {v['pin']} -> {v['sized_pin']:,} (logged 3,238)")
        w(f"- the 4060 Ti's 3,300 today = {sc['helper_today_gib']:.4f} GiB (F1: 6.206 GiB)")
        w("")
    for it in P.get("files", []):
        w(f"## {it.get('name') or it['label']}")
        w("")
        if it.get("note"):
            w(f"- {it['note']}")
            w("")
            continue
        s = it["slots"]
        w(f"- {it['label']} ({it['publisher']}, {it['source']}), {it['mode']} mode; {it['verdict']}; experts {it['experts_gib']:.2f} "
          f"GiB in {it['room_gib']:.2f} GiB of room (margin {it['margin_gib']:.2f})")
        w(f"- config `{it['config']}`: --expert-cache {s['uniform_cfg']:,} (expected {s['sized_cfg']:,} slots; auto would be "
          f"{s['uniform_auto']:,} / {s['sized_auto']:,}), --expert-cache-device1 {s.get('helper_final')} ({s.get('helper_note')}); "
          f"{s['profile_note']}; HC types {it['hc_types']}{' -> STRATA_HC_Q8=1' if it['hc_q8'] else ''}")
        dk = it["disk"]
        w(f"- disk: {dk['free_gb']} GB free - download {dk['download_gb']} - pack {dk['pack_gb']} - reference pack "
          f"{dk['ref_pack_gb']} - splice {dk['splice_gb']} - drafter {dk['drafter_gb']} = **{dk['free_after_gb']} GB** after "
          f"(floor 100: {'OK' if dk['ok'] else 'FAILS - freeing space is Karl decision'})")
        if it.get("drafter_fallback"):
            df = it["drafter_fallback"]
            w(f"- drafter fallback (no --mtp given): `{df['file']}` ({df['size'] / 1e9:.2f} GB, BF16; "
              f"{'here, verified' if df['here_verified'] else 'to download: ' + df['download']}) -> `{df['rt']}`; the config "
              f"carries --spec 7 --spec-min-p 0.5 --mtp to it and the drivers refuse until it exists. Steps: `{df['inspect']}`; "
              f"`{df['convert']}`; then {df['check']}")
        dl = it.get("download", {})
        if dl.get("command"):
            w(f"- download (plan, rc {dl['plan_rc']}): " + "; ".join(dl["plan"][-1:]))
            w(f"  - `{dl['command']}`" + (f"  ({dl['note']})" if dl.get("note") else ""))
        else:
            w(f"- download: {dl.get('note')}")
        pkk = it["pack"]
        w(f"- pack ({'--compat-bf16' if pkk['compat_bf16'] else 'no --compat-bf16'}; ~{pkk['est_gb']} GB; "
          f"{'exists' if pkk['exists'] else 'not made yet'}): `{pkk['command']}`")
        for kind, d in (it.get("drivers") or {}).items():
            w(f"- driver {kind}: `{d['path']}` (bash -n {d['bash_n']}; .ready file: {'PRESENT' if d['ready_file'] else 'none'})")
        w(f"- params: `{it['params']}`; minutes {it['minutes']}")
        w("")
    return "\n".join(L) + "\n"


# =====================================================================================================================
# 9. the pack pre-check (Karl 11-05 item 2): the release tree's own iq_pack on the HEADERS, before any full download
# =====================================================================================================================
HEAD_FIRST, HEAD_MAX = 128 << 10, 64 << 20
_FM: dict = {}


def fm():
    if "m" not in _FM:
        _FM["m"] = load("fetch_model", WS / "bringup/fetch_model.py")
    return _FM["m"]


def head_local(p):
    """(header bytes, the file's real size) of a local shard: a whole file, or a head-only file with NAME.size"""
    s = D1.read_shard(Path(p), 0)
    with open(p, "rb") as f:
        return f.read(s["header_end"]), s["size"]


def head_hf(repo, commit, path, size, dest):
    """One shard's header by HTTP range requests: bringup/fetch_model.py read_range (a 206 with the asked Content-Range,
    else nothing - a server that ignores Range is never read whole, #327), from 128 KiB up, doubling and APPENDED (no
    byte is read twice; 64 MiB at most), until day1's reader parses it. Saved as DEST/<path> + .size (fetch_model's head
    format: header_state and day1 read it like the real file). Returns (header bytes, bytes fetched). A refusal (HTTP
    403 / 429 ...) is raised, never retried another way."""
    url = f"https://huggingface.co/{repo}/resolve/{commit}/{path}"
    out = Path(dest) / path
    out.parent.mkdir(parents=True, exist_ok=True)
    tmp = out.with_name(out.name + ".head-part")
    data, want, s = b"", HEAD_FIRST, None
    try:
        while True:
            end = min(want, size)
            if len(data) < end:
                more, total = fm().read_range(url, len(data), end - 1)
                if total is not None and total != size:
                    raise OSError(f"{path}: the server says {total:,} bytes, the pin {size:,}")
                data += more
            tmp.write_bytes(data)
            try:
                s = D1.read_shard(tmp, 0)
                break
            except D1.Truncated:
                if len(data) >= min(HEAD_MAX, size):
                    raise
                want *= 2
                time.sleep(0.2)
    finally:
        tmp.unlink(missing_ok=True)
    head = data[:s["header_end"]]
    out.write_bytes(head)
    Path(str(out) + ".size").write_text(f"{size}\n")
    return head, len(data)


def pack_precheck(c, hroot, tree, work, offline=True):
    """Karl 11-05 item 2 on one quant c (quants_of / local_candidate). Every shard's header from, in order: the file at
    its destination at the pinned size (a finished download), a saved head under the headers folder (NAME + NAME.size),
    a head-only local file (local candidates), else Hugging Face range requests at the pinned commit (not --offline).
    Then the release tree's OWN tools/iq_pack.py runs on sparse stand-ins (each shard = its header bytes, cut to its real
    size: a hole, no disk) in its own process (dayone.py _packcheck): ACCEPTS / REFUSES (iq_pack's own message and the
    source line that writes it) / NOT CHECKED (why). The stand-ins are deleted; the heads fetched stay as headers."""
    res = OrderedDict([("label", c["label"]), ("publisher", c["publisher"]), ("source", c["source"]), ("tree", str(tree)),
                       ("verdict", "NOT CHECKED"), ("why", ""), ("shards", []), ("fetched_bytes", 0)])
    sd = Path(work) / slug(f"{c.get('repo')}-{c.get('commit')}-{c['label']}-{c['shard1']}", 20)
    shutil.rmtree(sd, ignore_errors=True)
    sd.mkdir(parents=True, exist_ok=True)
    heads = []
    try:
        for f in c["files"]:
            name, size = Path(f["path"]).name, f["size"]
            places = [("local file", Path(f["path"]))] if c["source"] == "local" else \
                [("download", Path(c["dest"]) / name)] + ([("saved head", Path(hroot) / f["path"])] if hroot else [])
            got = None
            for how, p in places:
                if not p.exists():
                    continue
                szf = Path(str(p) + ".size")
                real = int(szf.read_text().split()[0]) if szf.exists() else p.stat().st_size
                if size is not None and real != size:   # a partial download, or another file of that name
                    continue
                try:
                    hb, real = head_local(p)
                except (OSError, ValueError) as e:
                    res["shards"].append({"name": name, "from": how, "where": str(p), "error": str(e)[:200]})
                    continue
                got = (hb, real, how + (" (head only)" if szf.exists() else ""), str(p), 0)
                break
            if got is None and c["source"] == "listed" and not offline:
                try:
                    hb, n = head_hf(c["repo"], c["commit"], f["path"], size, hroot)
                    got = (hb, size, "HF range requests", f"huggingface.co/{c['repo']}/resolve/{c['commit'][:12]}/{f['path']}", n)
                except (OSError, ValueError, urllib.error.URLError) as e:
                    res["why"] = (f"{name}: its header could not be read from Hugging Face ({str(e)[:200]})"
                                  + ("; the site refused - not worked around" if re.search(r"\b(401|403|429)\b", str(e)) else ""))
                    return res
            if got is None:
                res["why"] = (f"{name}: no header here ({'offline; ' if offline and c['source'] == 'listed' else ''}"
                              + ", ".join(f"{h} {p}" for h, p in places) + " not found at the size"
                              + ("; a local candidate without a listing: give --repo to read the rest from Hugging Face"
                                 if c["source"] == "local" else "") + ")")
                return res
            hb, real, how, where, n = got
            heads.append((name, hb, real))
            res["shards"].append({"name": name, "from": how, "where": where, "header_bytes": len(hb), "size": real,
                                  "fetched": n})
            res["fetched_bytes"] += n
        for name, hb, real in heads:
            p = sd / name
            with open(p, "wb") as fo:
                fo.write(hb)
            os.truncate(p, max(real, len(hb)))
        js = sd / "packcheck.json"
        cmd = [str(PY), "-I", "-B", str(KIT / "dayone.py"), "_packcheck", "--tree", str(tree), "--gguf", str(sd / heads[0][0]),
               "--json", str(js)]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=900)
        if not js.exists():
            res["why"] = f"dayone.py _packcheck failed (rc {r.returncode}): {(r.stderr or r.stdout)[-400:]}"
            return res
        res.update(json.loads(js.read_text()))
    finally:
        for name, _, _ in heads:
            (sd / name).unlink(missing_ok=True)
    return res


def pack_summary(pk):
    if not pk:
        return None
    return OrderedDict((k, pk.get(k)) for k in ("verdict", "why", "stage", "cite", "layers", "table", "experts_bytes", "arch",
                                                 "family_known", "compat_bf16", "fetched_bytes", "iq_pack", "iq_pack_sha12",
                                                 "mixed_gate_up_layers") if pk.get(k) is not None) | \
        {"shards_from": sorted({s.get("from", "?") for s in pk.get("shards", [])})}


IQ_CITES = (("gate_up", r"gate and up differ in type"), ("no_experts", r"the model has no expert tensors"),
            ("nvfp4_scale", r"NVFP4 experts without their \.scale tensors"), ("routers", r"the routers disagree on the expert count"),
            ("expert_shape", r"an expert tensor is not \[\*, \*, %d\] of whole blocks"),
            ("tensor_type", r"unsupported or truncated tensor"), ("split_keys", r"does not declare itself shard"),
            ("index_dims", r"dimensions; the index holds two"), ("index_compat", r"but the engine requires %s; use --compat-bf16"),
            ("main_refuses_first", r"a model that cannot be packed is refused before any file of the pack changes"))


def cmd_packcheck_run(a):
    """internal: one tree's tools/iq_pack.py (+ its gguf_reader) in this process, on the stand-ins - the steps its main()
    takes before it writes any pack file: Model(src) (every shard, split keys, each tensor's type and size), expert_layout
    (the expert table: one gate/up type and blob size a layer, 3-D [*, *, n_expert] whole blocks, the routers' expert
    count, NVFP4 scales), hadamard_spec / native_experts_v5 (prism.hadamard), then index_standalone's checks before it
    writes (no tensor above 2 dimensions; quantized FORM roles need --compat-bf16) by iq_pack's own tables. The value
    checks (an F32 tensor that is not exactly BF16, non-finite values) need the data: they stay at pack time."""
    tree = Path(a.tree)
    ipp = tree / "tools/iq_pack.py"
    out = OrderedDict([("iq_pack", str(ipp)), ("iq_pack_sha12", sha256_file(ipp)[:12])])
    txt = ipp.read_text(errors="replace")

    def line_of(pat):
        m = re.search(pat, txt)
        return f"tools/iq_pack.py:{txt.count(chr(10), 0, m.start()) + 1}" if m else None
    out["cite"] = {k: line_of(p) for k, p in IQ_CITES}

    def done(verdict, stage, why):
        out.update(verdict=verdict, stage=stage, why=why)
        Path(a.json).write_text(json.dumps(out, indent=1, default=str) + "\n")
        print(f"{verdict} [{stage}] {why}")
        return 0
    mf = (tree / "include/strata/artifact/model_family.hpp")
    fams = re.findall(r'if \(arch == "([^"]+)"\)', mf.read_text(errors="replace")) if mf.exists() else []
    sys.path.insert(0, str(tree / "tools"))
    IQ = load("iq_pack", ipp)
    src = Path(a.gguf).absolute()
    try:
        arch0 = IQ.G.GGUFFile(src).metadata.get("general.architecture")
    except ValueError as e:
        return done("REFUSES", "gguf_reader.GGUFFile (shard 1's header)", str(e))
    if arch0 == "deepseek41":   # strata-dsv41's own pack: report the expert types, do not judge by iq_pack's rules
        out.update(arch=arch0, family_known=(tree / "src/dsv41").is_dir())
        mixed, combos = [], Counter()
        for p in D1.shards_of(src):
            try:
                g = IQ.G.GGUFFile(p)
            except (OSError, ValueError):
                continue
            ty = {t.name: t.type_name for t in g.tensors}
            for n, tn in ty.items():
                mm_ = re.match(r"blk\.(\d+)\.ffn_gate_exps\.weight$", n)
                if mm_ and f"blk.{mm_.group(1)}.ffn_up_exps.weight" in ty:
                    up = ty[f"blk.{mm_.group(1)}.ffn_up_exps.weight"]
                    combos[(tn, up)] += 1
                    if up != tn:
                        mixed.append({"layer": int(mm_.group(1)), "gate": tn, "up": up})
        out["mixed_gate_up_layers"] = sorted(mixed, key=lambda x: x["layer"])
        out["combos"] = [{"gate": g_, "up": u_, "layers": n_} for (g_, u_), n_ in combos.most_common()]
        return done("NOT CHECKED", "architecture", "deepseek41 is packed by tools/dsv41/pack_gguf.py for strata-dsv41 (its own "
                    "refusals at pack time), not by iq_pack: this pre-check applies iq_pack's rules only; INFO: expert "
                    "gate/up types " + (", ".join(f"{x['gate']}/{x['up']} x{x['layers']}" for x in out["combos"]) or "none read")
                    + (f"; gate != up in layer(s) {[x['layer'] for x in mixed][:8]}" if mixed else "; gate == up in every layer read"))
    try:
        model = IQ.Model(src)
    except (FileNotFoundError, ValueError) as e:
        return done("REFUSES", "iq_pack.Model (shards, split keys, every tensor's type and size)", str(e))
    md = model.files[0].metadata
    arch = md.get("general.architecture")
    out["arch"] = arch
    out["family_known"] = arch in fams or (arch == "deepseek41" and (tree / "src/dsv41").is_dir())
    out["families"] = fams + (["deepseek41 (strata-dsv41)"] if (tree / "src/dsv41").is_dir() else [])
    T = {n: w[1] for n, w in model.where.items()}
    out["tensors"] = len(T)
    ple = T.get("per_layer_token_embd.weight")
    out["ngram_bytes"] = (ple.expected_bytes() or 0) if ple is not None else 0
    lays = sorted({int(n.split(".")[1]) for n in T if re.match(r"blk\.\d+\.ffn_(gate|up|down)_exps\.weight$", n)})
    mixed = [l for l in lays if f"blk.{l}.ffn_gate_exps.weight" in T and f"blk.{l}.ffn_up_exps.weight" in T
             and T[f"blk.{l}.ffn_gate_exps.weight"].type_name != T[f"blk.{l}.ffn_up_exps.weight"].type_name]
    out["mixed_gate_up_layers"] = [{"layer": l, "gate": T[f"blk.{l}.ffn_gate_exps.weight"].type_name,
                                    "up": T[f"blk.{l}.ffn_up_exps.weight"].type_name} for l in mixed]
    got = IQ.expert_layout(model, src)
    if isinstance(got, str):
        return done("REFUSES", "iq_pack.expert_layout (the expert table)", got)
    layout, text, n_expert, total = got
    combos = Counter((ts[0].type_name, ts[2].type_name) for *_, ts in layout)
    out.update(layers=len(layout), n_expert=n_expert, experts_bytes=total,
               table=re.match(r"# strata native experts (v\d+)", text).group(1) if re.match(r"# strata native experts (v\d+)", text) else "?",
               combos=[{"gate_up": g_, "down": d_, "layers": n_} for (g_, d_), n_ in combos.most_common()])
    t0 = layout[0][5]
    had = IQ.hadamard_spec(IQ.G.GGUFFile(src).metadata, layout, int(t0[0].shape[0]), int(t0[2].shape[0]))
    if isinstance(had, str) and not had.startswith("# strata hadamard"):
        return done("REFUSES", "iq_pack.hadamard_spec (prism.hadamard)", "prism.hadamard: " + had)
    if had is not None:
        t5 = IQ.native_experts_v5(text)
        if not t5.startswith("# strata native experts v5:"):
            return done("REFUSES", "iq_pack.native_experts_v5", "prism.hadamard: " + t5)
        out["table"] = "v5"
    src_ix = inspect.getsource(IQ.index_standalone)
    mirror_ok = all(x in src_ix for x in ("if len(t.shape) > 2:", "native = t.type_name not in FLOAT and (form is None or (",
                                          "if t.type_name not in FLOAT and not native and not compat_bf16:"))
    compat, f32 = [], []
    for name, (g, t, mm, p) in model.where.items():
        if IQ.is_expert(t.name) or t.name in IQ.NOT_IN_PACK:
            continue
        if len(t.shape) > 2:
            return done("REFUSES", "iq_pack.index_standalone (before it writes)",
                        "tensor %s has %d dimensions; the index holds two" % (t.name, len(t.shape)))
        form = IQ.form_of(name)
        native = t.type_name not in IQ.FLOAT and (form is None or (name == "blk.1.ple_key.weight" and t.type_name in IQ.NATIVE_PLE_KEY))
        if t.type_name not in IQ.FLOAT and not native:
            compat.append(f"{name} is {t.type_name}, but the engine requires {form}")
        elif form == "BF16" and t.type_name == "F32":
            f32.append(name)
    out["compat_bf16"] = {"needed": bool(compat), "n": len(compat), "first": compat[:6],
                          "rule_source_unchanged": mirror_ok}
    out["f32_to_bf16_checked_at_pack_time"] = {"n": len(f32), "first": f32[:4]}
    why = (f"all {len(layout)} expert layers packable ("
           + ", ".join(f"{x['gate_up']}/{x['down']} x{x['layers']}" for x in out["combos"])
           + f"; native_experts.txt {out['table']}; {total / GIB:.2f} GiB of experts)"
           + (f"; needs --compat-bf16: {len(compat)} quantized FORM tensor(s) (e.g. {compat[0]})" if compat else "")
           + (f"; {len(f32)} F32 tensor(s) the engine reads as BF16: exact only if their values are BF16 (checked at pack "
              "time)" if f32 else "")
           + ("" if mirror_ok else "; WARNING: index_standalone's source changed - its pre-write rules here may be stale"))
    return done("ACCEPTS", "iq_pack: Model + expert_layout + hadamard_spec + index_standalone's pre-write type rules", why)


def fixture_materialize(tree, set_name, dest):
    """upstream's header-only fixture of Unsloth's v3.1 sets (strata-r23p0211 tests/fixtures/unsloth_v31, written by
    its tools/unsloth_v31_fixture.py) as head-only local files (NAME + NAME.size) through that tool's own materialize, in
    its own process; shard 1 (metadata only, not in the fixture) as upstream's tests make it: the architecture and the
    split keys. Returns shard 1's path."""
    dest = Path(dest)
    dest.mkdir(parents=True, exist_ok=True)
    code = ("import sys, json, pathlib; sys.dont_write_bytecode = True; sys.path.insert(0, sys.argv[1]); "
            "import unsloth_v31_fixture as FX; S = FX.load()['sets'][sys.argv[2]]['shards']; d = pathlib.Path(sys.argv[3]); "
            "tot = sum(len(s['header']['tensors']) for s in S if s['header']); out = []\n"
            "for i, s in enumerate(S):\n"
            "    h = s['header'] or {'split': [i, len(S), tot], 'tensors': []}\n"
            "    p = FX.materialize({'header': h}, d / s['name'], first=(i == 0)); (d / (s['name'] + '.size')).write_text(str(s['bytes']) + chr(10)); out.append(str(p))\n"
            "print(json.dumps(out))")
    r = subprocess.run([str(PY), "-I", "-B", "-c", code, str(Path(tree) / "tools"), set_name, str(dest)], capture_output=True, text=True)
    if r.returncode != 0:
        raise SystemExit(f"fixture {set_name}: {r.stderr[-400:]}")
    return json.loads(r.stdout.strip().splitlines()[-1])[0]


def cmd_precheck(a):
    """Karl 11-05 item 2 on its own: dayone.py precheck (--local SHARD1 | --repo R@REV [--quant L] | --fixture SET) ..."""
    out = Path(a.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    hroot = Path(a.headers).resolve() if a.headers else out / "headers"
    cands = []
    for l_ in a.local or []:
        cands.append(local_candidate(l_))
    listings = dict(kv.split("=", 1) for kv in a.listing or [])
    for spec in a.repo or []:
        repo, _, rev = spec.partition("@")
        lst = list_repo(repo, rev or "main", listings.get(repo), a.offline)
        if not lst.get("available", True):
            print(f"{repo}: not available ({lst['source']})")
            continue
        qs, _ = quants_of(lst, dest_root_of(a, repo))
        cands += [q for q in qs if not a.quant or q["label"] in a.quant]
    for s in a.fixture or []:
        cands.append(local_candidate(fixture_materialize(a.fixture_tree, s, out / "fixture" / s)))
        cands[-1]["label"] = f"{s} (fixture)"
    res = []
    for c in cands:
        r = pack_precheck(c, hroot, a.tree, out / "work", offline=a.offline)
        res.append(r)
        print(f"{c['label']:28s} {r['verdict']:12s} {r['why'][:230]}")
    (out / "precheck.json").write_text(json.dumps(res, indent=1, default=str) + "\n")
    print(f"-> {out / 'precheck.json'}")
    return 0


# =====================================================================================================================
# 10. the n-gram / Engram table's placement (Karl 11-05 item 3), explicit in the fit
# =====================================================================================================================
def d1_defaults():
    """day1.py check's own defaults, read from its argparse calls with ast (never copied by hand)"""
    out = {}
    for node in ast.walk(ast.parse((KIT / "day1.py").read_text())):
        if isinstance(node, ast.Call) and getattr(node.func, "attr", "") == "add_argument" and node.args \
                and isinstance(node.args[0], ast.Constant):
            for kw in node.keywords:
                if kw.arg == "default":
                    try:
                        out[node.args[0].value] = ast.literal_eval(kw.value)
                    except ValueError:
                        pass
    return out


def ngram_of(c):
    """the candidate's n-gram table bytes: the pre-check's tensor table, else the header (in-file per_layer_token_embd)"""
    pk = c.get("pack") or {}
    if pk.get("ngram_bytes") is not None:
        return pk["ngram_bytes"]
    if c.get("hdr", {}).get("state") in ("disk", "headers"):
        try:
            D1.type_table(Path(D1.TREE))
            t = D1.Model(c["hdr"]["path"]).tensors.get("per_layer_token_embd.weight")
            return (t.nbytes or 0) if t is not None else 0
        except (OSError, ValueError):
            return None
    return None


def ngram_placement(a, cands):
    """ssd (today's: --ple-io direct - the engine reads a few rows per token from the file, past the OS cache; with
    STRATA_PLE_AUTO_RAM=0 no residency policy moves it) costs the RAM tier nothing; ram (--ple-io ram) holds the whole
    table in RAM, so it comes out of the expert RAM tier: day1's --other-gib (everything but the tier) grows by the
    table - the largest of the candidates' tables (their headers), else --ngram-gib (an Engram sidecar)."""
    tabs = [x for x in (ngram_of(c) for c in cands) if x]
    tab = max(tabs) / GIB if tabs else (getattr(a, "ngram_gib", None) or 0.0)
    src = "the candidates' headers (per_layer_token_embd)" if tabs else ("--ngram-gib" if getattr(a, "ngram_gib", None)
                                                                        else "no table in any header")
    other = d1_defaults().get("--other-gib", 16.3)
    ram = getattr(a, "ngram_placement", "ssd") == "ram"
    if ram:
        why = (f"the table ({tab:.2f} GiB, {src}) is held in RAM (--ple-io ram): the expert RAM tier loses it - day1's "
               f"--other-gib {other:g} + {tab:.2f} = {other + tab:.2f} GiB; if the engine page-locks it, it counts toward the "
               "60 GiB stressapptest line")
        note = (f"--ple-io ram: the n-gram table ({tab:.2f} GiB) in RAM, taken from the expert RAM tier (dayone "
                "--ngram-placement ram)")
    else:
        why = (f"the table ({tab:.2f} GiB, {src}) stays on the SSD as today (--ple-io direct, STRATA_PLE_AUTO_RAM=0): 0 GiB "
               "of the RAM tier, a few rows (< 10 KB) read per token (UPGRADE-ESTIMATE 8.1); its file must stay on the NVMe")
        note = f"the n-gram table ({tab:.2f} GiB) on the SSD (--ple-io direct, the default; no RAM tier taken)"
    return {"placement": "ram" if ram else "ssd", "table_gib": round(tab, 3), "from": src, "ram_tier_cost_gib": round(tab if ram else 0.0, 3),
            "why": why, "config_note": note, "day1_extra": (["--other-gib", f"{other + tab:.3f}"] if ram else [])}


# =====================================================================================================================
# 11. quant timing (Karl 11-05 item 1): per publisher, the default by the v3.1 result, the U-vs-ISTA comparison
# =====================================================================================================================
def plan_parser():
    ap = argparse.ArgumentParser(prog="dayone.py plan")
    common_args(ap)
    return ap


def sub_args(a, **kw):
    b = copy.copy(a)
    for k, v in kw.items():
        setattr(b, k, v)
    return b


def plan_publishers(a):
    """Karl 11-05 item 1, with repos of both publishers: each publisher's own plan (DIR/<publisher>/, Karl's rule inside
    it, pinned to the commit listed here once), the DEFAULT by the v3.1 result (publisher_default), and - when both have
    a pick - the U-vs-ISTA comparison (DIR/uvi/). A publisher not out yet gets the `watch` line instead."""
    out = Path(a.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    (out / "listing").mkdir(exist_ok=True)
    listings = dict(kv.split("=", 1) for kv in a.listing or [])
    pubs = OrderedDict()
    for spec in a.repo or []:
        repo, _, rev = spec.partition("@")
        pub = publisher_of(repo)
        lst = list_repo(repo, rev or "main", listings.get(repo), a.offline)
        e = pubs.setdefault(pub, {"repos": [], "available": False, "specs": [], "listings": [], "locals": []})
        row = {"repo": repo, "available": lst.get("available", True), "source": lst["source"], "commit": lst.get("commit"),
               "http": lst.get("http"), "checked": now()}
        if row["available"]:
            tp = out / "listing" / f"{repo.replace('/', '--')}@{lst['commit'][:12]}.json"
            tp.write_text(json.dumps(lst["entries"], indent=0))
            n_models = sum(1 for x in lst["entries"] if x.get("type") == "file" and classify(x["path"])[0] == "model")
            row.update(models=n_models, listing=str(tp))
            if n_models:
                e["specs"].append(f"{repo}@{lst['commit']}")
                e["listings"].append(f"{repo}={tp}")
                e["available"] = True
            else:
                row["available"] = False
                row["source"] += " (no model GGUF in it yet)"
        e["repos"].append(row)
        log(f"{pub}: {repo} {'AVAILABLE @' + lst['commit'][:12] if row['available'] else 'not available'} ({row['source']})")
    for l_ in a.local or []:
        e = pubs.setdefault(publisher_of(l_), {"repos": [], "available": False, "specs": [], "listings": [], "locals": []})
        e["locals"].append(l_)
        e["available"] = True
    T = OrderedDict([("version", VERSION), ("when", now()), ("argv", sys.argv[1:]), ("out", str(out)), ("mode", "per publisher"),
                     ("first", a.first), ("publishers", OrderedDict())])
    ux = T["unsloth_exactness"] = u_exact_state(getattr(a, "ud31_dir", None), getattr(a, "hcoff_dir", None))   # Karl 11-06
    subs = {}
    for pub, e in pubs.items():
        T["publishers"][pub] = {"repos": e["repos"], "available": e["available"], "locals": e["locals"]}
        if not e["available"]:
            continue
        if pub == "unsloth" and ux["state"] == "VETOED":   # a failed v3.1 exactness result: no Unsloth plan, no download
            T["publishers"][pub]["vetoed"] = ux["why"]
            log(f"=== unsloth: VETOED - {ux['why']}")
            continue
        b = sub_args(a, repo=e["specs"], listing=e["listings"], local=e["locals"], out=str(out / pub),
                     name=f"{a.name}{pub[0]}", compare_publishers=False, no_compare=True,
                     _hc_q8_off=(pub == "unsloth" and ux["state"] == "HC_Q8 OFF"))
        log(f"=== {pub}: its own plan -> {out / pub}" + (" (STRATA_HC_Q8=0: the veto's escape)" if b._hc_q8_off else ""))
        Pp = plan(b)
        subs[pub] = Pp
        it = first_item(Pp)
        T["publishers"][pub].update(plan=str(out / pub), pick=(it or {}).get("label"), pick_experts_gib=(it or {}).get("experts_gib"),
                                    pick_name=(it or {}).get("name"), served=(it or {}).get("served"),
                                    hc_q8_switch="off" if b._hc_q8_off else None)
    have = [p for p in ("unsloth", "ista") if T["publishers"].get(p, {}).get("pick")]
    if not a.first and len(have) == 1:
        T["first"] = have[0]
    if len(have) == 2:
        T["comparison"] = uvi_comparison(a, out, Path(T["publishers"][T["first"] or have[0]]["plan"]),
                                         Path(T["publishers"][[p for p in have if p != (T["first"] or have[0])][0]]["plan"]),
                                         T["first"] or have[0])
    else:
        missing = [p for p in ("unsloth", "ista") if p not in have and not T["publishers"].get(p, {}).get("vetoed")]
        T["comparison"] = {"state": ("WAITING for " + " and ".join(missing)) if missing else "NOT NEEDED (Unsloth vetoed)",
                           "watch": [watch_line(out, r["repo"]) for p in missing for r in T["publishers"].get(p, {}).get("repos", [])]
                           or [watch_line(out, f"<{p} repo>") for p in missing],
                           "timer": [timer_line(out, r["repo"]) for p in missing for r in T["publishers"].get(p, {}).get("repos", [])]}
    T["default"] = publisher_default(T, a)
    (out / "plan.json").write_text(json.dumps(T, indent=1, default=str) + "\n")
    (out / "PLAN.md").write_text(top_md(T))
    log(f"top plan: {out / 'plan.json'}, {out / 'PLAN.md'}")
    return T


def watch_line(out, repo):
    return f"{PY} -I -B {KIT / 'dayone.py'} watch --plan {out} --repo {repo}"


def timer_line(out, repo):
    return (f"systemd-run --user --unit q4-arrival-{slug(repo, 10)} --on-calendar='*:0/30' -p Nice=19 -p MemoryHigh=2G "
            f"{watch_line(out, repo)} --notify    # NOT installed: Karl's go first")


def first_item(P):
    for it in P.get("files", []):
        if it.get("config") or it.get("served"):
            return it
    return None


def publisher_default(T, a):
    """Karl 11-05 + 11-06. One publisher out -> its pick ("take whichever is available first, run with it"), Unsloth only
    if its v3.1 exactness does not veto it (u_exact_state: AS IS / HC_Q8 OFF -> with STRATA_HC_Q8=0 / VETOED); speed and
    quality never veto. Both out -> "Unsloth is the stopgap until ISTA lands, and then the comparison decides": the
    U-vs-ISTA comparison's record (decision-uvi.json, q4_rules.py uvidecide: its quality verdict; no difference -> the
    v3.1 result as the tie-break, then Karl's size rule); until it has run, the stopgap (the first one out, unless
    vetoed) stays. --prefer ista|unsloth (a setting) wins; --prefer any = Karl's size rule."""
    ux = T.get("unsloth_exactness") or u_exact_state()
    pk = {p: T["publishers"][p] for p in ("unsloth", "ista") if T["publishers"].get(p, {}).get("pick")}
    notes = []
    if "unsloth" in T["publishers"] and ux["state"] == "VETOED":
        pk.pop("unsloth", None)
        notes.append(f"Unsloth VETOED: {ux['why']}")
    elif ux["state"] == "HC_Q8 OFF" and "unsloth" in pk:
        notes.append(f"Unsloth with STRATA_HC_Q8=0: {ux['why']}")
    elif ux["state"] == "NOT DECIDED" and "unsloth" in pk:
        notes.append(f"Unsloth's veto check: {ux['why']}")
    base = {"unsloth_exactness": ux["state"], "notes": notes}
    if not pk:
        return {**base, "state": "NONE", "publisher": None, "file": None,
                "why": "no publisher has a pick" + (" - " + "; ".join(notes) if notes else "") + ": wait for the other"}
    if len(pk) == 1:
        p = next(iter(pk))
        return {**base, "state": "FIRST AVAILABLE", "publisher": p, "file": pk[p]["pick"], "plan": pk[p]["plan"],
                "why": (f"only {p} is usable (Unsloth vetoed)" if p == "ista" and ux["state"] == "VETOED"
                        and T["publishers"].get("unsloth", {}).get("available") else f"only {p} is out")
                       + ": take whichever is available first, run with it (Karl 11-05)"
                       + (" - with STRATA_HC_Q8=0" if p == "unsloth" and ux["state"] == "HC_Q8 OFF" else "")}
    if a.prefer in ("unsloth", "ista"):
        p, st, why = a.prefer, "SETTING", f"--prefer {a.prefer} (set on the command line)"
    elif a.prefer == "any":
        d = abs((pk["unsloth"]["pick_experts_gib"] or 0) - (pk["ista"]["pick_experts_gib"] or 0))
        p = None if d <= a.tie_tol_gib else max(pk, key=lambda x: pk[x]["pick_experts_gib"] or 0)
        st, why = "SETTING", "--prefer any: Karl's size rule" + (" - a tie: the comparison decides" if p is None else "")
    else:
        dj = Path((T.get("comparison") or {}).get("decision") or "/nonexistent")
        dec = json.loads(dj.read_text()) if dj.exists() else None
        arm = ((dec or {}).get("default") or {}).get("arm")
        if dec is not None:
            p = (dec.get("publisher") or {}).get(arm) if arm else None
            st, why = "BY THE COMPARISON", f"the U-vs-ISTA comparison ({dj}): {(dec.get('default') or {}).get('why', '')[:200]}"
        else:
            p = T.get("first") if T.get("first") in pk else next(iter(pk))
            st, why = "PENDING THE COMPARISON", (f"Karl 11-06: \"Unsloth is the stopgap until ISTA lands, and then the comparison "
                                                f"decides\" - not run yet, so {p} (the first one out) stays")
    out = {**base, "state": st, "publisher": p, "file": pk[p]["pick"] if p else None, "plan": pk[p]["plan"] if p else None, "why": why}
    return out


def served_item(it):
    """the served file as an arm: configs/x28h.json (P028x without vision), its pack and engine, as gap-ud31.sh's P"""
    shards = [str(p) for p in D1.shards_of(SERVED)]
    prm = OrderedDict([("version", VERSION), ("name", "x28h"), ("label", it["label"]), ("mode", "swap"), ("config", str(X28H)),
                       ("config_sha256", {}), ("exe", str(WS / "engine-r22p028x/strata")), ("ngpu", 2), ("files", shards),
                       ("pack", str(WS / "bringup/out/r20a/pack")), ("hc_q8", False), ("prompt_dir", str(D1.PROMPTS)),
                       ("retok_needed", False), ("pin", F1["pin"]), ("slots", {"main": F1["sized_auto"], "helper": F1["helper"]}),
                       ("dl", {"n": 0, "items": []}), ("drafter_rt", str(WS / "strata-v0115/mtp/rt")), ("minutes", dict(MIN)),
                       ("target", [40, 60])])
    return {"name": "x28h", "label": f"{it['label']} (served: x28h)", "publisher": it.get("publisher"), "served": True,
            "config": str(X28H), "pack": {"dir": prm["pack"], "compat_bf16": False}, "experts_gib": it["experts_gib"],
            "hc_q8": False, "mode": "swap", "minutes": dict(MIN), "_prm": prm,
            "_c": {"rep": {"fit": {"room_ram_gib": it.get("room_ram_gib") or 58.0}, "tokenizer": {"tokens_sha": it.get("tokens_sha")}}}}


def item_from_plan(pdir):
    """the pick of a saved plan as kl_driver's item (plan.json's file entry + its params file; the served file -> x28h)"""
    pj = Path(pdir) / "plan.json"
    if not pj.exists():
        return None
    it = first_item(json.loads(pj.read_text()))
    if it is None:
        return None
    if it.get("served"):
        return served_item(it)
    prm = json.loads(Path(it["params"]).read_text())
    return {"name": it["name"], "label": it["label"], "publisher": it.get("publisher"), "served": False, "config": it["config"],
            "pack": it["pack"], "experts_gib": it["experts_gib"], "hc_q8": it.get("hc_q8"), "mode": it["mode"],
            "minutes": it["minutes"], "drivers": it.get("drivers"), "_prm": prm,
            "_c": {"rep": {"fit": {"room_ram_gib": it.get("room_ram_gib") or 58.0}, "tokenizer": {"tokens_sha": it.get("tokens_sha")}}}}


def uvi_comparison(a, out, dir_first, dir_other, first_pub):
    """the U-vs-ISTA comparison of two saved plans' picks, as gap steps for work/r23/gap-series.sh (NO .ready file):
      gap-<name>-uvi-kl.sh     quality: both files (or the new one against P when one IS the served file, as gap-ud31.sh)
                               against the named local reference R, the KL rules at the text level, the pair verdict
      gap-<name>-uvi-speed.sh  speed: the 9-workload screen x3, A (the first one out) against B, the no-loss rule both
                               ways; then q4_rules.py uvidecide -> decision-uvi.txt (the measurements + the DEFAULT by
                               the v3.1 result, re-read when it runs; NOTHING SWITCHES)"""
    u = out / "uvi"
    for d in (u / "drivers", u / "configs"):
        d.mkdir(parents=True, exist_ok=True)
    A, B = item_from_plan(dir_first), item_from_plan(dir_other)
    res = OrderedDict([("first", first_pub), ("A", (A or {}).get("label")), ("B", (B or {}).get("label")),
                       ("plans", [str(dir_first), str(dir_other)])])
    if not A or not B:
        res["state"] = "NOT POSSIBLE: " + ("no pick in " + str(dir_first) if not A else "no pick in " + str(dir_other))
        return res
    name = f"{a.name}-uvi"
    ref = analyse_ref(a, u) if a.kl_ref_gguf else None
    pk = {"final": [], "group": "uvi"}
    served = [x for x in (A, B) if x.get("served")]
    if served:
        new = [x for x in (A, B) if not x.get("served")]
        kd = kl_driver(a, u, new, ref, pk, tie=False, name=name, force_base=True) if new else None
        res["kl_note"] = "one file IS the served one: the new file against P (x28h) and R, gap-ud31.sh's design"
    else:
        kd = kl_driver(a, u, [A, B], ref, pk, tie=True, name=name, no_base=True)
        res["kl_note"] = "X1 = the first one out, X2 = the other: the pair verdict (kldecide --tie)"
    res["kl_driver"] = kd
    res["speed_driver"] = ab_speed_driver(a, u, A, B, name, (kd or {}).get("params"))
    res["v31_default_now"] = v31_default()
    res["decision"] = str(u / "gaps" / name / "gap-speed-ab" / "decision-uvi.json")   # uvidecide writes it
    rel = lambda p: str(Path(p).resolve().relative_to(WS)) if str(Path(p).resolve()).startswith(str(WS)) else str(p)  # noqa: E731
    q = [x["path"] for x in (res["kl_driver"], res["speed_driver"]) if x]
    res["queue"] = {"steps": [rel(p) for p in q], "how": (
        "NOT QUEUED by dayone.py (no .ready file; the running series untouched). To queue: Claude reviews each driver "
        "(bash -n is done), writes <driver>.ready, and adds the two paths to the STEPS of the next series start - a restart "
        "waiter as work/r23/series-restart-after-*.sh, or gap-series.sh's STEPS when no series runs: "
        + " ".join(rel(p) for p in q) + " (one research question between them, the series' default; '+' before the second "
        "runs it straight after the first)")}
    (u / "QUEUE.txt").write_text("\n".join([f"U-vs-ISTA comparison ({VERSION}, {now()}): A = {A['label']} ({first_pub}, out "
                                            f"first), B = {B['label']}", "steps (gap-series.sh STEPS, paths relative to "
                                            f"{WS}):"] + [f"  {s}" for s in res["queue"]["steps"]] + ["", res["queue"]["how"],
                                            "", f"the default now: {res['v31_default_now']['state']} - {res['v31_default_now']['why']}"]) + "\n")
    res["state"] = "WRITTEN (not queued)"
    return res


def ab_speed_driver(a, u, A, B, name, kl_params):
    """the A/B speed screen of the comparison (SPEED_AB): each arm's own config / engine / GPU count; a served arm = x28h"""
    prms = {}
    for k, it in (("A", A), ("B", B)):
        p = json.loads(json.dumps(it["_prm"]))
        if not it.get("served"):
            p["config_sha256"] = {it["config"]: sha256_file(it["config"])}
        pp = u / "drivers" / f"params-{name}-{k}.json"
        pp.write_text(json.dumps(p, indent=1) + "\n")
        prms[k] = (pp, p)
    prm = json.loads(json.dumps(prms["A"][1]))
    prm["dl"] = {"n": prms["A"][1]["dl"]["n"] + prms["B"][1]["dl"]["n"], "items": prms["A"][1]["dl"]["items"] + prms["B"][1]["dl"]["items"]}
    prm["config_sha256"] = {**prms["A"][1].get("config_sha256", {}), **prms["B"][1].get("config_sha256", {})}
    prm["ab"] = {"cfg": {"A": A["config"], "B": B["config"]}, "exe": {"A": A["_prm"]["exe"], "B": B["_prm"]["exe"]},
                 "ngpu": {"A": A["_prm"]["ngpu"], "B": B["_prm"]["ngpu"]}, "label": {"A": A["label"], "B": B["label"]},
                 "publisher": {"A": A.get("publisher"), "B": B.get("publisher")},
                 "served": {"A": bool(A.get("served")), "B": bool(B.get("served"))},
                 "params": {"A": str(prms["A"][0]), "B": str(prms["B"][0])},
                 "experts_gib": {"A": A.get("experts_gib"), "B": B.get("experts_gib")},
                 "kl_params": kl_params, "kl_results": str(u / "gaps" / name / "gap-kl"),
                 "slots": {k: (it["_prm"].get("slots") or {}) for k, it in (("A", A), ("B", B))}}
    pp = u / "drivers" / f"params-{name}-speed.json"
    pp.write_text(json.dumps(prm, indent=1) + "\n")
    mins = A["minutes"]
    exe0 = A["_prm"]["exe"] if not A.get("served") else B["_prm"]["exe"]
    shards = " ".join(sorted(set(A["_prm"]["files"]) | set(B["_prm"]["files"])))
    new = [k for k, it in (("A", A), ("B", B)) if not it.get("served")]
    v = {"VERSION": VERSION, "WHEN": now(), "NAME": name, "LABEL": f"{A['label']} vs {B['label']}", "SHORT": slug(name),
         "MODE": "U-vs-ISTA comparison", "MODE_KEY": "ab", "PARAMS": str(pp), "CFG": A["config"], "EXE": shlex.quote(exe0),
         "NGPU": A["_prm"]["ngpu"], "TREE": str(Path(a.rel or a.tree)),
         "ENGINES": " ".join(dict.fromkeys(["strata", "strata-host", "strata-vision", "strata-dsv41", "llama-server", "ollama"]
                                           + [Path(x).name[:15] for x in (A["_prm"]["exe"], B["_prm"]["exe"]) if x and not x.startswith("<")])),
         "RESULTS": str(u / "gaps" / name), "PROMPT_DIR": A["_prm"]["prompt_dir"],
         "EVICT": " ".join(sorted(set(A["_prm"]["files"]) | set(B["_prm"]["files"]))), "SHARDS": shards,
         "MAXM": 6 + 6 * mins["scr"] + 8, "WHAT": f"the U-vs-ISTA SPEED SCREEN of {A['label']} and {B['label']}",
         "SCR_MIN": mins["scr"], "TARGET": "40,60", "AB_NEW": " ".join(new) or ":",
         "NEED_AB": " ".join(f"{it['pack']['dir']}/native_experts.txt" for it in (A, B) if not it.get("served"))}
    d = write_driver(u / "drivers" / f"gap-{name}-speed.sh", "speed_ab", v, label="speed-ab")
    d["params"] = str(pp)
    return d


def top_md(T):
    L = [f"# Day-one plan per publisher ({T['when']}, {T['version']})", "",
         f"`dayone.py {' '.join(shlex.quote(x) for x in T['argv'])}`", "",
         "Karl 11-05 (item 1): \"Take whichever is available first, run with it, and automatically queue the U-vs-ISTA "
         "comparison when the other appears. The v3.1 result decides which one becomes the default once both exist.\"", ""]
    for p, e in T["publishers"].items():
        L.append(f"## {p}")
        L.append("")
        for r in e["repos"]:
            L.append(f"- `{r['repo']}`: {'AVAILABLE at ' + str(r['commit'])[:12] if r['available'] else 'NOT AVAILABLE'} ({r['source']})")
        for l_ in e.get("locals") or []:
            L.append(f"- local `{l_}`")
        if e.get("vetoed"):
            L.append(f"- **VETOED** (Karl 11-06: a failed v3.1 exactness result): {e['vetoed']}")
        if e.get("plan"):
            L.append(f"- its plan: `{e['plan']}/PLAN.md`; pick **{e.get('pick')}** ({e.get('pick_experts_gib')} GiB of experts)"
                     + (" - the served file" if e.get("served") else "")
                     + (" - with STRATA_HC_Q8=0 (the veto's escape)" if e.get("hc_q8_switch") == "off" else ""))
        L.append("")
    d = T["default"]
    ux = T.get("unsloth_exactness") or {}
    L += ["## The default", "", f"**{d.get('state')}: {d.get('publisher') or 'not decided'}** - {d.get('file') or ''}", "",
          f"- {d.get('why')}"] + [f"- {x}" for x in d.get("notes") or []] + [f"- FLAG: {x}" for x in d.get("flags") or []] + \
        [f"- Unsloth's v3.1 exactness veto (Karl 11-06): **{ux.get('state')}** - {ux.get('why')}" if ux else "", ""]
    c = T["comparison"]
    L += ["## The U-vs-ISTA comparison", "", f"**{c.get('state')}**", ""]
    for k in ("kl_driver", "speed_driver"):
        if c.get(k):
            L.append(f"- `{c[k]['path']}` (bash -n {c[k]['bash_n']}; .ready: {'PRESENT' if c[k]['ready_file'] else 'none'})")
    if c.get("kl_note"):
        L.append(f"- {c['kl_note']}")
    if c.get("queue"):
        L += ["", c["queue"]["how"]]
    for w in c.get("watch") or []:
        L.append(f"- when the other appears (one poll; a timer may run it): `{w}`")
    for t in c.get("timer") or []:
        L.append(f"- timer form: `{t}`")
    return "\n".join(L) + "\n"


def cmd_watch(a):
    """one poll for the other publisher (a timer may run it): not out -> a line in watch.log, exit 0; out -> its plan (the
    first plan's settings, its own repo) and the U-vs-ISTA comparison against the first plan's pick; QUEUE.txt; an
    already planned commit -> nothing. --notify: a desktop line when it plans."""
    first = Path(a.plan).resolve()
    T = json.loads((first / "plan.json").read_text())
    repo, _, rev = a.repo.partition("@")
    pub = publisher_of(repo)
    listings = dict(kv.split("=", 1) for kv in a.listing or [])
    lst = list_repo(repo, rev or "main", listings.get(repo), a.offline)
    n_models = sum(1 for x in lst["entries"] if x.get("type") == "file" and classify(x["path"])[0] == "model")
    with open(first / "watch.log", "a") as f:
        f.write(f"{now()} {repo}: {'available @' + lst['commit'] if lst.get('available') else 'not available'}; {n_models} model "
                f"files ({lst['source']})\n")
    if not lst.get("available") or not n_models:
        print(f"{repo}: not out yet ({lst['source']}) - nothing to do")
        return 0
    out2 = Path(a.out).resolve() if a.out else first.parent / f"{first.name}-{pub}-{lst['commit'][:8]}"
    if (out2 / "plan.json").exists():
        print(f"{repo}@{lst['commit'][:12]}: already planned in {out2}")
        return 0
    b = plan_parser().parse_args(T["argv"][1:] if T["argv"][:1] == ["plan"] else T["argv"])
    b.rel = b.rel or b.tree
    if T.get("mode") == "per publisher":
        fp = T.get("first") or next((p for p, e in T["publishers"].items() if e.get("pick")), None)
        dir_first = Path(T["publishers"][fp]["plan"])
    else:
        fp, dir_first = next((c["publisher"] for c in T.get("candidates", []) if c.get("source") == "listed"), "first"), first
    (out2 / "listing").mkdir(parents=True, exist_ok=True)
    tp = out2 / "listing" / f"{repo.replace('/', '--')}@{lst['commit'][:12]}.json"
    tp.write_text(json.dumps(lst["entries"], indent=0))
    ux = u_exact_state(getattr(b, "ud31_dir", None), getattr(b, "hcoff_dir", None))   # Karl 11-06: re-read at every poll
    nb = sub_args(b, repo=[f"{repo}@{lst['commit']}"], listing=[f"{repo}={tp}"], local=[], out=str(out2 / pub),
                  name=f"{b.name}{pub[0]}", compare_publishers=False, no_compare=True, headers=a.headers or b.headers,
                  dest_root=(a.dest_root or b.dest_root), offline=a.offline or b.offline,
                  _hc_q8_off=(pub == "unsloth" and ux["state"] == "HC_Q8 OFF"))
    if pub == "unsloth" and ux["state"] == "VETOED":
        log(f"=== unsloth is out ({repo}@{lst['commit'][:12]}) but VETOED: {ux['why']}")
        Pn, it = {}, None
    else:
        log(f"=== {pub} is out ({repo}@{lst['commit'][:12]}): its own plan -> {out2 / pub}")
        Pn = plan(nb)
        it = first_item(Pn)
    T2 = OrderedDict([("version", VERSION), ("when", now()), ("argv", sys.argv[1:]), ("out", str(out2)), ("mode", "per publisher"),
                      ("first", fp), ("publishers", OrderedDict())])
    for p, e in T.get("publishers", {}).items():
        T2["publishers"][p] = e
    if T.get("mode") != "per publisher":
        fi = first_item(T)
        T2["publishers"][fp] = {"repos": T.get("listings", []), "available": True, "plan": str(first), "pick": (fi or {}).get("label"),
                                "pick_experts_gib": (fi or {}).get("experts_gib"), "served": (fi or {}).get("served")}
    T2["publishers"][pub] = {"repos": [{"repo": repo, "available": True, "commit": lst["commit"], "source": lst["source"],
                                        "checked": now(), "models": n_models}],
                             "available": True, "plan": str(out2 / pub) if it else None, "pick": (it or {}).get("label"),
                             "pick_experts_gib": (it or {}).get("experts_gib"), "served": (it or {}).get("served")}
    T2["unsloth_exactness"] = ux
    if ux["state"] == "VETOED" and "unsloth" in T2["publishers"]:
        T2["publishers"]["unsloth"]["vetoed"] = ux["why"]
    if ux["state"] == "VETOED" and "unsloth" in (pub, fp):
        T2["comparison"] = {"state": f"NOT NEEDED: Unsloth VETOED ({ux['why'][:160]})"}
    else:
        T2["comparison"] = uvi_comparison(b, out2, dir_first, out2 / pub, fp) if it else {"state": f"NOT POSSIBLE: no pick for {pub}"}
    T2["default"] = publisher_default(T2, b)
    (out2 / "plan.json").write_text(json.dumps(T2, indent=1, default=str) + "\n")
    (out2 / "PLAN.md").write_text(top_md(T2))
    print(f"{pub} planned -> {out2}/PLAN.md; comparison: {T2['comparison'].get('state')}; default: {T2['default'].get('state')} "
          f"{T2['default'].get('publisher')}")
    if a.notify:
        subprocess.run(["notify-send", "-a", "Strata", "-u", "critical", f"{pub} is out", f"plan + U-vs-ISTA drivers written (not queued): "
                        f"{out2}/PLAN.md"], capture_output=True)
    return 0


# =====================================================================================================================
# 11b. the Unsloth exactness veto (Karl 11-06) and its HC_Q8-off check
# =====================================================================================================================
HCOFF_RESULTS = WS / "results/r23/ud31/hcoff"      # gap-ud31-hcoff.sh's results (written only when it runs)
HCOFF_DRIVER = KIT / "hcoff/gap-ud31-hcoff.sh"
EXACT_FAILED = ("NOT REPEATABLE", "CHECK FAILED")
U_LINE = re.compile(r"^  U: (REPEATABLE|NOT REPEATABLE|CHECK FAILED|VOID|NOT RUN)", re.M)


def u_exact_state(ud31=None, hcoff=None):
    """Karl 11-06, verbatim: "Unsloth first-out: a failed v3.1 exactness result vetoes it, unless the failure goes away
    with STRATA_HC_Q8 off and that config passes. In that case, day one uses Unsloth with the switch off. Speed and
    quality don't veto: Unsloth is the stopgap until ISTA lands, and then the comparison decides."
    U's exactness = the v3.1 gap's own EXACTNESS verdict (work/r23/ud31_rules.py decide: decision.json exactness.U, and
    decision.txt's line '  U: <verdict>.' under EXACTNESS - the two must agree). The decode-path follow-up
    (dec/decision.*) is quality only; the SPEED and QUALITY lines are never read here.
      REPEATABLE                      -> AS IS
      NOT REPEATABLE / CHECK FAILED   -> the HC_Q8-off check (work/qwen4-kit/hcoff/gap-ud31-hcoff.sh: the v3.1 U config
                                         with STRATA_HC_Q8=0, exact7 twice; results/r23/ud31/hcoff/gap-exact/decision.json):
                                         REPEATABLE -> HC_Q8 OFF; anything else, or not run yet -> VETOED
      VOID / NOT RUN / no file / .json and .txt disagree -> NOT DECIDED (no result, no veto: Unsloth runs as is, flagged)"""
    ud31 = Path(ud31) if ud31 else UD31_DECISION.parent
    hcoff = Path(hcoff) if hcoff else HCOFF_RESULTS
    dj, dt, hj = ud31 / "decision.json", ud31 / "decision.txt", hcoff / "gap-exact" / "decision.json"
    out = {"state": "NOT DECIDED", "files": [str(dj), str(dt), str(hj)], "hcoff_driver": str(HCOFF_DRIVER), "v31_exactness": None}
    if not dj.exists():
        out["why"] = f"no v3.1 exactness result yet ({dj}: work/r23/gap-ud31.sh has not run) - no veto, Unsloth as is"
        return out
    try:
        v = (json.loads(dj.read_text()).get("exactness") or {}).get("U")
    except (ValueError, OSError) as e:
        out["why"] = f"{dj} unreadable ({e}) - no veto, Karl looks"
        return out
    m = U_LINE.search(dt.read_text(errors="replace")) if dt.exists() else None
    out["v31_exactness"] = v
    if not v or not m or not v.startswith(m.group(1)):
        out["why"] = (f"decision.json says U {v!r}, decision.txt {'says ' + m.group(1) if m else 'has no U line'}: they disagree "
                      "- NOT DECIDED (no veto, Karl looks)")
        return out
    if v.startswith("REPEATABLE"):
        out.update(state="AS IS", why=f"U's v3.1 exactness: {v} - Unsloth as is")
    elif v.startswith(EXACT_FAILED):
        hv = None
        if hj.exists() and hj.stat().st_mtime < dj.stat().st_mtime:   # a result of an earlier v3.1 run: not this one's
            out["hcoff_stale"] = f"{hj} is older than {dj}: not counted"
        elif hj.exists():
            try:
                hv = json.loads(hj.read_text()).get("verdict")
            except (ValueError, OSError):
                hv = None
        out["hcoff_exactness"] = hv
        if hv and hv.startswith("REPEATABLE"):
            out.update(state="HC_Q8 OFF", why=f"U's v3.1 exactness {v} with STRATA_HC_Q8=1, {hv} with it off ({hj}): day one "
                                              "uses Unsloth with STRATA_HC_Q8=0")
        else:
            out.update(state="VETOED", why=f"U's v3.1 exactness {v}; with STRATA_HC_Q8 off: "
                                           + (hv or f"not run yet ({HCOFF_DRIVER.name} is the step that decides)")
                                           + " - Unsloth VETOED (Karl 11-06)")
    else:
        out["why"] = f"U's v3.1 exactness: {v} - no result, no veto (Unsloth as is; re-read when the gap reruns)"
    return out


def cmd_hcoff(a):
    """the HC_Q8-off check as a gap step (no .ready file): the v3.1 gap's U config (results/r23/ud31/configs/ud31-U.json)
    with STRATA_HC_Q8 1 -> 0 and no fallback, nothing else; the kit's exactness smoke + exact7 twice at pin 2500; the
    switch checked off in the engine log; it refuses (exit 1) unless U's v3.1 exactness failed (q4_rules.py hcoffneed)"""
    out = Path(a.out).resolve()
    for d in ("configs", "drivers"):
        (out / d).mkdir(parents=True, exist_ok=True)
    src = WS / "results/r23/ud31/configs/ud31-U.json"
    cfg = json.loads(src.read_text(), object_pairs_hook=OrderedDict)
    cfg["env"]["STRATA_HC_Q8"] = "0"
    fb = cfg.pop("fallback", None)
    cfg["log"] = str(WS / "logs/engine-ud31-U-hcoff.log")
    cfg["model_name"] = str(cfg.get("model_name", "strata-ud31-U")) + "-hcoff"
    cfg["_dayone"] = OrderedDict([("written", f"{VERSION} {now()}: Karl 11-06's HC_Q8-off check. NOT RUN."),
                                  ("from", str(src)), ("changes", f"STRATA_HC_Q8 1 -> 0; fallback dropped ({fb}); its own log; "
                                                                  "nothing else")])
    cfg_p = out / "configs" / "ud31-U-hcoff.json"
    cfg_p.write_text(json.dumps(cfg, indent=1) + "\n")
    tree = KIT / "unsloth-v31/dl/tree.json"
    paths = sorted(e["path"] for e in json.loads(tree.read_text()) if e.get("type") == "file" and e["path"].startswith("UD-IQ3_XXS/"))
    dest = WS / "models/unsloth-v31/UD-IQ3_XXS"
    files = [str(dest / Path(p).name) for p in paths]
    prm = OrderedDict([("version", VERSION), ("name", "ud31-hcoff"), ("label", "UD-IQ3_XXS v3.1, STRATA_HC_Q8=0"), ("mode", "swap"),
                       ("config", str(cfg_p)), ("config_sha256", {str(cfg_p): sha256_file(cfg_p)}), ("exe", cfg["exe"]),
                       ("ngpu", 2), ("files", files), ("pack", str(WS / "bringup/out/ud31/pack-u")), ("hc_q8", True),
                       ("hc_q8_switch", "off"), ("expert_cache_auto_ok", "the v3.1 gap's U config as it ran (auto; exact7 pins 2500)"),
                       ("prompt_dir", str(D1.PROMPTS)), ("retok_needed", False), ("pin", F1["pin"]),
                       ("slots", {"main": 0, "helper": None}),
                       ("dl", {"n": 1, "items": [{"dest": str(dest), "tree": str(tree), "paths_csv": ",".join(paths)}]}),
                       ("drafter_rt", None), ("minutes", dict(MIN)), ("target", [40, 60]),
                       ("hcoff", {"ud31": str(UD31_DECISION.parent), "rule": "Karl 11-06 (u_exact_state)"})])
    prm_p = out / "drivers" / "params-ud31-hcoff.json"
    prm_p.write_text(json.dumps(prm, indent=1) + "\n")
    mins = dict(MIN)
    v = {"VERSION": VERSION, "WHEN": now(), "NAME": "ud31-hcoff", "LABEL": prm["label"], "SHORT": slug("ud31-hcoff"),
         "MODE": "the v3.1 U file with STRATA_HC_Q8 off", "MODE_KEY": "swap", "PARAMS": str(prm_p), "CFG": str(cfg_p),
         "EXE": cfg["exe"], "NGPU": 2, "TREE": str(WS / "strata-r22p028x"),
         "ENGINES": "strata strata-host strata-vision strata-dsv41 llama-server ollama", "RESULTS": str(Path(a.results).resolve()),
         "PROMPT_DIR": str(D1.PROMPTS), "EVICT": " ".join(files), "SHARDS": " ".join(files), "PACK": prm["pack"], "PIN": F1["pin"],
         "E7REF": "x28h-e7a", "E7REF_WHAT": "against P028x's x28h-e7a, INFO (as the v3.1 gap's U1)", "PRED_MAIN": 0, "PRED_PIN": 0,
         "DRAFTER": "", "PRED_HELPER_ARG": "", "E7_MIN": mins["e7"], "SMOKE_MIN": mins["smoke"], "SCR_MIN": mins["scr"],
         "TARGET": "40,60", "KLDATA": "-", "MAXM": 6 + 2 * mins["e7"] + mins["smoke"] + 8,
         "WHAT": "U's EXACTNESS with STRATA_HC_Q8 off (Karl 11-06's veto check)"}
    d = write_driver(out / "gap-ud31-hcoff.sh", "exact_hcoff", v, label="exact")
    rel = str(Path(d["path"]).resolve().relative_to(WS)) if str(Path(d["path"]).resolve()).startswith(str(WS)) else d["path"]
    (out / "QUEUE.txt").write_text(
        f"gap-ud31-hcoff.sh ({VERSION}, {now()}): Karl 11-06's HC_Q8-off check of the v3.1 U file. NOT QUEUED, no .ready.\n"
        f"It refuses (exit 1, 8080 untouched) unless results/r23/ud31/decision.json says U NOT REPEATABLE / CHECK FAILED.\n"
        f"To queue: review, write {rel}.ready, add `{rel}` to the STEPS after work/r23/gap-ud31-dec.sh (a refusal costs one "
        f"retry and a skip). ~{v['MAXM']} min with 8080 down. Result: {Path(a.results).resolve()}/gap-exact/decision.json -> "
        "dayone.py u_exact_state (HC_Q8 OFF / VETOED).\n")
    log(f"HC_Q8-off check: {d['path']} (bash -n {d['bash_n']}; .ready {'PRESENT' if d['ready_file'] else 'none'})")
    return 0


# =====================================================================================================================
# 13b. the dense 27B's Q4 split as a day-one QUALITY comparison (Karl 11-06), on the pinned llama.cpp
# =====================================================================================================================
LCPP_SRC = WS / "ext/llama.cpp-3cf03257"
LCPP_BUILD = KIT / "lcpp-build"
CUDA_HOME = Path("/usr/local/cuda-13.3")


def export_texts(dest, tree, names=None):
    """the kit's 8 distinct texts (pf_yardstick long40's files: bringup/out/r20a/prompts, Flash-Next ids with the template
    applied) decoded to UTF-8 with Flash-Next's tokenizer (the tree's tools/strata_tokenizer.py), for llama-perplexity -f.
    llama.cpp tokenizes them itself (special tokens as text): the same texts, not the same token ids"""
    dest = Path(dest)
    dest.mkdir(parents=True, exist_ok=True)
    py = load("pf_yardstick", WS / "work/r22/pf_yardstick.py")
    files = names or [f for f, _ in py.LONG40]
    sys.path.insert(0, str(Path(tree) / "tools"))
    try:
        import strata_tokenizer as ST  # noqa: E402
        tok = ST.Tokenizer.from_gguf(str(SERVED))     # (it imports the tree's gguf_reader lazily)
    finally:
        sys.path.remove(str(Path(tree) / "tools"))   # no tools/ module may shadow a later import here
    meta = OrderedDict()
    for f in files:
        ids = [int(x) for x in (D1.PROMPTS / f).read_text().replace("\n", ",").split(",") if x.strip()]
        stem = f.split(".")[0]
        txt = tok.decode(ids)
        (dest / f"{stem}.txt").write_text(txt)
        c = min(32768, (len(ids) // 2) // 512 * 512)
        meta[stem] = {"file": f, "tokens_flash_next": len(ids), "chars": len(txt), "ctx": c, "scored": c - 1 - c // 2}
    (dest / "texts.json").write_text(json.dumps(meta, indent=1) + "\n")
    return meta


def lcpp_layers_fit(s, a, kv_ctx=32768):
    """layers of a file that fit both cards for llama.cpp (R: quality only, the rest on the CPU): 90 % of the two rooms
    less the head, the drafter and the K/V at kv_ctx (q8_0)"""
    room_h = (a.helper_free_gib - a.helper_keep_mib / 1024 - a.dense_stage_overhead_gib) * GIB
    room_m = a.vram_main_mib * MIB - a.dense_overhead_gib * GIB - a.reserve_mib * MIB - s["head"] - s["other"] - s["mtp"]
    room = 0.9 * (room_h + room_m) - kv_ctx * s["kv_cell"]
    per = s["layers"] / max(1, s["trunk"])
    return max(0, min(s["trunk"], int(room // per))), room_h / GIB, room_m / GIB


def dense_q4split(a, out, rows, pick, place, support):
    """Karl 11-06: "Dense 27B: yes, Q3 on the 5080 alone as the plan. Add a Q4 split across both cards as a day-one
    quality comparison." The largest Q4-class quant that fits across both cards (placement B) against the plan's pick,
    both scored against the largest quant (R). Strata cannot run it (support), so it is planned on the pinned llama.cpp
    (ext/llama.cpp-3cf03257: its llama-arch.cpp names the file's architecture; a layer split runs on mixed cards in one
    build for sm_89 + sm_120): QUALITY ONLY - no speed claim."""
    res = OrderedDict([("rule", "Karl 11-06: Q3 on the 5080 alone stays the plan; a Q4 split across both cards as a day-one QUALITY "
                                "comparison (no speed claim)")])
    q4 = next((r for r in rows if re.search(r"(?<![A-Z0-9])I?Q4", r["label"].upper()) and r["fit"]["B"]["fits"]), None)
    ref = rows[0] if rows else None
    if q4 is None:
        res["state"] = "NOT POSSIBLE: no Q4-class quant fits across both cards"
        return res
    if q4 is pick:
        res["state"] = "NOT NEEDED: the plan's pick is that Q4 quant across both cards already"
        return res
    if ref is None or ref["weights_gib"] <= max(q4["weights_gib"], pick["weights_gib"]):
        res["state"] = "NOT POSSIBLE: no quant larger than Q4 and Q3 to serve as the reference R"
        return res
    split_ok = (Path(support["tree"]) / "src/split").is_dir()
    res["strata"] = (support["verdict"] + ". Even for a family it ran: strata-split needs one compute capability on every "
                     "card (src/split/src/card_check.hpp: 5080 sm_120 + 4060 Ti sm_89 differ) and is built with FNX_27B=0; the main "
                     "engine's layer split runs mixed cards (MULTI_GPU.md, 4060 Ti + 5080 measured) but only for the families "
                     "it runs" + ("" if split_ok else " (this tree has no split engine)")) if not support["runs"] else \
        "a release runs the family: re-plan this comparison on Strata's main-engine layer split (mixed cards work there)"
    arch = pick["s"]["arch"]
    archs = re.findall(r'\{ LLM_ARCH_\w+,\s*"([^"]+)"\s*\}', (LCPP_SRC / "src/llama-arch.cpp").read_text(errors="replace"))
    res["llama_cpp"] = {"src": str(LCPP_SRC), "knows_arch": arch in archs, "arch": arch, "build": str(LCPP_BUILD),
                        "built": (LCPP_BUILD / "bin/llama-perplexity").exists(),
                        "build_commands": [
                            f"bash {WS}/work/r23/nogap-run.sh {out}/lcpp-build.log cmake -S {LCPP_SRC} -B {LCPP_BUILD} -DGGML_CUDA=ON "
                            f"-DCMAKE_CUDA_ARCHITECTURES='89;120' -DCMAKE_CUDA_COMPILER={CUDA_HOME}/bin/nvcc -DLLAMA_CURL=OFF "
                            "-DCMAKE_BUILD_TYPE=Release -DLLAMA_BUILD_SERVER=OFF",
                            f"bash {WS}/work/r23/nogap-run.sh {out}/lcpp-build.log cmake --build {LCPP_BUILD} --target llama-perplexity -j 12"],
                        "note": "NOT built (a build: Karl's go, under nogap-run.sh; no GPU needed to build)"}
    tex = export_texts(out / "texts", a.rel)
    tpl = json.loads(D1.TEMPLATE_CFG.read_text(encoding="utf-8-sig"))
    uu = (tpl.get("env", {}).get("CUDA_VISIBLE_DEVICES") or "").split(",")
    u5080, u4060 = uu[0], (uu[1] if len(uu) > 1 else "")
    final = lambda r: (str(Path(r["c"]["dest"]) / Path(r["c"]["files"][0]["path"]).name) if r["c"]["source"] == "listed"  # noqa: E731
                       else r["c"]["files"][0]["path"])
    ngl_r, rh, rm = lcpp_layers_fit(ref["s"], a)
    K = q4["fit"]["B"]["split"]["K"]
    tr = q4["s"]["trunk"]
    arms = OrderedDict([
        ("R", {"label": ref["label"], "gguf": final(ref), "cvd": f"{u4060},{u5080}", "ngl": ngl_r,
               "split": f"--split-mode layer --tensor-split {rh:.1f},{rm:.1f}", "min": 8,
               "memneed": round((ref["weights_gib"] * (1 - ngl_r / max(1, ref["s"]["trunk"]))) + 18.0, 1),
               "why": f"the reference: the largest quant; {ngl_r} of {ref['s']['trunk']} layers on the two cards, the rest on the CPU (quality only)"}),
        ("Q3", {"label": pick["label"], "gguf": final(pick), "cvd": u5080, "ngl": 99, "split": "--split-mode none", "min": 3,
                "memneed": 18.0, "why": f"the plan ({place}): the 5080 alone"}),
        ("Q4", {"label": q4["label"], "gguf": final(q4), "cvd": f"{u4060},{u5080}", "ngl": 99,
                "split": f"--split-mode layer --tensor-split {K},{tr + 1 - K}", "min": 3, "memneed": 18.0,
                "why": f"across both cards: the 4060 Ti first with ~{K} layers (the Strata fit's split), the 5080 last with the head"})])
    dl = {"n": 0, "items": []}
    for r in (ref, pick, q4):
        if r["c"]["source"] == "listed":
            dl["n"] += 1
            dl["items"].append({"dest": r["c"]["dest"], "tree": r["c"]["tree_json"], "paths_csv": ",".join(f["path"] for f in r["c"]["files"])})
    name = f"{a.name}-q4split"
    files = sorted({x for r in (ref, pick, q4) for x in ([str(Path(r["c"]["dest"]) / Path(f["path"]).name) for f in r["c"]["files"]]
                                                         if r["c"]["source"] == "listed" else [f["path"] for f in r["c"]["files"]])})
    results = out / "gaps" / name
    lq = OrderedDict([("lcpp", str(LCPP_BUILD / "bin/llama-perplexity")), ("lcpp_build", str(LCPP_BUILD)), ("lcpp_src", str(LCPP_SRC)),
                      ("arch", arch), ("texts", list(tex)), ("ctx", {k: v["ctx"] for k, v in tex.items()}),
                      ("scored", {k: v["scored"] for k, v in tex.items()}), ("arms", arms),
                      ("engine_note", "llama.cpp, NOT Strata: quality only, no speed claim"),
                      ("kv", "-fa on -ctk q8_0 -ctv q8_0 on every arm (int8-class K/V, as the kit's Strata configs)")])
    prm = OrderedDict([("version", VERSION), ("name", name), ("label", f"{q4['label']} split vs {pick['label']} (5080) vs R {ref['label']}"),
                       ("mode", "lcpp"), ("config", None), ("exe", lq["lcpp"]), ("ngpu", 2), ("files", files), ("dl", dl),
                       ("minutes", dict(MIN)), ("lq", lq)])
    prm_p = out / "drivers" / f"params-{name}.json"
    prm_p.parent.mkdir(parents=True, exist_ok=True)
    prm_p.write_text(json.dumps(prm, indent=1) + "\n")
    maxm = 6 + len(tex) * sum(v["min"] for v in arms.values()) + 8
    v = {"VERSION": VERSION, "WHEN": now(), "NAME": name, "LABEL": prm["label"], "SHORT": slug(name), "MODE": "llama.cpp, quality only",
         "MODE_KEY": "lcpp", "PARAMS": str(prm_p), "CFG": str(out / "configs" / f"{a.name}.json"), "EXE": lq["lcpp"], "NGPU": 2,
         "TREE": str(a.rel), "ENGINES": "strata strata-host strata-vision strata-dsv41 llama-server ollama llama-perplexit",
         "RESULTS": str(results), "PROMPT_DIR": str(D1.PROMPTS), "EVICT": " ".join(files), "SHARDS": " ".join(files), "MAXM": maxm,
         "WHAT": f"the dense 27B's Q4 split QUALITY comparison on llama.cpp ({q4['label']} vs {pick['label']})",
         "LCPP": lq["lcpp"], "TEXTS": str(out / "texts"), "BASEDIR": str(results / "kld")}
    res["driver"] = write_driver(out / "drivers" / f"gap-{name}.sh", "lcpp_kl", v, label="q4split")
    res.update(state="WRITTEN (not queued; refuses until the pinned llama.cpp is built: lcppcheck)", params=str(prm_p),
               arms={k: {x: y for x, y in v_.items() if x in ("label", "cvd", "ngl", "split", "why")} for k, v_ in arms.items()},
               minutes_8080_down=maxm, texts={k: v_["ctx"] for k, v_ in tex.items()})
    return res


# =====================================================================================================================
# 12. the fit table (Karl 11-05 item 3)
# =====================================================================================================================
QCLASS = [("IQ1_M", None), ("IQ2_XXS", None), ("IQ2-class mix", 2.4), ("IQ2_S", None), ("IQ3_XXS", None),
          ("IQ3_S mix (Flash-Next's)", 3.33), ("IQ3_S", None), ("IQ4_XS", None), ("Q4_K", None), ("Q5_K", None),
          ("Q6_K", None), ("Q8_0", None)]


def qclasses():
    D1.type_table(Path(D1.TREE))
    out = []
    for n, bpw in QCLASS:
        if bpw is None:
            tid = D1.NAME2ID.get(n)
            _, bs, tb = D1.TYPES[tid]
            bpw = 8 * tb / bs
        out.append((n, round(bpw, 4)))
    return sorted(out, key=lambda x: x[1])


def best_class(bpw, cls):
    fit = [n for n, b in cls if b <= bpw + 1e-9]
    return fit[-1] if fit else None


def cmd_fit(a):
    """Karl 11-05 item 3: the expert budget per hardware option and n-gram placement, and the bpw it gives the experts
    of a 250 / 300 / 400B model (UPGRADE-ESTIMATE section 8's convention: totals WITHOUT the n-gram table; --gguf: this
    file's own numbers instead)."""
    dd = d1_defaults()
    floor, other, head = dd.get("--floor-gib", 12.0), dd.get("--other-gib", 16.3), dd.get("--headroom-gib", 5.7)
    mt96 = dd.get("--memtotal-gib", 92.0)
    lost = 96.0 - mt96          # firmware + the iGPU's carve-out + the kernel: 96 GiB of DIMMs -> MemTotal 92.0 today
    helper_4060 = 7.56 - dd.get("--helper-keep-mib", 512) / 1024
    main_room, src, file_info = a.main_gib, "UPGRADE-ESTIMATE 8.1 (Qwen4 guess: dense 7-8.5B, KV, MTP)", None
    ngram_gib = a.ngram_gib
    if a.gguf:
        D1.type_table(Path(a.tree))
        E = D1.engine_tables(Path(a.tree))
        m = D1.Model(a.gguf)
        s = D1.sizes(m, E)
        ref = D1.Model(SERVED)
        sr = D1.sizes(ref, E)
        P = argparse.Namespace(**{k.lstrip("-").replace("-", "_"): v for k, v in dd.items() if k.startswith("--")})
        P.helpers = [(7.56, 288.0)]
        kvc, _ = D1.kv_cell_bytes(m, P.kv)
        kvr, _ = D1.kv_cell_bytes(ref, P.kv)
        B = D1.budget(P, s, sr, kvc, kvr, s["mtp_infile"] or P.drafter_gib * GIB)
        main_room, src = B["main"] / GIB, f"day1's budget on {Path(a.gguf).name} (its dense part, K/V, drafter)"
        ngram_gib = ngram_gib or s["ple"] / GIB
        file_info = {"file": a.gguf, "expert_params_b": s["expert_elems"] / 1e9, "experts_gib": s["experts"] / GIB,
                     "experts_bpw": 8 * s["experts"] / s["expert_elems"] if s["expert_elems"] else None, "ngram_gib": s["ple"] / GIB}
    ngram_gib = ngram_gib if ngram_gib is not None else 26.822
    hw = [("today: 5080 + 4060 Ti 8 GB, 96 GB", helper_4060, mt96), ("5080 + 5060 Ti 16 GB, 96 GB", a.helper_5060_gib, mt96),
          ("5080 + 4060 Ti 8 GB, 2x64 GB", helper_4060, 128.0 - lost), ("5080 + 5060 Ti 16 GB, 2x64 GB", a.helper_5060_gib, 128.0 - lost)]
    places = [("SSD", 0.0)] + [(f"RAM ({f:g}x Flash-Next's table: {f * ngram_gib:.1f} GiB)", f * ngram_gib) for f in a.ngram_factors] \
        if not a.gguf else [("SSD", 0.0), (f"RAM ({ngram_gib:.1f} GiB, this file's)", ngram_gib)]
    cls = qclasses()
    totals = [float(x) for x in a.totals.split(",")]
    rows = []
    for hn, hgib, mt in hw:
        tier = mt - floor - other - head
        for pn, tab in places:
            budget = main_room + hgib + tier - tab
            r = {"hardware": hn, "ngram": pn, "main_gib": main_room, "helper_gib": hgib, "ram_tier_gib": tier - tab,
                 "memtotal_gib": mt, "budget_gib": budget, "bpw": {}}
            for t in totals:
                ep = (t - a.dense_b) * 1e9
                bpw = 8 * budget * GIB / ep
                r["bpw"][f"{t:g}"] = {"expert_params_b": ep / 1e9, "bpw": bpw, "class": best_class(bpw, cls)}
            if file_info:
                r["file_bpw_fits"] = file_info["experts_gib"] <= budget
            rows.append(r)
    L = [f"# Expert budget and bpw (dayone.py fit, {VERSION}, {now()})", "",
         f"Expert room = the 5080 ({main_room:.2f} GiB: {src}) + the helper card + the RAM tier (MemTotal - the {floor:g} GiB "
         f"floor - {other:g} GiB everything else - {head:g} headroom; day1.py's defaults). MemTotal at 2x64 GB = 128 - "
         f"{lost:.1f} GiB (today 96 -> {mt96:g}). 5060 Ti: {a.helper_5060_gib:g} GiB of experts (UPGRADE-ESTIMATE 6.5 / "
         f"qwen4.py); 4060 Ti: 7.56 - 0.5 = {helper_4060:.2f}.",
         f"n-gram / Engram table: SSD = today's (--ple-io direct: no RAM tier); RAM = --ple-io ram, out of the RAM tier.",
         f"bpw = budget x 8 / expert parameters; expert parameters = total - {a.dense_b:g}B dense (UPGRADE-ESTIMATE 8.1: "
         "7-8.5B; totals WITHOUT the n-gram table, section 8's convention). Class = the largest single type (gguf block "
         "sizes) or section 8's mix at or below that bpw.", ""]
    hdr = "| hardware | n-gram table | expert budget GiB | " + " | ".join(f"{t:g}B: bpw (class)" for t in totals) + " |"
    L += [hdr, "|---|---|---|" + "---|" * len(totals)]
    for r in rows:
        cells = []
        for t in totals:
            b = r["bpw"][f"{t:g}"]
            cells.append(f"{b['bpw']:.2f} ({b['class'] or 'below IQ1_M: an SSD expert tier - DeepSeek only so far, Karl decides'})")
        L.append(f"| {r['hardware']} | {r['ngram']} | **{r['budget_gib']:.1f}** | " + " | ".join(cells) + " |")
    L += ["", f"Today with the table on the SSD: {main_room:.2f} + {helper_4060:.2f} + {mt96 - floor - other - head:.1f} = "
          f"**{main_room + helper_4060 + mt96 - floor - other - head:.1f} GiB** (the kit's ~72 GiB).",
          "Classes for reference: " + ", ".join(f"{n} {b:.2f}" for n, b in cls)]
    if file_info:
        L.append(f"This file: {file_info['expert_params_b']:.1f}B expert parameters, {file_info['experts_gib']:.2f} GiB of experts "
                 f"({file_info['experts_bpw']:.2f} bpw); n-gram table {file_info['ngram_gib']:.2f} GiB; fits: "
                 + ", ".join(f"{r['hardware']} / {r['ngram'].split(' (')[0]}: {'yes' if r['file_bpw_fits'] else 'no'}" for r in rows))
    L.append("Caveats: 2x64 GB sticks are dual-rank - whether 6000 MT/s holds on this board is not known (the RAM fault "
             "history: 6200 failed, 6000 runs); the 5060 Ti room is a scaled estimate, not measured; bytes only - decode "
             "speed is UPGRADE-ESTIMATE section 8's job.")
    txt = "\n".join(L) + "\n"
    print(txt, end="")
    if a.out:
        od = Path(a.out)
        od.mkdir(parents=True, exist_ok=True)
        (od / "fit.md").write_text(txt)
        (od / "fit.json").write_text(json.dumps({"rows": rows, "classes": cls, "file": file_info, "main_src": src}, indent=1) + "\n")
    return 0


# =====================================================================================================================
# 13. the dense fallback (Karl 11-05 item 4): a dense Qwen4-27B, 5080 alone with >= 32K, else both cards in VRAM
# =====================================================================================================================
DENSE_EVIDENCE = (
    ("include/strata/artifact/model_family.hpp", r'inline ModelFamily model_family_from_arch\(const std::string& arch\) \{',
     "the family table: general.architecture -> family (only the arch strings listed after it are known)"),
    ("include/strata/artifact/model_family.hpp", r"inline bool model_family_runs\(ModelFamily f\) \{[^\n]*",
     "the main engine path runs this family only"),
    ("include/strata/artifact/gguf_reader.hpp", r"if \(arch->s != \"qwen4exp\"\) return [^\n]*",
     "read_geometry refuses any other architecture"),
    ("include/strata/core/geometry.hpp", r"int64_t n_embd = \d+;[^\n]*", "the compiled shape: Flash-Next's width"),
    ("include/strata/core/geometry.hpp", r"int64_t n_expert = \d+;[^\n]*", "the compiled shape: routed experts"),
    ("src/program/generate.cpp", r"qwen35 = strata::model_family\(meta\) == strata::ModelFamily::Qwen35Moe;",
     "the family switch: the only other path is Qwen3.6-35B-A3B (MoE)"),
    ("src/qwen35/q36_engine.cu", r'err = "strata-q36 runs Qwen3\.6-35B-A3B \(qwen35moe\) files only";',
     "the qwen35 path refuses every other family"),
    ("tools/iq_pack.py", r"the model has no expert tensors", "the pack refuses a file without routed experts"),
    ("src/split/src/model.hpp", r"make FNX_MODEL=27b: Qwen3\.8-27B, dense[^\n]*",
     "the split engine (vendored sFNX) knows a dense Qwen3.8-27B only under FNX_27B"),
    ("src/split/src/model.cpp", r'const std::string p = "qwen35\.";', "sFNX's 27B reads architecture 'qwen35'"),
    ("src/split/src/model.cpp", r"27b: \" \+ what \+ \" is not Q8_0 \(the 27B's matvecs read Q8_0 only\)",
     "sFNX's 27B runs Q8_0 matrices only"),
    ("src/split/CMakeLists.txt", r"FNX_27B=0", "every strata-split target is built with FNX_27B=0"),
    ("src/split/src/card_check.hpp", r"if \(cc != arch\)", "strata-split: every card must be the build's one compute capability"),
    ("build/CMakeCache.txt", r"STRATA_BUILD_SPLIT:BOOL=\w+", "this tree's build: strata-split on/off"),
    ("docs/MULTI_GPU.md", r"\| `STRATA_STAGE_TRIM=1` \|[^\n]*", "the layer split's per-stage weights (a dense model needs them)"),
    ("docs/MULTI_GPU.md", r"Every card: a copy of the dense weights[^\n]*", "a layer split copies the dense weights by default"),
)


def dense_support(tree, arch):
    """Does the tree run a dense file of architecture ARCH? Read from its source at run time, each line cited."""
    S = D1.Src(Path(tree))
    ev = []
    split = (Path(tree) / "src/split").is_dir()
    for rel, pat, what in DENSE_EVIDENCE:
        if not split and (rel.startswith("src/split/") or rel == "build/CMakeCache.txt"):
            continue
        m, c = S.find(rel, pat)
        ev.append({"what": what, "where": c, "text": m.group(0)[:170] if m else None})
    mf = S.text("include/strata/artifact/model_family.hpp")
    fams = re.findall(r'if \(arch == "([^"]+)"\)', mf)
    if split:
        s27 = sorted(p.name for p in (Path(tree) / "src/split/src").glob("s27*"))
        ev.append({"what": "sFNX's 27B sources (src/s27_*: s27_engine.cu, s27_attn.cuh), named in model.hpp / engine.hpp",
                   "where": f"{Path(tree).name}/src/split/src/s27*", "text": ", ".join(s27) if s27 else "NOT IN THE TREE"})
    else:
        ev.append({"what": "the split engine (strata-split, vendored sFNX: v0.2.11's tree has its 27B code compiled out)",
                   "where": f"{Path(tree).name}/src/split", "text": "NOT IN THIS TREE"})
    # qwen4exp's path is compiled for Flash-Next's MoE shape (geometry.hpp n_expert 512) and qwen35moe's for Qwen3.6's
    # MoE: a dense file runs only on a family a release ADDS - the check passes then, and the release is read before use
    known = arch in fams
    runs = known and arch not in ("qwen4exp", "qwen35moe")
    verdict = ("RUNS (a family this tree knows beyond the two MoE paths: read its dense path before any .ready file)" if runs else
               f"NO: '{arch}' is {'a family this tree knows but does not run as a dense model' if known else 'not in the family table'} "
               f"({', '.join(fams)} only; both are MoE paths)"
               + ("; the split engine's dense 27B code is compiled out (FNX_27B=0, its s27 sources absent) and the split engine "
                  "needs one compute capability on every card (5080 sm_120 + 4060 Ti sm_89: no)" if split else
                  "; this tree has no split engine"))
    return {"tree": str(tree), "arch": arch, "families": fams, "known": known, "runs": runs, "verdict": verdict, "evidence": ev}


def dense_sizes(m):
    trunk = D1.trunk_of(m)
    per = [0] * trunk
    head = embed = ple = mtp = vision = other = 0
    params = 0
    experts = any(t.name.endswith("_exps.weight") for t in m.tensors.values())
    for t in m.tensors.values():
        nb, l = t.nbytes or 0, D1.layer_of(t.name)
        if t.name.startswith(("v.", "mm.")):
            vision += nb
            continue
        if t.name == "per_layer_token_embd.weight":
            ple += nb
            continue
        if l is not None and l >= trunk:
            mtp += nb
            continue
        params += t.n
        if t.name == "token_embd.weight":
            embed += nb
        elif l is not None:
            per[l] += nb
        elif t.name == "output.weight":
            head += nb
        else:
            other += nb
    kvc, n_attn = D1.kv_cell_bytes(m, "int8")
    fai = D1.ai(m, "full_attention_interval")
    attn = [l for l in range(trunk) if (fai > 0 and (l + 1) % fai == 0) or fai <= 0]
    S_, vh, gc = D1.ai(m, "ssm.state_size"), D1.ai(m, "ssm.time_step_rank"), D1.ai(m, "ssm.group_count")
    k_ = D1.ai(m, "ssm.conv_kernel")
    gdn = [l for l in range(trunk) if l not in attn] if fai > 0 else []
    gdn_state = (vh * S_ * S_ * 4 + (2 * gc * S_ + vh * S_) * max(0, k_ - 1) * 4) if gdn else 0   # per layer, one sequence
    return {"trunk": trunk, "per_layer": per, "layers": sum(per), "head": head, "embed": embed, "ple": ple, "mtp": mtp,
            "vision": vision, "other": other, "params": params, "kv_cell": kvc, "n_attn": len(attn), "attn": attn, "gdn": gdn,
            "gdn_state_layer": gdn_state, "has_experts": experts, "arch": m.arch,
            "bpw": 8 * (sum(per) + head + embed + other) / params if params else None}


def dense_fit(s, a):
    """the VRAM fit of one dense file: A = the 5080 alone, B = a layer split (the 4060 Ti first with layers [0, K), the
    5080 last with the rest + the head + the draft layer: MULTI_GPU.md "the faster card goes last"; per-stage weights
    as --trim-stage-weights). The token embedding stays in RAM (a row a token; sFNX's 27B locks it in RAM, model.cpp),
    the n-gram table where --ngram-placement says. K/V int8 at the context on each card for its attention layers."""
    vram = a.vram_main_mib * MIB
    fixed = a.dense_overhead_gib * GIB + a.reserve_mib * MIB + s["head"] + s["other"] + s["mtp"]
    room_a = vram - fixed - s["layers"] - len(s["gdn"]) * s["gdn_state_layer"]
    kv_l = s["kv_cell"] / max(1, s["n_attn"])
    ctx_a = int(max(0, room_a) // s["kv_cell"]) // 1024 * 1024 if s["kv_cell"] else 0
    helper = (a.helper_free_gib - a.helper_keep_mib / 1024 - a.dense_stage_overhead_gib) * GIB
    best, first_ok = None, None
    for K in range(1, s["trunk"]):
        wh = sum(s["per_layer"][:K]) + sum(1 for l in s["gdn"] if l < K) * s["gdn_state_layer"]
        wm = sum(s["per_layer"][K:]) + sum(1 for l in s["gdn"] if l >= K) * s["gdn_state_layer"]
        kh = sum(1 for l in s["attn"] if l < K) * kv_l
        km = sum(1 for l in s["attn"] if l >= K) * kv_l
        ch = (helper - wh) / kh if kh else (float("inf") if helper >= wh else -1)
        cm = (vram - fixed - wm) / km if km else (float("inf") if vram - fixed >= wm else -1)
        ctx = int(max(0, min(ch, cm, 1 << 30))) // 1024 * 1024
        row = {"K": K, "helper_gib": (wh + kh * min(ctx, a.min_ctx)) / GIB, "main_gib": (fixed + wm + km * min(ctx, a.min_ctx)) / GIB,
               "ctx": ctx, "helper_weights_gib": wh / GIB, "main_weights_gib": (wm + s["head"]) / GIB}
        if best is None or ctx > best["ctx"]:
            best = row
        if first_ok is None and ctx >= a.min_ctx:
            first_ok = row
    eff = a.bw_eff

    def tok_s(main_b, helper_b, handoff):
        t = main_b / (a.bw_main_gbs * 1e9 * eff) + helper_b / (a.bw_helper_gbs * 1e9 * eff) + handoff
        return 1.0 / t if t > 0 else None
    read_a = s["layers"] + s["head"]
    out = {"A": {"fits": ctx_a >= a.min_ctx, "max_ctx": ctx_a, "vram_weights_gib": (fixed + s["layers"]) / GIB,
                 "need_at_min_ctx_gib": (fixed + s["layers"] + len(s["gdn"]) * s["gdn_state_layer"] + a.min_ctx * s["kv_cell"]) / GIB,
                 "decode_tok_s_info": tok_s(read_a, 0, 0)},
           "B": {"fits": first_ok is not None, "split": first_ok, "widest": best,
                 "decode_tok_s_info": tok_s(first_ok["main_weights_gib"] * GIB, first_ok["helper_weights_gib"] * GIB, 0.3e-3)
                 if first_ok else None},
           "assumptions": (f"5080 {a.vram_main_mib:g} MiB - {a.dense_overhead_gib:g} GiB overhead (CUDA context, scratch, prompt "
                           f"buffers: an assumption for a 2x-wider model) - {a.reserve_mib} MiB reserve; 4060 Ti {a.helper_free_gib:g} "
                           f"GiB free - {a.helper_keep_mib:g} MiB kept - {a.dense_stage_overhead_gib:g} GiB stage buffers; decode = "
                           f"weight bytes / ({a.bw_main_gbs:g} | {a.bw_helper_gbs:g} GB/s x {eff:g}), no drafter, INFO only")}
    return out


def cmd_dense(a):
    """Karl 11-05 item 4: the dense fallback - candidates, the engine check, the VRAM fit, the pick, config + drivers"""
    out = Path(a.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    a.rel = a.rel or a.tree
    D1.type_table(Path(a.tree))
    hroot = Path(a.headers).resolve() if a.headers else out / "headers"
    cands = [local_candidate(l_) for l_ in a.local or []]
    listings = dict(kv.split("=", 1) for kv in a.listing or [])
    lsts = []
    for spec in a.repo or []:
        repo, _, rev = spec.partition("@")
        lst = list_repo(repo, rev or "main", listings.get(repo), a.offline)
        lsts.append({k: lst.get(k) for k in ("repo", "commit", "source", "available")})
        if lst.get("available", True):
            tp = out / "listing" / f"{repo.replace('/', '--')}@{lst['commit'][:12]}.json"
            tp.parent.mkdir(exist_ok=True)
            tp.write_text(json.dumps(lst["entries"], indent=0))
            qs, _ = quants_of(lst, dest_root_of(a, repo))
            for q in qs:
                q["tree_json"] = str(tp)
            cands += qs
    D = OrderedDict([("version", VERSION), ("when", now()), ("argv", sys.argv[1:]), ("out", str(out)), ("listings", lsts),
                     ("min_ctx", a.min_ctx), ("rows", [])])
    support = None
    for c in cands:
        c["hdr"] = header_state(c, hroot)
        if c["hdr"]["state"] == "none" and c["source"] == "listed" and not a.offline:   # the headers only (item 2's reader)
            for f in c["files"]:
                head_hf(c["repo"], c["commit"], f["path"], f["size"], hroot)
            c["hdr"] = header_state(c, hroot)
        if c["hdr"]["state"] not in ("disk", "headers"):
            D["rows"].append({"label": c["label"], "verdict": "NO HEADER", "why": c["hdr"]["why"]})
            continue
        m = D1.Model(c["hdr"]["path"])
        s = dense_sizes(m)
        if support is None:
            support = dense_support(a.rel, s["arch"])
        if s["has_experts"]:
            D["rows"].append({"label": c["label"], "verdict": "NOT DENSE", "why": "routed experts in the file: `dayone.py plan`"})
            continue
        f = dense_fit(s, a)
        pk = pack_precheck(c, hroot, a.rel, out / "precheck", offline=True) if not a.no_precheck else None
        D["rows"].append({"label": c["label"], "c": c, "s": s, "fit": f, "pack": pack_summary(pk), "file_gb": c["bytes"] / 1e9,
                          "weights_gib": (s["layers"] + s["head"] + s["other"]) / GIB, "bpw": s["bpw"], "params_b": s["params"] / 1e9})
    rows = sorted([r for r in D["rows"] if r.get("fit")], key=lambda r: -r["weights_gib"])
    pa = next((r for r in rows if r["fit"]["A"]["fits"]), None)
    pb = next((r for r in rows if r["fit"]["B"]["fits"]), None)
    pick, place = (pa, "A") if pa else (pb, "B") if pb else (None, None)
    D["support"] = support
    D["pick"] = {"label": pick["label"] if pick else None, "placement": place,
                 "why": (f"the largest quant that fits the 5080 alone with >= {a.min_ctx:,} context ({pa['label']}, max "
                         f"{pa['fit']['A']['max_ctx']:,})" if pa else
                         f"none fits the 5080 alone with {a.min_ctx:,}: the largest across both cards in VRAM ({pb['label']}, "
                         f"layers 0-{pb['fit']['B']['split']['K'] - 1} on the 4060 Ti)" if pb else "nothing fits VRAM with "
                         f"{a.min_ctx:,} context: Karl decides (RAM offload is not a mode Strata has for a dense model)")
                 + (f"; the largest across both cards would be {pb['label']} (~{pb['fit']['B']['decode_tok_s_info']:.0f} tok/s INFO "
                    f"vs ~{pa['fit']['A']['decode_tok_s_info']:.0f} on the 5080 alone)" if pa and pb and pb is not pa else ""),
                 "rule": "Karl 11-05: on the 5080 alone if it fits with at least 32K context, otherwise across both cards in VRAM; "
                         "inside each, the largest quant (Karl's quant rule)"}
    if pick and not a.no_drivers:
        D["pieces"] = dense_pieces(a, out, pick, place, support)
    if pick and not a.no_q4split:   # Karl 11-06: the Q4 split across both cards, a day-one QUALITY comparison
        D["q4split"] = dense_q4split(a, out, rows, pick, place, support)
    js = copy.deepcopy({k: v for k, v in D.items() if k != "rows"})
    js["rows"] = [{k: v for k, v in r.items() if k not in ("c", "s")} | ({"sizes": {k: v for k, v in r["s"].items()
                  if k not in ("per_layer", "attn", "gdn")}} if r.get("s") else {}) for r in D["rows"]]
    (out / "dense-plan.json").write_text(json.dumps(js, indent=1, default=str) + "\n")
    (out / "DENSE-PLAN.md").write_text(dense_md(D, a))
    log(f"dense plan: {out / 'DENSE-PLAN.md'}")
    return 0


def dense_pieces(a, out, r, place, support):
    """the dense config (P028x.json's machine and lossless settings, no expert flags), params and the kit's exactness +
    speed drivers in their dense form (q4_rules.py densecheck refuses before any gap while the tree does not run it)"""
    c, s, f = r["c"], r["s"], r["fit"]
    name = a.name
    tpl = json.loads(D1.TEMPLATE_CFG.read_text(encoding="utf-8-sig"), object_pairs_hook=OrderedDict)
    env0 = tpl.get("env", {})
    uu = (env0.get("CUDA_VISIBLE_DEVICES") or "").split(",")
    final = [str(Path(c["dest"]) / Path(x["path"]).name) for x in c["files"]] if c["source"] == "listed" else [x["path"] for x in c["files"]]
    ctx = min(f["A"]["max_ctx"] if place == "A" else f["B"]["split"]["ctx"], 131072)
    ctx = max(a.min_ctx, ctx // 4096 * 4096)
    env = OrderedDict((k, env0[k]) for k in D1.MACHINE_ENV if k in env0)
    env["CUDA_VISIBLE_DEVICES"] = uu[0] if place == "A" else ",".join([uu[1], uu[0]] if len(uu) > 1 else uu)
    env.update(D1.LOSSLESS_ENV)
    env.update(D1.V0210_PINS)
    args = ["--native", final[0], "--max-context", str(ctx), "--kv", "int8", "--vram-reserve-mib", str(a.reserve_mib),
            "--chat-cache", "16", "--chat-cache-mib", "2048", "--conversation-cache-mib", "0"]
    if s["ple"]:
        args += ["--ple-io", "ram" if a.ngram_placement == "ram" else "direct"]
    if place == "B":
        args += ["--layer-split", str(f["B"]["split"]["K"]), "--trim-stage-weights"]
    cfg = OrderedDict([("exe", a.exe or f"<SET: the engine of the release that runs '{s['arch']}' (none does today)>"),
                       ("args", args), ("cwd", str(WS)), ("tokenizer", "<SET: the release's tokenizer export of this GGUF>"),
                       ("model_name", f"strata-{name}"), ("log", str(WS / f"logs/engine-{name}.log")),
                       ("lib_dirs", tpl.get("lib_dirs")), ("port", 8081), ("sampling", tpl.get("sampling")), ("host", "127.0.0.1"),
                       ("env", env), ("server", a.server or "<SET: the release tree's serve/server.py>"),
                       ("_dense", OrderedDict([
                           ("written", f"{VERSION} {now()}: the dense fallback (Karl 11-05 item 4). NOT RUN."),
                           ("placement", "A: the 5080 alone" if place == "A" else
                            f"B: a layer split - CUDA_VISIBLE_DEVICES 4060 Ti first, the 5080 last (the last stage runs the head, "
                            f"the draft layer and the verify: MULTI_GPU.md), --layer-split {f['B']['split']['K']} (layers 0-"
                            f"{f['B']['split']['K'] - 1} on the 4060 Ti), --trim-stage-weights (each card its own layers' weights)"),
                           ("context", f"--max-context {ctx:,} (>= {a.min_ctx:,}; the fit's max {f['A']['max_ctx'] if place == 'A' else f['B']['split']['ctx']:,})"),
                           ("drafter", "the file's own nextn layer" + (f" ({s['mtp'] / GIB:.2f} GiB)" if s["mtp"] else ": none in the file")
                            + " - the release's flag for it is not known yet: no --spec / --mtp here"),
                           ("engine", support["verdict"]),
                           ("flags_unknown", "every flag above is the main engine's; a release that adds the dense family may "
                                             "name them differently - review against its docs before the .ready file")]))])
    for d in ("configs", "drivers"):
        (out / d).mkdir(exist_ok=True)
    cfg_p = out / "configs" / f"{name}.json"
    cfg_p.write_text(json.dumps(cfg, indent=1) + "\n")
    shards = [x["path"] for x in c["files"]]
    dl = {"n": 0, "items": []}
    if c["source"] == "listed":
        dl = {"n": 1, "items": [{"dest": c["dest"], "tree": c["tree_json"], "paths_csv": ",".join(shards)}]}
    mins = {k: math.ceil(v * max(1.0, (s["params"] / 6.671e9) ** 0.5)) for k, v in MIN.items()}   # dense: every weight a token
    prm = OrderedDict([("version", VERSION), ("name", name), ("label", c["label"]), ("mode", "dense"), ("config", str(cfg_p)),
                       ("config_sha256", {str(cfg_p): sha256_file(cfg_p)}), ("exe", cfg["exe"]), ("ngpu", 1 if place == "A" else 2),
                       ("files", final), ("pack", None), ("hc_q8", False), ("prompt_dir", str(D1.PROMPTS)),
                       ("retok_needed", None), ("pin", 0), ("slots", {"main": 0, "helper": None}), ("dl", dl), ("drafter_rt", None),
                       ("minutes", mins), ("target", [40, 60]),
                       ("dense", OrderedDict([("arch", s["arch"]), ("tree", str(a.rel)), ("placement", place), ("ctx", ctx),
                                              ("min_ctx", a.min_ctx), ("layer_split", f["B"]["split"]["K"] if place == "B" else None),
                                              ("engine_runs_at_plan", support["runs"]), ("support", support["verdict"]),
                                              ("e7_pin_note", "exact7.sh adds --expert-cache ${PIN_CACHE}: 0 here; a dense engine "
                                                              "that refuses the flag fails exact7, not the gap")]))])
    prm_p = out / "drivers" / f"params-{name}.json"
    prm_p.write_text(json.dumps(prm, indent=1) + "\n")
    exe = cfg["exe"]
    base_v = {"VERSION": VERSION, "WHEN": now(), "NAME": name, "LABEL": c["label"], "SHORT": slug(name), "MODE": f"dense {place}",
              "MODE_KEY": "dense", "PARAMS": str(prm_p), "CFG": str(cfg_p), "EXE": shlex.quote(exe), "NGPU": prm["ngpu"],
              "TREE": str(a.rel), "ENGINES": "strata strata-host strata-vision strata-dsv41 llama-server ollama"
              + ("" if exe.startswith("<") else " " + Path(exe).name[:15]),
              "RESULTS": str(out / "gaps" / name), "PROMPT_DIR": str(D1.PROMPTS), "EVICT": " ".join(final), "SHARDS": " ".join(final),
              "PACK": "none", "PIN": 0, "E7REF": "c13", "E7REF_WHAT": "the first run (INFO): X2 against X1 is the test",
              "PRED_MAIN": 0, "PRED_PIN": 0, "DRAFTER": "", "PRED_HELPER_ARG": "", "E7_MIN": mins["e7"], "SMOKE_MIN": mins["smoke"],
              "SCR_MIN": mins["scr"], "TARGET": "40,60", "KLDATA": "-",
              "STARTQ": "$P -I -B $Q4R startcheck $SPD/Q1.startlog $(slog q4-$SHORT-Q1) --gate start_Q --gates $G 8>&- 9>&- | tee -a $S",
              "STARTQ_WHAT": "q4_rules startcheck (unwanted lines only)"}
    drv = {}
    for kind, maxm in (("exact_dense", 6 + 2 * mins["e7"] + mins["smoke"] + 8), ("speed_dense", 6 + 6 * mins["scr"] + 8)):
        lab = kind.split("_")[0]
        v = dict(base_v, MAXM=maxm, WHAT={"exact": "the EXACTNESS SMOKE", "speed": "the SPEED SCREEN"}[lab] + f" of {name} (dense)")
        if lab == "speed":
            v["EVICT"] = " ".join(final + [str(SERVED.parent / "*.gguf")])
        drv[lab] = write_driver(out / "drivers" / f"gap-{name}-{lab}.sh", kind, v, label=lab)
    return {"config": str(cfg_p), "params": str(prm_p), "drivers": drv, "ctx": ctx}


def dense_md(D, a):
    L = [f"# Dense fallback plan ({D['when']}, {D['version']})", "",
         f"`dayone.py {' '.join(shlex.quote(x) for x in D['argv'])}`", "",
         "Karl 11-05 (item 4): \"a second path for a dense Qwen4-27B ... on the 5080 alone if it fits with at least 32K "
         "context, otherwise across both cards in VRAM, with the same exactness and speed drivers.\"", ""]
    sp = D.get("support")
    if sp:
        L += [f"## Does `{Path(sp['tree']).name}` run it? **{sp['verdict']}**", ""]
        L += [f"- `{e['where']}` - {e['what']}: `{(e['text'] or 'NOT FOUND').strip()}`" for e in sp["evidence"]]
        L.append("")
    L += ["## Quants (VRAM fit)", "", "| quant | GB | params B | bpw | VRAM weights GiB | A: 5080 alone, max ctx | "
          "B: split K, max ctx | decode INFO A / B tok/s | iq_pack |", "|---|---|---|---|---|---|---|---|---|"]
    for r in D["rows"]:
        if not r.get("fit"):
            L.append(f"| {r['label']} | - | - | - | - | {r['verdict']}: {r['why']} | | | |")
            continue
        f = r["fit"]
        b = f["B"]["split"] or f["B"]["widest"] or {}
        bcell = (f"K={b.get('K')}, {b.get('ctx', 0):,}{' (fits)' if f['B']['fits'] else ' (< the minimum)'}" if b and b.get("ctx")
                 else "no split fits (the weights exceed both cards)")
        L.append(f"| {r['label']} | {r['file_gb']:.1f} | {r['params_b']:.1f} | {r['bpw']:.2f} | {r['weights_gib']:.2f} | "
                 f"{'**' if f['A']['fits'] else ''}{f['A']['max_ctx']:,}{'**' if f['A']['fits'] else ''} | {bcell} | "
                 f"{(f['A']['decode_tok_s_info'] or 0):.0f} / "
                 f"{format(f['B']['decode_tok_s_info'], '.0f') if f['B']['decode_tok_s_info'] else '-'} | "
                 f"{(r.get('pack') or {}).get('verdict', '-')}: {((r.get('pack') or {}).get('why') or '')[:70]} |")
    if D["rows"] and D["rows"][0].get("fit"):
        L += ["", f"Assumptions: {D['rows'][0]['fit']['assumptions']}"]
    pk = D["pick"]
    L += ["", f"## The pick: **{pk['label']}**, placement **{pk['placement']}**", "", f"- {pk['why']}", f"- rule: {pk['rule']}"]
    pc = D.get("pieces")
    if pc:
        L += [f"- config `{pc['config']}` (--max-context {pc['ctx']:,}); params `{pc['params']}`"]
        for k, d in pc["drivers"].items():
            L.append(f"- driver {k}: `{d['path']}` (bash -n {d['bash_n']}; .ready: {'PRESENT' if d['ready_file'] else 'none'})"
                     " - refuses before any gap while the tree does not run the architecture (q4_rules.py densecheck)")
    q = D.get("q4split")
    if q:
        L += ["", "## The Q4 split across both cards: a day-one QUALITY comparison (Karl 11-06)", "", f"**{q['state']}**", "",
              f"- rule: {q['rule']}"]
        if q.get("strata"):
            L.append(f"- on Strata? {q['strata']}")
        lc = q.get("llama_cpp")
        if lc:
            L.append(f"- so on the pinned llama.cpp (`{lc['src']}`; it names '{lc['arch']}': {lc['knows_arch']}); built: {lc['built']} - "
                     f"{lc['note']}: " + " && ".join(f"`{c}`" for c in lc["build_commands"]))
        for k, v_ in (q.get("arms") or {}).items():
            L.append(f"- {k}: {v_['label']} - {v_['why']} (`CUDA_VISIBLE_DEVICES={v_['cvd'][:13]}...`, -ngl {v_['ngl']} {v_['split']})")
        if q.get("driver"):
            L.append(f"- driver `{q['driver']['path']}` (bash -n {q['driver']['bash_n']}; .ready: none; ~{q['minutes_8080_down']} min with 8080 "
                     f"down; texts and -c: {q['texts']}) - QUALITY ONLY, llama.cpp is not Strata: no speed claim")
    return "\n".join(L) + "\n"


# =====================================================================================================================
# 14. synthetic data, the additions' selftest and dry run
# =====================================================================================================================
def write_header_gguf(path, kv, tensors, align=32):
    """a header-only GGUF v3 (no data) + NAME.size (where the data would end): synthetic test files only"""
    D1.type_table(Path(D1.TREE))

    def st(x):
        b = x.encode()
        return struct.pack("<Q", len(b)) + b
    out = bytearray(b"GGUF" + struct.pack("<IQQ", 3, len(tensors), len(kv)))
    for k, v in kv:
        out += st(k)
        if isinstance(v, str):
            out += struct.pack("<I", 8) + st(v)
        elif isinstance(v, bool):
            out += struct.pack("<IB", 7, v)
        elif isinstance(v, int):
            out += struct.pack("<II", 4, v)
        elif isinstance(v, float):
            out += struct.pack("<If", 6, v)
        else:
            out += struct.pack("<IIQ", 9, 4, len(v)) + struct.pack(f"<{len(v)}I", *v)
    off = 0
    for name, dims, tname_ in tensors:
        tid = D1.NAME2ID[tname_]
        out += st(name) + struct.pack("<I", len(dims)) + struct.pack(f"<{len(dims)}Q", *dims) + struct.pack("<IQ", tid, off)
        _, bs, tb = D1.TYPES[tid]
        n = 1
        for d_ in dims:
            n *= d_
        off += (n // bs * tb + align - 1) // align * align
    out += b"\0" * ((-len(out)) % align)
    Path(path).parent.mkdir(parents=True, exist_ok=True)
    Path(path).write_bytes(bytes(out))
    Path(str(path) + ".size").write_text(f"{len(out) + off}\n")
    return len(out) + off


def synth_dense_27b(path, quant):
    """a header-only dense 27B in the shape of the split engine's FNX_27B constants (src/split/src/model.hpp: N 5120, 64
    layers + 1 nextn, dense FFN 17408, GDN 16 key / 48 value heads of 128, attention 24 q / 4 kv heads of 256, every 4th
    layer full attention) and sFNX's tensor names (model.cpp load_layers_27b), architecture 'qwen35'. Type mixes:
    llama.cpp-like (attn_v / ffn_down one step up in the _M mixes)."""
    N, NL, FFD, NKH, NVH, HS, NQH, NKVH, HD, V = 5120, 64, 17408, 16, 48, 128, 24, 4, 256, 248320
    mix = {"Q8_0": ("Q8_0", "Q8_0", "Q8_0", "Q8_0"), "Q6_K": ("Q6_K", "Q6_K", "Q6_K", "Q6_K"),
           "Q5_K_M": ("Q5_K", "Q6_K", "Q6_K", "Q5_K"), "Q4_K_M": ("Q4_K", "Q6_K", "Q6_K", "Q4_K"),
           "IQ4_XS": ("IQ4_XS", "IQ4_XS", "Q6_K", "IQ4_XS"), "Q3_K_M": ("Q3_K", "Q4_K", "Q6_K", "Q3_K"),
           "IQ3_XXS": ("IQ3_XXS", "IQ4_XS", "Q6_K", "IQ3_XXS")}[quant]
    base, up1, headt, embt = mix
    kv = [("general.architecture", "qwen35"), ("general.name", f"Qwen4-27B synthetic {quant} (header only, dayone selftest)"),
          ("qwen35.block_count", NL + 1), ("qwen35.nextn_predict_layers", 1), ("qwen35.context_length", 262144),
          ("qwen35.embedding_length", N), ("qwen35.feed_forward_length", FFD), ("qwen35.attention.head_count", NQH),
          ("qwen35.attention.head_count_kv", NKVH), ("qwen35.attention.key_length", HD), ("qwen35.attention.value_length", HD),
          ("qwen35.full_attention_interval", 4), ("qwen35.ssm.group_count", NKH), ("qwen35.ssm.time_step_rank", NVH),
          ("qwen35.ssm.state_size", HS), ("qwen35.ssm.inner_size", NVH * HS), ("qwen35.ssm.conv_kernel", 4),
          ("qwen35.rope.dimension_count", 64), ("qwen35.attention.layer_norm_rms_epsilon", 1e-6), ("general.file_type", 7)]
    T = [("token_embd.weight", [N, V], embt), ("output_norm.weight", [N], "F32"), ("output.weight", [N, V], headt)]

    def layer(l, attn):
        b = f"blk.{l}."
        r = [(b + "attn_norm.weight", [N], "F32"), (b + "post_attention_norm.weight", [N], "F32"),
             (b + "ffn_gate.weight", [N, FFD], base), (b + "ffn_up.weight", [N, FFD], base), (b + "ffn_down.weight", [FFD, N], up1)]
        if attn:
            r += [(b + "attn_q.weight", [N, NQH * HD * 2], base), (b + "attn_k.weight", [N, NKVH * HD], base),
                  (b + "attn_v.weight", [N, NKVH * HD], up1), (b + "attn_output.weight", [NQH * HD, N], base),
                  (b + "attn_q_norm.weight", [HD], "F32"), (b + "attn_k_norm.weight", [HD], "F32")]
        else:
            r += [(b + "attn_qkv.weight", [N, 2 * NKH * HS + NVH * HS], base), (b + "attn_gate.weight", [N, NVH * HS], base),
                  (b + "ssm_alpha.weight", [N, NVH], "F32"), (b + "ssm_beta.weight", [N, NVH], "F32"),
                  (b + "ssm_out.weight", [NVH * HS, N], base), (b + "ssm_conv1d.weight", [4, 2 * NKH * HS + NVH * HS], "F32"),
                  (b + "ssm_a", [NVH], "F32"), (b + "ssm_dt.bias", [NVH], "F32"), (b + "ssm_norm.weight", [HS], "F32")]
        return r
    for l in range(NL):
        T += layer(l, (l + 1) % 4 == 0)
    T += layer(NL, True) + [(f"blk.{NL}.nextn.eh_proj.weight", [2 * N, N], "Q8_0"), (f"blk.{NL}.nextn.enorm.weight", [N], "F32"),
                            (f"blk.{NL}.nextn.hnorm.weight", [N], "F32"), (f"blk.{NL}.nextn.shared_head_norm.weight", [N], "F32")]
    return write_header_gguf(path, kv, T)


def cmd_selftest_e(a):
    """the additions' selftest: synthetic data and upstream's v3.1 header fixture; no GPU, no server, no network"""
    d = Path(a.dir)
    d.mkdir(parents=True, exist_ok=True)
    fails = []

    def chk(name, cond, info=""):
        print(f"{'ok  ' if cond else 'FAIL'} {name}" + (f"  ({str(info)[:300]})" if info and not cond else ""))
        if not cond:
            fails.append(name)
    # ---- item 2: iq_pack's own decision on upstream's fixture, both trees (r22p028x = served v0.2.8 + ours; r23p0211)
    want_q5 = {"UD-IQ4_XS": 33, "UD-Q3_K_XL": 20, "UD-IQ2_XS": 1, "UD-Q2_K_XL": 1, "UD-IQ3_XXS": 0, "UD-IQ1_M": 0}
    for tree in (WS / "strata-r22p028x", R23):
        for s in ("UD-IQ1_S", "UD-IQ1_M", "UD-IQ2_XS", "UD-IQ3_XXS", "UD-IQ4_XS", "UD-Q2_K_XL", "UD-Q3_K_XL", "UD-Q4_K_XL"):
            c = local_candidate(fixture_materialize(R23, s, d / "fixture" / s))
            r = pack_precheck(c, None, tree, d / "work", offline=True)
            if s == "UD-IQ1_S":
                chk(f"{tree.name}: {s} REFUSES with iq_pack's own 'layer 18: gate and up differ in type' (upstream's test)",
                    r["verdict"] == "REFUSES" and r["why"] == "layer 18: gate and up differ in type"
                    and r.get("mixed_gate_up_layers") == [{"layer": 18, "gate": "IQ2_S", "up": "IQ2_XXS"}], r)
            else:
                q5 = sum(x["layers"] for x in r.get("combos", []) if x["down"] == "Q5_0")
                chk(f"{tree.name}: {s} ACCEPTS, 48 layers" + (f", {want_q5[s]} Q5_0 downs" if s in want_q5 else ""),
                    r["verdict"] == "ACCEPTS" and r.get("layers") == 48 and (s not in want_q5 or q5 == want_q5[s]), r)
                if s == "UD-IQ3_XXS":
                    chk(f"{tree.name}: UD-IQ3_XXS's layer across shards -> native_experts.txt v4 (upstream's test)", r.get("table") == "v4", r)
    # a shard missing / the size short of the tensor table -> iq_pack.Model refuses
    c = local_candidate(fixture_materialize(R23, "UD-IQ2_XS", d / "fixture-trunc" / "UD-IQ2_XS"))
    p2 = Path(c["files"][1]["path"])
    Path(str(p2) + ".size").write_text("1000000\n")
    c = local_candidate(c["shard1"])
    r = pack_precheck(c, None, WS / "strata-r22p028x", d / "work", offline=True)
    chk("a shard whose size is short of its tensor table -> REFUSES (iq_pack.Model: 'unsupported or truncated tensor')",
        r["verdict"] == "REFUSES" and "truncated tensor" in r["why"], r)
    # ---- item 1: the v3.1 default rule on synthetic decision files
    cases = [("BETTER THAN P", "BETTER THAN P", "NOT NEEDED", None, "UNSLOTH"),
             ("INCLUDES PACK ROUNDING", "WORSE THAN P", "WANTED", None, "PENDING"),
             ("INCLUDES PACK ROUNDING", "WORSE THAN P", "WANTED", "WORSE THAN P", "ISTA"),
             ("INCLUDES PACK ROUNDING", "INSIDE THE MARGIN, ABOVE P", "WANTED", "BETTER THAN P", "UNSLOTH"),
             ("INCLUDES PACK ROUNDING", "INSIDE THE MARGIN, AT OR BELOW P", "WANTED", "INCONCLUSIVE", "NO DIFFERENCE"),
             ("INCLUDES PACK ROUNDING", "WORSE THAN P", "WANTED", "NOT JUDGED", "PENDING"),
             ("NOT DECIDED", None, "NOT DECIDED", None, "PENDING")]
    for i, (kl, cls, fu, dv, want) in enumerate(cases):
        u = d / "v31" / str(i)
        shutil.rmtree(u, ignore_errors=True)
        (u / "dec").mkdir(parents=True)
        q = {"status": "JUDGED" if kl != "NOT DECIDED" else "NOT JUDGED", "kl_U": kl, "pack_rounding": {"dec_followup": fu}}
        if cls:
            q["kl_U_class"] = cls
        (u / "decision.json").write_text(json.dumps({"quality": q, "exactness": {"U": "REPEATABLE"}, "speed": {"U": "NO LOSS"}}))
        (u / "decision.txt").write_text(f"...\n{FOLLOW_MARK}{fu} (synthetic)\n")
        if dv:
            (u / "dec" / "decision.json").write_text(json.dumps({"verdict": dv}))
        v = v31_default(u, u / "dec")
        chk(f"v3.1 default: kl_U {kl} / {cls} / follow-up {dv} -> {want}", v["state"] == want, v)
    u = d / "v31" / "disagree"
    shutil.rmtree(u, ignore_errors=True)
    u.mkdir(parents=True)
    (u / "decision.json").write_text(json.dumps({"quality": {"status": "JUDGED", "kl_U": "BETTER THAN P",
                                                             "pack_rounding": {"dec_followup": "NOT NEEDED"}}}))
    (u / "decision.txt").write_text(f"{FOLLOW_MARK}WANTED\n")
    chk("v3.1 default: decision.json and decision.txt disagree -> PENDING", v31_default(u, u / "dec")["state"] == "PENDING")
    chk("v3.1 default today (no decision files yet) -> PENDING", v31_default()["state"] == "PENDING" or UD31_DECISION.exists())
    T = {"publishers": {"unsloth": {"pick": "U", "pick_experts_gib": 46.84, "plan": "u"}, "ista": {"pick": "I", "pick_experts_gib": 46.84,
                                                                                                   "plan": "i"}}, "first": "unsloth"}
    ns = argparse.Namespace(prefer="auto", tie_tol_gib=0.1)
    pdf = publisher_default(T, ns)
    chk("publisher default, both out, v3.1 PENDING -> the first one out stays (unsloth)",
        pdf["publisher"] == "unsloth" or UD31_DECISION.exists(), pdf)
    ns.prefer = "ista"
    chk("publisher default, --prefer ista -> ista", publisher_default(T, ns)["publisher"] == "ista")
    ns.prefer = "any"
    chk("publisher default, --prefer any, equal experts -> tie: the comparison decides (None)", publisher_default(T, ns)["publisher"] is None)
    T1 = {"publishers": {"unsloth": {"pick": "U", "pick_experts_gib": 46.84, "plan": "u"}}, "first": None}
    chk("publisher default, only Unsloth out -> FIRST AVAILABLE unsloth", publisher_default(T1, ns)["state"] == "FIRST AVAILABLE")
    chk("list_repo: --listing REPO=ABSENT -> not available (simulated)", not list_repo("x/y", "main", "ABSENT")["available"])
    # ---- item 3: the bpw arithmetic
    cls = qclasses()
    chk("fit classes: IQ2_XXS 2.0625, IQ3_XXS 3.0625, IQ4_XS 4.25 bpw from gguf-py's block sizes",
        dict(cls)["IQ2_XXS"] == 2.0625 and dict(cls)["IQ3_XXS"] == 3.0625 and dict(cls)["IQ4_XS"] == 4.25, cls)
    chk("fit: 72.36 GiB over 242.25B expert params = 2.566 bpw -> IQ2_S (2.5625)",
        best_class(8 * 72.36 * GIB / 242.25e9, cls) == "IQ2_S" and abs(8 * 72.36 * GIB / 242.25e9 - 2.566) < 0.001)
    dd = d1_defaults()
    chk("day1's defaults read with ast (memtotal 92.0, floor 12, other 16.3, headroom 5.7)",
        (dd.get("--memtotal-gib"), dd.get("--floor-gib"), dd.get("--other-gib"), dd.get("--headroom-gib")) == (92.0, 12.0, 16.3, 5.7), dd)
    # ---- item 4: the dense evidence and the synthetic 27B
    for tree in (WS / "strata-r22p028x", R23):
        sp = dense_support(tree, "qwen35")
        miss = [e["where"] for e in sp["evidence"] if e["text"] is None and "CMakeCache" not in e["where"]
                and ("split" not in e["where"] or (tree / "src/split").is_dir())]
        chk(f"{tree.name}: dense 'qwen35' does not run; every evidence line found ({len(sp['evidence'])})",
            not sp["runs"] and not miss, miss or sp["verdict"])
    p = d / "dense" / "Qwen4-27B-synth-Q4_K_M.gguf"
    synth_dense_27b(p, "Q4_K_M")
    D1.type_table(Path(D1.TREE))
    s = dense_sizes(D1.Model(p))
    chk("synthetic 27B: ~27B parameters, 16 attention + 48 GDN layers, K/V 33,792 B a cell",
        26.0e9 < s["params"] < 28.5e9 and s["n_attn"] == 16 and len(s["gdn"]) == 48 and s["kv_cell"] == 33792,
        (s["params"], s["n_attn"], len(s["gdn"]), s["kv_cell"]))
    # ---- 11-06: the Unsloth exactness veto (Karl)
    def ud31_dir(tag, v, txt_v=None, hc=None):
        u = d / "veto" / tag
        shutil.rmtree(u, ignore_errors=True)
        (u / "hcoff" / "gap-exact").mkdir(parents=True)
        (u / "decision.json").write_text(json.dumps({"exactness": {"U": v, "S": "REPEATABLE"}, "quality": {}, "speed": {}}))
        (u / "decision.txt").write_text(f"EXACTNESS (repeatability ...)\n  U: {txt_v or v}. e7_U1 ...\n  S: REPEATABLE. ...\n"
                                        f"SUMMARY\n  U: exactness {v}; ...\n")
        if hc:
            (u / "hcoff" / "gap-exact" / "decision.json").write_text(json.dumps({"verdict": hc}))
        return u
    for tag, v, tv, hc, want in (("rep", "REPEATABLE", None, None, "AS IS"),
                                 ("nr-none", "NOT REPEATABLE", None, None, "VETOED"),
                                 ("nr-off-ok", "NOT REPEATABLE", None, "REPEATABLE", "HC_Q8 OFF"),
                                 ("cf-off-bad", "CHECK FAILED (hcq8_scr_U)", None, "NOT REPEATABLE", "VETOED"),
                                 ("void", "VOID (env_e7U1)", None, None, "NOT DECIDED"),
                                 ("disagree", "REPEATABLE", "NOT REPEATABLE", None, "NOT DECIDED")):
        u = ud31_dir(tag, v, tv, hc)
        st_ = u_exact_state(u, u / "hcoff")
        chk(f"veto: v3.1 U exactness {v}{' (txt ' + tv + ')' if tv else ''}, HC_Q8 off {hc} -> {want}", st_["state"] == want, st_)
        r = subprocess.run([str(PY), "-I", "-B", str(KIT / "q4_rules.py"), "hcoffneed", "--ud31", str(u)], capture_output=True, text=True)
        chk(f"hcoffneed {tag}: runs only when U failed", (r.returncode == 0) == (v.startswith(EXACT_FAILED) and not tv), r.stdout)
    u = ud31_dir("nr-stale", "NOT REPEATABLE", None, "REPEATABLE")
    os.utime(u / "hcoff" / "gap-exact" / "decision.json", (time.time() - 3600, time.time() - 3600))
    chk("veto: an HC_Q8-off result older than the v3.1 decision is not counted -> VETOED",
        u_exact_state(u, u / "hcoff")["state"] == "VETOED")
    chk("veto today: no v3.1 decision -> NOT DECIDED (no veto)", u_exact_state()["state"] == "NOT DECIDED" or UD31_DECISION.exists())
    Tv = {"publishers": {"unsloth": {"pick": "U", "pick_experts_gib": 46.8, "plan": "u", "available": True},
                         "ista": {"pick": "I", "pick_experts_gib": 46.8, "plan": "i", "available": True}}, "first": "unsloth",
          "unsloth_exactness": {"state": "VETOED", "why": "synthetic"}}
    ns = argparse.Namespace(prefer="auto", tie_tol_gib=0.1)
    chk("publisher default, both out, Unsloth VETOED -> ista", publisher_default(Tv, ns)["publisher"] == "ista")
    Tv["publishers"].pop("ista")
    chk("publisher default, only Unsloth out and VETOED -> NONE", publisher_default(Tv, ns)["state"] == "NONE")
    Tv = {"publishers": {"unsloth": {"pick": "U", "pick_experts_gib": 46.8, "plan": "u"}, "ista": {"pick": "I", "pick_experts_gib": 46.8,
                                                                                                  "plan": "i"}},
          "first": "unsloth", "unsloth_exactness": {"state": "AS IS", "why": "synthetic"}, "comparison": {"decision": str(d / "nope.json")}}
    chk("publisher default, both out, the comparison not run -> PENDING THE COMPARISON, the stopgap unsloth stays",
        publisher_default(Tv, ns)["state"] == "PENDING THE COMPARISON" and publisher_default(Tv, ns)["publisher"] == "unsloth")
    (d / "uvi.json").write_text(json.dumps({"default": {"arm": "B", "why": "synthetic"}, "publisher": {"A": "unsloth", "B": "ista"}}))
    Tv["comparison"]["decision"] = str(d / "uvi.json")
    chk("publisher default, the comparison favours B (ista) -> BY THE COMPARISON ista",
        publisher_default(Tv, ns)["publisher"] == "ista" and publisher_default(Tv, ns)["state"] == "BY THE COMPARISON")
    cfg0 = OrderedDict([("args", ["--expert-cache", "3400", "--expert-cache-device1", "3300"]), ("env", OrderedDict())])
    c1 = finalize_config(cfg0, {"uniform_cfg": 3400, "helper_final": 3300, "max_blob": 1, "main_room_gib": 1, "margin_mib": 64,
                                "uniform_auto": 3400, "sized_cfg": 4400, "profile": True}, True, "t", False, "x", None, True)
    chk("finalize_config with the veto's escape: STRATA_HC_Q8=0", c1["env"]["STRATA_HC_Q8"] == "0")
    hcd = d / "hcoff"
    shutil.rmtree(hcd, ignore_errors=True)
    cmd_hcoff(argparse.Namespace(out=str(hcd), results=str(d / "hcoff-results")))
    dr = (hcd / "gap-ud31-hcoff.sh").read_text()
    chk("the HC_Q8-off driver: bash -n OK, hcoffneed + hcline --want off in it, no .ready",
        subprocess.run(["bash", "-n", str(hcd / "gap-ud31-hcoff.sh")]).returncode == 0 and "hcoffneed" in dr and "--want off" in dr
        and not Path(str(hcd / "gap-ud31-hcoff.sh") + ".ready").exists())
    r = subprocess.run([str(PY), "-I", "-B", str(KIT / "q4_rules.py"), "cfgcheck", str(hcd / "configs/ud31-U-hcoff.json"),
                        str(hcd / "drivers/params-ud31-hcoff.json")], capture_output=True, text=True)
    chk("cfgcheck on the HC_Q8-off config: PASS (switch 0, the v3.1 U config's auto slots allowed)", r.returncode == 0, r.stdout)
    # ---- 11-06: the Q4 split's decision on synthetic llama-perplexity output
    lq = d / "lcpp"
    shutil.rmtree(lq, ignore_errors=True)
    lq.mkdir(parents=True)
    texts = ["32k", "tf-long28k", "tf-long40k", "tf-long64k", "tf-long112k", "pp4k", "ldrsyn20k", "rep9k"]
    for tag, f4 in (("better", 0.5), ("same", 1.0), ("worse", 1.6)):
        for i, t in enumerate(texts):
            for arm, f in (("Q3", 1.0), ("Q4", f4)):
                m = (0.08 + 0.01 * i) * f
                (lq / f"{arm}-{t}.txt").write_text(
                    f"chunk ...\n====== Perplexity statistics ======\nMean PPL(Q): 7.1\n====== KL divergence statistics ======\n"
                    f"Mean    KLD: {m:10.6f} ±   0.000400\nMaximum KLD:   9.000000\n99.9%   KLD:   3.000000\n99.0%   KLD: {6 * m:10.6f}\n"
                    f"95.0%   KLD: {3 * m:10.6f}\n90.0%   KLD: {2 * m:10.6f}\nMedian  KLD:   0.010000\n====== Token probability statistics ======\n"
                    f"Same top p: {100 - 40 * m:6.3f} ±  0.100 %\n")
        pp = lq / "params.json"
        pp.write_text(json.dumps({"lq": {"texts": texts, "scored": {t: 8191 for t in texts},
                                         "arms": {k: {"label": k} for k in ("R", "Q3", "Q4")}}}))
        subprocess.run([str(PY), "-I", "-B", str(KIT / "q4_rules.py"), "lcppdecide", str(pp), "--dir", str(lq), "--out", str(lq / tag)],
                       capture_output=True, text=True)
        v = json.loads((lq / tag / "decision-q4split.json").read_text())["verdict"]
        want = {"better": "Q4 SPLIT BETTER THAN Q3", "same": "INSIDE THE MARGIN", "worse": "Q4 SPLIT WORSE THAN Q3"}[tag]
        chk(f"lcppdecide: Q4 = {f4} x Q3 on 8 texts -> {want}", v.startswith(want), v)
    print(f"selftest-e: {len(fails)} failure(s)" + (f": {fails}" if fails else ""))
    return 1 if fails else 0


def mixed_variant(src_shard1, dest, layer, new_type=None):
    """a copy of saved real heads (NAME + NAME.size) with one layer's ffn_up_exps type id rewritten in its header: a
    synthetic 'mixed gate/up' quant for the fall-through dry run (IQ1_M, or IQ1_S if it already is IQ1_M: the tensor's
    bytes shrink, its offset stays - no truncation, only the type rule can refuse it)"""
    D1.type_table(Path(D1.TREE))
    dest = Path(dest)
    dest.mkdir(parents=True, exist_ok=True)
    out1 = None
    for p in D1.shards_of(Path(src_shard1)):
        q = dest / p.name
        shutil.copyfile(p, q)
        shutil.copyfile(str(p) + ".size", str(q) + ".size")
        out1 = out1 or q
        b = bytearray(q.read_bytes())
        nm = f"blk.{layer}.ffn_up_exps.weight".encode()
        i = b.find(struct.pack("<Q", len(nm)) + nm)
        if i >= 0:
            j = i + 8 + len(nm)
            nd = struct.unpack_from("<I", b, j)[0]
            cur = struct.unpack_from("<I", b, j + 4 + 8 * nd)[0]
            nt = D1.NAME2ID[new_type] if new_type else (D1.NAME2ID["IQ1_S"] if cur == D1.NAME2ID["IQ1_M"] else D1.NAME2ID["IQ1_M"])
            struct.pack_into("<I", b, j + 4 + 8 * nd, nt)
            q.write_bytes(bytes(b))
            log(f"mixed variant: {q.name} blk.{layer}.ffn_up_exps {D1.tname(cur)} -> {D1.tname(nt)}")
    return out1


def synth_ista_listing(path):
    """an offline stand-in for an ISTA repo listing (dry run of item 1): our local ISTA IQ3_S shards' paths and sizes;
    the oids are placeholders (no 80 GB hash in a dry run) - predl / rehash would refuse them, as they should"""
    rows = []
    for p in D1.shards_of(SERVED):
        rows.append({"type": "file", "path": f"IQ3_S/{p.name}", "size": p.stat().st_size,
                     "lfs": {"oid": "0" * 64, "size": p.stat().st_size, "pointerSize": 135}, "oid": "dryrun"})
    Path(path).write_text(json.dumps(rows, indent=0))
    return path


def cmd_dryrun_e(a):
    """the four additions on Flash-Next's files and synthetic data: no GPU, no server; HF only for a few small headers
    (--live, read-only range requests)"""
    out = Path(a.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    SCRATCH["dir"] = out / "scratch"
    v31 = KIT / "unsloth-v31"
    REPO_U, COMMIT_U = "unsloth/Qwen3.8-Flash-Next-GGUF", "d96201194f103c906994f283f504209dc8d2a10c"
    REPO_I = "ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF"
    R = []
    # ---- item 2: the pre-check on local files (whole files, saved heads, a DeepSeek shard 1, the served file)
    pc = []
    for lab, path in (("served ISTA IQ3_S (whole files)", SERVED),
                      ("Unsloth v3.1 UD-IQ3_XXS (whole files)", WS / "models/unsloth-v31/UD-IQ3_XXS/Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00004.gguf"),
                      ("Unsloth v3.1 UD-IQ3_XXS (saved heads)", v31 / "headers/UD-IQ3_XXS/Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00004.gguf"),
                      ("Unsloth v3.1 UD-IQ2_XS (saved heads)", v31 / "headers/UD-IQ2_XS/Qwen3.8-Flash-Next-UD-IQ2_XS-00001-of-00003.gguf"),
                      ("DeepSeek ISTA IQ2_XXS (whole files)", WS / "models/DeepSeek-V4.1-Flash-1017-GSQ-RCO-GGUF/DeepSeek-V4.1-Flash-1017-GSQ-RCO-IQ2_XXS-00001-of-00004.gguf"),
                      ("DeepSeek UD-Q8_K_XL (shard 1 of 9 only)", WS / "models/DeepSeek-V4.1-Flash-1017-GSQ-RCO-GGUF/DeepSeek-V4.1-Flash-1017-UD-Q8_K_XL-00001-of-00009.gguf")):
        if not Path(path).exists():
            pc.append({"label": lab, "verdict": "NOT CHECKED", "why": f"{path} not here"})
            continue
        c = local_candidate(path)
        r = pack_precheck(c, None, a.rel, out / "precheck-work", offline=True)
        r["label"] = lab
        pc.append(r)
        log(f"pre-check {lab}: {r['verdict']} - {r['why'][:160]}")
    for s in ("UD-IQ1_S", "UD-IQ1_M", "UD-Q4_K_XL"):
        c = local_candidate(fixture_materialize(R23, s, out / "fixture" / s))
        r = pack_precheck(c, None, a.rel, out / "precheck-work", offline=True)
        r["label"] = f"{s} (upstream's header fixture)"
        pc.append(r)
        log(f"pre-check {s} (fixture): {r['verdict']} - {r['why'][:160]}")
    # the HF path, live, on UD-IQ1_S's two tensor shards (~10 MB of shard-1 metadata NOT fetched: the few-MB limit; shard
    # 1 = upstream's stand-in, as its tests make it), compared with upstream's fixture
    if a.live:
        lst = list_repo(REPO_U, COMMIT_U, str(v31 / "dl/tree.json"))
        qs, _ = quants_of(lst, str(out / "hf-dest"))
        q = next(x for x in qs if x["label"] == "UD-IQ1_S")
        hdir = out / "hf-heads"
        fx = Path(fixture_materialize(R23, "UD-IQ1_S", out / "hf-fixture"))
        live = {"repo": REPO_U, "commit": COMMIT_U, "shards": []}
        try:
            for f in q["files"][1:]:
                hb, n = head_hf(REPO_U, COMMIT_U, f["path"], f["size"], hdir)
                live["shards"].append({"path": f["path"], "header_bytes": len(hb), "fetched": n})
            (hdir / q["files"][0]["path"]).parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(fx, hdir / q["files"][0]["path"])
            Path(str(hdir / q["files"][0]["path"]) + ".size").write_text(f"{q['files'][0]['size']}\n")
            same = []
            for f in q["files"][1:]:
                got = D1.read_shard(hdir / f["path"], 0)
                ref = D1.read_shard(fx.parent / Path(f["path"]).name, 0)
                same.append([(t.name, t.type, t.shape, t.offset) for t in got["tensors"]] ==
                            [(t.name, t.type, t.shape, t.offset) for t in ref["tensors"]])
            live["tensor_directories_identical_to_fixture"] = same
            r = pack_precheck(q, hdir, a.rel, out / "precheck-work", offline=True)
            r["label"] = "UD-IQ1_S (HF range requests, live: shards 2-3)"
            live["precheck"] = {"verdict": r["verdict"], "why": r["why"]}
            pc.append(r)
        except (OSError, ValueError, urllib.error.URLError) as e:
            live["error"] = f"{e} (not retried another way)"
        live["fetched_total"] = sum(x["fetched"] for x in live["shards"])
        R.append({"hf_live": live})
        log(f"HF live: {live}")
    (out / "precheck.json").write_text(json.dumps(pc, indent=1, default=str) + "\n")
    # ---- item 3: the fit table, the guess and the served file
    for tag, extra in (("guess", []), ("served", ["--gguf", str(SERVED)])):
        ap = argparse.ArgumentParser()
        fit_args(ap)
        ns = ap.parse_args(extra + ["--out", str(out / f"fit-{tag}")])
        cmd_fit(ns)
    # ---- item 1: Unsloth out first (ISTA absent), then ISTA appears (watch); the v3.1 default today
    common = ["--listing", f"{REPO_U}={v31 / 'dl/tree.json'}", "--headers", str(v31 / "headers"),
              "--dest-root", f"{REPO_U}={WS / 'models/unsloth-v31'}", "--dest-root", f"{REPO_I}={WS / 'models/ISTA-GSQ-RCO'}",
              "--offline", "--rel", str(a.rel), "--exe", str(WS / "engine-r22p028x/strata"),
              "--server", str(WS / "strata-r22p028x/serve/server.py"),
              "--kl-ref-gguf", ("/home/USER/.cache/huggingface/hub/models--unsloth--Qwen3.8-Flash-Next-GGUF/snapshots/"
                                "38bb39ee97821de2c9009abb7e93950eec396e66/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf"),
              "--scratch", str(SCRATCH["dir"])]
    ap = plan_parser()
    sys_argv = sys.argv
    try:
        argv1 = ["--repo", f"{REPO_U}@{COMMIT_U}", "--repo", REPO_I, "--listing", f"{REPO_I}=ABSENT", "--name", "q4e",
                 "--out", str(out / "arrival-1")] + common
        sys.argv = ["dayone.py", "plan"] + argv1          # what the plan records as its own command line (watch re-reads it)
        shutil.rmtree(out / "arrival-1", ignore_errors=True)
        ns = ap.parse_args(argv1)
        ns.rel = ns.rel or ns.tree
        plan_publishers(ns)
        lt = synth_ista_listing(out / "ista-listing-synthetic.json")
        wa = argparse.Namespace(plan=str(out / "arrival-1"), repo=f"{REPO_I}@{'1' * 40}", listing=[f"{REPO_I}={lt}"],
                                out=str(out / "arrival-2"), offline=True, notify=False, headers=None, dest_root=None)
        shutil.rmtree(out / "arrival-2", ignore_errors=True)
        sys.argv = ["dayone.py", "watch", "--plan", wa.plan, "--repo", wa.repo, "--listing", wa.listing[0], "--out", wa.out, "--offline"]
        cmd_watch(wa)
        # ---- item 3 inside a plan: the n-gram table in RAM (the pick only)
        argv3 = ["--repo", f"{REPO_U}@{COMMIT_U}", "--name", "q4r", "--out", str(out / "ngram-ram"), "--no-compare",
                 "--ngram-placement", "ram", "--pick-only"] + common
        sys.argv = ["dayone.py", "plan"] + argv3
        nsr = ap.parse_args(argv3)
        nsr.rel = nsr.rel or nsr.tree
        plan(nsr)
        # ---- item 2 inside a plan: the largest quant refused by the pre-check -> the next one, and why
        mx = mixed_variant(v31 / "headers/UD-IQ3_XXS/Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00004.gguf", out / "mixed" / "UD-IQ3_XXS", 7)
        shutil.rmtree(out / "fallthrough", ignore_errors=True)
        argv4 = ["--local", str(mx), "--local", str(v31 / "headers/UD-IQ2_XS/Qwen3.8-Flash-Next-UD-IQ2_XS-00001-of-00003.gguf"),
                 "--name", "q4f", "--out", str(out / "fallthrough"), "--no-compare", "--pick-only", "--rel", str(a.rel), "--offline"]
        sys.argv = ["dayone.py", "plan"] + argv4
        nsf = ap.parse_args(argv4)
        nsf.rel = nsf.rel or nsf.tree
        plan(nsf)
    finally:
        sys.argv = sys_argv
    # ---- item 4: the dense fallback on synthetic 27B headers
    dd = out / "dense-synth"
    for qn in ("Q8_0", "Q6_K", "Q5_K_M", "Q4_K_M", "IQ4_XS", "Q3_K_M", "IQ3_XXS"):
        synth_dense_27b(dd / qn / f"Qwen4-27B-synth-{qn}.gguf", qn)
    apd = argparse.ArgumentParser()
    dense_args(apd)
    loc = lambda qq: sum((["--local", str(dd / qn / f"Qwen4-27B-synth-{qn}.gguf")] for qn in qq), [])  # noqa: E731
    allq = ("Q8_0", "Q6_K", "Q5_K_M", "Q4_K_M", "IQ4_XS", "Q3_K_M", "IQ3_XXS")
    for tag, qq, rel in (("dense", allq, a.rel), ("dense-r23", allq, R23),
                         ("dense-B", ("Q6_K", "Q5_K_M", "Q4_K_M"), a.rel)):   # B: no quant given fits the 5080 alone
        sys_argv = sys.argv
        try:
            sys.argv = ["dayone.py", "dense"] + loc(qq) + ["--name", f"q4d27{tag[5:].replace('-', '')}", "--out", str(out / tag),
                                                          "--rel", str(rel), "--offline"]
            cmd_dense(apd.parse_args(sys.argv[2:]))
        finally:
            sys.argv = sys_argv
    # ---- 11-06: Karl's veto inside a plan (synthetic v3.1 decision files): the escape, and the veto
    for tag, v, hc in (("veto-hcoff", "NOT REPEATABLE", "REPEATABLE"), ("veto-vetoed", "CHECK FAILED (hcq8_scr_U)", None)):
        u = out / tag / "ud31"
        shutil.rmtree(out / tag, ignore_errors=True)
        (u / "hcoff" / "gap-exact").mkdir(parents=True)
        (u / "decision.json").write_text(json.dumps({"exactness": {"U": v}, "quality": {}, "speed": {}}))
        (u / "decision.txt").write_text(f"EXACTNESS\n  U: {v}. (synthetic)\n")
        if hc:
            (u / "hcoff" / "gap-exact" / "decision.json").write_text(json.dumps({"verdict": hc}))
        argv5 = ["--repo", f"{REPO_U}@{COMMIT_U}", "--repo", REPO_I, "--listing", f"{REPO_I}=ABSENT", "--name", "q4v",
                 "--out", str(out / tag / "plan"), "--ud31-dir", str(u), "--hcoff-dir", str(u / "hcoff")] + common
        sys_argv = sys.argv
        try:
            sys.argv = ["dayone.py", "plan"] + argv5
            nv = ap.parse_args(argv5)
            nv.rel = nv.rel or nv.tree
            plan_publishers(nv)
        finally:
            sys.argv = sys_argv
    # ---- 11-06: the HC_Q8-off driver (a dry copy here; the real one: dayone.py hcoff -> work/qwen4-kit/hcoff)
    cmd_hcoff(argparse.Namespace(out=str(out / "hcoff"), results=str(out / "hcoff-results")))
    # ---- 11-06: the HF watch on synthetic repos (--dry: prints the alert; the second poll alerts nothing)
    hw = out / "hfwatch"
    shutil.rmtree(hw, ignore_errors=True)
    hw.mkdir(parents=True)
    st27 = [{"type": "file", "path": f"model-{i:05d}-of-00012.safetensors", "size": 4_600_000_000, "lfs": {"oid": "0" * 64}} for i in range(1, 13)]
    stfl = [{"type": "file", "path": f"model-{i:05d}-of-00060.safetensors", "size": 9_900_000_000, "lfs": {"oid": "0" * 64}} for i in range(1, 61)]
    (hw / "tree-27b.json").write_text(json.dumps(st27 + [{"type": "file", "path": "README.md", "size": 9000}]))
    (hw / "tree-flash.json").write_text(json.dumps(stfl))
    (hw / "tree-teaser.json").write_text(json.dumps([{"type": "file", "path": "README.md", "size": 4000}]))
    FL = "unsloth/Qwen4-Flash-GGUF"
    syn = {"orgs": {"unsloth": [{"id": FL, "sha": "a" * 40, "private": False, "gated": False},
                                {"id": "unsloth/Qwen3-4B-GGUF", "sha": "e" * 40, "private": False, "gated": False}],
                    "Qwen": [{"id": "Qwen/Qwen4-27B", "sha": "b" * 40, "private": False, "gated": False},
                             {"id": "Qwen/Qwen4-Flash", "sha": "c" * 40, "private": False, "gated": "manual"},
                             {"id": "Qwen/Qwen-4-Teaser", "sha": "d" * 40, "private": False, "gated": False}],
                    "ISTA-DASLab": []},
           "info": {FL: {"sha": "a" * 40, "cardData": {"license": "apache-2.0"}, "private": False, "gated": False},
                    "Qwen/Qwen4-27B": {"sha": "b" * 40, "cardData": {"license": "apache-2.0"}},
                    "Qwen/Qwen4-Flash": {"sha": "c" * 40, "gated": "manual", "cardData": {"license": "qwen"}},
                    "Qwen/Qwen-4-Teaser": {"sha": "d" * 40}},
           "trees": {FL: str(v31 / "dl/tree.json"), "Qwen/Qwen4-27B": str(hw / "tree-27b.json"),
                     "Qwen/Qwen4-Flash": str(hw / "tree-flash.json"), "Qwen/Qwen-4-Teaser": str(hw / "tree-teaser.json")},
           "plan_args": {FL: ["--listing", f"{FL}={v31 / 'dl/tree.json'}", "--headers", str(v31 / "headers"), "--offline",
                              "--dest-root", str(hw / "dest"), "--rel", str(a.rel), "--exe", str(WS / "engine-r22p028x/strata"),
                              "--server", str(WS / "strata-r22p028x/serve/server.py"), "--scratch", str(SCRATCH["dir"])]}}
    (hw / "synthetic.json").write_text(json.dumps(syn, indent=1))
    for i in (1, 2):
        log(f"=== HF watch, synthetic poll {i}")
        cmd_hfwatch(argparse.Namespace(orgs=",".join(HFW_ORGS), state=str(hw / "state.json"), until=HFW_UNTIL, force=True, dry=True,
                                       synthetic=str(hw / "synthetic.json"), rate=HFW_RATE, no_download=False, out=str(hw / "plans")))
    cmd_hfwatch_units(argparse.Namespace(out=str(hw / "units"), until=HFW_UNTIL))
    (out / "dryrun-e.json").write_text(json.dumps(R, indent=1, default=str) + "\n")
    log(f"dry run (additions): {out}")
    return 0


# =====================================================================================================================
# 15. the Hugging Face watch (Karl 11-06): Qwen4 repos of Qwen, unsloth and ISTA-DASLab, every 15 min through Sunday
# =====================================================================================================================
HFW_ORGS = ("Qwen", "unsloth", "ISTA-DASLab")
HFW_NAME = re.compile(r"qwen[-_. ]?4(?![0-9])", re.I)          # Qwen4, Qwen-4, Qwen4.0, qwen4-flash; not Qwen3-4B / Qwen40
HFW_DIR = KIT / "hfwatch"
HFW_UNTIL = "2026-11-08T23:59"
HFW_RATE = 35.0          # MB/s fixed: fetch_model's standing research-safe cap; the DS4.1 download ran at it beside LDR (10-23)
HFW_MARGIN_GB = 10.0     # free - the quant >= the 100 GB floor + this
NOTES_MD = WS / "NOTES.md"
NTFY_FILE = HFW_DIR / "ntfy-topic"   # one line: the ntfy topic URL, read inside the code only, never printed or logged
WEIGHT_RE = re.compile(r"\.(gguf|safetensors)$", re.I)


def hfw_get(url):
    with urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=60) as r:
        return json.load(r)


def hfw_org(org, syn):
    """one call per org: its 100 most recently modified repos (read-only, no token); sha / gated / private by expand"""
    if syn is not None:
        return syn.get("orgs", {}).get(org, [])
    q = (f"author={urllib.parse.quote(org)}&sort=lastModified&direction=-1&limit=100&"
         + "&".join(f"{urllib.parse.quote('expand[]')}={x}" for x in ("lastModified", "sha", "gated", "private", "createdAt")))
    return hfw_get(f"https://huggingface.co/api/models?{q}")


def hfw_repo(rid, sha, syn):
    """a new or changed repo only: its card's license, gated / private, and the file tree with sizes at the pinned sha"""
    if syn is not None:
        info = syn.get("info", {}).get(rid, {})
        tp = syn.get("trees", {}).get(rid)
        return info, (json.loads(Path(tp).read_text()) if tp else [])
    info = hfw_get(f"https://huggingface.co/api/models/{rid}")
    time.sleep(1)
    return info, (api_tree(rid, sha or info.get("sha")) if not info.get("private") else [])


def hfw_license(info):
    lic = (info.get("cardData") or {}).get("license")
    if not lic:
        lic = next((t.split(":", 1)[1] for t in info.get("tags") or [] if t.startswith("license:")), None)
    return lic or "license not stated"


def hfw_kind(rid, tree):
    n = rid.lower()
    return "Flash" if "flash" in n else "27B" if re.search(r"(?<![0-9])27b", n) else "other"


def hfw_gates_minutes(item, P=None):
    """the day-one gates' 8080-down minutes: each generated driver's MAXM (its deadline with 8080 down): exactness, the
    KL quality step (the pick group's driver) and the speed screen"""
    mins = {}
    drv = dict(item.get("drivers") or {})
    for pk in (P or {}).get("picks", []):
        if pk.get("kl_driver"):
            drv["quality"] = pk["kl_driver"]
    for kind, d in drv.items():
        m = re.search(r"MAXM=\$\{Q4_MAX_MIN:-(\d+)\}", Path(d["path"]).read_text()) if Path(d["path"]).exists() else None
        if m:
            mins[kind] = int(m.group(1))
    return mins


def hfw_alert(a, title, body, notes_line):
    """desktop (app "Strata", critical: the phone relay forwards those), a NOTES.md line, ntfy when it is set up; --dry prints"""
    if a.dry:
        print(f"[DRY] notify-send -a Strata -u critical {title!r} {body!r}")
        print(f"[DRY] NOTES.md: {now()[5:]} QWEN4 HF WATCH: {notes_line}")
        print(f"[DRY] ntfy: {'set up (would post the same text)' if NTFY_FILE.exists() else 'not set up'}")
        return
    subprocess.run(["notify-send", "-a", "Strata", "-u", "critical", title, body], capture_output=True)
    with open(NOTES_MD, "a") as f:
        f.write(f"{now()[5:]} QWEN4 HF WATCH: {notes_line}\n")
    if NTFY_FILE.exists():
        try:
            url = NTFY_FILE.read_text().strip()
            urllib.request.urlopen(urllib.request.Request(url, data=body.encode(), headers={**UA, "Title": title}), timeout=20)
        except (OSError, ValueError):
            log("ntfy: the post failed (the topic is not printed)")


def hfw_flash(a, rid, sha, tree, syn, out):
    """open Flash GGUF weights: the plan (Karl's rule; the pack pre-check first - a refused quant falls to the next, with
    why), the disk check (free - the quant >= 100 GB + 10), the download of the pick only (gentle_dl.py --rate cap, pausing
    while a gap is open) chained to its pack under work/r23/nogap-run.sh, as its own user unit. Nothing GPU, no gate."""
    name = "q4w" + re.sub(r"[^a-z0-9]", "", rid.split("/")[1].lower())[:10]
    pdir = out / f"{rid.replace('/', '--')}@{sha[:12]}"
    argv = ["--repo", f"{rid}@{sha}", "--name", name, "--out", str(pdir), "--no-compare", "--rate", f"{a.rate:g}"] + \
        ((syn or {}).get("plan_args", {}).get(rid) or [])
    ns = plan_parser().parse_args(argv)
    ns.rel = ns.rel or ns.tree
    sys_argv = sys.argv
    try:
        sys.argv = ["dayone.py", "plan"] + argv
        P = plan(ns)
    finally:
        sys.argv = sys_argv
    it = first_item(P)
    res = {"plan": str(pdir / "PLAN.md")}
    fell = [x for pk in P.get("picks", []) for x in pk.get("pack_fell_through") or []]
    res["fell"] = [f"{x['label']} ({x['refused']})" for x in fell]
    if not it:
        res.update(pick="none fits / runs", download="not started: no pick")
        return res
    rep = json.loads((pdir / "day1check" / "report.json").read_text())
    r = next((f for f in rep["files"] if f["file"] == it.get("header_path")), {})
    bpw = (r.get("fit") or {}).get("experts_bpw")
    res.update(pick=it["label"], bpw=bpw, experts_gib=it.get("experts_gib"), margin_gib=it.get("margin_gib"),
               precheck=it.get("pack_precheck"), gates=hfw_gates_minutes(it, P))
    size_gb = (it.get("disk") or {}).get("download_gb") or 0
    free_gb = shutil.disk_usage(WS / "models").free / 1e9
    need = 100 + HFW_MARGIN_GB
    res["disk"] = {"free_gb": round(free_gb, 1), "quant_gb": size_gb, "after_gb": round(free_gb - size_gb, 1), "need_gb": need}
    dl = it.get("download") or {}
    unit = f"q4dl-{name}-{time.strftime('%m%d%H%M')}"
    cmd = ["systemd-run", "--user", "--unit", unit, "--collect", "-p", "MemoryHigh=2G", "-p", "Nice=19", "-p", "IOSchedulingClass=idle",
           "bash", "-c", f"{dl.get('command')} && {it['pack']['command']}"]
    if dl.get("command"):
        res["unit_command"] = " ".join(shlex.quote(x) for x in cmd)   # recorded either way; started only below
    if not dl.get("command"):
        res["download"] = "nothing to download (on disk)"
    elif free_gb - size_gb < need:
        res["download"] = f"disk does not allow (need {need - (free_gb - size_gb):.0f} GB more): NOT started"
    elif a.no_download:
        res["download"] = "not started (--no-download)"
    else:
        if a.dry:
            res["download"] = f"[DRY] would start unit {unit}: gentle_dl --rate {a.rate:g} --window measure, then pack under nogap-run.sh"
        else:
            rc = subprocess.run(cmd, capture_output=True, text=True)
            res["download"] = (f"unit {unit} started (gentle_dl --rate {a.rate:g} MB/s, pauses while a gap is open; then the pack under "
                               "nogap-run.sh)" if rc.returncode == 0 else f"unit start FAILED rc {rc.returncode}: {rc.stderr[-200:]}")
            res["unit"] = unit
    return res


def watch_dispatch(a):
    if a.plan:
        if not a.repo:
            raise SystemExit("watch --plan needs --repo (the other publisher's)")
        return cmd_watch(a)
    a.out = a.out or str(HFW_DIR / "plans")
    return cmd_hfwatch(a)


def cmd_hfwatch(a):
    """Karl 11-06: "from now through Sunday, every 15 minutes, check Hugging Face for new Qwen4 repos from Qwen, unsloth
    and ISTA-DASLab, read-only. When files appear, alert me ... with the license, sizes and which quant the fit rule picks.
    If open Flash weights appear: Start the download of the quant the rule picks right away, if disk allows, rate-limited
    so LDR fetches aren't starved. Run the pack pre-check first. Pack under nogap-run. Do NOT pause the weekend chain for
    GPU tests until I say go. Tell me how long the day-one gates would keep 8080 down. If only the 27B is open, or nothing
    is, just report it." One poll: one listing call per org; a repo's metadata + file tree only when it is new or its sha /
    gated / private state changed; the state file makes each new repo, new weight file set and access change alert once."""
    if datetime.datetime.now() > datetime.datetime.fromisoformat(a.until) and not a.force:
        print(f"past the watch window ({a.until}): nothing polled - `systemctl --user disable --now qwen4-hfwatch.timer`")
        return 0
    os.nice(0 if a.dry else 19)
    syn = json.loads(Path(a.synthetic).read_text()) if a.synthetic else None
    sp = Path(a.state)
    sp.parent.mkdir(parents=True, exist_ok=True)
    state = json.loads(sp.read_text()) if sp.exists() else {"repos": {}, "polls": 0}
    out = Path(a.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    summary, n_new = [], 0
    for org in a.orgs.split(","):
        try:
            rows = hfw_org(org, syn)
        except urllib.error.HTTPError as e:
            summary.append(f"{org}: HTTP {e.code}" + (" (refused - not worked around)" if e.code in (401, 403, 429) else ""))
            continue
        except (OSError, ValueError) as e:
            summary.append(f"{org}: {str(e)[:100]}")
            continue
        hits = [r for r in rows if HFW_NAME.search(r.get("id", "").split("/")[-1])]
        summary.append(f"{org}: {len(rows)} repos listed, {len(hits)} Qwen4")
        for r in hits:
            rid = r["id"]
            st = state["repos"].get(rid)
            acc = {"private": bool(r.get("private")), "gated": r.get("gated") or False}
            if st and st.get("sha") == r.get("sha") and st.get("access") == acc:
                continue
            info, tree = hfw_repo(rid, r.get("sha"), syn)
            sha = info.get("sha") or r.get("sha") or ""
            acc = {"private": bool(info.get("private", acc["private"])), "gated": info.get("gated", acc["gated"]) or False}
            weights = {e["path"]: int(e.get("size") or 0) for e in tree if e.get("type") == "file" and WEIGHT_RE.search(e["path"])}
            ggufs = {p for p in weights if classify(p)[0] == "model"}
            new = st is None
            old_w = set((st or {}).get("weights", {}))
            kind = hfw_kind(rid, tree)
            lic = hfw_license(info)
            total_gb = sum(int(e.get("size") or 0) for e in tree if e.get("type") == "file") / 1e9
            ent = {"first_seen": (st or {}).get("first_seen", now()), "sha": r.get("sha"), "access": acc, "weights": weights,
                   "kind": kind, "license": lic, "alerts": (st or {}).get("alerts", [])}
            ev = []
            if new:
                ev.append("new repo")
            elif st.get("access") != acc:
                ev.append(f"access {st.get('access')} -> {acc}")
            if set(weights) - old_w:
                ev.append(f"{len(set(weights) - old_w)} new weight file(s)")
            log(f"hf watch: {rid}@{sha[:12]}: {', '.join(ev) or 'changed'}; {kind}; {lic}; {total_gb:.1f} GB; "
                f"{len(ggufs)} GGUF model file(s), {len(weights)} weight file(s); {acc}")
            key = f"{sha}:{len(weights)}:{acc['private']}:{acc['gated']}"
            if weights and key not in ent["alerts"]:
                is_open = not acc["private"] and not acc["gated"]
                tag = ("Flash open" if kind == "Flash" and is_open else "Flash gated" if kind == "Flash" else
                       "27B only" if kind == "27B" else kind)
                if kind == "Flash" and is_open and ggufs:
                    fr = hfw_flash(a, rid, sha, tree, syn, out)
                    g = fr.get("gates") or {}
                    gm = sum(g.values())
                    pick = f"{fr['pick']} {fr['bpw']:.2f} bpw" if fr.get("bpw") else fr["pick"]
                    body = f"{rid}: {lic}, {total_gb:.0f} GB, fit pick: {pick} | Flash open; gates ~{gm / 60:.1f} h 8080 down"
                    notes = (f"{rid}@{sha[:12]}: {lic}, {total_gb:.0f} GB; FIT PICK {pick} ({fr.get('experts_gib') or 0:.1f} GiB of "
                             f"experts, margin {fr.get('margin_gib') or 0:.1f}); pack pre-check {fr.get('precheck')}"
                             + (f"; fell through: {'; '.join(fr['fell'])}" if fr.get("fell") else "")
                             + f"; disk {fr['disk']['free_gb']:.0f} GB free, quant {fr['disk']['quant_gb']:.0f} GB; download: {fr['download']}"
                             + f"; day-one gates would keep 8080 down up to ~{gm} min ("
                             + ", ".join(f"{k} {v}" for k, v in g.items()) + "; drivers written, NOT queued, no .ready; the weekend "
                             f"chain is not paused - Karl's go); plan {fr['plan']}")
                    ent["flash"] = fr
                elif kind == "Flash" and is_open:
                    body = f"{rid}: {lic}, {total_gb:.0f} GB, fit pick: none (no GGUF yet) | Flash open"
                    notes = f"{rid}@{sha[:12]}: {lic}, {total_gb:.0f} GB of weights ({len(weights)} files), no GGUF quant yet - nothing downloaded"
                else:
                    body = f"{rid}: {lic}, {total_gb:.0f} GB, fit pick: - | {tag}"
                    notes = (f"{rid}@{sha[:12]}: {lic}, {total_gb:.0f} GB, {len(weights)} weight file(s), {tag}: report only (Karl 11-06)"
                             + (" - gated / private: no download without Karl's login" if not is_open else ""))
                hfw_alert(a, "Qwen4 files on Hugging Face", body, notes)
                ent["alerts"].append(key)
                n_new += 1
            elif not weights and new:
                log(f"hf watch: {rid}: a new Qwen4 repo, no weights yet ({acc}) - noted, no alert")
            state["repos"][rid] = ent
        if syn is None:
            time.sleep(1)
    state["polls"] = state.get("polls", 0) + 1
    state["last_poll"] = now()
    sp.write_text(json.dumps(state, indent=1, default=str) + "\n")
    line = f"{now()} poll {state['polls']}: " + "; ".join(summary) + f"; {n_new} alert(s)"
    with open(sp.parent / "hfwatch.log", "a") as f:
        f.write(line + "\n")
    print(line)
    return 0


HFW_SERVICE = """[Unit]
Description=Qwen4 day one: Hugging Face watch (Qwen, unsloth, ISTA-DASLab; read-only; Karl 11-06)

[Service]
Type=oneshot
Nice=19
MemoryHigh=2G
ExecStart={py} -I -B {dayone} watch --until {until}
"""
HFW_TIMER = """[Unit]
Description=Qwen4 day one: Hugging Face watch every 15 min through Sun {until}

[Timer]
OnCalendar=*:0/15
Persistent=false
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
"""


def cmd_hfwatch_units(a):
    """stage the user units in work/qwen4-kit/ (NOT installed): the service stops polling after --until by itself"""
    d = Path(a.out)
    d.mkdir(parents=True, exist_ok=True)
    (d / "qwen4-hfwatch.service").write_text(HFW_SERVICE.format(py=PY, dayone=KIT / "dayone.py", until=a.until))
    (d / "qwen4-hfwatch.timer").write_text(HFW_TIMER.format(until=a.until))
    print(f"staged {d / 'qwen4-hfwatch.service'}, {d / 'qwen4-hfwatch.timer'} (not installed)")
    return 0


# =====================================================================================================================
# 8. commands
# =====================================================================================================================
def common_args(p):
    p.add_argument("--repo", action="append", help="OWNER/NAME[@REV] (a branch or tag is resolved to its commit)")
    p.add_argument("--listing", action="append", metavar="REPO=FILE", help="a saved tree listing for REPO (offline)")
    p.add_argument("--local", action="append", help="shard 1 of a local model file (a candidate already on disk)")
    p.add_argument("--headers", help="folder of saved headers (DIR/<repo path> + .size)")
    p.add_argument("--offline", action="store_true", help="no network: listings from --listing, headers only as saved")
    p.add_argument("--fetch-test", metavar="LABEL=DIR", help="exercise the header fetch on a local copy of LABEL's files")
    p.add_argument("--name", required=True)
    p.add_argument("--out", required=True)
    p.add_argument("--dest-root", action="append",
                   help="where downloads land: DIR/<quant>/ (default models/<repo name>); REPO=DIR for one repo (repeat)")
    p.add_argument("--prefer", default="auto", choices=["auto", "ista", "unsloth", "any"])
    p.add_argument("--tie-tol-gib", type=float, default=0.10)
    p.add_argument("--tree", default=str(WS / "strata-r22p0210"), help="engine source tree for day1's type tables")
    p.add_argument("--rel", help="the release's tree (its tools/iq_pack.py; patchtest TREE=); default --tree")
    p.add_argument("--exe")
    p.add_argument("--server")
    p.add_argument("--mtp")
    p.add_argument("--no-swap", action="store_true", help="never the same-model swap (a new model's stock config)")
    p.add_argument("--kl-ref-gguf", help="shard 1 of the named local KL reference (a larger quant)")
    p.add_argument("--kl-published", help="the publisher's KLD / top-1 for the pick (text, with its source)")
    p.add_argument("--kl-data", default="auto", choices=["auto", "dump", "pfy"])
    p.add_argument("--main-margin-mib", type=float, default=64)
    p.add_argument("--ref-resident-margin-gib", type=float, default=5.0, help="R's --resident-budget-gib = RAM tier - this")
    p.add_argument("--helper-rule", choices=["today-bytes", "today-count", "max"])
    p.add_argument("--rate", type=float, default=0, help="a fixed download cap, MB/s (0 = none: Karl 11-05)")
    p.add_argument("--window", default="measure", choices=["measure", "gap", "any"],
                   help="measure (Karl 11-05): at once, paused only while a gap is open")
    p.add_argument("--gap-match", action="append")
    p.add_argument("--splice-gb", type=float, default=0)
    p.add_argument("--pick-only", action="store_true")
    p.add_argument("--no-drivers", action="store_true")
    # 11-05e (Karl's additions)
    p.add_argument("--no-precheck", action="store_true", help="item 2 off: no iq_pack pre-check of the headers")
    p.add_argument("--ngram-placement", default="ssd", choices=["ssd", "ram"],
                   help="item 3: the n-gram / Engram table on the SSD (--ple-io direct, today's) or in RAM (--ple-io ram, "
                        "taken from the expert RAM tier)")
    p.add_argument("--ngram-gib", type=float, help="the table's size when no header has it (an Engram sidecar)")
    p.add_argument("--compare-publishers", action="store_true",
                   help="item 1: run per publisher + the U-vs-ISTA comparison (automatic with repos of both publishers)")
    p.add_argument("--no-compare", action="store_true", help="item 1 off: one plan over every repo, as before")
    p.add_argument("--first", choices=["unsloth", "ista"], help="item 1: the publisher that was out first (watch sets it)")
    p.add_argument("--scratch", help="the scratch folder of --fetch-test (default work/qwen4-kit/scratch-d)")
    p.add_argument("--ud31-dir", help="11-06 veto: the v3.1 decision folder (default results/r23/ud31; tests only)")
    p.add_argument("--hcoff-dir", help="11-06 veto: the HC_Q8-off check's results (default results/r23/ud31/hcoff; tests only)")


def cmd_plan(a):
    if a.rel is None:
        a.rel = a.tree
    if a.scratch:
        SCRATCH["dir"] = Path(a.scratch).resolve()
    pubs = {publisher_of(s.partition("@")[0]) for s in a.repo or []} & {"unsloth", "ista"}
    if not a.no_compare and (a.compare_publishers or len(pubs) == 2):   # 11-05e item 1: per publisher + the comparison
        return 0 if plan_publishers(a) else 1
    return 0 if plan(a) else 1


def fit_args(p):
    p.add_argument("--gguf", help="shard 1 of a real file (header): its own expert parameters, table and 5080 room")
    p.add_argument("--totals", default="250,300,400", help="total parameters in B, WITHOUT the n-gram table (section 8)")
    p.add_argument("--dense-b", type=float, default=7.75, help="the dense part in B (UPGRADE-ESTIMATE 8.1: 7-8.5)")
    p.add_argument("--main-gib", type=float, default=7.3, help="the 5080's expert room (8.1's Qwen4 guess; --gguf: day1's)")
    p.add_argument("--helper-5060-gib", type=float, default=15.0, help="a 5060 Ti 16 GB's expert room (UPGRADE-ESTIMATE / qwen4.py)")
    p.add_argument("--ngram-gib", type=float, help="the n-gram / Engram table, GiB (default Flash-Next's 26.82 x the factors)")
    p.add_argument("--ngram-factors", type=lambda s: [float(x) for x in s.split(",")], default=[1.0, 1.6],
                   help="the table's size as multiples of Flash-Next's (8.1: 1.0-1.6)")
    p.add_argument("--tree", default=str(D1.TREE))
    p.add_argument("--out")


def dense_args(p):
    p.add_argument("--repo", action="append")
    p.add_argument("--listing", action="append", metavar="REPO=FILE")
    p.add_argument("--local", action="append")
    p.add_argument("--headers")
    p.add_argument("--offline", action="store_true")
    p.add_argument("--dest-root", action="append")
    p.add_argument("--name", required=True)
    p.add_argument("--out", required=True)
    p.add_argument("--tree", default=str(WS / "strata-r22p0210"))
    p.add_argument("--rel", help="the release's tree: its family table decides whether it runs the file (default --tree)")
    p.add_argument("--exe")
    p.add_argument("--server")
    p.add_argument("--min-ctx", type=int, default=32768)
    p.add_argument("--ngram-placement", default="ssd", choices=["ssd", "ram"])
    p.add_argument("--vram-main-mib", type=float, default=16303)
    p.add_argument("--reserve-mib", type=int, default=713)
    p.add_argument("--dense-overhead-gib", type=float, default=1.6, help="the 5080's CUDA context + scratch + prompt buffers")
    p.add_argument("--helper-free-gib", type=float, default=7.56)
    p.add_argument("--helper-keep-mib", type=float, default=512)
    p.add_argument("--dense-stage-overhead-gib", type=float, default=1.0, help="a later stage's session + prompt buffers")
    p.add_argument("--bw-main-gbs", type=float, default=960.0)
    p.add_argument("--bw-helper-gbs", type=float, default=288.0)
    p.add_argument("--bw-eff", type=float, default=0.8)
    p.add_argument("--no-precheck", action="store_true")
    p.add_argument("--no-drivers", action="store_true")
    p.add_argument("--no-q4split", action="store_true", help="11-06: no Q4-split quality comparison")


def cmd_execute(a):
    P = json.loads(Path(a.plan).read_text())
    cmds = []
    for it in P.get("files", []):
        if a.step == "download" and (it.get("download") or {}).get("command"):
            cmds.append(it["download"]["unit"])
        if a.step == "pack" and it.get("pack"):
            cmds.append(it["pack"]["command"])
        df = it.get("drafter_fallback")
        if df and a.step == "download" and not df["here_verified"]:
            cmds.append(df["download"])
        if df and a.step == "drafter":
            cmds += [df["inspect"], df["convert"]]
    if a.step == "pack":
        for pk in P.get("picks", []):
            ref = (pk.get("kl_driver") or {}).get("reference")
            if ref and ref.get("pack_command"):
                cmds.append(ref["pack_command"])
    for c in cmds:
        print(c)
    if not a.go:
        print(f"# {len(cmds)} command(s) printed, nothing started (--go runs them; the download starts at once and pauses "
              "only while a gap is open - Karl 11-05)")
        return 0
    for c in cmds:
        rc = subprocess.run(c, shell=True).returncode
        if rc != 0:
            print(f"rc {rc}: {c}")
            return rc
    return 0


def cmd_selftest(a):
    fails = []
    cal = served_calibration(str(WS / "strata-r22p0210"))
    row = cal["rows"]["logged budget (3,526 x largest)"]
    for what, got, want in (("uniform auto", row["uniform_auto"], F1["uniform_auto"]), ("sized auto", row["sized_auto"], F1["sized_auto"]),
                            ("sized at pin 2500", row["sized_pin"], F1["sized_pin"])):
        ok = got == want
        print(f"{'ok  ' if ok else 'FAIL'} slot model, served file, {what}: {got:,} (F1 logged {want:,})")
        fails += [] if ok else [what]
    hb = cal["helper_today_bytes"] / GIB
    ok = abs(hb - F1["helper_gib"]) < 1e-6
    print(f"{'ok  ' if ok else 'FAIL'} slot model, the 4060 Ti's 3,300 = {hb:.9f} GiB (F1 6.206154823)")
    fails += [] if ok else ["helper bytes"]
    s = slot_model(cal["blobs"], cal["n_exp"], cal["pairs"], F1["uniform_auto"] * max(cal["blobs"].values()) + 1,
                   cal["helper_today_bytes"], 0, None)
    ok = s["helper"] == F1["helper"]
    print(f"{'ok  ' if ok else 'FAIL'} slot model, helper count at today's bytes: {s['helper']:,} (3,300)")
    fails += [] if ok else ["helper count"]
    s2 = slot_model(cal["blobs"], cal["n_exp"], None, F1["uniform_auto"] * max(cal["blobs"].values()) + 1, 1 << 40, 0, None)
    ok = s2["sized_auto"] == F1["uniform_auto"]
    print(f"{'ok  ' if ok else 'FAIL'} slot model without a profile: uniform slots only ({s2['sized_auto']:,} = 3,526)")
    fails += [] if ok else ["no profile"]
    # the pick: a tie broken by --prefer, kept by any
    pk = {"pick": "/x/A-UD-IQ3_XXS-00001-of-00004.gguf", "tie": ["/x/A-UD-IQ3_XXS-00001-of-00004.gguf", "/y/ISTA/B-IQ3_S-00001-of-00002.gguf"]}
    co = {pk["tie"][0]: {"publisher": "unsloth"}, pk["tie"][1]: {"publisher": "ista"}}
    for pr, want in (("ista", [pk["tie"][1]]), ("unsloth", [pk["tie"][0]]), ("any", pk["tie"])):
        got, _ = apply_prefer(pk, co, pr, "")
        ok = got == want
        print(f"{'ok  ' if ok else 'FAIL'} --prefer {pr}: {[Path(x).name for x in got]}")
        fails += [] if ok else [f"prefer {pr}"]
    for path, want in (("UD-IQ3_XXS/Qwen3.8-Flash-Next-UD-IQ3_XXS-00001-of-00004.gguf", ("model", "UD-IQ3_XXS")),
                       ("MTP/mtp-Qwen3.8-Flash-Next-shared-BF16.gguf", ("mtp", "BF16")),
                       ("Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf", ("model", "IQ3_S")),
                       ("Q8_0/Qwen3.8-Flash-Next-Q8_0-00001-of-00006.gguf", ("model", "Q8_0")),
                       ("UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00002-of-00004.gguf", ("model", "UD-Q4_K_XL")),
                       ("mmproj-BF16.gguf", ("mmproj", "BF16")),
                       ("engram/Qwen3.8-Flash-Next-engram-Q5_1.gguf_file", ("engram", "Q5_1")),
                       ("imatrix_unsloth.gguf_file", ("imatrix", "imatrix_unsloth"))):
        k, lab, _ = classify(path)
        ok = (k, lab) == want
        print(f"{'ok  ' if ok else 'FAIL'} classify {path}: {k} {lab}")
        fails += [] if ok else [f"classify {path}"]
    print(f"selftest: {len(fails)} failure(s)" + (f": {fails}" if fails else ""))
    return 1 if fails else 0


def lossless_mirror(cfg_path):
    """bringup/patchtest.sh lossless_cfg's rule, mirrored read-only for the dry run (the drivers run the script itself)"""
    c = json.loads(Path(cfg_path).read_text())
    e, args, bad = c.get("env", {}), c.get("args", []), []
    for k, v in {"STRATA_ROUTE_TAIL_SKIP": "0", "STRATA_ADAPT_ASYNC": "0"}.items():
        if e.get(k) != v:
            bad.append(f"{k}={e.get(k, 'unset')}")
    if e.get("STRATA_PREFILL_CPU_SHARE") is None:
        bad.append("STRATA_PREFILL_CPU_SHARE unset")
    bad += [f"{k} unset" for k in ("STRATA_ROUTE_PRIOR", "STRATA_PROMPT_ATTN_IMMA", "STRATA_GR_V3", "STRATA_PREFILL_LAYER_MAJOR")
            if k not in e]
    if "STRATA_PLE_AUTO_RAM" not in e and "--ple-io" not in args:
        bad.append("STRATA_PLE_AUTO_RAM unset and no --ple-io")
    return ("PASS" if not bad else "FAIL " + ", ".join(bad))


def dryrun_checks(out, tag):
    """the non-GPU checks of a plan's pieces: cfgcheck / predl (the kit's, read-only, no gates file), the lossless rule
    (mirror), bash -n (done at generation), no .ready file, the execute steps in print-only mode"""
    P = json.loads((out / "plan.json").read_text())
    L = []
    for it in P.get("files", []):
        if not it.get("config"):
            continue
        r = subprocess.run([str(PY), "-I", "-B", str(KIT / "q4_rules.py"), "cfgcheck", it["config"], it["params"]],
                           capture_output=True, text=True)
        L.append(f"cfgcheck {Path(it['config']).name}: rc {r.returncode}: {r.stdout.strip()[-260:]}")
        L.append(f"lossless rule (mirror of patchtest.sh lossless_cfg) {Path(it['config']).name}: {lossless_mirror(it['config'])}")
        prm = json.loads(Path(it["params"]).read_text())
        for x in prm["dl"]["items"]:
            r = subprocess.run([str(PY), "-I", "-B", str(KIT / "q4_rules.py"), "predl", x["dest"], x["tree"], "--paths",
                                x["paths_csv"]], capture_output=True, text=True)
            L.append(f"predl {Path(x['dest']).name}: rc {r.returncode}: {r.stdout.strip()[-200:]}")
        for kind, d in (it.get("drivers") or {}).items():
            L.append(f"driver {Path(d['path']).name}: bash -n {d['bash_n']}; .ready file "
                     f"{'PRESENT' if Path(d['path'] + '.ready').exists() else 'none'}; sha {d['sha256']}")
    for pk in P.get("picks", []):
        k = pk.get("kl_driver")
        if k:
            L.append(f"driver {Path(k['path']).name}: bash -n {k['bash_n']}; .ready file "
                     f"{'PRESENT' if Path(k['path'] + '.ready').exists() else 'none'}; sha {k['sha256']}")
            ref = k.get("reference") or {}
            if ref.get("config"):
                r = subprocess.run([str(PY), "-I", "-B", str(KIT / "q4_rules.py"), "cfgcheck", ref["config"], k["params"],
                                    "--quality-only"], capture_output=True, text=True)
                L.append(f"cfgcheck --quality-only {Path(ref['config']).name}: rc {r.returncode}: {r.stdout.strip()[-220:]}")
                L.append(f"lossless rule (mirror) {Path(ref['config']).name}: {lossless_mirror(ref['config'])}")
            L.append(f"reference: {ref.get('label')}, {ref.get('experts_gib', 0):.2f} GiB of experts, larger than every candidate: "
                     f"{ref.get('larger_than_every_candidate')}, same vocabulary: {ref.get('same_vocabulary')}, data {ref.get('data')}")
    for step in ("download", "pack", "drafter"):
        r = subprocess.run([str(PY), "-I", "-B", str(KIT / "dayone.py"), "execute", step, "--plan", str(out / "plan.json")],
                           capture_output=True, text=True)
        (out / f"execute-{step}.txt").write_text(r.stdout + r.stderr)
        L.append(f"execute {step} (print only, no --go): rc {r.returncode}, {len([x for x in r.stdout.splitlines() if not x.startswith('#')])} "
                 f"command(s) -> execute-{step}.txt")
    (out / "CHECKS.txt").write_text("\n".join(L) + "\n")
    return L


def cmd_dryrun(a):
    """the Flash-Next stand-in: the v3.1 listing (pinned d9620119) + its saved headers + our ISTA file; the KL
    reference = the HF cache's UD-Q4_K_XL (as gap-ud31.sh); offline; three plans"""
    out = Path(a.out)
    out.mkdir(parents=True, exist_ok=True)
    v31 = KIT / "unsloth-v31"
    common = ["--repo", "unsloth/Qwen3.8-Flash-Next-GGUF@d96201194f103c906994f283f504209dc8d2a10c",
              "--listing", f"unsloth/Qwen3.8-Flash-Next-GGUF={v31 / 'dl/tree.json'}", "--headers", str(v31 / "headers"),
              "--local", str(SERVED), "--dest-root", str(WS / "models/unsloth-v31"), "--offline",
              "--kl-ref-gguf", ("/home/USER/.cache/huggingface/hub/models--unsloth--Qwen3.8-Flash-Next-GGUF/snapshots/"
                                "38bb39ee97821de2c9009abb7e93950eec396e66/UD-Q4_K_XL/Qwen3.8-Flash-Next-UD-Q4_K_XL-00001-of-00004.gguf"),
              "--rel", str(WS / "strata-r22p028x"), "--exe", str(WS / "engine-r22p028x/strata"),
              "--server", str(WS / "strata-r22p028x/serve/server.py")]
    runs = [("A-swap", ["--name", "fn31a", "--fetch-test", f"UD-IQ3_XXS={WS / 'models/unsloth-v31/UD-IQ3_XXS'}"]),
            ("B-stock", ["--name", "fn31b", "--no-swap", "--prefer", "unsloth", "--kl-data", "pfy"])]
    res = {}
    for tag, extra in runs:
        ap = argparse.ArgumentParser()
        common_args(ap)
        ns = ap.parse_args(common + extra + ["--out", str(out / tag)])
        if ns.rel is None:
            ns.rel = ns.tree
        log(f"=== dry run {tag}: {' '.join(extra)}")
        res[tag] = plan(ns)
        for ln in dryrun_checks(out / tag, tag):
            log(f"  {ln[:200]}")
    pv = {}
    for pr in ("auto", "ista", "unsloth", "any"):
        ap = argparse.ArgumentParser()
        common_args(ap)
        ns = ap.parse_args(common + ["--name", "fn31p", "--prefer", pr, "--pick-only", "--out", str(out / "prefer" / pr)])
        ns.rel = ns.rel or ns.tree
        r = plan(ns)
        pv[pr] = [{"final": [Path(f).name for f in pk["final"]], "note": pk["prefer_note"]} for pk in r["picks"]]
    (out / "prefer" / "variants.json").write_text(json.dumps(pv, indent=1) + "\n")
    # the provisional pick's download plan (header not read offline): the disk floor with a ~111 GB quant
    tree = out / "A-swap" / "listing" / "unsloth--Qwen3.8-Flash-Next-GGUF@d96201194f10.json"
    paths = [e["path"] for e in json.loads(tree.read_text()) if e.get("type") == "file" and e["path"].startswith("UD-Q4_K_XL/")]
    r = subprocess.run([str(PY), "-I", "-B", str(KIT / "gentle_dl.py"), "--tree", str(tree), "--repo",
                        "unsloth/Qwen3.8-Flash-Next-GGUF", "--commit", "d96201194f103c906994f283f504209dc8d2a10c", "--dest",
                        str(WS / "models/unsloth-v31/UD-Q4_K_XL"), "--plan"] + paths, capture_output=True, text=True)
    (out / "provisional-UD-Q4_K_XL-download-plan.txt").write_text(f"rc {r.returncode}\n" + r.stdout + r.stderr)
    log(f"provisional UD-Q4_K_XL download plan: rc {r.returncode}: {r.stdout.strip().splitlines()[-2][:220] if r.stdout.strip() else r.stderr[-200:]}")
    log(f"dry run: {out}")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    common_args(sp.add_parser("plan"))
    e = sp.add_parser("execute")
    e.add_argument("step", choices=["download", "pack", "drafter"])
    e.add_argument("--plan", required=True)
    e.add_argument("--go", action="store_true")
    d = sp.add_parser("dryrun")
    d.add_argument("--out", default=str(WS / "results/qwen4-kit/dayone-dryrun"))
    d.add_argument("--scratch", help="where the header fetch test's files go (default work/qwen4-kit/scratch-d)")
    sp.add_parser("selftest")
    # 11-05e: Karl's four additions
    pc = sp.add_parser("precheck", help="item 2: the pack pre-check alone")
    pc.add_argument("--local", action="append")
    pc.add_argument("--repo", action="append")
    pc.add_argument("--listing", action="append", metavar="REPO=FILE")
    pc.add_argument("--quant", action="append", help="only these quant labels of the repo")
    pc.add_argument("--fixture", action="append", help="a set of upstream's v3.1 header fixture (strata-r23p0211)")
    pc.add_argument("--fixture-tree", default=str(R23))
    pc.add_argument("--tree", default=str(WS / "strata-r22p028x"), help="whose tools/iq_pack.py decides")
    pc.add_argument("--headers")
    pc.add_argument("--dest-root", action="append")
    pc.add_argument("--offline", action="store_true")
    pc.add_argument("--out", required=True)
    w = sp.add_parser("watch", help="one poll: with --plan, the other publisher (item 1); without, the Hugging Face watch (Karl 11-06)")
    w.add_argument("--plan", help="item 1: the first plan's folder")
    w.add_argument("--repo", help="item 1: the other publisher's repo")
    w.add_argument("--listing", action="append", metavar="REPO=FILE")
    w.add_argument("--out", help="item 1: the new plan's folder; the HF watch: where its plans go (default work/qwen4-kit/hfwatch/plans)")
    w.add_argument("--orgs", default=",".join(HFW_ORGS))
    w.add_argument("--state", default=str(HFW_DIR / "state.json"))
    w.add_argument("--until", default=HFW_UNTIL)
    w.add_argument("--force", action="store_true", help="poll after --until too")
    w.add_argument("--dry", action="store_true", help="print the alert, the NOTES line and the download unit; send / start nothing")
    w.add_argument("--synthetic", help="tests: a JSON of fake org listings, repo infos, trees and plan arguments")
    w.add_argument("--rate", type=float, default=HFW_RATE, help="the download's fixed MB/s cap (LDR runs all weekend)")
    w.add_argument("--no-download", action="store_true")
    w.add_argument("--headers")
    w.add_argument("--dest-root", action="append")
    w.add_argument("--offline", action="store_true")
    w.add_argument("--notify", action="store_true")
    fit_args(sp.add_parser("fit", help="item 3: the expert budget / bpw table"))
    dense_args(sp.add_parser("dense", help="item 4: the dense fallback"))
    pr = sp.add_parser("_packcheck", help="internal: one tree's iq_pack on stand-ins")
    pr.add_argument("--tree", required=True)
    pr.add_argument("--gguf", required=True)
    pr.add_argument("--json", required=True)
    hu = sp.add_parser("hfwatch-units", help="11-06: stage the HF watch's user timer + service (not installed)")
    hu.add_argument("--out", default=str(KIT))
    hu.add_argument("--until", default=HFW_UNTIL)
    hc = sp.add_parser("hcoff", help="11-06: the v3.1 U file's exactness with STRATA_HC_Q8 off (Karl's veto escape), as a gap step")
    hc.add_argument("--out", default=str(KIT / "hcoff"))
    hc.add_argument("--results", default=str(HCOFF_RESULTS))
    se = sp.add_parser("selftest-e")
    se.add_argument("--dir", default=str(KIT / "scratch-e/selftest"))
    de = sp.add_parser("dryrun-e")
    de.add_argument("--out", default=str(KIT / "scratch-e/dryrun"))
    de.add_argument("--rel", default=str(WS / "strata-r22p028x"))
    de.add_argument("--live", action="store_true", help="also the HF range-request path on two small headers")
    a = ap.parse_args()
    if getattr(a, "scratch", None):
        SCRATCH["dir"] = Path(a.scratch).resolve()
    return {"plan": cmd_plan, "execute": cmd_execute, "dryrun": cmd_dryrun, "selftest": cmd_selftest, "precheck": cmd_precheck,
            "watch": cmd_watch, "fit": cmd_fit, "dense": cmd_dense, "_packcheck": cmd_packcheck_run,
            "selftest-e": cmd_selftest_e, "dryrun-e": cmd_dryrun_e, "hcoff": cmd_hcoff,
            "hfwatch-units": cmd_hfwatch_units}[a.cmd](a) if a.cmd != "watch" else watch_dispatch(a)


if __name__ == "__main__":
    sys.exit(main())
