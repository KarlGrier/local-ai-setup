+# 10-30 (Fix 1c; the Fix 1b replays lost 33 of 56 right marks): in b-f1b-jan1024 one of the two engine_dirs answers took
+# Strata's core runtime (src/core, src/prefill, ...) as the DeepSeek engine's, so those folders were disputed - 18 Qwen-only
+# names (--pcie-frac, STRATA_HOST_CORE, --adapt-every, ...) went "unsure" and 7 (STRATA_IO_PREFETCH, ...) "this version".
+# For a project of deep/engines/ at the user's pinned version (enginescope's per-version map, checked against the build
+# files; Karl 10-29: src/core + src/platform are the Qwen engine's at v0.2.4) the map gives the engine's folders and the
+# other engines' instead; a project or version the map does not cover keeps the two model answers.
+def _map_dirs(repo: Any, task: str, pins: dict | None, e: dict) -> dict:
+    """e (the settled model answers) with the engine map's folders, when the map covers this clone's project at the
+    user's pinned version and the task names one of its engines; else e unchanged."""
+    try:
+        from . import enginescope as es
+        tab = es.table()
+    except Exception:  # noqa: BLE001 - no map installed
+        return e
+    rn = str(getattr(repo, "name", "") or "").lower()
+    key = next((k for k, p in tab.items()
+                if rn in [x.lower() for x in [k, *p.get("repo_names", []), *p.get("repos", [])]]), None)
+    if key is None:
+        return e
+    ver = es.project_version(key, {str(k).lower(): v for k, v in (pins or {}).items()}) or getattr(repo, "ref", None)
+    ve = es.version_entry(key, ver)
+    task_eng = es.task_scopes(task or "").get(key)
+    if ve is None or not task_eng:
+        return e
+    p = tab[key]
+    moved = {f for fs in ve[1].values() if isinstance(fs, list) for f in fs}
+    owner: dict[str, str] = {}
+    for eng, ent in p["engines"].items():
+        for f in ent.get("folders", []):
+            if f not in moved:
+                owner[f] = eng
+    for f in p.get("shared", []):
+        if f not in moved:
+            owner[f] = "shared"
+    for eng, fs in ve[1].items():
+        if isinstance(fs, list) and (eng in p["engines"] or eng == "shared"):
+            for f in fs:
+                owner[f] = eng
+    strip = lambda f: f.rstrip("/")                              # noqa: E731 - _in_dirs takes folders without the slash
+    # the engine's code only: its lab / reference scripts and data files (tools/dsv41/ref.py takes --model) are not what
+    # the engine binary parses, so they stay "elsewhere" and the launcher trace still runs
+    mine = [strip(f) for f, o in owner.items() if o == task_eng and not f.startswith(("tools/", "data/"))]
+    other = {strip(f): p["engines"][o].get("label", o) for f, o in owner.items() if o not in (task_eng, "shared")}
+    # the model's launcher / server folders stay shared unless the map gives them to an engine (b-f1-fixes: src/program,
+    # the Qwen engine, came back as "shared", so its flags read as launcher-only)
+    shared = [d for d in e.get("shared", []) if es.path_engine(key, d + "/x", ver) in (None, "shared")]
+    return {**e, "dirs": mine, "shared": shared, "disputed": [], "other_engines": other,
+            "map": f"{p.get('name', key)} {ver} (the project's engine map: {ve[0]} entry)", "model_dirs": e.get("dirs")}
+
+
