#!/usr/bin/env python3
"""research-status - the research jobs' progress without asking the model (2026-10-18). Same text as Jan's
research_status, plus what Strata and the gate are doing right now.  Usage: ~/ai/deep-research/research-status [job]"""
import json, sys, urllib.request
sys.path.insert(0, "/home/USER/ai/deep-research/tools")
import importlib.util
spec = importlib.util.spec_from_file_location("mcp", "/home/USER/ai/deep-research/tools/research-mcp.py")
mcp = importlib.util.module_from_spec(spec); spec.loader.exec_module(mcp)
import research_common as rc
print(mcp.t_status({"job": sys.argv[1] if len(sys.argv) > 1 else None}))
# the stage LDR is in (its last MILESTONE line): "researching" covers the report and citation check too
import glob, os, re
logs = sorted(glob.glob("/home/USER/ai/deep-research/logs/ldr-web_*.log"), key=os.path.getmtime)
if logs and any(j.get("state") == "running" for j in rc.all_jobs()):
    with open(logs[-1], "rb") as f:
        f.seek(max(0, os.path.getsize(logs[-1]) - 200000))
        ms = [l for l in f.read().decode("utf-8", "replace").splitlines() if "| MILESTONE |" in l]
    if ms:
        m = re.match(r"\S+ (\d\d:\d\d).*? - (.*)", ms[-1])
        if m:
            print(f"Stage: {m.group(2)[:150]} (since {m.group(1)})")
try:
    op = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    live = json.load(op.open("http://127.0.0.1:8080/metrics", timeout=3))["live"]
    gen = f", {live.get('generated')} tokens written" if live.get("generated") else ""
    print(f"Strata now: {live.get('state')}{' - ' + live['phase'] if live.get('phase') else ''}{gen}")
except Exception:
    print("Strata now: not answering (stopped or starting)")
c = rc.read_clock()
if c:
    print(f"Gate: {c.get('gate')}" + (f" ({c['reason']})" if c.get("reason") else "") + f", research calls running: {c.get('inflight')}")
q = [j for j in rc.all_jobs() if j.get("state") == "queued"]
if q:
    print("Queued: " + "; ".join(j["id"] for j in q))
