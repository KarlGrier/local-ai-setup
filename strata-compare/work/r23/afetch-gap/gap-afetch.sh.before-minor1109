              [ -f $SQO/sq-score.watchdog ] && say "  $(cat $SQO/sq-score.watchdog)"
              case $EW in "ENV CHECK OK"*) gate env_sqscore PASS "$EW";; *) gate env_sqscore FAIL "$EW";; esac
              gate score INFO "rc $(cat $SQO/score.rc 2> /dev/null || echo none): $(grep -E '^scored|^PROBLEM' $SQO/score-run.txt | head -2 | tr '\n' ' ' | cut -c1-200)"
              kc score
            else
              say "  the scorer skipped (under $SCORE_MIN min to the deadline)"; gate skip_score INFO "the deadline"
            fi;;
          *) say "  no R1 samples (arms with samples:${DONE_ARMS:- none}): no ids, no scorer"; gate skip_score INFO "no R1 samples (${DONE_ARMS:-none})";;
        esac
      fi
    fi
    sq_decide
  else
    say "5 the sampled part does not fit: $(( $(left) / 60 )) min left, $SQNEED needed"
    gate skip_sampled INFO "the deadline: $(( $(left) / 60 )) min left, $SQNEED needed"
  fi
else
  gate skip_sampled INFO "$(why_not)"
  [ "$VFV" = FAIL ] && sq_decide   # (the read-back start found a mismatch: the harness's decision still written, both FAIL)
fi

# ---- 6 the decision, the lock sweep, P028x back
afr fetchstats $O --sampled $SQO > $O/fetchstats.txt 2>&1
sed 's/^/  (info) /' $O/fetchstats.txt | tee -a $S
DOWN_WORK=$(( ($(date +%s) - T0) / 60 ))
say "the gap's work took $DOWN_WORK min (deadline $MAXM)"
end_gap
DOWN=$(( ($(date +%s) - T0) / 60 ))
KA=ok; kc after || KA=FAILED
RL=$(cat $O/result-line.txt 2> /dev/null || echo "decision missing - rerun afetch_rules.py decide")
say "8080 was down for about $DOWN min; kernel check after the gap: $KA"
[ $KA = ok ] || alert "ADAPT_FETCH gap: kernel check" "the kernel check after the ADAPT_FETCH gap failed (8080 is back); see kwatch.log"
if [ $PRIO = 1 ]; then
  alert "ADAPT_FETCH gap stopped" "open Qwen4 Flash weights were found during the gap: it ended early, P028x is back; the day-one work goes first"
  finish "STOPPED by the priority rule (Karl 11-09: day-one work first; $PRIOWHY); P028x back after $DOWN min, nothing switched; what ran: $RL" 8
fi
note "ADAPT_FETCH gap done" "Measurements only, nothing switched; 8080 back after $DOWN min. $(echo "$RL" | sed -E 's/admissions\/window [0-9./]+//g' | cut -c1-160)"
finish "DONE (measurements only, nothing switched; 8080 down $DOWN min; kernel check after: $KA): $RL" 0
