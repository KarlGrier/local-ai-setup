    n = 0
    while p.poll() is None:
        m = memavail()
        low = min(low, m)
        if m < 12:
            why = f"failed: memory - MemAvailable {m:.1f} GB < 12"
            break
        n += 1
        if n % 30 == 0 and subprocess.run(["bash", f"{SC}/bringup/lib/kcheck.sh", "after-qwen"],
                                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
            why = "kernel check failed"
            break
        time.sleep(2)
    if p.poll() is None:
        p.terminate()
        p.wait()
    sh(["bash", f"{SC}/run-strata.sh", "stop"], env=env)
    for _ in range(60):
        if not subprocess.run(["pgrep", "-x", "strata"], capture_output=True).stdout:
            break
        time.sleep(1)
    st[k] = {"label": GL["qwen"], "min": round((time.time() - t0) / 60, 1), "lowest_mem": round(low, 1), "guard": why,
             "complete": suite_done(GL["qwen"])}
    save(st)
    say(f"graded set Qwen: {st[k]}")
    if why == "kernel check failed" or sh(["bash", f"{SC}/bringup/lib/kcheck.sh", "after-qwen-end"]) != 0:
        stop(st, "kernel check failed in the Qwen graded set")


def ds_engine():
    """the head-to-head's winner by the measurable part of maya-catchup.md's rule, else v026"""
    try:
        h = json.load(open(H2H_STATE))
    except (OSError, ValueError):
        return "v026", "no head-to-head state"
    S, kl, best, notes = h.get("steps", {}), h.get("kl") or {}, None, []
    for m, nb in (("M1", ("S1", "S2")), ("M2", ("S2", "S3"))):
        if not str(kl.get(m, "")).startswith("PASS"):
            notes.append(f"{m}: KL {kl.get(m)}")
            continue
        ok, gains = True, []
        for a in nb:
            if not ((S.get(a) or {}).get("dir") and (S.get(m) or {}).get("dir")):
                ok = False
                break
            c = json.loads(subprocess.run(["python3", f"{T}/compare.py", S[a]["dir"], S[m]["dir"]], capture_output=True,
                                          text=True).stdout or "{}")
            d, p4, p20 = c.get("decode") or {}, c.get("P4K") or {}, c.get("P20K") or {}
            if not (d.get("gain_pct", -99) > d.get("noise_pct", 99) and p4.get("gain_pct", -99) >= -p4.get("noise_pct", 0)
                    and p20.get("gain_pct", -99) >= -p20.get("noise_pct", 0)):
                ok = False
            gains.append(d.get("gain_pct", 0))
        notes.append(f"{m}: {'ahead' if ok else 'not ahead'} (decode {gains})")
        if ok and (best is None or min(gains) > best[1]):
            best = (m, min(gains))
    return (best[0] if best else "v026"), "; ".join(notes)


def graded_ds(st, effort):
    k = f"g_ds{effort}"
    if st.get(k) or DRY:
        if DRY:
            print(f"  DRY: DeepSeek effort {effort}: suite " + suite_cmd(GL[effort], "$URL", effort, CATS))
        return
    eng = FINAL_ENG   # (10-26, Karl: Maya is a fallback only - the ported Strata)
    d = st.get("daily") or {}
    t = next((x for x in d.get("tries", []) if x.get("ok")), None)
    cats, items = DS_SETS[effort]
    for attempt in range(3):   # (the suite resumes: a run cut by the client time limit collects only what is missing)
        key = f"g-ds{effort}" + (f"-r{attempt + 1}" if attempt else "")
        cmd = suite_cmd(GL[effort], "$URL", effort, cats) + f" --items {','.join(items)}"
        note = f"graded set, DeepSeek effort {effort} ({eng} + {FINAL_MODS}{', daily config ' + str(t['store_gb']) + ' GB' if t else ''}, {len(items)} prompts)"
        mods = ds_mods(t["store_gb"], f"{R}/graded-slots") if t else ds_mods()
        arm(st, key, mods, note, cmd, server_env="STRATA_DS4_AUTO_PIN=1" if t else None, client_timeout=36000)
        if suite_done(GL[effort]):
            break
    st[k] = {"label": GL[effort], "engine": eng, "mods": FINAL_MODS, "items": len(items), "complete": suite_done(GL[effort]),
             "runs": [x for x in st["steps"] if x.startswith(f"g-ds{effort}")]}
    save(st)
    say(f"graded set DeepSeek effort {effort}: {st[k]}")


def arm_maya(st, key, m, note, client):
    """a graded-set run on the head-to-head's Maya arm, inside maya-netns.sh as the head-to-head ran it"""
    if key in st["steps"]:
        return st["steps"][key]
    cfg = f"{SC}/results/ds41/h2h/cfg-{m}/maya-{m}.json"
    shutil.copy(tune.SHIPPED, MPROF)
    env = clean_env(ARM_NOTE=note, PROFILE=MPROF, COOL_MIN=0, PASSES=1, NPROMPT=1, ENGINE_NAME="maya-ds4", MAYA_ROOT=MSRC,
                    DS_SERVER=f"{MSRC}/serve/server.py", SERVER_ENV=f"STRATA_GLM_THINK_RESERVE=512 MAYA_UPDATE_CHECK=0 TMPDIR={SC}/results/ds41/h2h/tmp",
                    CLIENT=client, CLIENT_TIMEOUT=36000)
    say(f"{key}: {note}")
    t0 = time.time()
    with open(LOG, "a") as lf:
        subprocess.run(["bash", f"{MY}/maya-netns.sh", "bash", f"{MY}/maya-tunearm.sh", key, cfg], env=env, stdout=lf, stderr=lf)
    d = open(f"{SC}/tmp/ds41-arm-out").read().strip()
    g = open(f"{d}/GUARD").read().strip() if os.path.exists(f"{d}/GUARD") else ""
    s = open(f"{d}/summary.txt").read() if os.path.exists(f"{d}/summary.txt") else ""
    if "kernel" in g.lower() or re.search(r"KCHECK FAILED|kernel check failed", s, re.I):
        st["steps"][key] = {"dir": d, "guard": g or "kernel check failed"}
        stop(st, f"{key}: kernel event ({g or 'kcheck failed'}) - {d}")
    st["steps"][key] = {"dir": d, "min": round((time.time() - t0) / 60, 1), "guard": g or None,
                        "softstop": os.path.exists(f"{d}/SOFTSTOP"),
                        "nvme": next((l.strip() for l in s.splitlines() if l.startswith("nvme0")), None),
                        "swap": next((l.strip() for l in s.splitlines() if l.startswith("swap:")), None)}
    save(st)
    say(f"{key}: {st['steps'][key]['min']} min" + (f"; {g}" if g else ""))
    return st["steps"][key]


def ctx_cost(st):
    """12 (the user, 10-26, report only: "After the graded set ... measure DeepSeek's decode speed and VRAM expert count at a
    max context of 32K, 64K and 128K on the daily config. That shows what raising its context would cost if it becomes the
    main chat model"): the daily config of step 8 (the ship config if none) with --max-context 32768 / 65536 / 131072, the
    full protocol (speed3.py: P4K x3, P20K x3, W1-W3 x3), soft stop 14 GB as the daily-size runs; one that does not start
    or stops is recorded with the reason"""
    if st.get("ctx_cost") or DRY:
        if DRY:
            print("  DRY: context cost: daily config at --max-context 32768 / 65536 / 131072, full protocol")
        return
    d = st.get("daily") or {}
    t = next((x for x in d.get("tries", []) if x.get("ok")), None)
    base = ds_mods(t["store_gb"], f"{R}/ctx-slots") if t else ds_mods()
    out = {}
    for n in (32768, 65536, 131072):
        r = arm(st, f"ctx-{n // 1024}k", dict(base, **{"--max-context": n}),
                f"context cost: the daily config at --max-context {n} (report only)", "", passes=3, nprompt=3, soft=14,
                cool=60, server_env="STRATA_DS4_AUTO_PIN=1" if t else None)
        start = ""
        if r.get("dir") and os.path.exists(f"{r['dir']}/engine-start.log"):
            start = " / ".join(l.strip()[:160] for l in open(f"{r['dir']}/engine-start.log", errors="replace")
                               if re.search(r"context|KV|cache.*GB|layers \[|in VRAM|CPU lane", l))[:900]
        out[n] = {k: r.get(k) for k in ("decode", "P4K", "P20K", "vram_experts", "lowest_mem", "guard", "softstop", "dir")}
        out[n]["engine_lines"] = start
        say(f"context {n}: decode {r.get('decode')}, P4K {r.get('P4K')}, P20K {r.get('P20K')}, VRAM experts {r.get('vram_experts')}, "
            f"lowest {r.get('lowest_mem')} GB" + (f"; {r.get('guard')}" if r.get("guard") else "") + ("; SOFT STOP" if r.get("softstop") else ""))
    st["ctx_cost"] = out
    save(st)


