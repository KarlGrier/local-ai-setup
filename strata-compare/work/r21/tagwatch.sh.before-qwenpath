#!/bin/bash
# tagwatch.sh - 2026-10-17, your standing request: check hourly for a new final Strata release tag (read-only). Since
# 10-23 (the user: "make the queue and tag watch decide by what changed") the decision is work/r22/tagcheck.sh's: a
# release that changes nothing on the engine/server path raises the baseline itself (NOTES.md line) and the watch
# carries on; one that changes the engine or server sends a desktop alert and ends the watch ("NEW TAG ..." in
# tagwatch.out). After the review: work/r22/tagcheck.sh --accept <tag>, then start strata-tagwatch.service again.
# The baseline: ~/ai/deep-research/run/strata-baseline-tag (shared with the research queue). Log: logs/r21/tagwatch.log.
while :; do
  R=$(/home/USER/ai-speed-testing/strata-compare/work/r22/tagcheck.sh --who "tag watch")
  case "$R" in
    PAUSE*)
      read -r _ T B N WHY <<< "$R"
      echo "NEW TAG $T at $(date -Is): $N engine/server files changed since $B (${WHY#*: })"
      notify-send -a "Strata tag watch" -u critical "Strata $T changes the engine or server" "$N files on the engine/server path changed since $B. The research queue pauses at its next clean point. After the review: work/r22/tagcheck.sh --accept $T, then start strata-tagwatch.service again." 2> /dev/null || true
      exit 0 ;;
    RAISED*) echo "$(date -Is) $R (no engine/server change; baseline raised)" ;;
  esac
  sleep 3600
done
