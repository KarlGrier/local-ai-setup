    return sorted(f"{cat}/{x.split('.r')[0]}" for x in os.listdir(d)) if os.path.isdir(d) else []


def _spread(xs, k):
    """k of xs, evenly spaced (the first and the last kept: each category's range of difficulty stays covered)"""
    if k >= len(xs):
        return list(xs)
    return [xs[round(i * (len(xs) - 1) / (k - 1))] for i in range(k)] if k > 1 else [xs[0]]


# 10-26 (Karl): "DeepSeek at effort 50: the quick set minus the agentic repo fixes. Keep the tool-call prompts. DeepSeek at
# effort 75: math and coding only. If the estimate is over ~4 h, sample fewer prompts per category rather than dropping
# categories." Estimate at ~27 tok/s with the 8,192 thinking budget (DeepSeek thinks long: C.10's three prompts all
# reached the old cap at effort 75): the full sets ~3.1 h (effort 50) + ~4.4 h (effort 75) + Qwen ~0.8 h = ~8.3 h, so
# both DeepSeek runs are sampled, evenly spaced per category: effort 50 = coding 10/25, math 8/20, instruct 10/20, tools
# 10/10, honesty 10/20 (both halves), research 3/7 (~1.7 h); effort 75 = coding 8 and math 6, taken from effort 50's
# (~1.25 h). Qwen runs the full quick set (~0.8 h). Total ~3.75 h of GPU.
_E50 = {"coding": 10, "math": 8, "instruct": 10, "tools": 10, "honesty": 10, "research": 3}
