+    issues = [i for i in (crit or {}).get("issues") or [] if isinstance(i, dict) and (i.get("quote") or "").strip()
+              and i.get("type") != "gap"]
+    issues.sort(key=lambda i: PRIORITY.get(i.get("type"), 5))
+    items = []
