 # ------------------------------------------------------------------------------------------------ OpenAI
+def openai_timing_usage(stats: dict) -> dict:
+    """Engine timings for the latest model call, displayed by Open WebUI's usage tooltip.
+
+    Match Strata's own DONE/log counters: prefill counts only fresh tokens; decode includes all tokens the
+    engine produced (including reasoning/control tokens). Never estimate missing timings or divide by zero.
+    Open WebUI sums input/output token totals across tool rounds, but retains these fields from the last call.
+    """
+    if not stats:
+        return {}
+    extra = {"timing_scope": "last_model_call"}
+    prompt_n = stats.get("prompt_tokens")
+    reused = stats.get("reused")
+    fresh = None
+    if isinstance(prompt_n, int) and isinstance(reused, int) and 0 <= reused <= prompt_n:
+        fresh = prompt_n - reused
+        extra["prefill_tokens"] = fresh
+        extra["cached_prompt_tokens"] = reused
+    for source, count, duration_key, rate_key in (
+        ("prompt_ms", fresh, "prefill_ms", "prefill_tokens_per_second"),
+        ("decode_ms", stats.get("generated"), "decode_ms", "decode_tokens_per_second"),
+    ):
+        ms = stats.get(source)
+        if isinstance(ms, (int, float)) and 0 <= ms < float("inf"):
+            extra[duration_key] = round(ms, 2)
+            if isinstance(count, int) and count > 0 and ms > 0:
+                extra[rate_key] = round(1000.0 * count / ms, 2)
+    return extra
+
+
