def ds_mods(store_gb=None, slot_dir=None):
    """the final DeepSeek config: the ship config + the kept ports on the final engine; with store_gb the daily settings
    (the store, growth floor 14 GiB, slot keep on, cap 16, the folder cap 2 GB)"""
