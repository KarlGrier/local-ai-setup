#!/bin/bash
# gap-afetch-adopt.sh - Karl 11-09 (after the ADAPT_FETCH gap): "ADAPT_FETCH: make =2 the daily, as a recorded owner
# exception to the prompt no-loss rule. [...] Outside a gap, one restart: 1. Back up the config with a date. 2. Point P028x
# at the fetch build's engine and add STRATA_ADAPT_FETCH=2. 3. Run exact7 and the short speed check, and tell me the
# result. Keep a ready =1 config as the fallback. Give me the one-command rollback."
# The change = the gap's F2 arm exactly: exe engine-r22p028x -> engine-r23afetch (153ce47d3ef0, r23-adaptfetch f381bfdf5),
# env STRATA_ADAPT_FETCH=2. Gap 11-09 (results/r23/adaptfetch/gap/decision.txt): build vs switch PASS, F2 sampled PASS,
# read-back PASS, screen decode +12.7 %; its prompt no-loss FAIL (R4-agent33k -0.1 % vs noise 0.1 %) is Karl's recorded
# owner exception for this decision only (results/r23/adaptfetch/OWNER-EXCEPTION-1109.md; the rule is unchanged).
# The form of work/r23/gap-u-adopt.sh (reviewed 11-09), with the 11-09 kernel-error policy and the Qwen4 priority rule.
#   0 BEFORE THE GAP (no GPU, 8080 untouched) - REFUSES (nothing changed; exit 1 busy, exit 6 hard + an alert) unless:
#     the owner-exception record exists; the gap's decision.txt is the one adopted from (DONE, build vs switch PASS, F2's
#     quality PASS); af_adopt.py plan passes (P028x.json = the file the gap measured from, by sha; + the change = the gap's
#     F2.json key by key); the fetch build is 153ce47d3ef0; the stored exact7 x28h-e7a, this morning's P / PU bp90 files,
#     the gap's P / F2 decode files and the U adoption's S files exist; the Qwen4 priority rule is CLEAR; no other gap, no
#     held test lock, no model server but 8080's P028x, nothing on 8081; kwatch runs, no kernel-error marker, a clean
#     kernel check. The ready =1 fallback configs/P028x.json.afetch1-1109 and a copy of the =2 daily
#     configs/P028x.json.afetch2-1109 are written here (never served by this script; served-afetch.sh switches to them).
#   1 port_gap4.sh begin (the research queue held, the test lock, 8080 down; it waits for a running question, an active
#     Jan job and a chat being answered on 8080)
#   2 configs/P028x.json -> P028x.json.before-afetch2-1109 (kept for rollback), then exe engine-r23afetch/strata + env
#     STRATA_ADAPT_FETCH=2, nothing else (checked); the test configs S2 = the new file without the picture reader /
#     fallback / guard key (= the gap's F2.json, checked) and S0 = S2 without the switch (= F0.json)
#   3 exact7 S0 at pin 2500 against P028x's stored x28h-e7a: 7/7 slots MATCHED wanted (the new engine + config are P028x
#     bitwise with the switch unset); the CLI engines' env checked. Then exact7 S2 (the switch on) - INFORMATION ONLY: the
#     fetch admissions move experts between the CPU and the GPUs, so bit-identity is not expected; its env check must pass
#     and no fatal line may appear (the switch's quality is the gap's sampled test + read-back)
#   4 the short speed check on S2, a fresh engine each, its env checked: pp16k, pp64k, decode (conv / struct / prose), 1
#     pass; pp16k / pp64k against this morning's PU (P028x + U) and P and the U adoption's check, decode against the gap's
#     P and F2; reported, a FLAG when a prompt set is more than 3 % below PU (Karl decides; no rollback for a FLAG)
#   5 a FAIL in 2-4 (the edit, the env checks, exact7 S0, a fatal line, no speed server up) -> the backup goes back
#     (P028x as before) and a critical alert; the restart below then brings P028x back as it was
#   6 port_gap4.sh end = THE ONE RESTART: configs/P028x.json on 8080
#   7 after it: the 8080 engine is 153ce47d3ef0 with STRATA_ADAPT_FETCH=2 and STRATA_HC_UPMIX=1 in its environment; its
#     log shows the switch's start line (on, not an off-condition); the guard answers DeepSeek's model with its 400; one
#     short chat answers and its request prints a fetch line; a kernel check
# KERNEL ERRORS (Karl 11-09: any new Xid or kernel error: stop at once, bring P028x back, alert; kwatch not cleared):
# kwatch's tmp/r19/KERNEL_ERROR is polled every 5 s while a test engine runs (this gap's engines, started after the gap
# opened and not under 8080's listener, are killed at once) and checked before every step and by every kernel check; then
# the backup goes back (P028x as before), the lock sweep, port_gap4.sh end, a critical alert, exit 3.
# -> results/r23/afetch-adopt/ (summary.txt, gates.txt, result.txt), a NOTES.md line, a non-urgent ntfy note (an alert on a
# FAIL). Exit 0 adopted, 1 busy (refused), 2 rolled back (P028x as before), 3 kernel error (stopped, P028x back) or a failed
# restore (gap left OPEN), 4 port_gap4.sh end failed, 5 served checks failed after the restart, 6 hard refusal, 7 signal.
set -u -o pipefail
exec 8>&- 9>&-     # no inherited lock descriptor reaches a child (this script holds none itself)
WS=/home/USER/ai-speed-testing/strata-compare
source $WS/bringup/lib/env.sh
unset GUARD_MEM_GIB GUARD_VRAM_MIB GUARD_SWAP_GROW_GIB GUARD_VRAM_MODE GUARD_FOLLOW_PORT LR_MAX SPEED_FILE
for v in $(compgen -e | grep '^STRATA_'); do [ "$v" = STRATA_MON_GPU ] || unset "$v"; done   # no stray switch reaches an engine
export PROMPT_DIR=$WS/bringup/out/r20a/prompts RB_CACHE=$WS/tmp/r23 EVICT_GLOB="$WS/models/ISTA-GSQ-RCO/IQ3_S/*.gguf"
P=$WS/.venv/bin/python; AA=$WS/work/r23/afetch-adopt/af_adopt.py; FR=$WS/work/r23/basalt_fix_rules.py; KR=$WS/work/r22
AFR=$WS/work/r23/afetch-gap/afetch_rules.py; LIB=$WS/bringup/lib; B90=$KR/basalt-pr90
O=$WS/results/r23/afetch-adopt; S=$O/summary.txt; G=$O/gates.txt; BO=$O/bp90; EL=$O/englog; FG=$O/foreign
CFG=$WS/configs/P028x.json; BAK=$WS/configs/P028x.json.before-afetch2-1109; FB1=$WS/configs/P028x.json.afetch1-1109
FB2=$WS/configs/P028x.json.afetch2-1109   # a copy of the adopted daily (served-afetch.sh afetch2 switches back to it)
GAPD=$WS/results/r23/adaptfetch/gap; GC=$GAPD/configs; GAPBP=$GAPD/bp90; DEC=$GAPD/decision.txt
EXC=$WS/results/r23/adaptfetch/OWNER-EXCEPTION-1109.md
UBP=$WS/results/r23/u-adopt/bp90; MORNING=$WS/results/r23/basalt-prompt/gap-speed/bp90
S2C=$O/S2.json; S0C=$O/S0.json
W28=$WS/strata-r22p028x; E28=$WS/engine-r22p028x; EAF=$WS/engine-r23afetch; E7REF=x28h-e7a; PROF=$WS/bringup/out/logs/prof
LOCKPID=$WS/tmp/port-gap.lockpid; LOCKF=$WS/tmp/gpu-test.lock; HOLD=/home/USER/ai/deep-research/tmp/bench2.hold
KERR=$WS/tmp/r19/KERNEL_ERROR   # kwatch's marker (never taken from the environment, never cleared here)
STATE=$WS/work/qwen4-kit/hfwatch/state.json; PRIO_DONE=$WS/tmp/afetch-priority-done
NOTE=$WS/configs/usability/bin/ntfy-note.py
P028X_SHA=f4c4f654fb24; EAF_SHA=153ce47d3ef0
MAXM=${AA_MAX_MIN:-55}
CLK=$(getconf CLK_TCK)
LP=r23aa$(date +%m%d%H%M)
PREV=""; if [ -n "$(find $O/bp90 $O/englog -mindepth 1 2> /dev/null | head -1)" ]; then PREV=$O-prev-$(date +%m%d-%H%M%S); mv $O $PREV; fi   # judge only this attempt
mkdir -p $O $BO $EL $FG $WS/logs $WS/tmp/r23
say() { echo "=== $(date '+%F %T') $*" | tee -a $S; }
gate() { echo "$1 $2 ${*:3} [23aa $(date '+%m-%d %H:%M')]" >> $G; say "  gate $*"; }
gst() { grep "^$1 " $G 2> /dev/null | tail -1 | cut -d' ' -f2; }
br() { $P -I -B $FR br "$@" 8>&- 9>&- < /dev/null; }
aa() { nice -n 19 $P -I -B $AA "$@" 8>&- 9>&- < /dev/null; }
afr() { nice -n 19 $P -I -B $AFR "$@" 8>&- 9>&- < /dev/null; }
alert() { notify-send -a Strata -u critical "$1" "$2" 2> /dev/null || true; }
note() { $NOTE "$1" "$2" >> $S 2>&1 8>&- 9>&- < /dev/null || say "(the ntfy note did not go out)"; }
KFAIL=0; GAPOPEN=0; ENDING=0; T0=$(date +%s); T0T=0; PRE=""; DEADLINE=$(( T0 + MAXM * 60 ))
kc() {   # a kernel check, and kwatch's marker: either fails -> KFAIL (Karl 11-09: stop at once)
  [ -e $KERR ] && { [ $KFAIL = 1 ] || say "KERNEL ERROR recorded by kwatch ($(head -c 160 $KERR 2> /dev/null | tr '\n' ' ')) at $1"; KFAIL=1; return 1; }
  $LIB/kcheck.sh "r23aa-$1" > /dev/null 8>&- 9>&- < /dev/null || { say "KERNEL CHECK FAILED after $1"; KFAIL=1; return 1; }
}
left() { echo $(( DEADLINE - $(date +%s) )); }
ok_to_go() {   # (review 11-09 #7) kwatch's marker sets KFAIL here too, so every later step takes the kernel-error path
  if [ -e $KERR ] && [ $KFAIL = 0 ]; then say "KERNEL ERROR recorded by kwatch ($(head -c 160 $KERR 2> /dev/null | tr '\n' ' '))"; KFAIL=1; fi
  [ $KFAIL = 0 ] && [ $(left) -gt 0 ]
}
fits() { ok_to_go && [ $(left) -ge $(( $1 * 60 )) ]; }
sha12() { sha256sum "$1" | cut -c1-12; }
elog() { $P -I -c "import json, sys; print(json.load(open(sys.argv[1]))['log'])" "$1"; }
exe_of() { $P -I -c "import json, sys; print(json.load(open(sys.argv[1]))['exe'])" "$1"; }
slog() { ls -t $WS/bringup/out/logs/server_$1_*.log 2> /dev/null | head -1; }
ppid_of() { local s; s=$(cat /proc/$1/stat 2> /dev/null) || return 0; s=${s##*) }; set -- $s; echo "${2:-}"; }
memav() { awk '/^MemAvailable/ {printf "%d", $2 / 1048576}' /proc/meminfo; }
engines_left() { local x out=""; for x in strata strata-host strata-vision strata-dsv41 llama-server ollama; do pgrep -x $x > /dev/null && out="$out $x"; done; echo $out; }
listener8080() { ss -H -ltnp "( sport = :8080 )" 2> /dev/null | grep -o 'pid=[0-9]*' | head -1 | cut -d= -f2; }
srv8080_engine() {   # the engine process under the server listening on 8080 ("" if none)
  local l p q
  l=$(listener8080)
  [ -n "$l" ] || return 0
  for p in $( { pgrep -x strata-host; pgrep -x strata; } | sort -un); do
    q=$p; while [ -n "$q" ] && [ "$q" -gt 1 ] && [ "$q" != "$l" ]; do q=$(ppid_of $q); done
    [ "$q" = "$l" ] && { echo $p; return 0; }
  done
}
uptk() { awk -v c=$CLK '{printf "%d", $1 * c}' /proc/uptime; }
ptick() { local s; s=$(cat /proc/$1/stat 2> /dev/null) || { echo 0; return 0; }; s=${s##*) }; set -- $s; echo ${20}; }
under8080() { local l q; l=$(listener8080); [ -n "$l" ] || return 1; q=$1; while [ -n "$q" ] && [ "$q" -gt 1 ] && [ "$q" != "$l" ]; do q=$(ppid_of $q); done; [ "$q" = "$l" ]; }
our_exe_pids() { find /proc/[0-9]*/exe -maxdepth 0 \( -lname "$EAF/*" -o -lname "$E28/*" \) 2> /dev/null | cut -d/ -f3 | sort -un; }
ours_new() {   # ours_new PID EXE: an engine binary of this gap AND started after the gap opened AND not one of PRE (running when
  # it opened) AND not under the 8080 listener - never the served engine, never one from before the gap
  case "$2" in $EAF/*|$E28/*) ;; *) return 1;; esac
  [ $GAPOPEN = 1 ] && [ $T0T -gt 0 ] || return 1
  case " $PRE " in *" $1 "*) return 1;; esac
  [ "$(ptick $1)" -ge $T0T ] || return 1
  under8080 $1 && return 1
  return 0
}
desc() { local c; for c in $(pgrep -P $1 2> /dev/null); do echo $c; desc $c; done; }
kill_tree() { local p; [ -n "${1:-}" ] && kill -0 $1 2> /dev/null || return 0; for p in $(desc $1) $1; do kill -KILL $p 2> /dev/null; done; }
JP=""   # the running exact7 job (its subshell); set before its GPU watch starts, so the watch can stop it
kerr_poll() {   # Karl 11-09: a kernel error -> this gap's programs are killed at once, and again at EVERY poll while the marker
  # exists (review 11-09 #2: exact7 starts a fresh engine per item), the exact7 job too; $O/kerr.seen marks it
  local p ex
  [ -e $KERR ] || return 0
  [ -e $O/kerr.seen ] || touch $O/kerr.seen
  [ $ENDING = 0 ] || return 0   # (never during port_gap4.sh end: the served engine starting there has the fetch build's binary)
  for p in $(our_exe_pids); do ex=$(readlink /proc/$p/exe 2> /dev/null) || continue; ours_new $p "$ex" && kill -KILL $p 2> /dev/null; done
  kill_tree "$JP"
  return 0
}
lock_sweep() {   # before port_gap4.sh end: nothing of this gap may still run or hold the test lock (strata-ensure refuses then)
  local p ex cmd lp pp bad=""
  [ $GAPOPEN = 1 ] && [ $ENDING = 0 ] || return 0
  lp=$(cat $LOCKPID 2> /dev/null); pp=$(ppid_of ${lp:-0})
  for p in $(our_exe_pids); do
    ex=$(readlink /proc/$p/exe 2> /dev/null) || continue
    if ours_new $p "$ex"; then kill -KILL $p 2> /dev/null; bad="$bad $p(${ex##*/}: this gap's, killed)"
    else case " $PRE " in *" $p "*) bad="$bad $p(${ex##*/}: running since before the gap - left alone)";; esac; fi
  done
  for p in $(find /proc/[0-9]*/fd -maxdepth 1 -lname "$LOCKF" 2> /dev/null | cut -d/ -f3 | sort -un); do
    { [ "$p" = $$ ] || [ "$p" = "$lp" ] || [ "$p" = "$pp" ]; } && continue
    cmd=$(tr '\0' ' ' < /proc/$p/cmdline 2> /dev/null | cut -c1-400)
    case $cmd in *monitor-$LP-*|*srv-$LP-*|*$O/*) kill -TERM $p 2> /dev/null; bad="$bad $p(this gap's leftover, stopped)";;
      *) bad="$bad $p($(cat /proc/$p/comm 2> /dev/null) holds the test lock)";; esac
  done
  [ -n "$bad" ] && { say "  lock sweep before the end:$bad"; gate lock_sweep INFO "$bad"; sleep 3; }
  return 0
}

hold_foreign() { [ -e $HOLD ] && ! grep -qF 'ADAPT_FETCH=2 adoption' $HOLD 2> /dev/null; }   # the research queue held by someone else
preflight() {   # gap-u-adopt.sh's rule: no measurement on the GPU lock, no other gap, no model server but 8080's P028x
  local l p q apps bad="" sh
  hold_foreign && refuse busy "the research queue is held by someone else (bench2.hold: $(head -c 120 $HOLD 2> /dev/null | tr '\n' ' ')) - another gap opener or a pause"
  if [ -s $LOCKPID ] && kill -0 "$(cat $LOCKPID)" 2> /dev/null; then
    refuse busy "another gap holds the test lock (tmp/port-gap.lockpid $(cat $LOCKPID))"
  fi
  if ! flock -n -x $LOCKF true 2> /dev/null; then
    refuse busy "tmp/gpu-test.lock is held (a measurement or a test server)"
  fi
  l=$(listener8080)
  apps=$(timeout 30 nvidia-smi --query-compute-apps=pid --format=csv,noheader 2> /dev/null) || refuse busy "nvidia-smi did not answer"
  for p in $( { for x in strata strata-host strata-vision strata-dsv41 llama-server ollama; do pgrep -x "$x"; done; echo "$apps"; } \
              | tr -d ' ' | grep -E '^[0-9]+$' | sort -un); do
    q=$p; while [ -n "$q" ] && [ "$q" -gt 1 ] && [ "$q" != "${l:-none}" ]; do q=$(ppid_of $q); done
    if [ -n "$l" ] && [ "$q" = "$l" ]; then
      case $(cat /proc/$p/comm 2> /dev/null) in
        strata|strata-host) sh=$(sha12 /proc/$p/exe 2> /dev/null)   # (a rerun after a restart with the change: the fetch build)
          [ "$sh" = $P028X_SHA ] || [ "$sh" = $EAF_SHA ] || bad="$bad 8080-engine:$p($(readlink /proc/$p/exe))";;
        strata-vision) ;;
        *) bad="$bad 8080:$p($(cat /proc/$p/comm 2> /dev/null))";;
      esac
    else bad="$bad $p($(cat /proc/$p/comm 2> /dev/null))"; fi
  done
  ss -H -ltn "( sport = :8081 )" 2> /dev/null | grep -q . && bad="$bad listener-on-8081(a-test-server)"
  [ -z "$bad" ] || refuse busy "a model server other than the 8080 queue's P028x is running:$bad"
}
fatalchk() {   # fatalchk GATE ENGINE_LOG OFFSET LABEL
  local L=$2 off=$3 sl hits
  sl=$(slog $4)
  hits=$( { tail -c +$((off + 1)) $L 2> /dev/null; [ -n "$sl" ] && cat $sl; } | grep -c -E "fatal GPU error|no progress for [0-9]+ s during a request|the engine had stopped \(exit code|became non-finite")
  [ "$hits" = 0 ] || gate $1 FAIL "$hits line(s): fatal GPU error / stall / engine restart / non-finite ($L from byte $off; $sl)"
}
foreign() {   # GPU users that are not this gap's engine: an engine process (exact names) or an NVIDIA compute process
  # holding >= 512 MiB (or an unknown amount) whose binary is not in engine-r23afetch/
  local p m x ex c
  { for x in strata strata-host strata-vision strata-dsv41 llama-server ollama; do pgrep -x $x | sed 's/$/,engine/'; done
    timeout 30 nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader,nounits 2> /dev/null; } | tr -d ' ' \
  | while IFS=, read -r p m; do
      [[ $p =~ ^[0-9]+$ ]] && [ -e /proc/$p ] || continue
      [[ $m =~ ^[0-9]+$ ]] && [ $m -lt 512 ] && continue
      ex=$(readlink /proc/$p/exe 2> /dev/null) || ex=""; c=$(cat /proc/$p/comm 2> /dev/null)
      case $c in strata-dsv41|llama-server|ollama) ;; *) [ -n "$ex" ] || continue
        case $ex in $EAF/*) continue;; esac;; esac
      echo "pid $p ($c, ${ex:-?}, $m$([[ $m =~ ^[0-9]+$ ]] && echo ' MiB'))"
    done | sort -u
}
gwatch() { while [ -e $1 ] && kill -0 $$ 2> /dev/null; do foreign | sed "s/^/$(date +%T) /" >> $2; kerr_poll; sleep 5; done; }
gpu_clear() {
  local i f
  for i in $(seq 12); do f=$(foreign); [ -z "$f" ] && return 0; sleep 5; done
  gate foreign_$1 FAIL "not started: $(echo "$f" | head -1) still on the GPU after 60 s"
  return 1
}
WGP=""
wstart() { rm -f $FG/$1.foreign; touch $FG/$1.watching; gwatch $FG/$1.watching $FG/$1.foreign 8>&- 9>&- < /dev/null & WGP=$!; }
wstop() {
  rm -f $FG/$1.watching; [ -n "$WGP" ] && wait $WGP 2> /dev/null; WGP=""
  [ -s $FG/$1.foreign ] && gate foreign_$1 FAIL "seen during $1 ($(wc -l < $FG/$1.foreign) sample(s)): $(head -1 $FG/$1.foreign | cut -c1-160)"
  return 0
}
bprun() {   # bprun SET: one fresh test server from S2, its env checked, Basalt's fixture SET, 1 pass -> bp90/S2-SET-1.jsonl
  local set=$1 lab=$LP-S2-$1 out=$BO/S2-$1-1.jsonl L off exe
  fits 4 || { say "skipped $set (under 4 min to the deadline, or a kernel error)"; return 0; }
  gpu_clear S2_$set || { say "$lab NOT started (a foreign GPU user)"; return 0; }
  exe=$(exe_of $S2C); L=$(elog $S2C); touch $L; off=$(stat -c %s $L)
  say "server $lab (S2.json)"
  wstart S2_$set
  $LIB/with_server.sh $lab $S2C -- "$P -I -B $FR br envcheck $exe $S2C --gate env_S2_$set --gates $G && $P -I -B $B90/bp90_client.py http://127.0.0.1:8081 --label $lab --sets $set --passes 1 --first-pass 1 --tree $W28 --out $out" 8>&- 9>&- < /dev/null 2>&1 \
    | grep -E "engine pid [0-9]+:|ENV CHECK| pass |tok/s|ready|exited|refus|Error|GUARD|Traceback" | tee -a $S
  wstop S2_$set
  tail -c +$((off + 1)) $L > $EL/$lab.englog
  fatalchk fatal_S2_$set $L $off $lab
  if [ "$(gst foreign_S2_$set)" = FAIL ]; then mkdir -p $BO/void; [ -e $out ] && mv $out $BO/void/; fi
  kc $lab
  return 0
}
e7() {   # e7 TAG CFG: exact7 at pin 2500 against the stored x28h-e7a, every item's engine env checked -> gates e7_TAG, env_TAG_e7
  local tag=$1 cfg=$2 jp
  fits 6 || { say "skipped exact7 $tag (under 6 min to the deadline, or a kernel error)"; return 1; }
  say "exact7 $LP-$tag ($(basename $cfg) against $E7REF, pin 2500)"
  ( PIN_CACHE=2500 REF=$E7REF $LIB/exact7.sh $LP-$tag $cfg 2>&1 | tail -9 | tee -a $S ) 8>&- 9>&- < /dev/null &
  jp=$!; JP=$jp
  wstart e7_$tag
  br envcli $(exe_of $cfg) $cfg --job $jp --mode e7 --kill --gate env_${tag}_e7 --gates $G 2>&1 | tee -a $S
  wait $jp
  JP=""
  wstop e7_$tag
  br e7gate $S $LP-$tag --gate e7_$tag --gates $G | tee -a $S
  local hits; hits=$(cat $PROF/$LP-$tag-*.out $PROF/$LP-$tag-*.err 2> /dev/null | grep -c -E "fatal GPU error|became non-finite|no progress for [0-9]+ s")
  [ "${hits:-0}" = 0 ] || gate fatal_e7_$tag FAIL "$hits fatal / non-finite / stall line(s) in $PROF/$LP-$tag-*.out / .err"
  kc e7-$LP-$tag
}
EDITED=0; ROLLED=0; RESTARTING=0
cfgstate() {   # what configs/P028x.json is now, for the result lines
  if [ -e $BAK ] && cmp -s $CFG $BAK; then echo "configs/P028x.json = its backup (P028x as before: engine-r22p028x, U, the guard)"
  elif [ $EDITED = 1 ]; then echo "configs/P028x.json STILL HAS the fetch build + STRATA_ADAPT_FETCH=2 (not restored)"
  else echo "configs/P028x.json not changed"; fi
}
served_sw() {   # yes / no / none: STRATA_ADAPT_FETCH=2 in the 8080 engine's environment
  local ep; ep=$(srv8080_engine); [ -n "$ep" ] || { echo none; return 0; }
  tr '\0' '\n' < /proc/$ep/environ 2> /dev/null | grep -qx 'STRATA_ADAPT_FETCH=2' && echo yes || echo no
}
refuse() {   # refuse busy|hard WHY - before the gap, nothing changed. busy: exit 1; hard: an alert, exit 6
  echo "not started ($1): $2 - nothing changed" > $O/result.txt
  say "NOT STARTED ($1): $2 - nothing changed"
  if [ "$1" = hard ]; then
    printf -- '- %s ADAPT_FETCH=2 ADOPTION not started: %s - nothing changed (work/r23/afetch-adopt/gap-afetch-adopt.sh)\n' "$(date '+%m-%d %H:%M')" "$2" >> $WS/NOTES.md
    alert "ADAPT_FETCH adoption not started" "$(echo "$2" | cut -c1-120); nothing changed"; exit 6
  fi
  exit 1
}
on_signal() {   # stopped from outside (review 11-09 #3 / #6): the exact7 job stopped; inside the gap and before the restart the
  # backup goes back and this gap's engines are swept; port_gap4.sh end is NOT run here (a systemd stop would cut it off) -
  # the result says what to do; stopped inside begin: this driver's research-queue hold is lifted (or "maybe open")
  trap - TERM INT HUP
  say "SIGNAL: the driver was stopped"
  local st
  kill_tree "$JP"
  if [ $RESTARTING = 1 ]; then
    st="stopped during or after the restart (port_gap4.sh end): do NOT run end a second time blindly - check 8080's engine, tmp/port-gap.lockpid and the research-queue hold first; $(cfgstate)"
  elif [ $GAPOPEN = 1 ]; then
    [ $ROLLED = 0 ] && rollback "the driver was stopped"
    lock_sweep
    if [ $ROLLED = 9 ]; then st="the restore FAILED: the gap is OPEN (8080 down) - fix configs/P028x.json (backup configs/P028x.json.before-afetch2-1109) before work/r22/port_gap4.sh end"
    else st="the gap is OPEN (8080 down); $(cfgstate): close it with work/r22/port_gap4.sh end (8080 then starts P028x as before)"; fi
  else
    st="the gap was not open; $(cfgstate)"
    if grep -qF 'ADAPT_FETCH=2 adoption' $HOLD 2> /dev/null; then
      if [ -s $LOCKPID ] && kill -0 "$(cat $LOCKPID)" 2> /dev/null; then st="the gap may have opened as it was stopped (lock held; the config not changed): close it with work/r22/port_gap4.sh end"
      else rm -f $HOLD; st="the gap was not open (this driver's research-queue hold lifted); $(cfgstate)"; fi
    fi
  fi
  ss -H -ltn "( sport = :8080 )" 2> /dev/null | grep -q . && st="$st; 8080 is listening" || st="$st; 8080 is NOT listening"
  echo "INTERRUPTED: $st" > $O/result.txt
  say "INTERRUPTED: $st"
  printf -- '- %s ADAPT_FETCH=2 ADOPTION INTERRUPTED: %s\n' "$(date '+%m-%d %H:%M')" "$st" >> $WS/NOTES.md
  alert "ADAPT_FETCH adoption interrupted" "$(echo "$st" | cut -c1-160)"
  exit 7
}
rollback() {   # $1 = why: the backup back, before the restart (once the edit has run, or the config differs from its backup in the gap)
  [ $EDITED = 0 ] && [ $GAPOPEN = 1 ] && [ -e $BAK ] && ! cmp -s $CFG $BAK && EDITED=1
  [ $EDITED = 1 ] || { say "no rollback needed ($1): configs/P028x.json was not changed"; ROLLED=1; return 0; }
  say "ROLLBACK ($1): configs/P028x.json back to its backup"
  if aa restore $CFG $BAK | tee -a $S | grep -q '^restored'; then ROLLED=1
  else say "THE RESTORE FAILED - configs/P028x.json needs a look before 8080 starts"; ROLLED=9; fi
}
finish() {   # $1 = the result line, $2 = exit code
  echo "$1" > $O/result.txt
  say "RESULT: $1"
  printf -- '- %s ADAPT_FETCH=2 ADOPTION (Karl 11-09; work/r23/afetch-adopt/, results/r23/afetch-adopt/): %s\n' "$(date '+%m-%d %H:%M')" "$1" >> $WS/NOTES.md
  exit $2
}
