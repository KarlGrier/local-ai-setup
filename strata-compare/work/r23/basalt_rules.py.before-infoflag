def expect_plan(cuts, C, smin, kind):
    n_exp = 0
    for n in cuts:
        if n <= C:
            continue
        if kind == "first":
            if C > 16384:
                rest = n - 16384
                k = (rest + C - 1) // C
                n_exp += k > 1 or rest >= smin
        else:
            k = (n + C - 1) // C
            last = n - (k - 1) * C
            r = C + last
            aa = min(C, ((r + 1) // 2 + 255) // 256 * 256)
            n_exp += last >= 256 and last < smin and aa >= smin and r - aa >= smin
    return n_exp


