MOCKENV=""
if [ $MOCK = 1 ]; then   # every tool, folder and lock file under scratch/mock; the real configs and spec are only read
  O=$M/out; LIB=$M/lib; KR=$M/kr; B90=$M/b90; Q=$M/sq; FR=$M/fr/basalt_fix_rules.py; LOCKPID=$M/lockpid; HOLD=$M/hold
  NOTE=$M/lib/ntfy-note.py; STATE=$M/state.json; SHAPE_RES=$M/shape-result.txt; PROF=$M/prof; Y16=$M/y16; COLDM=$M/cold-M.jsonl
  SRVSH=$M/lib/srv.sh; STOPMON=$M/lib/stopmon.sh; BPD=$M/bpd; MOCKENV=" --mock-env $M/engine-env.json"; MAXM=${AF_MAX_MIN:-150}
