+        p = (p.replace("General statements about other machines", BASELINE_RULES.strip() + "\nGeneral statements about other machines", 1)
+             .replace("\"contradicts|consistent|unsupported\"", "\"contradicts|already-set|consistent|unsupported\"", 1)
+             .replace("<user_setup>", TASK_BLOCK.strip().replace("{", "{{").replace("}", "}}").replace("{{task}}", "{task}") + "\n\n<user_setup>", 1))
+        only = only.replace('"contradicts" or "unsupported"', '"contradicts", "already-set" or "unsupported"')
