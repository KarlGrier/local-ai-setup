    return m


def cmp(a, b):
    return json.loads(subprocess.run(["python3", f"{T}/compare.py", a, b], capture_output=True, text=True).stdout or "{}")


def split_step(st):
    """10-26 (Karl: "after the IQ_Q8K work and before the graded set, add one single-pass screen with fewer layers on the
    4060 Ti: 8/32 with the 4060 Ti first, or the closest split that fits VRAM, on the #343 config. Confirm it with a 3-pass
    A/B/A only if 20K prompts gain beyond noise and decode loses no more than 1%. If it's kept, the graded set and the
    daily launcher use it"). Screens (one pass, one P4K / P20K, W1-W3 once, cool-down 60 s) of the final config at its
    split (10,30) and at 8,32 (9,31 if 8,32 does not start or fails a guard), back to back. Beyond noise = more than the
    round's largest per-group P20K screen noise (0.9 %). The A/B/A (A = 10,30, B = the new split, A; a replacement A if
    one fails a guard) keeps it when P20K gains beyond compare.py's noise and decode is no worse than -1 % against both."""
    global FINAL_MODS
    if st.get("split") or DRY:
        if DRY:
            print("  DRY: split screen 10,30 vs 8,32 (9,31) on the final config; A/B/A if P20K > +0.9 % and decode >= -1 %")
        return
    base = ds_mods()
    cur = base.get("DS4_SPLIT", "10,30")
    ok = lambda r: bool(r.get("dir")) and not r.get("guard") and not r.get("softstop") and r.get("decode") and r.get("P20K")
    sa = arm(st, "split-screen-a", base, f"split screen: the final config at {cur}", "", cool=60)
    out = {"from": cur, "screen_a": {k: sa.get(k) for k in ("decode", "P4K", "P20K", "vram_experts", "guard")}}
    new, sb = None, {}
    for sp in ("8,32", "9,31"):
        sb = arm(st, f"split-screen-{sp.replace(',', '-')}", dict(base, DS4_SPLIT=sp), f"split screen: the final config at {sp}", "", cool=60)
        out[f"screen_{sp}"] = {k: sb.get(k) for k in ("decode", "P4K", "P20K", "vram_experts", "guard")}
        if ok(sb):
            new = sp
            break
    verdict = "no split started cleanly"
    if new and ok(sa):
        dg, pg = 100 * (sb["decode"] / sa["decode"] - 1), 100 * (sb["P20K"] / sa["P20K"] - 1)
        out["screen_gain"] = {"decode": round(dg, 2), "P20K": round(pg, 2), "P4K": round(100 * (sb["P4K"] / sa["P4K"] - 1), 2)}
        verdict = f"screen {new}: P20K {pg:+.1f} %, decode {dg:+.1f} %"
        if pg > 0.9 and dg >= -1.0:
            runs = {"A1": arm(st, "split-A1", base, f"split A/B/A: A1 = {cur}", "", passes=3, nprompt=3, cool=60),
                    "B": arm(st, "split-B", dict(base, DS4_SPLIT=new), f"split A/B/A: B = {new}", "", passes=3, nprompt=3, cool=60),
                    "A2": arm(st, "split-A2", base, f"split A/B/A: A2 = {cur}", "", passes=3, nprompt=3, cool=60)}
            clean = [k for k in ("A1", "A2") if ok(runs[k])]
            if ok(runs["B"]) and len(clean) < 2:
                runs["A3"] = arm(st, "split-A3", base, f"split A/B/A: A3 = {cur} (a replacement)", "", passes=3, nprompt=3, cool=60)
                clean += ["A3"] if ok(runs["A3"]) else []
            comps = {a: cmp(runs[a]["dir"], runs["B"]["dir"]) for a in clean[:2]} if ok(runs["B"]) else {}
            keep = len(comps) == 2 and all(
                (c.get("P20K") or {}).get("gain_pct", -99) > (c.get("P20K") or {}).get("noise_pct", 99) and
                (c.get("decode") or {}).get("gain_pct", -99) >= -1.0 for c in comps.values())
            out["aba"] = {a: {m: (c.get(m) or {}) for m in ("decode", "P4K", "P20K")} for a, c in comps.items()}
            out["kept"] = keep
            verdict += f"; A/B/A: " + "; ".join(f"vs {a} " + tune.gains(c) for a, c in comps.items()) + \
                f" -> {'KEPT' if keep else 'not kept'}"
            if keep:
                FINAL_MODS = dict(FINAL_MODS, DS4_SPLIT=new)
                fj = dict(_fj, mods=FINAL_MODS, split_note=f"10-26 split screen + A/B/A: {new} kept over {cur}")
                json.dump(fj, open(FINAL_JSON, "w"), indent=1)
        else:
            verdict += " - no A/B/A (Karl's bar: P20K beyond 0.9 % and decode >= -1 %)"
    out["verdict"] = verdict
    st["split"] = out
    save(st)
    say(f"split: {verdict}")


