def tree_hash(d):
    h = hashlib.sha256()
    for f in sorted(Path(d).rglob("*")):
        if f.is_file():
            h.update(str(f.relative_to(d)).encode())
            h.update(f.read_bytes())
    return h.hexdigest()


FAC = {"B": 1.0, "L": 1.05, "O": 1.0, "LO": 1.05, "Bs": 0.9, "Os": 0.9}
JIT = (1.0, 1.004, 0.997)


def rows(arm, k):
    wl = dr().WL9
    out = {}
    for s, ids in (("n", wl[:3]), ("a", wl[3:5]), ("r", wl[5:])):
        out[s] = "".join(json.dumps({"arm": f"{arm}{k}{s}", "id": w, "decode_tps": round(150 * FAC[arm] * JIT[k - 1] * (1 + i / 10), 2),
                                     "prompt_tps": round(2000 * JIT[k - 1] * (1 + i / 10), 1)}) + "\n" for i, w in enumerate(ids))
    return out


def put_pass(d, arm, k, gates):
    (d / "speed").mkdir(parents=True, exist_ok=True)
    for s, txt in rows(arm, k).items():
        (d / "speed" / f"{arm}{k}{s}.jsonl").write_text(txt)
    (d / "speed" / f"{arm}{k}.wu.jsonl").write_text('{"id": "warmup"}\n')
    gates += [f"env_{arm}{k} PASS synthetic", f"lines_{arm}{k} PASS synthetic", f"pcie_{arm}{k} INFO synthetic"]


def bp_recs(arm, sets_passes, f=1.0):
    out = []
    for s, k in sets_passes:
        for t in {"decode": ("conv", "struct", "prose"), "pp16k": ("pp16k",), "pp64k": ("pp64k",)}[s]:
            key_ = "decode_tps" if s == "decode" else "prompt_tps"
            out.append({"label": f"bp{arm}-{s}-{k}", "test": t, "pass": k, key_: round((150 if s == "decode" else 3000) * f * JIT[k - 1], 2)})
    return "".join(json.dumps(r) + "\n" for r in out)


def fake_gapb(d, broken=()):
    d.mkdir(parents=True)
    gates = []
    for k in (1, 2, 3):
        for arm in ORDER[k].split():
            n = f"{arm}{k}"
            (d / "speed").mkdir(exist_ok=True)
            if n in RECORDED:
                (d / "speed" / f"{n}.engine.log").write_text(
                    "strata generate: cudaMalloc(1538035200) for the weight arena failed (out of memory): 306 MiB free\n"
                    "strata generate:   CUDA0 (NVIDIA GeForce RTX 5080): 306 MiB free of 15933 MiB; other programs on it: "
                    "strata-dsv41 (pid 1135004) 15.0 GiB, Xorg (pid 1831) 4 MiB\n")
                gates.append(f"lines_{n} " + ("PASS synthetic" if arm == "Bs" else "FAIL synthetic UNEXERCISED"))
            elif n in broken:
                (d / "speed" / f"{n}.engine.log").write_text("strata serve: fatal GPU error (synthetic)\n")
                put_pass(d, arm, k, gates)
                gates.append(f"fatal_{n} FAIL synthetic")
            else:
                (d / "speed" / f"{n}.engine.log").write_text("ok\n")
                put_pass(d, arm, k, gates)
    (d / "gates.txt").write_text("\n".join(gates) + "\n")
    (d / "bp90").mkdir()
    keep = [(s, k) for k in (1, 2, 3) for s in ("decode", "pp16k", "pp64k") if k > 1]
    (d / "bp90" / "cold-B.jsonl").write_text(bp_recs("B", keep))
    (d / "bp90" / "cold-LO.jsonl").write_text(bp_recs("LO", [x for x in keep if x != ("decode", 2)], 1.01))


def fake_bprr(d, empty=False):
    d.mkdir(parents=True)
    if empty:
        return
    (d / "cold-B.jsonl").write_text(bp_recs("B", [("decode", 1), ("pp16k", 1), ("pp64k", 1)]))
    (d / "cold-LO.jsonl").write_text(bp_recs("LO", [("decode", 1), ("pp16k", 1), ("pp64k", 1), ("decode", 2)], 1.01))
    (d / "gates.txt").write_text("".join(f"env_bp{x} PASS synthetic\n" for x in
                                         ("B-decode-1", "B-pp16k-1", "B-pp64k-1", "LO-decode-1", "LO-pp16k-1", "LO-pp64k-1", "LO-decode-2")))


def fake_sr(d, labels=RECORDED, extra=()):
    d.mkdir(parents=True)
    gates = []
    for n in labels:
        mm = re.fullmatch(r"(B|L|O|LO|Bs|Os)([123])", n)
        put_pass(d, mm.group(1), int(mm.group(2)), gates)
    (d / "gates.txt").write_text("\n".join(gates + list(extra)) + "\n")


def verdicts(out):
    j = json.loads((Path(out) / "decision-b-final.json").read_text())
    return {k: v["verdict"] for k, v in j["decision"]["items"].items()}, j


def selftest(a):
    sc = Path(a.dir)
    if sc.exists():
        shutil.rmtree(sc)
    sc.mkdir(parents=True)
    bad = []

    def chk(name, ok, detail=""):
        print(f"{'ok  ' if ok else 'FAIL'} {name}{(': ' + detail) if detail else ''}")
        if not ok:
            bad.append(name)

    def missing(gb, only=None):
        with contextlib.redirect_stdout(io.StringIO()) as b:
            cmd_missing(argparse.Namespace(gap_b=str(gb), only=only))
        t = b.getvalue().splitlines()
        return [x.split()[1] for x in t if x.startswith("RERUN")], [x.split()[1].rstrip(":") for x in t if x.startswith("KEPT")]

    def final(name, gb, sr, bprr, ga):
        o = sc / name
        o.mkdir(exist_ok=True)
        with contextlib.redirect_stdout(io.StringIO()):
            cmd_final(argparse.Namespace(gap_b=str(gb), gap_a=str(ga), rerun=str(sr), bp_rerun=str(bprr), out=str(o)))
        return o

    real_h = tree_hash(GAPB) if GAPB.exists() else None
    ga = sc / "gapa"
    ga.mkdir()
    (ga / "decision.json").write_text(json.dumps({"items": {"L": {"exact": "PASS"}, "O": {"exact": "PASS"}}}))
    gb1, gb2 = sc / "gapb1", sc / "gapb2"
    fake_gapb(gb1)
    fake_gapb(gb2, broken=("Os2",))
    h1 = tree_hash(gb1)
    # 1-3 missing
    r, k = missing(gb1)
    chk("missing: the 3 collided arm-passes, in pass 3's positions (LO Bs L)", r == ["LO3", "Bs3", "L3"] and not k, f"{r} kept {k}")
    r, k = missing(gb2)
    chk("missing: an uncounted pass without collision lines is KEPT, not rerun", r == ["LO3", "Bs3", "L3"] and k == ["Os2"], f"{r} kept {k}")
    r, k = missing(gb1, "LO3 L3")
    chk("missing --only LO3 L3: LO3, L3 (Bs3 kept)", r == ["LO3", "L3"] and k == ["Bs3"], f"{r} kept {k}")
    if GAPB.exists():
        r, k = missing(GAPB)
        chk("missing on gap b's real files (read only): LO3 Bs3 L3, nothing kept", r == RECORDED and not k, f"{r} kept {k}")
    # 5 full merge
    bp_full, bp_empty = sc / "bprr-full", sc / "bprr-empty"
    fake_bprr(bp_full)
    fake_bprr(bp_empty, empty=True)
    sr = sc / "sr-full"
    fake_sr(sr)
    o = final("f-full", gb1, sr, bp_full, ga)
    v, j = verdicts(o)
    chk("final, all three rerun + the bp90 rerun: L GAIN, O PASS, L+O GAIN, bp90 PASS, nothing missing",
        v == {"L": "GAIN", "O": "PASS", "L+O": "GAIN"} and j["decision"]["bp90"] == "PASS"
        and j["still_missing"] == {"screen": [], "bp90": []}, f"{v} {j['decision']['bp90']} {j['still_missing']}")
    chk("final: merged gates hold this gap's lines_L3 PASS, not gap b's FAIL",
        dr().read_gates(o / "merged")["lines_L3"][0] == "PASS")
    chk("final: the synthetic gap b is unchanged", tree_hash(gb1) == h1)
    # 6 Bs3 not run (deadline)
    sr = sc / "sr-noBs3"
    fake_sr(sr, ["LO3", "L3"])
    v, j = verdicts(final("f-noBs3", gb1, sr, bp_full, ga))
    chk("final, Bs3 not rerun: item O NOT DECIDED, L GAIN, Bs3 still missing",
        v["O"] == "NOT DECIDED" and v["L"] == "GAIN" and j["still_missing"]["screen"] == ["Bs3"], f"{v} {j['still_missing']}")
    # 7 a fatal line in the rerun L3
    sr = sc / "sr-fatalL3"
    fake_sr(sr, extra=["fatal_L3 FAIL synthetic"])
    v, _ = verdicts(final("f-fatal", gb1, sr, bp_full, ga))
    chk("final, a fatal line in the rerun L3: item L FAIL", v["L"] == "FAIL", f"{v}")
    # 8 a foreign process during L3: void
    sr = sc / "sr-foreignL3"
    fake_sr(sr, extra=["foreign_L3 FAIL synthetic: pid 1 (strata-dsv41)"])
    o = final("f-foreign", gb1, sr, bp_full, ga)
    v, j = verdicts(o)
    chk("final, a foreign GPU process during L3: L3 VOID (not merged), item L NOT DECIDED",
        v["L"] == "NOT DECIDED" and "L3" not in j["screen_rerun_used"] and "VOID" in (o / "decision-b-final.txt").read_text(), f"{v}")
    # 9 the decode-path gap's bp90 rerun did not run
    v, j = verdicts(final("f-nobp", gb1, sc / "sr-full", bp_empty, ga))
    chk("final, no bp90 rerun: bp90 NOT DECIDED, items NOT DECIDED, the header says so",
        j["decision"]["bp90"] == "NOT DECIDED" and set(v.values()) == {"NOT DECIDED"}
        and "not run - bp90 = gap b's own passes" in (sc / "f-nobp" / "decision-b-final.txt").read_text(), f"{v}")
    # 10 a label gap b already counts is never replaced
    sr = sc / "sr-extraB3"
    fake_sr(sr, RECORDED + ["B3"])
    for s in "nar":
        f = sr / "speed" / f"B3{s}.jsonl"
        f.write_text(f.read_text().replace('"decode_tps": ', '"decode_tps": 1'))
    o = final("f-extra", gb1, sr, bp_full, ga)
    chk("final: a pass gap b counts (B3) keeps gap b's rows",
        (o / "merged/speed/B3n.jsonl").read_bytes() == (gb1 / "speed/B3n.jsonl").read_bytes())
    # 11 gap b's real files + a synthetic rerun (pass 2's real rows relabelled), no bp90 rerun: the merge on real data
    if GAPB.exists() and (GAPA / "decision.json").exists():
        sr = sc / "sr-real"
        (sr / "speed").mkdir(parents=True)
        gates = []
        for n in RECORDED:
            for s in "nar":
                t = (GAPB / "speed" / f"{n[:-1]}2{s}.jsonl").read_text()
                (sr / "speed" / f"{n}{s}.jsonl").write_text(t.replace(f'"arm": "{n[:-1]}2{s}"', f'"arm": "{n}{s}"'))
            gates += [f"env_{n} PASS synthetic", f"lines_{n} PASS synthetic (relabelled pass 2)"]
        (sr / "gates.txt").write_text("\n".join(gates) + "\n")
        o = final("f-real", GAPB, sr, bp_empty, GAPA)
        txt = (o / "merged/decision.txt").read_text()
        _, j = verdicts(o)
        chk("final on gap b's real files: L, LO and Os vs their bases decided (3 passes each), bp90 still 2 of 3",
            all(f"{x} decode:" in txt for x in ("L vs B", "LO vs B", "Os vs Bs")) and "complete clean passes" not in txt
            and j["decision"]["bp90"] == "NOT DECIDED", f"screen missing {j['still_missing']['screen']}")
        chk("gap b's real files are unchanged", tree_hash(GAPB) == real_h)
    print(f"selftest: {len(bad)} failure(s)" + (": " + ", ".join(bad) if bad else ""))
    return 1 if bad else 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    p = sp.add_parser("missing")
    p.add_argument("--gap-b", default=str(GAPB))
    p.add_argument("--only")
    p = sp.add_parser("final")
    p.add_argument("--gap-b", default=str(GAPB))
    p.add_argument("--gap-a", default=str(GAPA))
    p.add_argument("--rerun", default=str(OUT))
    p.add_argument("--bp-rerun", default=str(BPRR))
    p.add_argument("--out", default=str(OUT))
    sp.add_parser("selftest").add_argument("--dir", default=str(SCRATCH / "selftest"))
