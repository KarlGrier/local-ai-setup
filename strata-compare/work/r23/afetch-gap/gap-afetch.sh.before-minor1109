      else rm -f $HOLD; st="the gap was not open (this gap's research-queue hold lifted)"; fi
    fi
  fi
  ss -H -ltn "( sport = :8080 )" 2> /dev/null | grep -q . && st="$st; 8080 is listening" || st="$st; 8080 is NOT listening"
  echo "INTERRUPTED: $st; nothing switched" > $O/result.txt
  say "INTERRUPTED: $st"
  notes_line "INTERRUPTED: $st; nothing switched"
  alert "ADAPT_FETCH gap interrupted" "the driver was stopped; $( [ $ENDING = 1 ] && echo 'during the end: check 8080 before anything else' || { [ $GAPOPEN = 1 ] && echo 'the gap may still be open: 8080 down' || echo 'the gap was not open'; })"
