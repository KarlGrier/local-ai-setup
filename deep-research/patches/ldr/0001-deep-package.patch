+    def _follow(self, via: int, text: str, url: str, ctx: set[str]) -> None:
+        links = rank_links(text, candidate_links(text, url), ctx)[:PRIMARY_PER_PAGE]
+        self.stats["primary_links"] += len(links)
+        for link in links:
