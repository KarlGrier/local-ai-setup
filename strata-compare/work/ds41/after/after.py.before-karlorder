#!/usr/bin/env python3
"""after.py - 10-26: the user's follow-ups to the DS4.1 round, run "after the head-to-head, when there's room" in one gap.
User unit ds41-after; resumes from results/ds41/after/state.json. AFTER_DRY=1: print the plan only (own state / log).
  0. wait until the Maya head-to-head has finished cleanly (ds41-h2h inactive 3 checks in a row, its state has gap_closed
     and no "stopped"); a stopped or unclean h2h: one alert, keep waiting (nothing starts)
  1. install what was staged for after it (the user, item 4, and the daily launcher): tunearm.sh.v3 / maya-tunearm.sh.v3
     (the swap rule, refined), run-strata.sh.next / switch-model.sh.next (DeepSeek daily config support) - by rename,
     the old files kept as *.before-after
  2. gap: port_gap4.sh begin in its own scope (queue held, test lock, 8080 stopped), LDR + SearXNG 8889/8890 stopped,
     drive-temperature log on
  3. builds (no measurement runs meanwhile): build-variant.sh fix, build-variant.sh test (apply_variant.py)
  4. item 6, the one-line fix: ckpt_client.py on the ship config with engine v026fix, slot keep off (the same 12
     follow-ups, 6 after a two-pass answer, as ckpt-v026-keep0)
  5. item 2, repeat pairs: cont_client.py exact (each case twice, seed 4242, placement frozen) - stock v0.2.6 with
     STRATA_DS4_REUSE=0 (as the user asked); v026test with DS4_TEST_SEED_RESET=1 and REUSE=0; v026test with the reset and
     reuse on (separates the sampler's running counter from the reuse path)
  6. item 3, resumed vs fresh (report only): teacher-forced on v026test, the ship config: fresh (must equal the round's
     eng-cand byte for byte), the 12,000-token prefix in 4 pieces, the 4 pieces set aside and taken back (slot_save /
     reset / slot_load), one piece set aside and taken back; references R1 chunk 4096, R2 reserve 2600 on the same build
  7. (item 5, thinking length, replaced 10-26 by the graded set - step 10)
  8. item 1, the daily config: --ssd-cache 68 (the round's everything-up size), slot keep on, cap 16, the folder cap 2 GB,
     growth floor 14 GiB, auto-pin on; everything up (SearXNG 8889/8890 started, LDR's RAM held by ballast.py as in the
     round); slotfill.py (17 chats of ~31K tokens -> 16 in RAM, then the speed requests on top); soft stop 14. Pass =
     lowest MemAvailable >= 14 GB and no stop; else the daily-size rule steps the store down 2 GB (to 62 at most) and runs
     again. The passing config is written to configs/DS41-daily.json (+ its shared settings: effort medium, T 1.0 / 0.95 /
     20, as P021m's); then a launcher smoke test on port 8086 (run-strata.sh start, one completion, stop)
  10. the graded set (thinking budget 8,192 + max_tokens 16,384: suite_cmd) (the user, 10-26: "run our quick graded set on both models so Karl can decide whether DeepSeek
     becomes the main chat model ... One model server at a time"): suite/run.sh --mode quick, budget 8,192 / max_tokens 16,384, the
     scored categories (coding, agentic, math, instruct, tools, honesty, research; longctx on Qwen only - its ~95K-token
     documents do not fit DeepSeek's 32K context), answers only (--no-grade). Qwen: P021m as the daily launcher starts it
     (run-strata.sh, configs/P021m.json, port 8085), effort medium (its daily default). DeepSeek: the daily config of
     step 8 (= the ship config + the user's daily slot / store choices; the ship config itself if step 8 found no size)
     on v0.2.6 - or on the head-to-head's Maya arm if it won by the measurable part of the decision rule (KL pass, decode
     ahead beyond noise against both neighbouring Strata runs, prompts not behind beyond noise) - at effort 50, then 75
  11. after the gap: suite regrade of each label (the suite's script checkers: they see only the answer, never the model
     or the thinking); report.py -> results/ds41/after/graded/REPORT.md + blind research packets (names and thinking
     stripped) for the Phase 4 grader (one fresh grader per question, labels shuffled, key opened after)
  12. context cost (report only): the daily config at --max-context 32K / 64K / 128K, full protocol - ctx_cost()
  9. port_gap4 end (P021m back on 8080); services back; summary results/ds41/after/summary.md; alert
Kernel rule: as the head-to-head - any kernel event or failed kernel check stops here with 8080 left stopped and an alert.
"""
import json
import os
import re
import shutil
import subprocess
import sys
import time

SC = "/home/USER/ai-speed-testing/strata-compare"
T = f"{SC}/work/ds41/tune"
A = f"{SC}/work/ds41/after"
MY = f"{SC}/work/ds41/maya"
R = f"{SC}/results/ds41/after"
PY = f"{SC}/.venv/bin/python"
H2H_STATE = f"{SC}/results/ds41/h2h/state.json"
DRY = os.environ.get("AFTER_DRY") == "1"
STATE = f"{R}/state-dry.json" if DRY else f"{R}/state.json"
LOG = f"{R}/after-dry.log" if DRY else f"{R}/after.log"
ELOG = f"{SC}/logs/ds41/engine-DS41-v024.log"   # (the base config's "log": every arm's engine writes here)

sys.path.insert(0, T)
import tune  # noqa: E402  (mkcfg, ENGINES, SHIPPED, PROF; never tune.run/save: they write the round's state)
import skipcheck  # noqa: E402

for _v in ("fix", "test"):   # the local test variants: in this process only (mkcfg writes exe into each config)
    tune.ENGINES[f"v026{_v}"] = dict(tune.ENGINES["v026"], exe=f"{SC}/engine-v026{_v}-ds41/strata-dsv41")
STAGED = [(f"{T}/tunearm.sh.v3", f"{T}/tunearm.sh"), (f"{MY}/maya-tunearm.sh.v3", f"{MY}/maya-tunearm.sh"),
          (f"{SC}/run-strata.sh.next", f"{SC}/run-strata.sh"), (f"{SC}/switch-model.sh.next", f"{SC}/switch-model.sh")]


def say(msg):
    line = f"=== {time.strftime('%F %T')} {msg}"
    print(line, flush=True)
    with open(LOG, "a") as f:
        f.write(line + "\n")


def notify(title, body, crit=False):
    if DRY:
        print(f"  DRY notify: {title}: {body[:200]}")
        return
    subprocess.run(["notify-send", "-a", "DeepSeek-V4.1"] + (["-u", "critical"] if crit else []) + [title, body[:400]],
                   stderr=subprocess.DEVNULL)


def load():
    try:
        return json.load(open(STATE))
    except (OSError, ValueError):
        return {"steps": {}}


def save(st):
    if DRY:
        return
    json.dump(st, open(STATE + ".tmp", "w"), indent=1)
    os.replace(STATE + ".tmp", STATE)


def sh(cmd, log=None, **kw):
    if DRY:
        print("  DRY:", " ".join(cmd)[:400])
        return 0
    with open(log or LOG, "a") as lf:
        return subprocess.run(cmd, stdout=lf, stderr=lf, **kw).returncode


def stop(st, why):
    st["stopped"] = why
    save(st)
    say(f"STOPPED: {why} - 8080 left stopped, the gap held; nothing else runs")
    notify("DeepSeek follow-ups stopped", f"{why}. 8080 is NOT restarted.", True)
    sys.exit(1)


def clean_env(**extra):
    e = {k: v for k, v in os.environ.items() if not k.startswith(("STRATA_", "MAYA_", "DS4_"))}
    e.update({k: str(v) for k, v in extra.items()})
    return e


# ---------- 0-2 ----------------------------------------------------------------------------------------------------------
def wait_h2h(st):
    if st.get("h2h_done"):
        return
    say("waiting for the Maya head-to-head to finish (its gap closed, 8080 back on P021m)")
    inactive, alerted = 0, False
    while True:
        act = subprocess.run(["systemctl", "--user", "is-active", "--quiet", "ds41-h2h.service"]).returncode == 0
        inactive = 0 if act else inactive + 1
        if inactive >= 3:
            try:
                h = json.load(open(H2H_STATE))
            except (OSError, ValueError):
                h = {}
            if h.get("gap_closed") and not h.get("stopped"):
                st["h2h_done"] = time.strftime("%F %T")
                save(st)
                say(f"the head-to-head has finished (gap closed {h['gap_closed']})")
                return
            if not alerted:
                notify("DeepSeek follow-ups waiting", "the head-to-head is not running but did not finish cleanly - nothing starts")
                say(f"the head-to-head is not running but did not finish cleanly ({h.get('stopped') or 'no gap_closed'}) - waiting")
                alerted = True
        time.sleep(60)


def install(st):
    if st.get("installed"):
        return
    for new, cur in STAGED:
        if DRY:
            print(f"  DRY: install {new} -> {cur}")
            continue
        if os.path.exists(new):
            shutil.copy2(cur, cur + ".before-after")
            os.replace(new, cur)   # (by rename: a script that is running keeps the old file)
    st["installed"] = time.strftime("%F %T")
    save(st)
    say("installed: the swap rule (tunearm.sh, maya-tunearm.sh), run-strata.sh / switch-model.sh (DeepSeek daily config)")


def open_gap(st):
    if st.get("gap_open"):
        return
    if sh(["bash", f"{SC}/bringup/lib/kcheck.sh", "after-before"]) != 0:
        stop(st, "kernel check failed before the follow-ups")
    rc = sh(["systemd-run", "--user", "--scope", "--unit", "ds41-after-gaplock", "--collect", "bash",
             f"{SC}/work/r22/port_gap4.sh", "begin", "DeepSeek follow-ups (the user, 10-26; lock in its own scope)"])
    if rc != 0:
        stop(st, f"port_gap4 begin failed (rc {rc})")
    sh(["/home/USER/ai/deep-research/run-ldr.sh", "stop"])
    sh(["systemctl", "--user", "stop", "searxng-watch.service", "searxng-ldr.service", "searxng-ldr-baseline.service"])
    if os.path.exists(f"{SC}/tmp/ds41-nvmetemp.stop") and not DRY:
        os.remove(f"{SC}/tmp/ds41-nvmetemp.stop")
    if subprocess.run(["systemctl", "--user", "is-active", "--quiet", "ds41-nvmetemp.service"]).returncode:
        sh(["systemd-run", "--user", "--unit", "ds41-nvmetemp", "--collect", "bash", f"{SC}/work/ds41/nvmetemp.sh", "12"])
    st["gap_open"] = time.strftime("%F %T")
    save(st)
    say("gap open: queue held, test lock, 8080 stopped, LDR + SearXNG 8889/8890 stopped, drive log on")


def close_gap(st):
    rc = sh(["bash", f"{SC}/work/r22/port_gap4.sh", "end"])
    sh(["systemctl", "--user", "start", "searxng-ldr.service", "searxng-ldr-baseline.service", "searxng-watch.service"])
    if not DRY:
        open(f"{SC}/tmp/ds41-nvmetemp.stop", "w").close()
    k = sh(["bash", f"{SC}/bringup/lib/kcheck.sh", "after-after"])
    st["gap_closed"] = time.strftime("%F %T")
    save(st)
    say(("8080 back on P021m" if rc == 0 else "port_gap4 end FAILED - check 8080") + ("; kcheck clean" if k == 0 else "; KCHECK FAILED"))
    return rc


def builds(st):
    for v in ("fix", "test"):
        k = f"build_{v}"
        if st.get(k):
            continue
        rc = sh(["bash", f"{A}/build-variant.sh", v], f"{R}/build-{v}.log")
        exe = tune.ENGINES[f"v026{v}"]["exe"]
        if rc != 0 or (not DRY and not os.path.exists(exe)):
            st[k] = f"FAILED (rc {rc}, {R}/build-{v}.log)"
            say(f"build {v}: {st[k]}")
        else:
            st[k] = open(f"{SC}/engine-v026{v}-ds41/SHA256").read().split()[0][:12] if not DRY else "dry"
            say(f"build {v}: ok, sha256 {st[k]}")
        save(st)


# ---------- arms -----------------------------------------------------------------------------------------------------------
def arm(st, key, mods, note, client, passes=1, soft=None, server_env=None, cool=0, client_timeout=None, nprompt=1):
    if key in st["steps"]:
        return st["steps"][key]
    eng = mods.get("engine", "v026")
    if eng in ("v026fix", "v026test"):
        b = str(st.get(f"build_{eng[4:]}", ""))
        if not b or b.startswith("FAILED"):
            st["steps"][key] = {"skipped": f"the {eng} build failed or is missing"}
            save(st)
            say(f"{key}: skipped - the {eng} build failed")
            return st["steps"][key]
    cfg = tune.mkcfg(f"after-{key}", dict(mods, engine=eng))
    if not DRY:
        shutil.copy(tune.SHIPPED, tune.PROF)
    env = clean_env(ARM_NOTE=note, PROFILE=tune.PROF, COOL_MIN=cool, PASSES=passes, NPROMPT=nprompt,
                    DS_SERVER=tune.ENGINES[eng]["server"], CLIENT=client)
    se = server_env if server_env is not None else tune.ENGINES[eng]["server_env"]
    if se:
        env["SERVER_ENV"] = se
    if soft:
        env["SOFT_GB"] = str(soft)
    if client_timeout:
        env["CLIENT_TIMEOUT"] = str(client_timeout)
    say(f"{key}: {note}")
    t0 = time.time()
    if DRY:
        sh(["bash", f"{T}/tunearm.sh", key, cfg])
        return {"dir": None}
    with open(LOG, "a") as lf:
        subprocess.run(["bash", f"{T}/tunearm.sh", key, cfg], env=env, stdout=lf, stderr=lf)
    d = open(f"{SC}/tmp/ds41-arm-out").read().strip()
    g = open(f"{d}/GUARD").read().strip() if os.path.exists(f"{d}/GUARD") else ""
    s = open(f"{d}/summary.txt").read() if os.path.exists(f"{d}/summary.txt") else ""
    if "kernel" in g.lower() or re.search(r"KCHECK FAILED|kernel check failed", s, re.I):
        st["steps"][key] = {"dir": d, "guard": g or "kernel check failed"}
        stop(st, f"{key}: kernel event ({g or 'kcheck failed'}) - {d}")
    try:
        a = json.load(open(f"{d}/arm.json"))
    except (OSError, ValueError):
        a = {}
    res = {"dir": d, "cfg": cfg, "min": round((time.time() - t0) / 60, 1), "guard": g or None,
           "softstop": os.path.exists(f"{d}/SOFTSTOP"), "lowest_mem": a.get("lowest_memavail_gb"),
           "decode": (a.get("decode") or {}).get("mean"), "P4K": (a.get("P4K") or {}).get("mean"),
           "P20K": (a.get("P20K") or {}).get("mean"), "vram_experts": [c.get("vram_experts") for c in a.get("cards", [])],
           "nvme": next((l.strip() for l in s.splitlines() if l.startswith("nvme0")), None),
           "swap": next((l.strip() for l in s.splitlines() if l.startswith("swap:")), None),
           "client_tail": open(f"{d}/client.out").read()[-2500:] if os.path.exists(f"{d}/client.out") else ""}
    st["steps"][key] = res
    save(st)
    say(f"{key}: {res['min']} min, lowest {res['lowest_mem']} GB" + (f"; {g}" if g else "") +
        ("; SOFT STOP" if res["softstop"] else "") + "\n" + res["client_tail"][-1200:])
    return res


def final():
    f = dict(json.load(open(tune.STATE)).get("final") or {})
    f.pop("engine", None)
    return f


# ---------- 6. resumed vs fresh -------------------------------------------------------------------------------------------
def resume_kl(st):
    if st.get("resume_kl") or DRY:
        if DRY:
            print("  DRY: resume KL (skipcheck.score in-process, engine v026test): fresh, pieces4, resume4, resume1, R1, R2")
        return
    if str(st.get("build_test", "")).startswith("FAILED"):
        st["resume_kl"] = "skipped: the test build failed"
        save(st)
        return
    say("resumed vs fresh (teacher-forced, v026test, ship config): 6 scoring runs")
    ids = skipcheck.ids_file()
    base = dict(final(), engine="v026test", **{"--expert-profile": tune.SHIPPED})
    env0 = {"DS4_SCORE_PREFIX": str(skipcheck.PREFIX)}
    runs = {"fresh": (base, env0), "R1-chunk4096": (dict(base, **{"--prefill-chunk": 4096}), env0),
            "R2-cpu-share": (dict(base, **{"--reserve-mib": 2600}), env0),
            "pieces4": (base, dict(env0, DS4_SCORE_PIECES="4")),
            "resume4": (base, dict(env0, DS4_SCORE_PIECES="4", DS4_SCORE_RESUME="1")),
            "resume1": (base, dict(env0, DS4_SCORE_RESUME="1"))}
    dirs = {}
    for k, (m, e) in runs.items():
        try:
            dirs[k] = skipcheck.score(f"after-{k}", m, ids, e)
        except SystemExit as x:
            if str(x) == "3" or x.code == 3:
                stop(st, f"kernel error in the scoring run after-{k}")
            say(f"resume KL: the scoring run after-{k} could not run ({x})")
    if "fresh" not in dirs:
        st["resume_kl"] = "could not run (no fresh run)"
        save(st)
        return
    f0 = dirs["fresh"]
    out = {"vs_fresh": {}, "pairs": {}}
    for k in ("R1-chunk4096", "R2-cpu-share", "pieces4", "resume4", "resume1"):
        if k in dirs:
            out["vs_fresh"][k] = skipcheck.pct_row(f0, dirs[k])
    if "pieces4" in dirs and "resume4" in dirs:
        out["pairs"]["resume4 vs pieces4 (the set-aside / take-back alone)"] = skipcheck.pct_row(dirs["pieces4"], dirs["resume4"])
    ec = f"{skipcheck.OUT}/eng-cand/score.tsv"
    out["fresh_equals_round_eng_cand"] = os.path.exists(ec) and open(ec, "rb").read() == open(f"{f0}/score.tsv", "rb").read()
    for k in ("resume4", "pieces4", "resume1"):
        v = out["vs_fresh"]
        if k in v and "R1-chunk4096" in v and "R2-cpu-share" in v:
            c, r1, r2 = v[k], v["R1-chunk4096"], v["R2-cpu-share"]
            ok = {"mean": c["mean"] <= 1.10 * max(r1["mean"], r2["mean"]), "p90": c["p90"] <= 1.10 * max(r1["p90"], r2["p90"]),
                  "gt1": c["gt1"] <= max(r1["gt1"], r2["gt1"]) + 1, "top1": c["top1"] >= min(r1["top1"], r2["top1"]) - 1}
            out[f"{k}_judged"] = "within the rounding references" if all(ok.values()) else \
                "outside the rounding references: " + ", ".join(x for x, y in ok.items() if not y)
    st["resume_kl"] = out
    save(st)
    say("resumed vs fresh: " + json.dumps({k: v for k, v in out.items() if k.endswith("judged") or k.startswith("fresh_")}))


# ---------- 8. the daily config --------------------------------------------------------------------------------------------
def daily(st):
    if st.get("daily") or DRY:
        if DRY:
            print("  DRY: daily config: SearXNG 8889/8890 up + ballast; slotfill at 68 (then 66, 64, 62 if it does not fit)")
        return
    sdir = f"{R}/daily-slots"
    sh(["systemctl", "--user", "start", "searxng-ldr.service", "searxng-ldr-baseline.service"])
    time.sleep(60)
    mf = f"{R}/svcmem.jsonl"
    sx = json.loads(subprocess.run([PY, f"{T}/svcmem.py", "SearXNG 8889/8890 started", mf], capture_output=True,
                                   text=True).stdout or "{}").get("rss_gib", {}).get("SearXNG 8889 (LDR)", 0) or 0
    hold = round(3.54 + max(0.0, 1.74 - sx), 2)
    bal = subprocess.Popen([PY, f"{T}/ballast.py", str(hold)], stdout=subprocess.DEVNULL)
    tries, ok_n = [], None
    try:
        time.sleep(30)
        subprocess.run([PY, f"{T}/svcmem.py", f"everything up (held {hold} GiB: LDR 3.54 + SearXNG 8889 to 1.74)", mf])
        for n in (68, 66, 64, 62):
            shutil.rmtree(sdir, ignore_errors=True)
            mods = dict(final(), engine="v026", **{"--ssd-cache": n, "DS4_STORE_FLOOR_GB": 14, "STRATA_DS4_SLOT_KEEP": "1",
                                                   "STRATA_DS4_SLOT_CAP": "16", "STRATA_DS4_SLOT_GB": "2",
                                                   "STRATA_DS4_SLOT_DIR": sdir})
            r = arm(st, f"daily-{n}", mods, f"daily config at --ssd-cache {n}: 16 slots filled (17 chats of ~31K tokens), "
                    f"then the speed requests; everything up; soft stop 14 GB",
                    f"{PY} {A}/slotfill.py $URL $OUT {ELOG} {sdir} 17", soft=14, server_env="STRATA_DS4_AUTO_PIN=1")
            subprocess.run([PY, f"{T}/svcmem.py", f"daily-{n} after the run", mf])
            fill = json.load(open(f"{r['dir']}/slotfill.json")) if r.get("dir") and os.path.exists(f"{r['dir']}/slotfill.json") else {}
            ok = not r.get("guard") and not r.get("softstop") and (r.get("lowest_mem") or 0) >= 14.0 and bool(fill)
            tries.append({"store_gb": n, "ok": ok, "lowest_mem": r.get("lowest_mem"), "guard": r.get("guard"),
                          "softstop": r.get("softstop"), "fill": fill, "dir": r.get("dir"), "cfg": r.get("cfg")})
            say(f"daily-{n}: {'fits' if ok else 'does not fit'} (lowest {r.get('lowest_mem')} GB; slots {fill.get('slot_gb_sum')} GB "
                f"for {fill.get('in_ram_last')} in RAM; 16 x 32,768 tokens = {fill.get('at_32768_x16_gb')} GB)")
            if ok:
                ok_n = n
                break
    finally:
        bal.kill()
        bal.wait()
        sh(["systemctl", "--user", "stop", "searxng-ldr.service", "searxng-ldr-baseline.service"])
    st["daily"] = {"tries": tries, "store_gb": ok_n}
    save(st)
    if ok_n:
        write_daily(st, next(t for t in tries if t["ok"]))


def write_daily(st, t):
    c = json.load(open(t["cfg"]))
    c["env"].pop("STRATA_DS4_SLOT_DIR", None)   # (the server's default: ds4-slots next to the log)
    c["env"].pop("DS4_FLOW_STATS", None)
    c["env"]["STRATA_DS4_AUTO_PIN"] = "1"
    a = c["args"]
    prof = f"{SC}/logs/ds41/daily-profile.bin"
    a[a.index("--expert-profile") + 1] = prof
    # the start check: the memory this run used (MemAvailable before the engine started - its lowest) + the 12 GB floor
    m0 = next((float(l.split()[1]) for l in list(open(f"{t['dir']}/monitor.tsv"))[1:2]), None)
    need = int((m0 - t["lowest_mem"] + 12) * 1024) if m0 else 76000
    c.update({"server": tune.ENGINES["v026"]["server"], "model_name": "deepseek-v4.1-flash",
              "log": f"{SC}/logs/ds41/engine-daily.log", "warmup": False, "expert_profile_from": tune.SHIPPED,
              "need_vram_mib": 7000, "need_ram_mib": need, "host": "127.0.0.1",
              "_comment": f"10-26 DeepSeek-V4.1 daily (the user: slot keep on, cap 16, the store {t['store_gb']} GB, 6 experts, "
                          f"v0.2.6, the ship settings {json.dumps(final())}); measured {t['dir']} (lowest {t['lowest_mem']} GB "
                          f"with everything up, 16 slots full). Start: ./switch-model.sh deepseek."})
    p = f"{SC}/configs/DS41-daily.json"
    json.dump(c, open(p, "w"), indent=1)
    json.dump({"reasoning_effort": "medium", "temperature": 1.0, "top_p": 0.95, "top_k": 20},
              open(f"{SC}/configs/DS41-daily.shared-settings.json", "w"), indent=1)
    st["daily_cfg"] = p
    save(st)
    say(f"daily config written: {p} (store {t['store_gb']} GB)")
    # launcher smoke test on a spare port: start through run-strata.sh, one completion, stop
    env = clean_env(STRATA_PORT="8086", STRATA_CONFIG=p)
    with open(LOG, "a") as lf:
        rc = subprocess.run(["bash", f"{SC}/run-strata.sh", "start"], env=env, stdout=lf, stderr=lf).returncode
        out = subprocess.run(["curl", "-s", "-m", "300", "http://127.0.0.1:8086/v1/chat/completions", "-H",
                              "Content-Type: application/json", "-d", json.dumps({"model": "x", "max_tokens": 1, "stream": False,
                              "messages": [{"role": "user", "content": "Reply with OK."}]})], capture_output=True, text=True).stdout
        models = subprocess.run(["curl", "-s", "-m", "10", "http://127.0.0.1:8086/v1/models"], capture_output=True, text=True).stdout
        subprocess.run(["bash", f"{SC}/run-strata.sh", "stop"], env=env, stdout=lf, stderr=lf)
    for _ in range(60):   # (run-strata.sh's stop does not wait for a strata-dsv41 engine: port_gap4 end needs the VRAM)
        pids = subprocess.run(["pgrep", "-x", "strata-dsv41"], capture_output=True, text=True).stdout.split()
        if not pids:
            break
        time.sleep(1)
    for p in subprocess.run(["pgrep", "-x", "strata-dsv41"], capture_output=True, text=True).stdout.split():
        subprocess.run(["kill", "-9", p])
    good = rc == 0 and '"finish_reason"' in out and "deepseek" in models
    st["smoke"] = f"{'ok' if good else 'FAILED'} (start rc {rc}; models {models[:120]}; reply {out[:160]})"
