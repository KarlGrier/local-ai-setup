def _model_profile():
    """10-29 (C3b): the model profile run-ldr.sh starts LDR with (profiles/<LDR_MODEL_PROFILE or flash-next>.env),
    read by the deep package's loader (deep/modelprofile.py, loaded from its file: stdlib only). A missing or bad file
    leaves today's values (its defaults) and says so on stderr."""
    import importlib.util
    name = "deep_modelprofile"
    mp = sys.modules.get(name)
    if mp is None:
        spec = importlib.util.spec_from_file_location(
            name, WS / ".venv/lib/python3.12/site-packages/local_deep_research/deep/modelprofile.py")
        mp = importlib.util.module_from_spec(spec)
        sys.modules[name] = mp
        spec.loader.exec_module(mp)
    res = mp.resolve(profile=str(mp.profile_file(os.environ.get("LDR_MODEL_PROFILE"))))
    mp.warn(res)
    return res.values


