+                agrees = "no" if _no(c.get("agrees")) else "yes" if _yes(c.get("agrees")) else "unclear"
+                rec["claims"].append({"claim": claim, "agrees": agrees, "why": clean_mark(c.get("why"), 300)})
+                if agrees != "no" or holds == "unknown":
