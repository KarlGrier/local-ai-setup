  say "  sq.py decide (exit $sdc): $(echo "$sd" | tail -1 | cut -c1-300)"
  gate sampled_decide INFO "exit $sdc: $(echo "$sd" | tail -1 | cut -c1-200)"
}

# ---------------------------------------------------------------- refusals, the signal trap, the end
DRYREF=0
refuse() {   # refuse busy|hard WHY - before the gap, nothing changed. busy: exit 1 (the starter retries); hard: an alert, exit 6
  if [ $DRY = 1 ]; then DRYREF=$((DRYREF + 1)); say "DRY RUN: the real run would REFUSE ($1) here: $2"; return 1; fi
  echo "not started ($1): $2 - nothing changed" > $O/result.txt
  say "NOT STARTED ($1): $2 - nothing changed"
  if [ "$1" = hard ]; then
    notes_line "not started: $2 - nothing changed"
    alert "ADAPT_FETCH gap not started" "$(echo "$2" | cut -c1-120); nothing changed"; exit 6
  fi
  exit 1
}
hold() {   # the priority rule before the gap: final (exit 8), an alert, nothing changed
  if [ $DRY = 1 ]; then DRYREF=$((DRYREF + 1)); say "DRY RUN: the real run would be HELD by the priority rule here: $1"; return 1; fi
  echo "HELD by the priority rule (Karl 11-09), before the gap: $1 - nothing changed; the day-one work goes first (override: tmp/afetch-priority-done with a dated reason line, only on Karl's word)" > $O/result.txt
  say "HELD (priority rule): $1 - nothing changed"
  notes_line "HELD by the priority rule before the gap: $1 - nothing changed; day-one work first"
  alert "ADAPT_FETCH gap held" "open Qwen4 Flash weights were found: the day-one work goes first; the gap did not start"
  exit 8
}
on_signal() {   # the driver stopped from outside: result.txt, the NOTES line and the alert FIRST (review 11-09 m7: a 90-s
  # systemd stop timeout must not lose them), then the test server and this gap's leftovers (never during port_gap4.sh end;
  # never an engine from before the gap); the gap left as it is (Karl / Claude decide); whether 8080 listens is said
  trap - TERM INT HUP
  say "SIGNAL: the driver was stopped"
  wdg_stop
  local st
  if [ $ENDING = 1 ]; then
    st="the driver was stopped while port_gap4.sh end was running: do NOT run end a second time blindly - check first whether 8080 serves P028x, whether tmp/port-gap.lockpid and the research-queue hold are gone"
  elif [ $GAPOPEN = 1 ]; then
    st="the gap may still be open (tmp/port-gap.lockpid): close it with work/r22/port_gap4.sh end"
  else
    st="the gap was not open"
    # stopped inside port_gap4.sh begin: a hold this gap set is lifted again; a lock it may already have taken = "maybe open"
    if grep -qF 'ADAPT_FETCH gap' $HOLD 2> /dev/null; then
