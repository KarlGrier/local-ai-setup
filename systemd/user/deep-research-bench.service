[Unit]
Description=Deep research measurements (Phase 5 holdout since 11-06: queue-plan-p5-holdout.json - baseline p5 + final p5final; o04-o06, the harder four, the 25 checkables; ~/ai/deep-research/tools/bench2-queue.sh)
After=default.target deep-research-runner.service

[Service]
Type=simple
# waits for 09:00; new work only 09:00-22:00; stops between questions for a new Strata release or tmp/bench2.stop
ExecStart=/bin/bash /home/USER/ai/deep-research/tools/bench2-queue.sh
WorkingDirectory=/home/USER/ai/deep-research
Environment=BENCH2_PLAN=queue-plan-p5-holdout.json
Restart=on-failure
RestartSec=60
KillMode=process

[Install]
WantedBy=default.target
