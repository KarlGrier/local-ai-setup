class LDRClient:
    def __init__(self):
        self.s = None
        self.csrf = None

    def login(self) -> None:
        d = json.loads(CREDS.read_text())
        s = requests.Session()
        s.trust_env = False
        tok = s.get(f"{LDR}/auth/csrf-token", timeout=10).json()["csrf_token"]
        r = s.post(f"{LDR}/auth/login", data={"username": d["username"], "password": d["password"], "csrf_token": tok},
                   timeout=120, allow_redirects=False)
        if r.status_code != 302:
            raise RuntimeError(f"LDR login failed: HTTP {r.status_code}")
        self.csrf = s.get(f"{LDR}/auth/csrf-token", timeout=10).json()["csrf_token"]
        self.s = s

    def api(self, method: str, path: str, **kw):
        for attempt in range(2):
            if self.s is None:
                self.login()
            try:
                r = self.s.request(method, f"{LDR}{path}", headers={"X-CSRFToken": self.csrf},
                                   timeout=kw.pop("timeout", 60), **kw)
            except requests.RequestException:
                self.s = None
                if attempt:
                    raise
                continue
            if r.status_code in (401, 403) and attempt == 0:
                self.s = None
                continue
            return r
        raise RuntimeError("unreachable")


def ldr_pid() -> int | None:
    try:
        pid = int((WS / "run" / "ldr.pid").read_text().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


# 2026-11-04 (staged: staging/ldr-study/MEMORY.md): ldr-web keeps the memory of its biggest transient peak (0.3 GB fresh,
# 1.0-2.6 GB after one deep research, 4.2-4.7 GB on a long-lived LDR), which shrinks Strata's room before a relief
# restart. The bench gives every question a fresh LDR since 11-01; a Jan job gets one too when the running LDR is above
# this RSS (a fresh, idle LDR is ~0.3 GB). LDR_FRESH_RSS_GB=0 turns it off.
FRESH_RSS_GB = float(os.environ.get("LDR_FRESH_RSS_GB", "1.0") or 0)


def ldr_rss_gb(pid: int | None = None) -> float | None:
    """ldr-web's resident memory (VmRSS) in GB, read from /proc; None when it is not running."""
    pid = pid if pid is not None else ldr_pid()
    if not pid:
        return None
    try:
        for line in Path(f"/proc/{pid}/status").read_text().splitlines():
            if line.startswith("VmRSS:"):
                return int(line.split()[1]) / 1024 / 1024
    except (OSError, ValueError, IndexError):
        return None
    return None


def ldr_memory_reasons(limit_gb: float = FRESH_RSS_GB, pid: int | None = None) -> list[str]:
    """['LDR holds X GB (fresh LDR above Y GB)'] when the running LDR should be restarted before a job, else []."""
    if not limit_gb or limit_gb <= 0:
        return []
    rss = ldr_rss_gb(pid)
    if rss is None or rss < limit_gb:
        return []
    return [f"LDR holds {rss:.1f} GB (a fresh LDR for every job above {limit_gb:g} GB)"]


def ldr_up() -> bool:
