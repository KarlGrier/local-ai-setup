#!/usr/bin/env bash
# run-strata.sh — Strata (tuned, "C*12.1") serving Qwen3.8-Flash-Next GSQ-RCO IQ3_S on http://127.0.0.1:8081/v1
#
#   ./run-strata.sh start     start in the background (survives closing the terminal), wait until ready
#   ./run-strata.sh stop      graceful stop (the engine exits, VRAM is released; the local SearXNG stops too)
#   ./run-strata.sh status    pid, uptime, health, memory, log, search service
#   ./run-strata.sh logs [-f] the server + engine log
#
# C*12.1 (REPORT.md "Round 10"): C*12 on Strata v0.1.38 (patches/r10c38; v0.1.38's server security fixes). C*12 was
# Round 11: C*13 = Strata v0.1.39 (6f32ec0) + patches/r11c39 (C*12.1's series ported to 0.1.39, the Phase 0 fixes #550 / #700 /
# #454 / #652 / #567, A.2, B.1, B.2 and B.3), built from a clean checkout by work/r11/build-cstar13.sh into
# engine-cstar13/strata (sha256 in engine-cstar13/SHA256); server and chat page from that checkout (strata-cstar13/serve);
# settings configs/Cstar13.json = C*12.1's flags + STRATA_ROUTER_Q8K / STRATA_GR_FORK / STRATA_QSA_SPLIT_ATTN / STRATA_MMVQ_IL
# (STRATA_SIDE_SHARED gone: 0.1.39's own STRATA_SH_STREAM). Before that (C*12.1, Round 10):
# Strata v0.1.36 + patches/r10c (25 patches: C*11's 16 ported to 0.1.36, the adaptive
# tier skipping helper-held experts, #453's drafter ring K/V, #413's DeltaNet key-head recurrence, the mixer / shared-expert
# branches from Eddoursul's fork), C*12.1 built from a clean checkout by work/r10/build-cstar121.sh into engine-cstar121/strata
# (sha256 in engine-cstar121/SHA256; sm_89 + sm_120); server and chat page from that checkout (strata-cstar121/serve).
# Settings: configs/Cstar121.json (= Cstar12.json's) = C*11's flags + --prefill auto:16384, with STRATA_SPEC_EXACT=1, STRATA_GR_V3=1,
# STRATA_ADAPT_LAND=2 (as C*11) and STRATA_ADAPT_HELPER=1, STRATA_PF_FUSED=1, STRATA_SIDE_MIXER=2, STRATA_SIDE_SHARED=1
# (upstream's v3 hyper-connection read), STRATA_ADAPT_LAND=2 (deterministic swap landing) (the RTX 4060 Ti as a helper
# GPU with 3,300 experts; if it has too little free memory the config's "fallback" = the 5080 alone is started),
# CUDA_MODULE_LOADING=LAZY, 64 n-gram I/O threads, web search
# (SearXNG on 127.0.0.1:8888, started here when the config has "web_search"). After loading, one warm-up prompt
# (~4 s: kernels and GPU memory pool in place before other programs can take the VRAM).
# Binds 127.0.0.1 only. For the chat page on 8080 use ./switch-model.sh (it calls this script with STRATA_PORT=8080).
# Environment overrides: STRATA_PORT (default 8081), STRATA_CONFIG (default configs/Cstar171.json = C*17.1 (v0.1.43, round 19 Part D); rollback: STRATA_CONFIG=configs/Cstar17.json = C*17, configs/Cstar161.json = C*16.1, configs/Cstar16.json = C*16, configs/Cstar15.json = C*15, configs/Cstar14.json = C*14, configs/Cstar131.json = C*13.1, configs/Cstar13.json = C*13, configs/Cstar121.json = C*12.1 (v0.1.38), configs/Cstar12.json = C*12 (v0.1.36), configs/Cstar11.json = C*11 (v0.1.34), configs/Cstar10.json = C*10 (v0.1.31), configs/Cstar9.json = C*9 (v0.1.30), configs/Cstar8.json = C*8, configs/Cstar7.json = round 7's C*7;
# configs/Cstar6.json = round 6's C*6, configs/Cstar5.json = round 5's C*5, configs/Cstar4.json = round 4's C*4, configs/Cstar3.json = C*3,
# configs/Cstar2.json = round 2's C*2 on the v0.1.11 server, configs/Cstar.json = round 1's C*).
# The server script comes from the config's "server" key (C*2 and C* have none: the v0.1.11 server).
set -euo pipefail

WS=/home/USER/ai-speed-testing/strata-compare
PORT=${STRATA_PORT:-8081}
CFG=${STRATA_CONFIG:-$WS/configs/Cstar171.json}
PY=$WS/.venv/bin/python
SERVER=$("$PY" -c "import json,sys; print(json.load(open(sys.argv[1])).get('server', sys.argv[2]))" "$CFG" \
         "$WS/strata-v0111/serve/server.py" 2>/dev/null || echo "$WS/strata-v0111/serve/server.py")
RUN=$WS/logs/run
PIDFILE=$RUN/strata-$PORT.pid
LOGFILE=$RUN/strata-$PORT.logpath
# measured peak with the C* settings (see REPORT.md, resources): leave real headroom
NEED_VRAM_MIB=${NEED_VRAM_MIB:-12000}   # less still works, with fewer experts cached on the GPU
NEED_RAM_MIB=${NEED_RAM_MIB:-58000}     # measured peak RSS 51 GB + headroom
mkdir -p "$RUN"

die()  { echo "run-strata: $*" >&2; exit 1; }
info() { echo "run-strata: $*"; }

our_pid() {
  [[ -f $PIDFILE ]] || return 1
  local pid; pid=$(cat "$PIDFILE")
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null && tr '\0' ' ' < "/proc/$pid/cmdline" | grep -q "serve/server.py" && { echo "$pid"; return 0; }
  return 1
}

engine_pid() {  # the strata engine is a child of the server
  pgrep -P "$1" -f 'strata --serve' 2>/dev/null | head -1 || true
}

helper_check() {
  # round 6: a config with a helper GPU (--expert-cache-device1 N) needs N experts (~1.93 MiB each) + ~700 MiB free on
  # the second card (the RTX 4060 Ti, which also drives the desktop); if it has less, start the config's "fallback"
  # (the same flags on the RTX 5080 alone) instead of failing, and say so in the log
  local slots gpu2 free2 need2 fb
  slots=$("$PY" -c "import json; a=json.load(open('$CFG'))['args']; print(a[a.index('--expert-cache-device1')+1] if '--expert-cache-device1' in a else 0)")
  (( slots > 0 )) || return 0
  gpu2=$("$PY" -c "import json; v=json.load(open('$CFG')).get('env',{}).get('CUDA_VISIBLE_DEVICES','').split(','); print(v[1] if len(v)>1 else '')")
  [[ -n $gpu2 ]] || return 0
  free2=$(nvidia-smi -i "$gpu2" --query-gpu=memory.free --format=csv,noheader,nounits | head -1)
  need2=$(( slots * 193 / 100 + 700 ))
  if (( free2 < need2 )); then
    fb=$("$PY" -c "import json; print(json.load(open('$CFG')).get('fallback',''))")
    [[ -n $fb && -f $fb ]] || die "the helper GPU has only $free2 MiB free (need $need2) and the config names no fallback"
    info "the helper GPU (RTX 4060 Ti) has only $free2 MiB free (need $need2): starting $fb (RTX 5080 alone) instead"
    CFG=$fb
  else
    info "helper GPU ok: $free2 MiB free (need $need2)"
  fi
}

preflight() {
  [[ -f $CFG ]] || die "config missing: $CFG"
  helper_check
  local exe; exe=$("$PY" -c "import json,sys; print(json.load(open('$CFG'))['exe'])")
  [[ -x $exe ]] || die "engine not built: $exe (run scripts/build-patched.sh)"
  if ss -H -ltn "( sport = :$PORT )" | grep -q .; then die "port $PORT is already in use"; fi
  if pgrep -f '(^|/)llama-server( |$)|/strata --serve' >/dev/null; then   # not a tool whose command line merely names them
    pgrep -af '(^|/)llama-server( |$)|/strata --serve' | cut -c1-160 >&2
    die "another model server is running (above); stop it first — two of them do not fit in RAM/VRAM together"
  fi
  local free_vram avail_ram
  # the GPU the config pins (CUDA_VISIBLE_DEVICES = the RTX 5080's UUID since the 4060 Ti went in), else the first one
  local gpu; gpu=$("$PY" -c "import json; print(json.load(open('$CFG')).get('env',{}).get('CUDA_VISIBLE_DEVICES',''))")
  # round 8 fix: a helper config lists two cards; ask about the first (the main card) only - with two lines, `head -1`
  # could close the pipe under nvidia-smi (SIGPIPE), and pipefail + set -e then ended the script without a word
  gpu=${gpu%%,*}
  free_vram=$(nvidia-smi ${gpu:+-i "$gpu"} --query-gpu=memory.free --format=csv,noheader,nounits)
  avail_ram=$(( $(awk '/MemAvailable/{print $2}' /proc/meminfo) / 1024 ))
  (( free_vram >= NEED_VRAM_MIB )) || die "only $free_vram MiB VRAM free (need $NEED_VRAM_MIB): close GPU-heavy apps"
  (( avail_ram >= NEED_RAM_MIB )) || die "only $avail_ram MiB RAM available (need $NEED_RAM_MIB): close memory-heavy apps"
  info "preflight ok: VRAM free $free_vram MiB, RAM available $avail_ram MiB"
}

do_start() {
  local pid log i envs=()
  if pid=$(our_pid); then info "already running (pid $pid) on http://127.0.0.1:$PORT/v1"; return 0; fi
  preflight
  log=$WS/logs/run/strata_$(date +%Y%m%dT%H%M%S)_$PORT.log
  # environment variables the tuned config asks for (e.g. STRATA_ARENA_THP=1)
  mapfile -t envs < <("$PY" -c "import json; [print(f'{k}={v}') for k,v in json.load(open('$CFG')).get('env',{}).items()]")
  echo "# run-strata $(date -Is) config=$CFG env=${envs[*]:-}" > "$log"
  setsid nohup env "${envs[@]}" "$PY" "$SERVER" --engine strata --config "$CFG" --host 127.0.0.1 --port "$PORT" \
      >> "$log" 2>&1 < /dev/null &
  pid=$!
  echo "$pid" > "$PIDFILE"; echo "$log" > "$LOGFILE"
  info "starting pid $pid, log $log (loading ~50 GB of experts takes about a minute)"
  for i in $(seq 1 900); do
    kill -0 "$pid" 2>/dev/null || { tail -30 "$log" >&2; die "server exited during startup"; }
    curl -sf -m 2 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1 && break
    sleep 1
  done
  curl -sf -m 2 "http://127.0.0.1:$PORT/health" >/dev/null || die "not ready after 15 minutes"
  info "ready: http://127.0.0.1:$PORT/v1   $(curl -s "http://127.0.0.1:$PORT/health")"
  # warm-up (round 5): read one full prompt chunk now, so the prompt path's kernels and GPU memory pool are in place
  # before another program can take the VRAM (a first long prompt would otherwise allocate them mid-request)
  "$PY" "$WS/scripts/strata-warmup.py" "http://127.0.0.1:$PORT" || info "warning: the warm-up request failed"
  # the chat page's Web search switch needs the local SearXNG (websearch/searxng.sh, 127.0.0.1:8888)
  if "$PY" -c "import json,sys; sys.exit(0 if json.load(open('$CFG')).get('web_search') else 1)"; then
    "$WS/websearch/searxng.sh" start || info "warning: SearXNG did not start; the Web search switch will say so"
  fi
}

do_stop() {
  local pid e i
  pid=$(our_pid) || { info "not running"; rm -f "$PIDFILE"; return 0; }
  e=$(engine_pid "$pid")
  info "stopping pid $pid${e:+ (engine $e)}"
  kill -INT "$pid" 2>/dev/null || true          # server.py: KeyboardInterrupt -> engine QUIT -> clean exit
  for i in $(seq 1 60); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
  kill -0 "$pid" 2>/dev/null && { kill -TERM "$pid" 2>/dev/null || true; sleep 2; }
  [[ -n $e ]] && kill -0 "$e" 2>/dev/null && { kill -TERM "$e" 2>/dev/null || true; sleep 2; }
  for i in $(seq 1 60); do
    [[ -n $e ]] && nvidia-smi --query-compute-apps=pid --format=csv,noheader | grep -qw "$e" || break; sleep 0.5
  done
  rm -f "$PIDFILE"; info "stopped"
  "$WS/websearch/searxng.sh" status >/dev/null 2>&1 && "$WS/websearch/searxng.sh" stop >/dev/null 2>&1 && info "SearXNG stopped"
  true
}

do_status() {
  local pid e
  if pid=$(our_pid); then
    e=$(engine_pid "$pid")
    echo "running: server pid $pid${e:+, engine pid $e}, up $(ps -o etime= -p "$pid" | tr -d ' '), http://127.0.0.1:$PORT/v1"
    echo "health: $(curl -s -m 3 "http://127.0.0.1:$PORT/health" || echo unreachable)"
    echo "status: $(curl -s -m 3 "http://127.0.0.1:$PORT/status" || true)"
    [[ -n $e ]] && echo "memory: engine RSS $(( $(awk '/VmRSS/{print $2}' /proc/$e/status) / 1024 )) MiB, GPU $(nvidia-smi --query-compute-apps=pid,used_memory --format=csv,noheader | awk -F', ' -v p="$e" '$1==p{print $2}'), MemAvailable $(( $(awk '/MemAvailable/{print $2}' /proc/meminfo) / 1024 )) MiB"
    echo "log:    $(cat "$LOGFILE" 2>/dev/null)"
    echo "search: $("$WS/websearch/searxng.sh" status 2>/dev/null | head -1)"
  else
    echo "not running"; return 3
  fi
}

case ${1:-} in
  start)  do_start;;
  stop)   do_stop;;
  status) do_status;;
  logs)   l=$(cat "$LOGFILE" 2>/dev/null) || die "no log"; [[ ${2:-} == -f ]] && exec tail -f "$l" || tail -n 60 "$l";;
  *) sed -n '2,15p' "$0"; exit 2;;
esac
