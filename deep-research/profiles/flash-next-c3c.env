# profiles/flash-next-c3c.env - backlog C3c part (1), Karl 10-27: bigger fixed sizes for Qwen3.8-Flash-Next at the
# SAME 131K context. Staged 11-04 (staging/post7d/profiles/; NOT installed): a copy of profiles/flash-next.env
# (sha256 28732eeb029b) with exactly four values changed - everything else byte-identical:
#   LDR_DEEP_SUB_RETURN_MAX_CHARS    16000 -> 32000 chars  (the lead's view of each subagent report)   research phase
#   LDR_DEEP_SNIPPET_CHARS             300 ->   600 chars  (per search result, for the agents)            research phase
#   LDR_DEEP_REPORT_EVIDENCE_TOKENS  48000 -> 72000 tokens (evidence per section call)                   report stage
#   LDR_DEEP_REPORT_FINDINGS_TOKENS  12000 -> 24000 tokens (subagent findings per section call)          report stage
# Fixed numbers for the test (not 'auto'): if C3c is adopted, the bases in deep/modelprofile.py change instead, so
# the sizes stay derived from LDR_DEEP_CONTEXT_TOKENS (Karl: "the sizes become derived from the profile's context").
# Fit at 131K (backlog, on paper): a section prompt ~72K + 24K + ~6K overhead = ~102K tokens, under the report
# writer's 121.8K limit (~28K left for output). LDR_PROFILE_STATUS stays "measured": the model facts are
# flash-next's measured ones (run-ldr.sh refuses only "draft", i.e. unmeasured model facts); the four sizes are the
# test arm's, which the C3c runs measure (queue-plan-c3c.json, label pc3c).
#
# ~100 tok/s decode). C3b (10-29): exactly the values the build ran with before profiles existed - NO behaviour change
# (staging/c3/tests/test_equivalence.py checks it against the package as it was).
#
# Format: KEY=VALUE, one per line; '#' starts a comment. run-ldr.sh reads this file when LDR_MODEL_PROFILE is unset
# (or =flash-next) and gives LDR its path (LDR_DEEP_MODEL_PROFILE). An explicit environment variable always wins over
# a line here (bench2, the research runner and the queue set some of these per run).
# auto = derived from the context: base * LDR_DEEP_CONTEXT_TOKENS // 131072 (the base is the value at 131,072 tokens,
# shown in the comment), so these sizes scale by themselves when the context changes. A number fixes the size.
# Check a profile: .venv/bin/python -I <package>/deep/modelprofile.py --check profiles/flash-next.env
#            show: .venv/bin/python -I <package>/deep/modelprofile.py --show --profile flash-next

LDR_PROFILE_MODEL=Qwen3.8-Flash-Next (Strata)
LDR_PROFILE_STATUS=measured

# ---- context and output -------------------------------------------------------------------------------------------
LDR_DEEP_CONTEXT_TOKENS=131072            # Strata's --max-context; LDR's context window (run-ldr.sh) and every budget
LDR_LLM_MAX_TOKENS=30000                  # completion budget per LDR call (LDR's default); prompts over ~101K refused
LDR_DEEP_REPORT_MAX_OUTPUT=60000          # report calls' output cap, within the context (NOTES 09-30)
LDR_DEEP_REPORT_ANSWER_RESERVE=8192       # a report prompt is cut to context - 8192 - 1024
LDR_DEEP_REPORT_MARGIN=1024
LDR_DEEP_TOKEN_MARGIN=512                 # agent calls: tokens kept free below the context (exact Qwen counts)

# ---- compaction (each agent's history) ----------------------------------------------------------------------------
LDR_DEEP_COMPACT_AT=auto                  # 56000 at 131072
LDR_DEEP_KEEP_RECENT=6                    # messages kept verbatim
LDR_DEEP_KEEP_RECENT_FRAC=0.35            # ... taking at most this share of LDR_DEEP_COMPACT_AT
LDR_DEEP_COMPACT_FALLBACK_TOKENS=auto     # 12000 at 131072: history kept (cut) when a summary fails

# ---- what the lead and the writers see ----------------------------------------------------------------------------
LDR_DEEP_SUB_RETURN_MAX_CHARS=32000       # C3c (flash-next: auto = 16000 at 131072): of each subagent report, for the lead
LDR_DEEP_SNIPPET_CHARS=600                # C3c (flash-next: auto = 300 at 131072): per search result, for the agents
LDR_DEEP_FETCH_MAX_CHARS=auto             # 120000 at 131072: page text given to extraction (and file parts)
LDR_DEEP_EXTRACT_MAX_CHARS=4000           # extraction output
LDR_DEEP_REPORT_EVIDENCE_TOKENS=72000     # C3c (flash-next: auto = 48000 at 131072): evidence per section call
LDR_DEEP_SECTION_EXTRACT_FRAC=0.6         # ... extractions / claims first, page passages with the rest
LDR_DEEP_REPORT_FINDINGS_TOKENS=24000     # C3c (flash-next: auto = 12000 at 131072): subagent findings per section call
LDR_DEEP_OUTLINE_LEAD_TOKENS=auto         # 10000 at 131072: the lead's answer in the outline call
LDR_DEEP_OUTLINE_FINDINGS_FRAC=0.40       # share of the outline budget for findings (a source digest gets the rest)
LDR_DEEP_CLAIMS_PER_SOURCE=auto           # 40 at 131072: item 5, checked quotes per source in a section's evidence
LDR_DEEP_READ_PASSAGE_TOKENS=auto         # 350 at 131072: item 6, passages of a page only the reader fetched
LDR_DEEP_SEED_TEXT_CHARS=auto             # 60000 at 131072: earlier findings in a continued run
LDR_DEEP_VERIFY_CLAIM_SOURCE_TOKENS=auto  # 2000 at 131072: per cited source per claim (citation check)
LDR_DEEP_VERIFY_BATCH_TOKENS=auto         # 36000 at 131072: per citation-check call (and the two-source verifier)
LDR_DEEP_VERIFY_BATCH_CLAIMS=8            # claims per citation-check call
LDR_DEEP_VERIFY_PAGE_TOKENS=auto          # 40000 at 131072: the old per-source check only
LDR_DEEP_TRIED_PART_CHARS=auto            # 60000 at 131072: tried list (off by default)
LDR_DEEP_TRIED_MERGE_CHARS=auto           # 100000 at 131072
LDR_DEEP_TRIED_BLOCK_CHARS=auto           # 36000 at 131072

# ---- tokenizer ----------------------------------------------------------------------------------------------------
LDR_DEEP_TOKENIZER_DIR=/home/USER/ai/deep-research/deep/tokenizer   # Qwen BPE, 248,320 tokens (exact counts)
LDR_DEEP_TOK_MSG_OVERHEAD=8               # ChatML tokens per message
LDR_DEEP_TOK_TOOLS_OVERHEAD=150           # the template's tool-use instructions
LDR_DEEP_TOK_CHARS_PER_TOKEN=3            # the estimate when the tokenizer is missing

# ---- reasoning effort per call type (our names: low / medium / high / xhigh) ------------------------------------------
# package defaults - measurements (bench2) set report / verify per run; agent and extraction efforts reach Strata
# through strata-proxy's mode file (run/proxy-mode.json), not through LDR
LDR_DEEP_EXTRACT_EFFORT=                  # empty: the proxy / Strata decides
LDR_DEEP_COMPACT_EFFORT=medium            # xhigh thought 30K tokens with no answer (09-30)
LDR_DEEP_REPORT_EFFORT=xhigh
LDR_DEEP_VERIFY_EFFORT=xhigh              # citation, setup, version, arithmetic, consistency checks, critic
LDR_DEEP_TRIED_MAP_EFFORT=low
LDR_DEEP_TRIED_MERGE_EFFORT=medium
LDR_DEEP_EFFORT_MAP=                      # empty: Strata takes our names as they are
LDR_DEEP_EFFORT_LADDER=lower              # no answer / an error -> one effort lower (runaway xhigh thinking)
# Jan's deep jobs (tools/research-runner.py): agent + extraction via the proxy mode file, report + check via LDR's env
LDR_JOB_AGENT_EFFORT=medium
LDR_JOB_EXTRACT_EFFORT=medium
LDR_JOB_REPORT_EFFORT=medium
LDR_JOB_VERIFY_EFFORT=xhigh

# ---- pace: workers, step limits, time -----------------------------------------------------------------------------
LDR_WORKERS=1                             # Strata answers one request at a time
LDR_DEEP_MAX_ITERATIONS=200               # lead agent model calls
LDR_DEEP_MAX_SUB_ITERATIONS=30            # per subagent
LDR_DEEP_MAX_SUBTOPICS=8
LDR_DEEP_MAX_SUBTOPICS_HARD=12
LDR_DEEP_SUBAGENT_BUDGET_S=3600
LDR_DEEP_SUBAGENT_HARD_S=7200
LDR_DEEP_SUBAGENT_SHARE=0.75              # a subagent's share of the research time left per wave
LDR_DEEP_SUBAGENT_MIN_START_S=60
LDR_DEEP_TIME_BUDGET_S=10800              # research phase, 3 h (Jan: research.conf; bench2: per run)
LDR_DEEP_VERIFY_MAX_CLAIMS=120            # key claims checked (Jan: research.conf verify_max_claims)
LDR_DEEP_READ_MAX=400                     # item 6: pages the reader fetches per run
LDR_DEEP_READ_PRIMARY_MAX=40              # item 6: primary sources added per run
LDR_DEEP_READ_PRIMARY_PER_PAGE=2          # item 6: primary-source links followed per page
LDR_QUICK_MAX_ITERATIONS=12               # quick jobs: agent cycles
LDR_QUICK_CAP_S=900                       # quick jobs: stopped after 15 min (research runner)

# ---- code tool ------------------------------------------------------------------------------------------------------
LDR_DEEP_CODE_READ_LINES=auto             # 120 at 131072: lines per code_read
LDR_DEEP_CODE_GREP_HITS=auto              # 40 at 131072: hits per code_search
LDR_DEEP_CODE_TREE_ENTRIES=auto           # 200 at 131072
LDR_DEEP_CODE_LINE_CHARS=240
LDR_DEEP_CODE_ISSUE_CHARS=auto            # 3000 at 131072: an opened issue / PR
LDR_DEEP_CODE_COMMENT_CHARS=auto          # 1500 at 131072: each of its first 8 comments
LDR_DEEP_CODE_ISSUE_LIST_CHARS=auto       # 600 at 131072: an issue in a search listing
LDR_DEEP_CODE_SHORT_READS=1               # "search first and read short ranges - never whole files"

# ---- sampling -------------------------------------------------------------------------------------------------------
LDR_TEMPERATURE=1.0                       # Karl's rule for Qwen: T 1.0 / 0.95 / 20 / 0.05 (Strata supplies the rest)
