#!/bin/bash
# port_gap4.sh begin "WHAT" | end  -  a gap in the phase 4 research queue for builds and checks (the v0.2.2 port, the
# Basalt A/B builds), 2026-10-21. Phase 4's version of port_gap.sh: the same hold and lock, but the switch-back is to
# P021 with the chat-cache parking policy left ON (phase 4 runs with it). The user, 10-21: P021 stays on 8080 for all of
# phase 4 (its baselines are the "without" arm of stages 2 and 3); the 0.2.2 port is built and checked, never switched.
#
#   begin  the queue holds (deep-research tmp/bench2.hold; the stage 1 runner waits on it too), the running research run
#          finishes, then this takes the measurement lock (tmp/gpu-test.lock, shared) and stops P021 on 8080.
#          Test servers run on their own ports (never 8080).
#   end    the test server is stopped (by its PID file), P021 is started on 8080 again and checked (engine SHA-256 and
#          the parking policy on), the switch-back is logged in deep-research NOTES.md, the lock is released and the
#          queue resumes.
set -euo pipefail
SC=/home/USER/ai-speed-testing/strata-compare
DR=/home/USER/ai/deep-research
HOLD=$DR/tmp/bench2.hold
LOCKPID=$SC/tmp/port-gap.lockpid
NOTES=$DR/NOTES.md
P021_SHA=c9fe314316c4                          # engine-r22p021/strata (P021, served since 10-20)
PORT_PIDFILE=$SC/tmp/port-test-server.pid      # written by whatever starts a test server
say() { echo "$(date '+%F %T') port_gap4: $*"; }

engine_sha() {   # the 8080 engine's binary, first 12 hex of its SHA-256 ("" if none)
  local pid
  pid=$(pgrep -x strata | while read -r p; do tr '\0' ' ' < /proc/$p/cmdline | grep -q -- "--port 8080\|:8080" && echo $p; done | head -1)
  [ -z "$pid" ] && pid=$(pgrep -x strata | head -1)
  [ -n "$pid" ] && sha256sum "/proc/$pid/exe" | cut -c1-12 || true
}

case ${1:-} in
begin)
  what=${2:?say what the gap is for}
  echo "phase 4 gap: $what (since $(date '+%F %T'))" > "$HOLD"
  say "hold set; waiting for the running research run to finish"
  while ! flock -n "$DR/run/bench.lock" true; do sleep 20; done
  mkdir -p "$SC/tmp"
  setsid bash -c "exec flock -s '$SC/tmp/gpu-test.lock' bash -c 'echo \$\$ > \"$LOCKPID\"; exec sleep infinity'" < /dev/null > /dev/null 2>&1 &
  for _ in $(seq 30); do [ -s "$LOCKPID" ] && break; sleep 1; done
  [ -s "$LOCKPID" ] || { say "could not take tmp/gpu-test.lock"; exit 1; }
  (cd "$SC" && STRATA_PORT=8080 ./run-strata.sh stop) || true
  printf '\n* %s phase 4 gap BEGIN (%s): queue held after its run, test lock taken, P021 on 8080 stopped.\n' \
    "$(date '+%F %H:%M')" "$what" >> "$NOTES"
  say "gap open: test lock held (pid $(cat "$LOCKPID")), 8080 stopped"
  ;;
end)
  if [ -s "$PORT_PIDFILE" ] && kill -0 "$(cat "$PORT_PIDFILE")" 2> /dev/null; then
    kill "$(cat "$PORT_PIDFILE")"; for _ in $(seq 60); do kill -0 "$(cat "$PORT_PIDFILE")" 2> /dev/null || break; sleep 1; done
  fi
  rm -f "$PORT_PIDFILE"
  if [ -s "$LOCKPID" ]; then kill "$(cat "$LOCKPID")" 2> /dev/null || true; rm -f "$LOCKPID"; fi
  # 10-21 11:09: strata-ensure ran before the killed lock holder had exited ("a measurement holds tmp/gpu-test.lock")
  for _ in $(seq 30); do flock -n -x "$SC/tmp/gpu-test.lock" true 2> /dev/null && break; sleep 1; done
  env -u HTTP_PROXY -u HTTPS_PROXY "$SC/configs/usability/bin/strata-ensure.sh" "phase 4 gap end" || { say "P021 did not start"; exit 1; }
  sha=$(engine_sha)
  pol=$(python3 -c "import json; print('on' if json.load(open('$DR/run/chat-cache-policy.json')).get('enabled') else 'off')")
  if [ "$sha" != "$P021_SHA" ] || [ "$pol" != on ]; then
    say "8080 engine sha '$sha' (want $P021_SHA) or policy '$pol' (want on): NOT resuming the queue"; exit 1
  fi
  printf '* %s phase 4 gap END: P021 back on 8080 (engine sha %s), chat-cache parking policy on; queue resumes.\n' \
    "$(date '+%F %H:%M')" "$sha" >> "$NOTES"
  rm -f "$HOLD"
  say "P021 back ($sha), policy on, queue released"
  ;;
*) sed -n 2,13p "$0"; exit 2 ;;
esac
