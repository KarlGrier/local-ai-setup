def suite_cmd(label, url, effort, cats):
    """10-26 (the user: "make sure the 8,192 cap doesn't cut off DeepSeek's answers when its thinking hits the limit. The
    cap should behave like the daily setup (thinking budget, then room for the full answer), the same for both models"):
    max_tokens 8,192 alone gave the thinking 6,144 and the answer 2,048 on both servers (answer_room / #984), and long
    answers were cut. Now every request carries reasoning_budget_tokens 8,192 (#123, both servers) and max_tokens 16,384:
    #984 keeps the budget (8,192 <= 16,384 - 4,096), so the answer has at least 8,192 tokens after the thinking. (Where
    the context leaves less - DeepSeek's 32K with a long research prompt - the suite fits max_tokens and the server cuts
    the budget to leave a quarter for the answer; a cut answer is reported as truncated.)"""
    return (f"bash {SUITE} --label {label} --endpoint {url} --mode quick --only {cats} --max-tokens 16384 --no-grade "
            f"--extra-body '{json.dumps({'reasoning_effort': effort, 'reasoning_budget_tokens': 8192})}'")


def suite_done(label):
    try:
        return json.load(open(f"{SC}/suite/results/{label}/meta.json")).get("status") == "complete"
    except (OSError, ValueError):
        return False


def memavail():
    return int(next(l for l in open("/proc/meminfo") if l.startswith("MemAvailable")).split()[1]) / 1048576


def graded_qwen(st):
    """Qwen P021m exactly as the daily launcher starts it (run-strata.sh), on 8085; a small guard: MemAvailable under 12 GB
    stops the server (the run is then 'failed: memory'), the kernel log checked every minute"""
    k = "g_qwen"
    if st.get(k) or DRY:
        if DRY:
            print("  DRY: Qwen P021m on 8085 (run-strata.sh), suite " + suite_cmd(GL["qwen"], "http://127.0.0.1:8085", "medium", CATS + ",longctx"))
        return
    env = clean_env(STRATA_PORT="8085", STRATA_CONFIG=f"{SC}/configs/P021m.json")
    say("graded set: Qwen P021m (daily settings, effort medium) on 8085")
    if sh(["bash", f"{SC}/run-strata.sh", "start"], env=env) != 0:
        st[k] = {"error": "run-strata.sh start failed"}
        save(st)
        return
    t0, low, why = time.time(), 999.0, None
    lf = open(f"{R}/g-qwen-suite.log", "a")
    p = subprocess.Popen(["bash", "-c", suite_cmd(GL["qwen"], "http://127.0.0.1:8085", "medium", CATS + ",longctx")],
                         cwd=SC, stdout=lf, stderr=lf, env=clean_env())
    n = 0
    while p.poll() is None:
        m = memavail()
        low = min(low, m)
        if m < 12:
            why = f"failed: memory - MemAvailable {m:.1f} GB < 12"
            break
        n += 1
        if n % 30 == 0 and subprocess.run(["bash", f"{SC}/bringup/lib/kcheck.sh", "after-qwen"],
                                          stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode != 0:
            why = "kernel check failed"
            break
        time.sleep(2)
    if p.poll() is None:
        p.terminate()
        p.wait()
    sh(["bash", f"{SC}/run-strata.sh", "stop"], env=env)
    for _ in range(60):
        if not subprocess.run(["pgrep", "-x", "strata"], capture_output=True).stdout:
            break
        time.sleep(1)
    st[k] = {"label": GL["qwen"], "min": round((time.time() - t0) / 60, 1), "lowest_mem": round(low, 1), "guard": why,
             "complete": suite_done(GL["qwen"])}
    save(st)
    say(f"graded set Qwen: {st[k]}")
    if why == "kernel check failed" or sh(["bash", f"{SC}/bringup/lib/kcheck.sh", "after-qwen-end"]) != 0:
        stop(st, "kernel check failed in the Qwen graded set")


def ds_engine():
    """the head-to-head's winner by the measurable part of maya-catchup.md's rule, else v026"""
    try:
        h = json.load(open(H2H_STATE))
    except (OSError, ValueError):
        return "v026", "no head-to-head state"
    S, kl, best, notes = h.get("steps", {}), h.get("kl") or {}, None, []
    for m, nb in (("M1", ("S1", "S2")), ("M2", ("S2", "S3"))):
        if not str(kl.get(m, "")).startswith("PASS"):
            notes.append(f"{m}: KL {kl.get(m)}")
            continue
        ok, gains = True, []
        for a in nb:
            if not ((S.get(a) or {}).get("dir") and (S.get(m) or {}).get("dir")):
                ok = False
                break
            c = json.loads(subprocess.run(["python3", f"{T}/compare.py", S[a]["dir"], S[m]["dir"]], capture_output=True,
                                          text=True).stdout or "{}")
            d, p4, p20 = c.get("decode") or {}, c.get("P4K") or {}, c.get("P20K") or {}
            if not (d.get("gain_pct", -99) > d.get("noise_pct", 99) and p4.get("gain_pct", -99) >= -p4.get("noise_pct", 0)
                    and p20.get("gain_pct", -99) >= -p20.get("noise_pct", 0)):
                ok = False
            gains.append(d.get("gain_pct", 0))
        notes.append(f"{m}: {'ahead' if ok else 'not ahead'} (decode {gains})")
        if ok and (best is None or min(gains) > best[1]):
            best = (m, min(gains))
    return (best[0] if best else "v026"), "; ".join(notes)


def graded_ds(st, effort):
    k = f"g_ds{effort}"
    if st.get(k) or DRY:
        if DRY:
            print(f"  DRY: DeepSeek effort {effort}: suite " + suite_cmd(GL[effort], "$URL", effort, CATS))
        return
    if not st.get("g_engine"):
        st["g_engine"] = list(ds_engine())
        save(st)
        say(f"graded set: DeepSeek engine {st['g_engine'][0]} ({st['g_engine'][1]})")
    eng = st["g_engine"][0]
    d = st.get("daily") or {}
    t = next((x for x in d.get("tries", []) if x.get("ok")), None)
    for attempt in range(3):   # (the suite resumes: a run cut by the client time limit collects only what is missing)
        key = f"g-ds{effort}" + (f"-r{attempt + 1}" if attempt else "")
        cmd = suite_cmd(GL[effort], "$URL", effort, CATS)
        note = f"graded set, DeepSeek effort {effort} ({eng}{', daily config ' + str(t['store_gb']) + ' GB' if t and eng == 'v026' else ''})"
        if eng == "v026":
            mods = dict(final(), engine="v026")
            if t:
                mods.update({"--ssd-cache": t["store_gb"], "DS4_STORE_FLOOR_GB": 14, "STRATA_DS4_SLOT_KEEP": "1",
                             "STRATA_DS4_SLOT_CAP": "16", "STRATA_DS4_SLOT_GB": "2", "STRATA_DS4_SLOT_DIR": f"{R}/graded-slots"})
            arm(st, key, mods, note, cmd, server_env="STRATA_DS4_AUTO_PIN=1" if t else None, client_timeout=36000)
