+# 10-30 (Fix 1c): what names a setting's owner in a sentence - another program, an upstream / fork reference, or a
+# release that is not the user's (a three-part version number)
+OWNER_RE = re.compile(r"llama\.cpp|\bik_llama|\bvLLM\b|\bSGLang\b|\bk?transformers\b|\bExLlama|\bTensorRT|\bOllama\b|"
+                      r"\bLM Studio\b|\bMLC\b|\bUnsloth\b|\bMaya\b|\bBasalt\b|\bKoboldCpp\b|\bllamafile\b|\bAphrodite\b|"
+                      r"\bTabbyAPI\b|\bDeepSpeed\b|\bFlashInfer\b|\bPyTorch\b|\bupstream\b|\bfork\b|\bPR\s*#\d+|"
+                      r"\bpull request\b|\bissue\s*#\d+", re.I)
+VERSION_NUM_RE = re.compile(r"\bv?(\d+\.\d+\.\d+)\b")
+
+
+def _attributed_in_text(name: str, body: str, pins: dict | None = None) -> bool:
+    """True when every sentence of the report that names `name` also names whose it is (OWNER_RE, or a version number
+    other than the user's); a name the report never mentions keeps the model's word."""
+    mine = {str(v).lstrip("vV") for v in (pins or {}).values()}
+    sents = []
+    for line in strip_marks(body).split("\n"):
+        if name in line and not line.lstrip().startswith("#"):
+            sents += [s for s in re.split(r"(?<=[.!?])\s+|\s+\|\s+", line) if name in s]
+    if not sents:
+        return True
+    for s in sents:
+        if OWNER_RE.search(s):
+            continue
+        if any(v not in mine for v in VERSION_NUM_RE.findall(s)):
+            continue
+        return False
+    return True
+
