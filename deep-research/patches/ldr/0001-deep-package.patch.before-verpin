+
+
+def setup_block(path: str, task: str = "") -> str:
+    return "<user_setup>\n" + SETUP_INTRO + "\n" + facts_for(path, task) + "\n</user_setup>"
+
+
+def with_setup(prompt: str, path: str, task: str = "") -> str:
+    """A report prompt (a str.format template) with the setup block and note right after </task>."""
+    block = setup_block(path, task).replace("{", "{{").replace("}", "}}")
