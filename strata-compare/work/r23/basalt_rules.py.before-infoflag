        if not tl:
            lines.append(f"{f.stem}: no prefill timing line")
            continue
        n, gpu, wall, ph = max(tl, key=lambda x: x[0])
        gdn = sum(ph.get(x, 0) for x in GDN_PHASES)
        res.setdefault(arm, {})[fx] = gdn
        host = re.findall(r"strata prefill timing: host: (.*)$", t, re.M)
