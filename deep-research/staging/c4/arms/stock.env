# arms/stock.env - C4 arm (b): stock LDR 1.10.7 at its own defaults (apart from the model and search) on Claude
# Sonnet 5.5 through the budget guard. EVERY VALUE IS A DRAFT, UNMEASURED.
# Read by c4-arm.sh with `set -a; source`; a variable the caller already set wins.

GUARD_STATUS=${GUARD_STATUS:-draft}
GUARD_ARM=stock
GUARD_PORT=${GUARD_PORT:-8192}
C4_LDR_PORT=${C4_LDR_PORT:-5012}
GUARD_RUN_ID=${GUARD_RUN_ID:-o03-stock}
GUARD_MODEL=claude-sonnet-5-5

# ---- money -----------------------------------------------------------------------------------------------------------------
GUARD_RUN_CAP_USD=${GUARD_RUN_CAP_USD:-12}             # draft: the plan's figure
GUARD_TOTAL_CAP_USD=${GUARD_TOTAL_CAP_USD:-60}         # the same value as arms/ours.env (one ledger)
GUARD_REPORT_RESERVE=${GUARD_REPORT_RESERVE:-0.22}     # Karl 10-29: research refused at (1 - 0.22) x $12 = $9.36. Stock's
                                                       # identifiable report stage = LDR's citation pass and its fallback
                                                       # synthesis; the lead's own final answer looks like any other lead
                                                       # call, so it counts as research (README: the fallback)
GUARD_AGENT_CAP_USD=${GUARD_AGENT_CAP_USD:-}
GUARD_INPUT_TOKENS_PER_BYTE=${GUARD_INPUT_TOKENS_PER_BYTE:-1.0}
GUARD_WAIT_INFLIGHT_S=${GUARD_WAIT_INFLIGHT_S:-900}
GUARD_KEY_FILE=${GUARD_KEY_FILE:-$HOME/.config/model-suite/anthropic.key}

# ---- requests (draft, unmeasured) -------------------------------------------------------------------------------------------
GUARD_DEFAULT_EFFORT=${GUARD_DEFAULT_EFFORT:-high}     # Karl 10-29: high, the same as our arm (matched settings); stock
                                                       # sends no effort, so every stock call gets this
GUARD_CLASS_EFFORTS=${GUARD_CLASS_EFFORTS:-}
GUARD_EFFORT_MAP=${GUARD_EFFORT_MAP:-}
GUARD_DEFAULT_MAX_TOKENS=${GUARD_DEFAULT_MAX_TOKENS:-32000}
GUARD_MAX_TOKENS_CAP=${GUARD_MAX_TOKENS_CAP:-64000}
GUARD_CACHE_TTL=${GUARD_CACHE_TTL:-5m}                 # Karl 10-29: 5 minutes; caching only on reused prefixes
GUARD_LEAD_CACHE_1H=${GUARD_LEAD_CACHE_1H:-0}          # Karl 10-29: OFF unless the pilot's lead gaps say otherwise
GUARD_THINKING_REPLAY=${GUARD_THINKING_REPLAY:-store}

# ---- LDR ---------------------------------------------------------------------------------------------------------------------
LDR_PROFILE=baseline                                   # no LDR_DEEP: pristine LDR, SearXNG 8889 with LDR's own settings
LDR_MODEL_PROFILE=${LDR_MODEL_PROFILE:-sonnet-5-5}     # only its context / max_tokens / temperature / workers are used
C4_STOCK_MODE=${C4_STOCK_MODE:-venv}                   # venv = the plan's separate install (NOT BUILT YET);
                                                       # baseline-site = the main venv + baseline/site (interim)
STOCK_VENV=${STOCK_VENV:-/home/USER/ai/deep-research/stock-ldr/.venv}
LDR_SEARCH_FALLBACK=0
LDR_RESEARCH_S2=0
