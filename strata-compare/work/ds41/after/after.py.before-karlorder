def arm_maya(st, key, m, note, client):
    """a graded-set run on the head-to-head's Maya arm, inside maya-netns.sh as the head-to-head ran it"""
    if key in st["steps"]:
        return st["steps"][key]
    cfg = f"{SC}/results/ds41/h2h/cfg-{m}/maya-{m}.json"
    shutil.copy(tune.SHIPPED, MPROF)
    env = clean_env(ARM_NOTE=note, PROFILE=MPROF, COOL_MIN=0, PASSES=1, NPROMPT=1, ENGINE_NAME="maya-ds4", MAYA_ROOT=MSRC,
                    DS_SERVER=f"{MSRC}/serve/server.py", SERVER_ENV=f"STRATA_GLM_THINK_RESERVE=512 MAYA_UPDATE_CHECK=0 TMPDIR={SC}/results/ds41/h2h/tmp",
                    CLIENT=client, CLIENT_TIMEOUT=36000)
    say(f"{key}: {note}")
    t0 = time.time()
    with open(LOG, "a") as lf:
        subprocess.run(["bash", f"{MY}/maya-netns.sh", "bash", f"{MY}/maya-tunearm.sh", key, cfg], env=env, stdout=lf, stderr=lf)
    d = open(f"{SC}/tmp/ds41-arm-out").read().strip()
    g = open(f"{d}/GUARD").read().strip() if os.path.exists(f"{d}/GUARD") else ""
    s = open(f"{d}/summary.txt").read() if os.path.exists(f"{d}/summary.txt") else ""
    if "kernel" in g.lower() or re.search(r"KCHECK FAILED|kernel check failed", s, re.I):
        st["steps"][key] = {"dir": d, "guard": g or "kernel check failed"}
        stop(st, f"{key}: kernel event ({g or 'kcheck failed'}) - {d}")
    st["steps"][key] = {"dir": d, "min": round((time.time() - t0) / 60, 1), "guard": g or None,
                        "softstop": os.path.exists(f"{d}/SOFTSTOP"),
                        "nvme": next((l.strip() for l in s.splitlines() if l.startswith("nvme0")), None),
                        "swap": next((l.strip() for l in s.splitlines() if l.startswith("swap:")), None)}
    save(st)
    say(f"{key}: {st['steps'][key]['min']} min" + (f"; {g}" if g else ""))
    return st["steps"][key]


def ctx_cost(st):
    """12 (the user, 10-26, report only: "After the graded set ... measure DeepSeek's decode speed and VRAM expert count at a
    max context of 32K, 64K and 128K on the daily config. That shows what raising its context would cost if it becomes the
    main chat model"): the daily config of step 8 (the ship config if none) with --max-context 32768 / 65536 / 131072, the
    full protocol (speed3.py: P4K x3, P20K x3, W1-W3 x3), soft stop 14 GB as the daily-size runs; one that does not start
    or stops is recorded with the reason"""
    if st.get("ctx_cost") or DRY:
        if DRY:
            print("  DRY: context cost: daily config at --max-context 32768 / 65536 / 131072, full protocol")
        return
    d = st.get("daily") or {}
    t = next((x for x in d.get("tries", []) if x.get("ok")), None)
    base = dict(final(), engine="v026")
    if t:
        base.update({"--ssd-cache": t["store_gb"], "DS4_STORE_FLOOR_GB": 14, "STRATA_DS4_SLOT_KEEP": "1",
                     "STRATA_DS4_SLOT_CAP": "16", "STRATA_DS4_SLOT_GB": "2", "STRATA_DS4_SLOT_DIR": f"{R}/ctx-slots"})
    out = {}
    for n in (32768, 65536, 131072):
        r = arm(st, f"ctx-{n // 1024}k", dict(base, **{"--max-context": n}),
                f"context cost: the daily config at --max-context {n} (report only)", "", passes=3, nprompt=3, soft=14,
                cool=60, server_env="STRATA_DS4_AUTO_PIN=1" if t else None)
        start = ""
        if r.get("dir") and os.path.exists(f"{r['dir']}/engine-start.log"):
            start = " / ".join(l.strip()[:160] for l in open(f"{r['dir']}/engine-start.log", errors="replace")
                               if re.search(r"context|KV|cache.*GB|layers \[|in VRAM|CPU lane", l))[:900]
        out[n] = {k: r.get(k) for k in ("decode", "P4K", "P20K", "vram_experts", "lowest_mem", "guard", "softstop", "dir")}
        out[n]["engine_lines"] = start
        say(f"context {n}: decode {r.get('decode')}, P4K {r.get('P4K')}, P20K {r.get('P20K')}, VRAM experts {r.get('vram_experts')}, "
            f"lowest {r.get('lowest_mem')} GB" + (f"; {r.get('guard')}" if r.get("guard") else "") + ("; SOFT STOP" if r.get("softstop") else ""))
    st["ctx_cost"] = out
    save(st)


