+        label = {"outdated": "OUTDATED", "still_true": "still true", "unclear": "unclear"}.get(v, v)
+        lines.append(f"- \"{q[:300]}\" -> {label}{(': ' + upd) if upd else ''}{(' (' + src + ')') if src else ''}")
+    return body, "\n".join(lines)
