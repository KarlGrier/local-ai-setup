[ -s $EXC ] && grep -q 'owner exception' $EXC || refuse hard "the owner-exception record $EXC is missing"
head -1 $GAPD/result.txt 2> /dev/null | grep -q '^DONE' || refuse hard "the ADAPT_FETCH gap's result.txt does not start DONE"
