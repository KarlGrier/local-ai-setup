def summary(st):
    S = st["steps"]
    L = [f"# DeepSeek follow-ups ({time.strftime('%F')})", "",
         f"Builds: fix {st.get('build_fix')}, test {st.get('build_test')}. Ship config: `{json.dumps(final())}`.", ""]
    for k, title in (("fix-ckpt", "Item 6 - the one-line fix, slot keep off (follow-up reads)"),
                     ("rep-stock-reuse0", "Item 2 - repeat pairs, stock v0.2.6, STRATA_DS4_REUSE=0"),
                     ("rep-test-reuse0", "Item 2 - repeat pairs, counter reset per seeded request, REUSE=0"),
                     ("rep-test-reuse1", "Item 2 - repeat pairs, counter reset per seeded request, reuse on")):
        x = S.get(k) or {}
        L += [f"## {title}", "", "```", (x.get("client_tail") or x.get("skipped") or "not run").strip()[-2400:], "```", ""]
    L += ["## Item 3 - resumed vs fresh (teacher-forced, report only)", "", "```", json.dumps(st.get("resume_kl"), indent=1)[:5000],
          "```", "", "## Item 1 - the daily config", "", "```", json.dumps(st.get("daily"), indent=1)[:5000], "```",
          f"Config: {st.get('daily_cfg')}; launcher smoke test: {st.get('smoke')}", "",
          "## The graded set (answers; grades and the report come after the gap: graded/REPORT.md)", "",
          f"- DeepSeek engine: {st.get('g_engine')}", f"- Qwen: {st.get('g_qwen')}", f"- DeepSeek 50: {st.get('g_ds50')}",
          f"- DeepSeek 75: {st.get('g_ds75')}", "", "## Context cost (report only)", "", "```",
          json.dumps(st.get("ctx_cost"), indent=1)[:4000], "```", ""]
    open(f"{R}/summary.md", "w").write("\n".join(L) + "\n")
    say(f"summary: {R}/summary.md")


def main():
    os.makedirs(R, exist_ok=True)
    st = load()
    if st.get("stopped") and not DRY:
        say(f"not resuming: stopped earlier ({st['stopped']}) - clear 'stopped' in state.json to go on")
        return 1
    if not DRY:
        wait_h2h(st)
    install(st)
    open_gap(st)
    builds(st)
    f = final()
    arm(st, "fix-ckpt", dict(f, engine="v026fix", STRATA_DS4_SLOT_KEEP="0"),
        "item 6: the one-line fix (v026fix), slot keep off - follow-up reads",
        f"{PY} {T}/ckpt_client.py $URL $OUT {ELOG} 0")
    ex = f"{PY} {T}/cont_client.py $URL $OUT {ELOG} exact"
    arm(st, "rep-stock-reuse0", dict(f, engine="v026", STRATA_DS4_REUSE="0", **{"--no-expert-cache": None}),
        "item 2: repeat pairs, stock v0.2.6, STRATA_DS4_REUSE=0, seed 4242, placement frozen", ex)
    arm(st, "rep-test-reuse0", dict(f, engine="v026test", STRATA_DS4_REUSE="0", DS4_TEST_SEED_RESET="1", **{"--no-expert-cache": None}),
        "item 2: repeat pairs, the sampler counter reset per seeded request (v026test), REUSE=0", ex)
    arm(st, "rep-test-reuse1", dict(f, engine="v026test", DS4_TEST_SEED_RESET="1", **{"--no-expert-cache": None}),
        "item 2: repeat pairs, the counter reset per seeded request (v026test), reuse on", ex)
    resume_kl(st)
    daily(st)
    graded_qwen(st)
    graded_ds(st, 50)
    graded_ds(st, 75)
    ctx_cost(st)
    for fn in (summary,):
        if DRY:
            continue
        try:
            fn(st)
        except Exception as e:   # noqa: BLE001  (a bug here must not keep 8080 down)
            say(f"{fn.__name__} failed: {type(e).__name__}: {e}")
    rc = close_gap(st) if not DRY else 0
    try:
        graded_after(st)   # (CPU only, after the gap: the suite's checkers and the report)
    except Exception as e:   # noqa: BLE001
        say(f"graded_after failed: {type(e).__name__}: {e}")
    notify("DeepSeek follow-ups done", f"summary: {R}/summary.md; 8080 {'back on P021m' if rc == 0 else 'NOT restored'}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
