[Unit]
Description=Deep research measurements (phase 4 item 7 since 10-31: queue-plan-item7.json - p7b, p7c, p7a, each o01-o03 + the hard five; ~/ai/deep-research/tools/bench2-queue.sh)
After=default.target deep-research-runner.service

[Service]
Type=simple
# waits for 09:00; new work only 09:00-22:00; stops between questions for a new Strata release or tmp/bench2.stop
ExecStart=/bin/bash /home/USER/ai/deep-research/tools/bench2-queue.sh
WorkingDirectory=/home/USER/ai/deep-research
Environment=BENCH2_PLAN=queue-plan-item7.json
Restart=on-failure
RestartSec=60
KillMode=process

[Install]
WantedBy=default.target
