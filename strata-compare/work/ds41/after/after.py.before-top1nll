def daily_tests(st):
    """Karl (via the user, 16:05): "Re-run the end tests that matter for daily use on the final config: the
    conversation-cache test and the follow-up re-read test with slot keep on, cap 16. Skip the slot-keep-off and cap-4
    variants; their decisions are made. If anything fails, report it and keep the daily config on hold." The round's
    clients unchanged (conv.py phases 1-2: a ~20K chat, another chat, back to the first from the RAM slot, then after an
    engine restart from the disk slot; ckpt_client.py: Jan's format, 2 chats x 5 follow-ups after both kinds of answer) on
    the daily config (its store, slot keep 1, cap 16, folder 2 GB, AUTO_PIN 1). Phase 3 (slots off: a fresh-prefill
    reference and C.10) is left out with the slot-keep-off variants; the round's verdict rule never used it."""
    if st.get("daily_tests") or DRY:
        return
    out = {}
    sdir = f"{R}/conv-slots"
    if "conv-final-1" not in st["steps"]:
        shutil.rmtree(sdir, ignore_errors=True)
    sf = f"{R}/conv-A.json"
    mods = daily_mods(st, sdir)
    c1 = arm(st, "conv-final-1", mods, "daily end test: conversation cache, engine run 1 (A to ~20K, B, back to A), daily config",
             f"{PY} {T}/conv.py 1 $URL $OUT {ELOG} {sdir} {sf}", server_env="STRATA_DS4_AUTO_PIN=1")
    c2 = arm(st, "conv-final-2", mods, "daily end test: conversation cache, engine run 2 (after a restart: back to A from the disk slot)",
             f"{PY} {T}/conv.py 2 $URL $OUT {ELOG} {sdir} {sf}", server_env="STRATA_DS4_AUTO_PIN=1")
    rows = []
    for r in (c1, c2):
        if r.get("dir") and os.path.exists(f"{r['dir']}/conv.jsonl"):
            rows += [json.loads(l) for l in open(f"{r['dir']}/conv.jsonl")]

    def reuse_ok(label):
        r = next((x for x in rows if x["turn"].startswith(label)), None)
        return bool(r and r.get("reused") is not None and r.get("prompt_tokens") and r["reused"] >= 0.9 * r["prompt_tokens"])
    inner_rows = [x for x in rows if x["turn"] in ("A2", "A3", "A4", "A5")]
    # (the round's "read <= 50 % of the prompt" tripped on a turn whose new text is over half its prompt - the harness slip
    # in the report; the exact rule as well: each inner turn reads only its new text, reused = the previous prompt - 1)
    inner = bool(inner_rows) and all((x.get("read") or 0) <= 0.5 * (x.get("prompt_tokens") or 1) for x in inner_rows)
    prev = {x["turn"]: x for x in rows}
    exact_inner = bool(inner_rows) and all(
        x.get("reused") is not None and prev.get(f"A{int(x['turn'][1]) - 1}") and
        x["reused"] >= (prev[f"A{int(x['turn'][1]) - 1}"].get("prompt_tokens") or 0) - 1 for x in inner_rows)
    ok6, ok7 = reuse_ok("A6"), reuse_ok("A7")
    conv_ok = ok6 and ok7 and (inner or exact_inner) and not c1.get("guard") and not c2.get("guard")
    out["conv"] = {"pass": conv_ok, "back_to_A_from_RAM": ok6, "back_to_A_from_disk_after_restart": ok7,
                   "inner_read_le_half": inner, "inner_reused_previous_prompt": exact_inner,
                   "guards": [c1.get("guard"), c2.get("guard")],
                   "rows": [{k: x.get(k) for k in ("turn", "prompt_tokens", "reused", "read", "ttft_s", "engine_write_mb",
                                                    "slot_dir_mb")} for x in rows]}
    say(f"daily end test, conversation cache: {'PASS' if conv_ok else 'FAIL'} (back to A from RAM {ok6}, from disk after a "
        f"restart {ok7}, inner turns read only the new text {inner or exact_inner})\n" +
        "\n".join(f"  {x['turn']}: prompt {x.get('prompt_tokens')} = {x.get('reused')} reused + {x.get('read')} read, TTFT "
                  f"{x.get('ttft_s')} s, engine wrote {x.get('engine_write_mb')} MB, slot folder {x.get('slot_dir_mb')} MB" for x in rows))
    k = arm(st, "ckpt-final", daily_mods(st, f"{R}/ckpt-slots"), "daily end test: follow-up reads (Jan's format), daily config, slot keep on, cap 16",
            f"{PY} {T}/ckpt_client.py $URL $OUT {ELOG} 1", server_env="STRATA_DS4_AUTO_PIN=1")
    cj = json.load(open(f"{k['dir']}/ckpt.json")) if k.get("dir") and os.path.exists(f"{k['dir']}/ckpt.json") else {}
    ck_ok = cj.get("verdict") == "PASS" and not k.get("guard")
    out["ckpt"] = {"pass": ck_ok, "guard": k.get("guard"), **{x: cj.get(x) for x in ("followups", "ok", "re_read",
                                                                                      "render_mismatch", "history_differs")}}
    say(f"daily end test, follow-up reads: {'PASS' if ck_ok else 'FAIL'} ({cj.get('ok')} of {cj.get('followups')} read only "
        f"the last answer + the new message; re-reads {cj.get('re_read')}; guard {k.get('guard')})")
    out["pass"] = conv_ok and ck_ok
    st["daily_tests"] = out
    save(st)
    if not conv_ok:
        hold_daily(st, "the daily config failed the conversation-cache end test")
    if not ck_ok:
        hold_daily(st, "the daily config failed the follow-up re-read end test")


