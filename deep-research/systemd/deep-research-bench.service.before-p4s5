[Unit]
Description=Deep research measurements (phase 4 stage 3 since 10-22: queue-plan-p4s3.json - o01-o03 + the hard five with items setup + critic; ~/ai/deep-research/tools/bench2-queue.sh)
After=default.target deep-research-runner.service

[Service]
Type=simple
# waits for 09:00; new work only 09:00-22:00; stops between questions for a new Strata release or tmp/bench2.stop
ExecStart=/bin/bash /home/USER/ai/deep-research/tools/bench2-queue.sh
WorkingDirectory=/home/USER/ai/deep-research
Environment=BENCH2_PLAN=queue-plan-p4s4.json
Restart=on-failure
RestartSec=60
KillMode=process

[Install]
WantedBy=default.target
