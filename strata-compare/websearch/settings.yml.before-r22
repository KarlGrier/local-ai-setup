# SearXNG settings for the Strata chat page's web search (round 5). Local only: 127.0.0.1:8888, JSON API on.
use_default_settings: true
general:
  instance_name: "local search (strata)"
  enable_metrics: false
server:
  bind_address: "127.0.0.1"
  port: 8888
  secret_key: "<generate: openssl rand -hex 32>"
  limiter: false
  public_instance: false
  image_proxy: false
  method: "GET"
search:
  safe_search: 0
  autocomplete: ""
  default_lang: "auto"
  formats:
    - html
    - json
valkey:
  url: false
outgoing:
  request_timeout: 5.0
  max_request_timeout: 10.0
  pool_connections: 50
  pool_maxsize: 10
engines:
  # CAPTCHA'd from this address / Tor-only: off (the others answer)
  - name: duckduckgo
    disabled: true
  - name: ahmia
    inactive: true
  - name: torch
    inactive: true
  # round 9 (2026-10-01): brave + google cse ("Suspended: too many requests" since round 8) gave 0 results; these two
  # keyless engines answered 4/4 probe queries from this address (kernel.org / python.org / nvidia.com / wikipedia on top).
  # Backup of the previous file: websearch/settings.yml.before-r9
  - name: google
    disabled: false
  - name: yahoo
    disabled: false
