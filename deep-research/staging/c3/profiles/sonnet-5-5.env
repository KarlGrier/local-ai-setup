# profiles/sonnet-5-5.env - Claude Sonnet 5.5 (claude-sonnet-5-5) through Anthropic's API, for C4 (one question, o03,
# our build vs stock LDR, $60 hard stop; results/SONNET55-LDR-PLAN-1027.md).
#
# EVERY VALUE BELOW IS A DRAFT, UNMEASURED. Nothing here has been run. run-ldr.sh refuses this profile
# (LDR_PROFILE_STATUS=draft) unless LDR_ALLOW_DRAFT_PROFILE=1 - and even then it cannot run C4 as it is: run-ldr.sh
# talks to Strata (model discovery on 8080, strata-proxy on 8090). C4 needs an API launcher first (see README, open
# items): prompt caching on, effort sent as output_config.effort, no Strata-only proxy fields.
#
# Model facts (Anthropic's model table, cached 2026-10-06): 1M context, 128K output (streaming needed for large
# max_tokens), effort low / medium / high / xhigh / max (default high, levels recalibrated from Sonnet 5), adaptive
# thinking on by default ({type: "disabled"} is refused), non-default temperature / top_p / top_k refused, $2 / $10
# per MTok, cache reads $0.20. No local tokenizer: counts are estimated (chars / 3), so the margins are larger.
# auto = derived from the context (base * context // 131072); the value it gives at 1,000,000 is in the comment.
# Several auto sizes are capped here for C4's cost (draft numbers, chosen on paper - not measured).

LDR_PROFILE_MODEL=claude-sonnet-5-5       # draft, unmeasured
LDR_PROFILE_STATUS=draft                  # draft, unmeasured: every value in this file
LDR_PROMPT_CACHING=required               # draft, unmeasured: a requirement for C4 (the launcher must turn it on)

# ---- context and output (draft, unmeasured) -------------------------------------------------------------------------
LDR_DEEP_CONTEXT_TOKENS=1000000           # draft, unmeasured: the model's 1M window
LDR_LLM_MAX_TOKENS=64000                  # draft, unmeasured: per agent call (thinking + answer; model max 128000)
LDR_DEEP_REPORT_MAX_OUTPUT=64000          # draft, unmeasured: report calls (model max 128000; a section needs < 20K)
LDR_DEEP_REPORT_ANSWER_RESERVE=8192       # draft, unmeasured
LDR_DEEP_REPORT_MARGIN=16384              # draft, unmeasured: estimated counts (no tokenizer) - wider than 1024
LDR_DEEP_TOKEN_MARGIN=8192                # draft, unmeasured: estimated counts - wider than Qwen's exact 512

# ---- compaction (draft, unmeasured) -----------------------------------------------------------------------------------
LDR_DEEP_COMPACT_AT=200000                # draft, unmeasured: capped for cost (auto: 427246 - every lead call re-reads
                                          # its history; cache reads at $0.20/MTok x ~200 calls)
LDR_DEEP_KEEP_RECENT=6                    # draft, unmeasured
LDR_DEEP_KEEP_RECENT_FRAC=0.35            # draft, unmeasured
LDR_DEEP_COMPACT_FALLBACK_TOKENS=auto     # draft, unmeasured: 91552 at 1M

# ---- what the lead and the writers see (draft, unmeasured) -----------------------------------------------------------
LDR_DEEP_SUB_RETURN_MAX_CHARS=auto        # draft, unmeasured: 122070 at 1M (the whole report, as a rule)
LDR_DEEP_SNIPPET_CHARS=auto               # draft, unmeasured: 2288 at 1M (full snippets)
LDR_DEEP_FETCH_MAX_CHARS=240000           # draft, unmeasured: capped for cost (auto: 915527 = ~230K tokens a page,
                                          # ~$0.46 per extraction); 240000 = what 262K would give
LDR_DEEP_EXTRACT_MAX_CHARS=8000           # draft, unmeasured: a stronger extractor may keep more verbatim text
LDR_DEEP_REPORT_EVIDENCE_TOKENS=150000    # draft, unmeasured: capped for cost (auto: 366210 per section call)
LDR_DEEP_SECTION_EXTRACT_FRAC=0.6         # draft, unmeasured
LDR_DEEP_REPORT_FINDINGS_TOKENS=auto      # draft, unmeasured: 91552 at 1M
LDR_DEEP_OUTLINE_LEAD_TOKENS=auto         # draft, unmeasured: 76293 at 1M
LDR_DEEP_OUTLINE_FINDINGS_FRAC=0.40       # draft, unmeasured
LDR_DEEP_CLAIMS_PER_SOURCE=auto           # draft, unmeasured: 305 at 1M
LDR_DEEP_READ_PASSAGE_TOKENS=auto         # draft, unmeasured: 2670 at 1M
LDR_DEEP_SEED_TEXT_CHARS=auto             # draft, unmeasured: 457763 at 1M
LDR_DEEP_VERIFY_CLAIM_SOURCE_TOKENS=auto  # draft, unmeasured: 15258 at 1M per cited source per claim
LDR_DEEP_VERIFY_BATCH_TOKENS=120000       # draft, unmeasured: capped (auto: 274658) - smaller calls, fewer re-reads
LDR_DEEP_VERIFY_BATCH_CLAIMS=8            # draft, unmeasured
LDR_DEEP_VERIFY_PAGE_TOKENS=auto          # draft, unmeasured: 305175 at 1M (old per-source check, unused)
LDR_DEEP_TRIED_PART_CHARS=auto            # draft, unmeasured (tried list is off)
LDR_DEEP_TRIED_MERGE_CHARS=auto           # draft, unmeasured
LDR_DEEP_TRIED_BLOCK_CHARS=auto           # draft, unmeasured

# ---- tokenizer (draft, unmeasured) ------------------------------------------------------------------------------------
LDR_DEEP_TOKENIZER_DIR=                   # draft, unmeasured: none - estimated counts (the API's count_tokens is a
                                          # network call; not used for budgets)
LDR_DEEP_TOK_MSG_OVERHEAD=8               # draft, unmeasured
LDR_DEEP_TOK_TOOLS_OVERHEAD=500           # draft, unmeasured: Anthropic's tool-use system prompt is larger
LDR_DEEP_TOK_CHARS_PER_TOKEN=3            # draft, unmeasured: conservative for English (Claude ~3.5-4)

# ---- reasoning effort (draft, unmeasured; Sonnet 5.5 levels: low medium high xhigh max) ---------------------------------
LDR_DEEP_EXTRACT_EFFORT=low               # draft, unmeasured: quoting a page is routine work
LDR_DEEP_COMPACT_EFFORT=medium            # draft, unmeasured
LDR_DEEP_REPORT_EFFORT=high               # draft, unmeasured
LDR_DEEP_VERIFY_EFFORT=high               # draft, unmeasured (Flash-Next needed xhigh; re-measure)
LDR_DEEP_TRIED_MAP_EFFORT=low             # draft, unmeasured
LDR_DEEP_TRIED_MERGE_EFFORT=medium        # draft, unmeasured
LDR_DEEP_EFFORT_MAP=                      # draft, unmeasured: our four names exist on Sonnet 5.5 as they are; the
                                          # launcher must send them as output_config.effort, not reasoning_effort
LDR_DEEP_EFFORT_LADDER=same               # draft, unmeasured: errors retried at the same effort after a pause
LDR_JOB_AGENT_EFFORT=medium               # draft, unmeasured: Anthropic's start point for multistep tool use
LDR_JOB_EXTRACT_EFFORT=low                # draft, unmeasured
LDR_JOB_REPORT_EFFORT=high                # draft, unmeasured
LDR_JOB_VERIFY_EFFORT=high                # draft, unmeasured

# ---- pace (draft, unmeasured) -------------------------------------------------------------------------------------------
LDR_WORKERS=4                             # draft, unmeasured: stock LDR's 4 - an API runs subagents in parallel
LDR_DEEP_MAX_ITERATIONS=200               # draft, unmeasured: C4's per-run caps decide the real stop
LDR_DEEP_MAX_SUB_ITERATIONS=30            # draft, unmeasured
LDR_DEEP_MAX_SUBTOPICS=8                  # draft, unmeasured
LDR_DEEP_MAX_SUBTOPICS_HARD=12            # draft, unmeasured
LDR_DEEP_SUBAGENT_BUDGET_S=3600           # draft, unmeasured
LDR_DEEP_SUBAGENT_HARD_S=7200             # draft, unmeasured
LDR_DEEP_SUBAGENT_SHARE=0.75              # draft, unmeasured (built for serial waves; with 4 workers maybe 1.0)
LDR_DEEP_SUBAGENT_MIN_START_S=60          # draft, unmeasured
LDR_DEEP_TIME_BUDGET_S=10800              # draft, unmeasured: C4 keeps the Flash-Next budget for comparability
LDR_DEEP_VERIFY_MAX_CLAIMS=120            # draft, unmeasured (0 = all is realistic on a fast model, cost permitting)
LDR_DEEP_READ_MAX=400                     # draft, unmeasured
LDR_DEEP_READ_PRIMARY_MAX=40              # draft, unmeasured
LDR_DEEP_READ_PRIMARY_PER_PAGE=2          # draft, unmeasured
LDR_QUICK_MAX_ITERATIONS=12               # draft, unmeasured (quick jobs are not part of C4)
LDR_QUICK_CAP_S=900                       # draft, unmeasured

# ---- code tool (draft, unmeasured; o03 has no code question) ------------------------------------------------------------
LDR_DEEP_CODE_READ_LINES=auto             # draft, unmeasured: 915 at 1M
LDR_DEEP_CODE_GREP_HITS=auto              # draft, unmeasured: 305 at 1M
LDR_DEEP_CODE_TREE_ENTRIES=auto           # draft, unmeasured: 1525 at 1M
LDR_DEEP_CODE_LINE_CHARS=240              # draft, unmeasured
LDR_DEEP_CODE_ISSUE_CHARS=auto            # draft, unmeasured: 22888 at 1M
LDR_DEEP_CODE_COMMENT_CHARS=auto          # draft, unmeasured: 11444 at 1M
LDR_DEEP_CODE_ISSUE_LIST_CHARS=auto       # draft, unmeasured: 4577 at 1M
LDR_DEEP_CODE_SHORT_READS=0               # draft, unmeasured: the large-context wording (whole files when they matter)

# ---- sampling (draft, unmeasured) ---------------------------------------------------------------------------------------
LDR_TEMPERATURE=1.0                       # draft, unmeasured: the API default - Sonnet 5.5 refuses any other value
