+    tv = _versions(task)
+    return bool(tv) and _baseline_on() and bool(tv - _versions(facts))
+
+
+def hardware_only(facts: str) -> str:
+    """The top-level hardware bullets of the setup facts, with their continuation lines."""
+    out, keep = [], False
+    for line in facts.splitlines():
+        if line.startswith("- "):
